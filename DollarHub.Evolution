function aa.Gradient(az,aA,aB)
local b={}
local d={}

for f,g in next,aA do
local h=tonumber(f)
if h then
h=math.clamp(h/100,0,1)

local i=g.Color
if typeof(i)=="string"and string.sub(i,1,1)=="#"then
i=Color3.fromHex(i)
end

local l=g.Transparency or 0

table.insert(b,ColorSequenceKeypoint.new(h,i))
table.insert(d,NumberSequenceKeypoint.new(h,l))
end
end

table.sort(b,function(f,g)
return f.Time<g.Time
end)
table.sort(d,function(f,g)
return f.Time<g.Time
end)

if#b<2 then
table.insert(b,ColorSequenceKeypoint.new(1,b[1].Value))
table.insert(d,NumberSequenceKeypoint.new(1,d[1].Value))
end

local f={
Color=ColorSequence.new(b),
Transparency=NumberSequence.new(d),
}

if aB then
for g,h in pairs(aB)do
f[g]=h
end
end

return f
end

function aa.Popup(az,aA)
aA.WindUI=aa
return a.load'u'.new(aA,aa.ScreenGui.Popups)
end

aa.Themes=a.load'v'(aa,as)

as.Themes=aa.Themes

aa:SetTheme"Dark"
aa:SetLanguage(as.Language)

function aa.CreateWindow(az,aA)
local aB=a.load'ae'

if not am:IsStudio()and writefile then
if not isfolder"WindUI"then
makefolder"WindUI"
end
if aA.Folder then
makefolder(aA.Folder)
else
makefolder(aA.Title)
end
end

aA.WindUI=aa
aA.Window=aa.Window
aA.Parent=aa.ScreenGui.Window

if aa.Window then
warn"You cannot create more than one window"
return
end

local b=true

local d=aa.Themes[aA.Theme or"Dark"]


as.SetTheme(d)

local f=gethwid or function()
return ak.LocalPlayer.UserId
end

local g=f()

if aA.KeySystem then
b=false

local function loadKeysystem()
ar.new(aA,g,function(h)
b=h
end)
end

local h=(aA.Folder or"Temp").."/"..g..".key"

if aA.KeySystem.KeyValidator then
if aA.KeySystem.SaveKey and isfile(h)then
local i=readfile(h)
local l=aA.KeySystem.KeyValidator(i)

if l then
b=true
else
loadKeysystem()
end
else
loadKeysystem()
end
elseif not aA.KeySystem.API then
if aA.KeySystem.SaveKey and isfile(h)then
local i=readfile(h)
local l=(type(aA.KeySystem.Key)=="table")and table.find(aA.KeySystem.Key,i)
or tostring(aA.KeySystem.Key)==tostring(i)

if l then
b=true
else
loadKeysystem()
end
else
loadKeysystem()
end
else
if isfile(h)then
local i=readfile(h)
local l=false

for m,p in next,aA.KeySystem.API do
local r=aa.Services[p.Type]
if r then
local u={}
for v,x in next,r.Args do
table.insert(u,p[x])
end

local v=r.New(table.unpack(u))
local x=v.Verify(i)
if x then
l=true
break
end
end
end

b=l
if not l then
loadKeysystem()
end
else
loadKeysystem()
end
end

repeat
task.wait()
until b
end

local h=aB(aA)

aa.Transparent=aA.Transparent
aa.Window=h

if aA.Acrylic then
au.init()
end













return h
end

return aa
end
local function CreateEvolutionInterface(WindUI, brand, logo, folder)
    local gold = Color3.fromHex("D5AD4A")
    WindUI:AddTheme({
        Name = "EvolutionObsidianGold", Accent = Color3.fromHex("1B1A16"),
        Background = Color3.fromHex("0D0E10"), Dialog = Color3.fromHex("151619"),
        Outline = Color3.fromHex("6C5730"), Text = Color3.fromHex("F5F0E4"),
        Placeholder = Color3.fromHex("96918A"), Button = Color3.fromHex("29251B"),
        Icon = Color3.fromHex("DEC478"), Toggle = gold, Slider = gold,
        Checkbox = gold, Primary = gold,
    })
    local api = { WindUI = WindUI, Flags = {}, SetFlags = {}, Windows = {}, Unloaded = false }
    local controls, cleanups = {}, {}
    local function call(fn, ...)
        if type(fn) ~= "function" then return end
        local ok, err = pcall(fn, ...)
        if not ok then warn("[" .. brand .. "] " .. tostring(err)) end
    end
    local function title(options)
        if type(options) == "string" then return options end
        return options.Title or options.Name or options.Text or ""
    end
    local function first(value, fallback)
        if value ~= nil then return value end
        return fallback
    end
    local function rootOf(object)
        local elements = object and object.UIElements
        return elements and (elements.Main or elements.Container or elements.Element)
    end
    local function visible(object, value)
        if object and type(object.SetVisible) == "function" then object:SetVisible(value)
        else local root = rootOf(object); if root then root.Visible = value end end
    end
    local function array(value)
        if type(value) ~= "table" then return {} end
        local out = {}
        for key, entry in pairs(value) do
            if type(key) == "number" then table.insert(out, entry)
            elseif entry == true then table.insert(out, key) end
        end
        return out
    end
    function api:OnUnload(fn) table.insert(cleanups, fn) end
    function api:Notification(data) return self:Notify(data) end
    function api:Notify(data, text, duration)
        if type(data) ~= "table" then data = { Title = data, Content = text, Duration = duration } end
        return WindUI:Notify({ Title = data.Title or data.Name or brand,
            Content = data.Content or data.Description or data.Desc or "", Duration = data.Duration or 4,
            Icon = data.Icon or "sparkles" })
    end
    function api:Unload()
        if self.Unloaded then return end
        self.Unloaded = true
        for i = #cleanups, 1, -1 do call(cleanups[i]) end
        for _, window in ipairs(self.Windows) do if not window.Destroyed then window:Destroy() end end
        table.clear(cleanups)
    end
    function api:CreateWindow(options)
        options = options or {}
        local camera = workspace.CurrentCamera
        local viewport = camera and camera.ViewportSize or Vector2.new(1280, 720)
        local width, height = math.min(760, math.max(280, viewport.X - 28)), math.min(540, math.max(240, viewport.Y - 48))
        local window = WindUI:CreateWindow({
            Title = brand, Author = "สายเลือดอาชีวะ", Icon = logo, IconThemed = false,
            Folder = folder, Size = UDim2.fromOffset(width, height),
            MinSize = Vector2.new(math.min(380, width), math.min(300, height)),
            MaxSize = Vector2.new(1100, 850), SideBarWidth = viewport.X < 650 and 138 or 178,
            Theme = "EvolutionObsidianGold", Transparent = false, Resizable = true,
            HideSearchBar = false, ScrollBarEnabled = true,
            ToggleKey = options.ToggleKey or Enum.KeyCode.RightShift,
            OpenButton = { Title = brand, Icon = logo, Enabled = true, Draggable = true, OnlyMobile = false },
            User = { Enabled = true, Anonymous = false },
        })
        if window.EditOpenButton then window:EditOpenButton({ Title = brand, Icon = logo,
            Color = ColorSequence.new(gold, Color3.fromHex("A67F28")), OnlyMobile = false }) end
        local facade = { Native = window, UIElements = window.UIElements, Tabs = {}, Closed = false,
            Destroyed = false, Root = rootOf(window), _destroy = {}, _resize = {} }
        api.MainWindow = facade
        table.insert(api.Windows, facade)
        local function attachControl(parent, kind, data)
            data = data or {}
            local multi = data.Multi == true or kind == "MultiDropdown"
            if kind == "MultiDropdown" then kind = "Dropdown" end
            if kind == "Textbox" then kind = "Input" end
            if kind == "Label" or kind == "KeyValue" then kind = "Paragraph" end
            local actionKey = kind == "Keybind" and (data.Mode == "Hold" or data.Mode == "Toggle")
            local checkbox
            if kind == "Dropdown" and data.Checkbox then
                checkbox = attachControl(parent, "Toggle", { Title = title(data) .. " · เปิดใช้งาน", Flag = data.CheckFlag,
                    Default = data.CheckDefault == true, Callback = data.CheckCallback })
            end
            local initial = first(data.Value, data.Default)
            if kind == "Slider" then
                initial = type(data.Value) == "table" and data.Value.Default or first(data.Default, data.Value)
                initial = tonumber(initial) or data.Min or 0
            elseif kind == "Toggle" then initial = initial == true
            elseif kind == "Dropdown" and multi then initial = array(initial)
            elseif kind == "Colorpicker" then initial = data.Default or data.Value or gold
            elseif kind == "Keybind" then initial = data.Default or data.Value or "RightShift"
                if typeof(initial) == "EnumItem" then initial = initial.Name end
            elseif kind == "Paragraph" then initial = data.Value or data.Desc or data.Text or data.Name or data.Title or "" end
            local control = { Value = initial, Default = initial, Type = kind, Multi = multi, Picking = false,
                Title = title(data), Visible = true, Locked = data.Locked == true, Flag = data.Flag,
                _callback = data.Callback, _suppress = true, _parent = parent, _changed = {} }
            local function update(value, ...)
                if control._suppress or control.Destroyed then return end
                if kind == "Slider" then value = tonumber(value) or control.Value end
                if kind == "Dropdown" and multi then value = array(value) end
                if kind == "Keybind" and typeof(value) == "EnumItem" then value = value.Name end
                control.Value = value
                if data.Flag then api.Flags[data.Flag] = value end
                if not actionKey then call(control._callback, value, ...) end
                for _, fn in ipairs(control._changed) do call(fn, value) end
            end
            local config = { Title = title(data), Desc = data.Desc or data.Tooltip or data.Description,
                Icon = data.Icon, Flag = data.Flag, Locked = control.Locked, Callback = update }
            if kind == "Toggle" then config.Value = initial; config.Type = "Toggle"
            elseif kind == "Slider" then
                local limits = type(data.Value) == "table" and data.Value or data
                config.Value = { Min = limits.Min or 0, Max = limits.Max or 100, Default = initial }
                config.Step = data.Step or data.Increment or 1
            elseif kind == "Dropdown" then
                config.Values = data.Values or data.Items or {}; config.Value = initial
                config.Multi = multi; config.AllowNone = true; config.SearchBarEnabled = true
            elseif kind == "Colorpicker" then config.Default = initial; config.Transparency = data.Transparency or 0
            elseif kind == "Input" then config.Value = tostring(initial or ""); config.Placeholder = data.Placeholder or ""
            elseif kind == "Keybind" then config.Value = initial
            elseif kind == "Paragraph" then config.Desc = tostring(initial or "")
            elseif kind == "Button" then config.Callback = function() if not control.Locked then call(data.Callback) end end end
            assert(type(parent[kind]) == "function", "WindUI element unavailable: " .. kind)
            local native = parent[kind](parent, config)
            control.Native, control.UIElements = native, native.UIElements
            control.Items = { Label = { Instance = rootOf(native) } }
            control.Checkbox = checkbox
            function control:Set(value, silent)
                if self.Destroyed then return end
                if self.Type == "Paragraph" and type(value) == "table" then
                    if value.Title then self:SetTitle(value.Title) end
                    if value.Desc or value.Content then self:SetDesc(value.Desc or value.Content) end
                    return self
                end
                if self.Type == "Slider" then value = tonumber(value) or self.Value end
                if self.Type == "Dropdown" and self.Multi then value = array(value) end
                self.Value, self._suppress = value, true
                if self.Flag then api.Flags[self.Flag] = value end
                if self.Type == "Paragraph" then self:SetDesc(value)
                elseif self.Type == "Dropdown" then native:Select(value)
                elseif native.Set then native:Set(value, false, false)
                elseif native.Update then native:Update(value) end
                self._suppress = false
                if not silent and self.Type ~= "Paragraph" then update(value) end
                return self
            end
            control.SetValue, control.Select = control.Set, control.Set
            function control:Get() return self.Value end
            control.GetValue = control.Get
            function control:SetTitle(value) self.Title = value; if native.SetTitle then native:SetTitle(tostring(value)) end end
            function control:SetDesc(value) self.Desc = tostring(value or ""); if native.SetDesc then native:SetDesc(self.Desc) end end
            function control:SetText(value) return self:SetTitle(value) end
            function control:Refresh(values, selected)
                if native.Refresh then native:Refresh(values) end
                if selected ~= nil then self:Set(selected, true) end
            end
            function control:SetMin(value) if native.SetMin then native:SetMin(value) end end
            function control:SetMax(value) if native.SetMax then native:SetMax(value) end end
            function control:SetVisibility(value) self.Visible = value == true; visible(native, self.Visible) end
            control.SetVisible = control.SetVisibility
            function control:Lock(reason) self.Locked = true; if native.Lock then native:Lock(reason) end end
            function control:Unlock() self.Locked = false; if native.Unlock then native:Unlock() end end
            function control:OnChanged(fn) table.insert(self._changed, fn); return self end
            function control:SubColorpicker(picker)
                picker = table.clone(picker or {})
                if not picker.Name and not picker.Title then picker.Title = self.Title .. " · สี" end
                return attachControl(parent, "Colorpicker", picker)
            end
            control.Colorpicker = control.SubColorpicker
            function control:Destroy() if not self.Destroyed then self.Destroyed = true; if native.Destroy then native:Destroy() end end end
            if data.Flag then
                api.Flags[data.Flag] = initial; controls[data.Flag] = control
                api.SetFlags[data.Flag] = function(value) control:Set(value) end
            end
            if actionKey then
                local input = game:GetService("UserInputService")
                local held = false
                local began = input.InputBegan:Connect(function(event, processed)
                    if processed or control.Destroyed or control.Locked or input:GetFocusedTextBox() then return end
                    if event.KeyCode == Enum.KeyCode[control.Value] then
                        if data.Mode == "Toggle" then held = not held else held = true end
                        call(control._callback, held)
                    end
                end)
                local ended = input.InputEnded:Connect(function(event)
                    if data.Mode == "Hold" and held and event.KeyCode == Enum.KeyCode[control.Value] then
                        held = false; call(control._callback, false)
                    end
                end)
                api:OnUnload(function()
                    began:Disconnect(); ended:Disconnect()
                    if held then held = false; call(control._callback, false) end
                end)
            end
            control._suppress = false
            if data.Default ~= nil and data.Callback and kind ~= "Button" and kind ~= "Paragraph" and not actionKey then
                call(data.Callback, initial)
            end
            return control
        end
        local wrapContainer
        wrapContainer = function(native)
            local container = { Native = native, UIElements = native.UIElements, _children = {}, Visible = true }
            for _, method in ipairs({ "Toggle", "Slider", "Dropdown", "MultiDropdown", "Input", "Textbox", "Button", "Paragraph", "Label", "KeyValue", "Keybind", "Colorpicker" }) do
                container[method] = function(self, data)
                    local control = attachControl(native, method, data)
                    table.insert(self._children, control)
                    return control
                end
            end
            function container:Section(data)
                if type(data) == "string" then data = { Title = data } end
                data = data or {}
                local section = native:Section({ Title = title(data), Box = true, Opened = true,
                    TextSize = 15, FontWeight = Enum.FontWeight.SemiBold, Icon = data.Icon })
                local group = wrapContainer(section)
                table.insert(self._children, group)
                return group
            end
            function container:Group(name) return self:Section({ Title = name }) end
            function container:Divider() return native:Divider() end
            function container:Space(height) if native.Space then return native:Space(height or 8) end; return native:Divider() end
            function container:SetVisibility(value)
                self.Visible = value == true
                visible(native, self.Visible)
            end
            container.SetVisible = container.SetVisibility
            function container:ServerBrowser(options)
                options = options or {}
                local browser = { Sort = options.DefaultSort or "ping", Items = {}, Busy = false }
                local panel = self:Section({ Title = title(options) })
                local modes = { ["ปิงต่ำที่สุด"] = "ping", ["คนน้อยที่สุด"] = "low", ["คนมากที่สุด"] = "high", ["ลื่นที่สุด"] = "fps" }
                panel:Dropdown({ Title = "จัดเรียงเซิร์ฟเวอร์", Values = { "ปิงต่ำที่สุด", "คนน้อยที่สุด", "คนมากที่สุด", "ลื่นที่สุด" }, Value = "ปิงต่ำที่สุด",
                    Callback = function(value) browser.Sort = modes[value] or "ping" end })
                local status = panel:Paragraph({ Title = "สถานะ", Desc = "กดรีเฟรชเพื่อค้นหาเซิร์ฟเวอร์" })
                local labels, selected = {}, nil
                local list = panel:Dropdown({ Title = "เซิร์ฟเวอร์ที่พบ", Values = {}, Callback = function(value) selected = labels[value] end })
                function browser:SetStatus(text) status:SetDesc(text) end
                function browser:SetBusy(value) self.Busy = value == true end
                function browser:SetItems(items, meta)
                    self.Items = items or {}; labels = {}; selected = nil
                    local values = {}
                    for i, item in ipairs(self.Items) do
                        local name = string.format("#%s · %s/%s คน%s", tostring(item.Id or i):sub(1, 8), tostring(item.Playing or 0), tostring(item.MaxPlayers or 0), item.Ping and (" · " .. tostring(math.floor(item.Ping)) .. " ms") or "")
                        labels[name] = item; table.insert(values, name)
                    end
                    list:Refresh(values)
                    self:SetStatus(meta and meta.StatusText or ("พบ " .. tostring(#values) .. " เซิร์ฟเวอร์"))
                end
                function browser:Refresh() if not self.Busy then call(options.OnRefresh, self.Sort, self) end end
                panel:Button({ Title = "รีเฟรชรายชื่อ", Icon = "refresh-cw", Callback = function() browser:Refresh() end })
                panel:Button({ Title = "เข้าเซิร์ฟเวอร์ที่เลือก", Icon = "log-in", Callback = function() if selected and not browser.Busy then call(options.OnJoin, selected, browser) end end })
                return browser
            end
            return container
        end
        function facade:Tab(data)
            data = data or {}
            local native = window:Tab({ Title = title(data), Icon = data.Icon or "layout-grid", Locked = false })
            local tab = wrapContainer(native)
            table.insert(self.Tabs, tab)
            return tab
        end
        function facade:Page(data) return self:Tab(data) end
        function facade:Section(name) return window:Section({ Title = type(name) == "table" and title(name) or name, Opened = true }) end
        facade.Category = facade.Section
        function facade:Tag(data) data.Color = gold; if window.Tag then return window:Tag(data) end end
        function facade:SelectTab(index) return window:SelectTab(index) end
        function facade:SetToggleKey(key) return window:SetToggleKey(key) end
        function facade:SetIcon() if window.SetIcon then return window:SetIcon(logo) end end
        function facade:SetTitle() if window.SetTitle then return window:SetTitle(brand) end end
        function facade:GetUIScale() return window:GetUIScale() end
        function facade:SetUIScale(scale) return window:SetUIScale(scale) end
        function facade:SetSize(size)
            if typeof(size) == "Vector2" then size = UDim2.fromOffset(size.X, size.Y) end
            if typeof(size) == "UDim2" then
                local vp = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or viewport
                return window:SetSize(UDim2.fromOffset(math.min(size.X.Offset, vp.X - 20), math.min(size.Y.Offset, vp.Y - 30)))
            end
        end
        function facade:SetBackgroundImageTransparency(value) if window.SetBackgroundImageTransparency then window:SetBackgroundImageTransparency(value) end end
        function facade:SetBackgroundColor(color)
            local background = self.UIElements.Main and self.UIElements.Main:FindFirstChild("Background")
            if background and background:IsA("GuiObject") then background.BackgroundColor3 = color end
        end
        function facade:OnDestroy(fn) table.insert(self._destroy, fn) end
        function facade:OnResize(fn) table.insert(self._resize, fn) end
        function facade:Notify(...) return api:Notify(...) end
        function facade:Open() self.Closed = false; return window:Open() end
        function facade:Close() self.Closed = true; return window:Close() end
        function facade:Toggle() if self.Closed then return self:Open() else return self:Close() end end
        function facade:Destroy()
            if self.Destroyed then return end
            self.Destroyed = true
            for _, fn in ipairs(self._destroy) do call(fn) end
            local result = window:Destroy()
            if not api.Unloaded then api:Unload() end
            return result
        end
        if window.OnDestroy then window:OnDestroy(function()
            if facade.Destroyed then return end
            facade.Destroyed = true
            for _, fn in ipairs(facade._destroy) do call(fn) end
            api:Unload()
        end) end
        if window.OnOpen then window:OnOpen(function() facade.Closed = false end) end
        if window.OnClose then window:OnClose(function() facade.Closed = true end) end
        local main = facade.Root
        if main and main.GetPropertyChangedSignal then
            local createdAt, resizeQueued = os.clock(), false
            local connection = main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
                if facade.Destroyed or facade.Closed or resizeQueued or os.clock() - createdAt < 1 then return end
                resizeQueued = true
                task.delay(0.15, function()
                    resizeQueued = false
                    if facade.Destroyed or facade.Closed then return end
                    local size = main.AbsoluteSize
                    for _, fn in ipairs(facade._resize) do call(fn, size.X, size.Y) end
                end)
            end)
            api:OnUnload(function() connection:Disconnect() end)
        end
        function facade:FloatingToggle(options)
            local gui = Instance.new("ScreenGui")
            gui.Name = folder .. "QuickAction"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true; gui.DisplayOrder = 10000020
            gui.Parent = main and main:FindFirstAncestorOfClass("ScreenGui") and main:FindFirstAncestorOfClass("ScreenGui").Parent or game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
            local button = Instance.new("TextButton")
            button.Size = UDim2.fromOffset(118, 38); button.Position = UDim2.new(1, -140, 0.65, 0)
            button.BackgroundColor3 = Color3.fromHex("171613"); button.TextColor3 = gold
            button.Font = Enum.Font.GothamBold; button.TextSize = 12; button.Text = options.Text or "AIM"; button.Parent = gui
            button.Active = true; button.Draggable = true; button.Visible = options.Visible == true
            local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 12); corner.Parent = button
            local stroke = Instance.new("UIStroke"); stroke.Color = gold; stroke.Thickness = 1; stroke.Transparency = 0.35; stroke.Parent = button
            local connection = button.Activated:Connect(function() call(options.Callback) end)
            local quick = { Button = button, State = false, Destroyed = false }
            function quick:SetText(value) if not self.Destroyed then button.Text = value end end
            function quick:SetState(value, text)
                if self.Destroyed then return end
                self.State = value == true
                button.Text = text or (self.State and "AIM: ON" or "AIM: OFF")
                button.BackgroundColor3 = self.State and gold or Color3.fromHex("171613")
                button.TextColor3 = self.State and Color3.fromHex("14120D") or gold
                stroke.Transparency = self.State and 0.1 or 0.35
            end
            function quick:SetVisible(value) if not self.Destroyed then button.Visible = value == true end end
            quick.SetVisibility = quick.SetVisible
            function quick:Set(value) if type(value) == "table" then
                if value.Text then self:SetText(value.Text) end
                if value.Visible ~= nil then self:SetVisible(value.Visible) end
                else self:SetVisible(value) end end
            function quick:Destroy()
                if self.Destroyed then return end
                self.Destroyed = true
                connection:Disconnect(); gui:Destroy()
            end
            api:OnUnload(function() quick:Destroy() end)
            facade:OnDestroy(function() quick:Destroy() end)
            return quick
        end
        return facade
    end
    function api:CreateHub(options)
        options = options or {}
        local window = self:CreateWindow(options.Window)
        local hub = { Window = window, KeyList = {}, _cleanups = {} }
        function hub:Page(_, data) return window:Tab(data) end
        function hub:Group(name, data) data = data or {}; data.Title = data.Title or name; return window:Tab(data) end
        function hub:CleanUp(fn) api:OnUnload(fn) end
        function hub:Init() return window:SelectTab(1) end
        if options.Home ~= false then
            local home = window:Tab({ Title = "หน้าหลัก", Icon = "house" })
            local welcome = home:Section({ Title = brand })
            welcome:Paragraph({ Title = "สายเลือดอาชีวะ", Desc = "เลือกหมวดหมู่จากเมนูด้านข้างเพื่อเริ่มใช้งาน" })
            local info = home:Section({ Title = "ข้อมูลการใช้งาน" })
            local player = game:GetService("Players").LocalPlayer
            info:KeyValue({ Name = "ผู้เล่น", Value = player.DisplayName or player.Name })
            info:KeyValue({ Name = "เซิร์ฟเวอร์", Value = "Version " .. tostring(game.PlaceVersion) })
            hub.Home = home
        end
        return hub
    end
    function api:CreateSettingsPage(window)
        local tab = window:Tab({ Title = "ตั้งค่า", Icon = "settings-2" })
        local view = tab:Section({ Title = "หน้าต่าง" })
        view:Keybind({ Name = "ปุ่มเปิด / ปิดหน้าต่าง", Default = "RightShift", Callback = function(value) window:SetToggleKey(Enum.KeyCode[value]) end })
        view:Slider({ Name = "ขนาดหน้าจอ", Min = 70, Max = 125, Default = 100, Increment = 5, Callback = function(value) window:SetUIScale(value / 100) end })
        local profile = tab:Section({ Title = "โปรไฟล์การตั้งค่า" })
        local profileName = "default"
        local profileFolder = folder .. "/Profiles"
        local function cleanName(value)
            local name = tostring(value or ""):gsub("[\\/:*?\"<>|%c]", ""):gsub("%.%.", ""):sub(1, 64)
            return name ~= "" and name or "default"
        end
        local function path() return profileFolder .. "/" .. profileName .. ".json" end
        local function ensureFolders()
            if not (makefolder and isfolder) then return end
            if not isfolder(folder) then makefolder(folder) end
            if not isfolder(profileFolder) then makefolder(profileFolder) end
        end
        local function profileNames()
            local names = { "default" }
            if listfiles and isfolder and isfolder(profileFolder) then
                for _, file in ipairs(listfiles(profileFolder)) do
                    local name = file:match("([^/\\]+)%.json$")
                    if name and name ~= "default" then table.insert(names, name) end
                end
            end
            table.sort(names)
            return names
        end
        local selected = profile:Dropdown({ Name = "โปรไฟล์", Items = profileNames(), Default = "default", Callback = function(value) profileName = cleanName(value) end })
        profile:Input({ Name = "ชื่อโปรไฟล์ใหม่", Value = "", Placeholder = "เช่น ฟาร์ม / ต่อสู้", Callback = function(value) profileName = cleanName(value) end })
        local function encode(value)
            if typeof(value) == "Color3" then return { _kind = "color", hex = value:ToHex() } end
            if typeof(value) == "EnumItem" then return { _kind = "key", name = value.Name } end
            if type(value) ~= "table" then return value end
            local result = {}; for key, v in pairs(value) do result[key] = encode(v) end; return result
        end
        profile:Button({ Title = "บันทึกการตั้งค่า", Icon = "save", Callback = function()
            if not writefile then return self:Notify({ Title = "บันทึกไม่ได้", Content = "โปรแกรมที่ใช้ไม่รองรับการบันทึกไฟล์" }) end
            ensureFolders()
            writefile(path(), game:GetService("HttpService"):JSONEncode(encode(self.Flags)))
            selected:Refresh(profileNames(), profileName)
            self:Notify({ Title = "บันทึกแล้ว", Content = "เก็บการตั้งค่าปัจจุบันเรียบร้อย" })
        end })
        profile:Button({ Title = "โหลดการตั้งค่า", Icon = "folder-open", Callback = function()
            if not (readfile and isfile and isfile(path())) then return end
            local values = game:GetService("HttpService"):JSONDecode(readfile(path()))
            for key, value in pairs(values) do
                if type(value) == "table" and value._kind == "color" then value = Color3.fromHex(value.hex)
                elseif type(value) == "table" and value._kind == "key" then value = value.name end
                if controls[key] then controls[key]:Set(value) end
            end
        end })
        profile:Button({ Title = "ลบโปรไฟล์ที่เลือก", Icon = "trash-2", Callback = function()
            if delfile and isfile and isfile(path()) then delfile(path()) end
            profileName = "default"
            selected:Refresh(profileNames(), profileName)
        end })
        profile:Button({ Title = "คืนค่าเริ่มต้น", Icon = "rotate-ccw", Callback = function()
            for _, control in pairs(controls) do control:Set(control.Default) end
        end })
        view:Button({ Title = "ปิดสคริปต์", Icon = "power", Callback = function() self:Unload() end })
        local servers = tab:Section({ Title = "เซิร์ฟเวอร์" })
        local function join(id)
            return game:GetService("TeleportService"):TeleportToPlaceInstance(game.PlaceId, id, game:GetService("Players").LocalPlayer)
        end
        servers:Button({ Title = "เข้าเซิร์ฟเวอร์เดิมอีกครั้ง", Icon = "refresh-cw", Callback = function() join(game.JobId) end })
        local function hop(smallest)
            local ok, response = pcall(function()
                return game:GetService("HttpService"):JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
            end)
            if not ok or type(response) ~= "table" then return self:Notify({ Title = "ค้นหาไม่สำเร็จ", Content = "ลองใหม่อีกครั้งในภายหลัง" }) end
            local choices = {}
            for _, server in ipairs(response.data or {}) do
                if server.id ~= game.JobId and (server.playing or 0) < (server.maxPlayers or 0) then table.insert(choices, server) end
            end
            if smallest then table.sort(choices, function(a,b) return a.playing < b.playing end) end
            if choices[1] then join(choices[1].id) else self:Notify({ Title = "ไม่พบเซิร์ฟเวอร์", Content = "ยังไม่มีเซิร์ฟเวอร์อื่นที่ว่าง" }) end
        end
        servers:Button({ Title = "ย้ายเซิร์ฟเวอร์", Icon = "shuffle", Callback = function() hop(false) end })
        servers:Button({ Title = "เข้าเซิร์ฟเวอร์คนน้อยที่สุด", Icon = "users", Callback = function() hop(true) end })
        return tab
    end
    function api:AddTranslations() end
    function api:SetLanguage(value) self.Language = value end
    api.Language, api.Locale = "Thai", { clear = function() end }
    return api
end

