local function ResolveEvolutionFontWeight(value, fallback)
    if type(value) == "string" then
        local ok, item = pcall(function() return Enum.FontWeight[value] end)
        value = ok and item or nil
    end
    if typeof(value) ~= "EnumItem" or value.EnumType ~= Enum.FontWeight then return fallback end
    return value
end

