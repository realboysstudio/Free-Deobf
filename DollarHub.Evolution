            ThemeTag = (r.Icon(x) or G) and { ImageColor3 = F and (H or "Icon") or nil } or nil,
        }, { u("UICorner", { CornerRadius = UDim.new(0,A) }) }),
    })
    local image = J:FindFirstChildOfClass("ImageLabel")
    local disposed = false
    J.Destroying:Connect(function() disposed = true end)
    local function canUpdate()
        return not disposed and image ~= nil and image.Parent == J
    end
    if r.Icon(x) then
        if image then image:Destroy() end
        local icon = m.Image({ Icon = x, Size = UDim2.new(1,0,1,0), Colors = { (F and (H or "Icon") or false), "Button" } }).IconFrame
        icon.Parent = J
    elseif string.find(x,"http") and not string.find(x,"roblox.com") then
        local path = "WindUI/" .. B .. "/assets/." .. C .. "-" .. z .. ".png"
        task.spawn(function()
            local ok = pcall(function()
                if not canUpdate() then return end
                local response = r.Request and r.Request({ Url = x, Method = "GET" })
                if not canUpdate() then return end
                assert(type(response) == "table" and type(response.Body) == "string" and #response.Body > 0, "Invalid image response")
                if not d:IsStudio() and writefile then writefile(path, response.Body) end
                if not canUpdate() then return end
                assert(type(getcustomasset) == "function", "Custom assets are unavailable")
                local asset = getcustomasset(path)
                if canUpdate() and type(asset) == "string" then image.Image = asset end
            end)
            if not ok and not disposed then warn("[WindUI] Cannot load URL image; the interface remains available") end
        end)
    elseif x == "" then
        J.Visible = false
    elseif canUpdate() then
        image.Image = x
    end
    return J
end

function r.Color3ToHSB(x)
local z,A,B=x.R,x.G,x.B
local C=math.max(z,A,B)
local F=math.min(z,A,B)
local G=C-F

local H=0
if G~=0 then
if C==z then
H=(A-B)/G%6
elseif C==A then
H=(B-z)/G+2
else
H=(z-A)/G+4
end
H=H*60
else
H=0
end

local J=(C==0)and 0 or(G/C)
local L=C

return{
h=math.floor(H+0.5),
s=J,
b=L,
}
end

