local evolutionFontStyles = setmetatable({}, { __mode = "k" })
local function applyEvolutionFont(object, family, initialFace)
    if object == nil or type(family) ~= "string" then return false end
    local style = evolutionFontStyles[object]
    if not style then
        style = { Weight = Enum.FontWeight.Regular, Style = Enum.FontStyle.Normal }
        local ok, face = pcall(function() return initialFace or object.FontFace end)
        if ok and face then
            pcall(function()
                if typeof(face.Weight) == "EnumItem" and face.Weight.EnumType == Enum.FontWeight then style.Weight = face.Weight end
                if typeof(face.Style) == "EnumItem" and face.Style.EnumType == Enum.FontStyle then style.Style = face.Style end
            end)
        end
        evolutionFontStyles[object] = style
    end
    return pcall(function() object.FontFace = Font.new(family, style.Weight, style.Style) end)
end

function r.AddFontObject(object, initialFace)
    if object == nil then return end
    local known = evolutionFontStyles[object]
    if known and known.Registered then return end
    if applyEvolutionFont(object, r.Font, initialFace) then
        evolutionFontStyles[object].Registered = true
        table.insert(r.FontObjects, object)
    else
        evolutionFontStyles[object] = nil
    end
end

function r.UpdateFont(family)
    if type(family) ~= "string" then return end
    r.Font = family
    for i = #r.FontObjects, 1, -1 do
        local object = r.FontObjects[i]
        if not applyEvolutionFont(object, family) then
            table.remove(r.FontObjects, i)
            evolutionFontStyles[object] = nil
        end
    end
end

