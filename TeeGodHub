        if cache[name] ~= nil then return cache[name] end
        assert(not loading[name], "Circular runtime dependency: " .. name)
        assert(sources[name], "Missing runtime module: " .. name)
        loading[name] = true
        local chunk, err = loadstring("local require, runtime = ...\n" .. sources[name], "=TeeGodRuntime/" .. name)
