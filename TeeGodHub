    entry.bodyParts = (#parts > 0) and parts or nil
    if not entry.humanoid then
        local ok, cf, size = pcall(function() return t:GetBoundingBox() end)
        if ok and cf then
            entry.boundsSize = size
            entry.boundsOffset = t:GetPivot():ToObjectSpace(cf)
        end
    end
end

local corners = {}
for x = -1, 1, 2 do
    for y = -1, 1, 2 do
        for z = -1, 1, 2 do table.insert(corners, Vector3.new(x, y, z) * 0.5) end
    end
end

local function projectBox(cam, cf, size)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local any, behind = false, 0
    for _, c in ipairs(corners) do
        local p = cam:WorldToViewportPoint(cf * (c * size))
        if p.Z > 0 then
            any = true
            if p.X < minX then minX = p.X end
            if p.X > maxX then maxX = p.X end
            if p.Y < minY then minY = p.Y end
            if p.Y > maxY then maxY = p.Y end
        else
            behind = behind + 1
        end
    end
    if not any then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY), behind
end

local function measure(entry, cam, now)
    local t = entry.target
    if entry.isPart then
        local pos = t.Position
        if not entry.opts.Box and not entry.opts.Health then
            local sp = cam:WorldToViewportPoint(pos)
            if sp.Z <= 0 then return pos, nil end
            return pos, Vector2.new(sp.X - 6, sp.Y - 6), Vector2.new(12, 12)
        end
        local cf = t.CFrame
        local boxPos, size = projectBox(cam, cf, t.Size)
        return cf.Position, boxPos, size
    end
    resolveParts(entry, now)
    local root = entry.root
    if not entry.opts.Box and not entry.opts.Health and root and root.Parent then
        local pos = root.Position
        local sp = cam:WorldToViewportPoint(pos)
        if sp.Z <= 0 then return pos, nil end
        return pos, Vector2.new(sp.X - 10, sp.Y - 14), Vector2.new(20, 28)
    end

    local skelBones = entry.skelBones
    if skelBones and (not root or (cam.CFrame.Position - root.Position).Magnitude <= 350) then
        local minX, minY, minZ = math.huge, math.huge, math.huge
        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
        local count = 0
        for i = 1, #skelBones do
            local b = skelBones[i]
            if b.Parent then
                local p = nodePosition(b)
                if p.X < minX then minX = p.X end
                if p.X > maxX then maxX = p.X end
                if p.Y < minY then minY = p.Y end
                if p.Y > maxY then maxY = p.Y end
                if p.Z < minZ then minZ = p.Z end
                if p.Z > maxZ then maxZ = p.Z end
                count = count + 1
            end
        end
        if count > 0 then
            minX, maxX = minX - 0.55, maxX + 0.55
            minY, maxY = minY - 0.35, maxY + 0.7
            minZ, maxZ = minZ - 0.55, maxZ + 0.55
            local center = Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
            local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
            local pos, sz, behind = projectBox(cam, CFrame.new(center), size)
            if pos and behind == 0 then
                local w = math.min(sz.X, sz.Y * entry.opts.BoxRatio * 1.15)
                return center, Vector2.new(pos.X + (sz.X - w) / 2, pos.Y), Vector2.new(w, sz.Y)
            end
            if not pos then return center, nil end
        end
    end
    local bodyParts = entry.bodyParts
    if bodyParts then
        local minX, minY, minZ = math.huge, math.huge, math.huge
        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
        local count = 0
        for i = 1, #bodyParts do
            local p = bodyParts[i]
            if p.Parent then
                local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = p.CFrame:GetComponents()
                local s = p.Size
                local hx, hy, hz = s.X / 2, s.Y / 2, s.Z / 2
                local ex = math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz
                local ey = math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz
                local ez = math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz
                if x - ex < minX then minX = x - ex end
                if x + ex > maxX then maxX = x + ex end
                if y - ey < minY then minY = y - ey end
                if y + ey > maxY then maxY = y + ey end
                if z - ez < minZ then minZ = z - ez end
                if z + ez > maxZ then maxZ = z + ez end
                count = count + 1
            end
        end
        if count > 0 then
            local center = Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
            local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
            local pos, sz, behind = projectBox(cam, CFrame.new(center), size)
            if pos and behind == 0 then
                local w = math.min(sz.X, sz.Y * entry.opts.BoxRatio * 1.15)
                return center, Vector2.new(pos.X + (sz.X - w) / 2, pos.Y), Vector2.new(w, sz.Y)
            end
            if not pos then return center, nil end
        end
    end
    if entry.boundsSize and entry.boundsOffset then
        local cf = t:GetPivot() * entry.boundsOffset
        local pos, size = projectBox(cam, cf, entry.boundsSize)
        return cf.Position, pos, size
    end
    if root then
        local pos, size = projectBox(cam, root.CFrame, root.Size)
        return root.Position, pos, size
    end
    return nil
end

local function onViewport(pos, size, viewport)
    return pos.X + size.X >= 0 and pos.Y + size.Y >= 0 and pos.X <= viewport.X and pos.Y <= viewport.Y
end

local function sameTeam(player)
    local mine = LocalPlayer and LocalPlayer.Team
    return mine ~= nil and player.Team == mine
end

local function entryColor(entry)
    local o, player = entry.opts, entry.player
    local color = o.Color
    if type(color) == "function" then color = color(entry.target, player) end
    if player and o.TeamColor and player.Team then
        color = player.TeamColor.Color
    end
    return color
end

local function entryName(entry)
    local name, player, t = entry.opts.Name, entry.player, entry.target
    if type(name) == "string" then return name end
    if type(name) == "function" then
        local ok, text = pcall(name, t, player)
        return ok and tostring(text or "") or ""
    end
    if player then return player.DisplayName end
    return t.Name
end

local function entryHealth(entry)
    local o = entry.opts
    if o.GetHealth then
        local ok, hp, max = pcall(o.GetHealth, entry.target)
        if ok and hp then return hp, max or 100 end
        return nil
    end
    local hum = entry.humanoid
    if hum and hum.Parent then return hum.Health, hum.MaxHealth end
    return nil
end

local ctx = { viewport = Vector2.new(1280, 720), camPos = Vector3.new(0, 0, 0), mouse = Vector2.new(0, 0) }

local function styleComposite(item, o, color)
    local opts = item.Options
    opts.Color = color
    opts.Thickness = o.Thickness
    opts.Outline = o.Outline
    opts.Transparency = o.Transparency
    item:_style()
end

local InfoLine = {}
InfoLine.__index = InfoLine

local function newInfoLine()
    return setmetatable({
        Options = {},
        Parts = {},
        Text = "",
        Visible = false,
        _lastHp = nil,
        _lastDist = nil,
        _lastHpColor = nil,
        _lastDistColor = nil,
        _lastSize = nil,
        _widths = {},
        _totalW = 0,
        _segCount = 0,
    }, InfoLine)
end

function InfoLine:Update(hasHp, hpVal, hpColor, hasDist, distVal, distColor, cx, y, o)
    local changed = (self._lastHp ~= hpVal) or (self._lastDist ~= distVal)
        or (self._lastHpColor ~= hpColor) or (self._lastDistColor ~= distColor)
        or (self._lastSize ~= o.TextSize)

    if changed then
        self._lastHp = hpVal
        self._lastDist = distVal
        self._lastHpColor = hpColor
        self._lastDistColor = distColor
        self._lastSize = o.TextSize

        local segCount = 0
        if hasHp and hasDist then
            segCount = 3
            self._seg1Text = string.format("%dHP", hpVal)
            self._seg1Color = hpColor
            self._seg2Text = " | "
            self._seg2Color = o.BracketColor or Color3.fromRGB(255, 255, 255)
            self._seg3Text = string.format("%dM", distVal)
            self._seg3Color = distColor
            self.Text = self._seg1Text .. " | " .. self._seg3Text
        elseif hasHp then
            segCount = 1
            self._seg1Text = string.format("%dHP", hpVal)
            self._seg1Color = hpColor
            self.Text = self._seg1Text
        else
            segCount = 1
            self._seg1Text = string.format("%dM", distVal)
            self._seg1Color = distColor
            self.Text = self._seg1Text
        end
        self._segCount = segCount

        local totalW = 0
        for i = 1, segCount do
            local label = self.Parts[i]
            if not label then
                label = Draw.acquire("Text", { Center = false, Outline = o.Outline ~= false })
                self.Parts[i] = label
            end
            local t = (i == 1 and self._seg1Text) or (i == 2 and self._seg2Text) or self._seg3Text
            local c = (i == 1 and self._seg1Color) or (i == 2 and self._seg2Color) or self._seg3Color
            label.Text = t
            label.Size = o.TextSize
            label.Color = c
            label.Outline = o.Outline ~= false
            label.Transparency = o.Transparency
            local w = label.TextBounds.X
            self._widths[i] = w
            totalW = totalW + w
        end
        self._totalW = totalW

        for i = segCount + 1, #self.Parts do
            Draw.release(self.Parts[i])
            self.Parts[i] = nil
            self._widths[i] = nil
        end
    end

    local curX = cx - self._totalW / 2
    for i = 1, self._segCount do
        local label = self.Parts[i]
        label.Position = Vector2.new(math.floor(curX + 0.5), y)
        label.Visible = true
        curX = curX + self._widths[i]
    end
    self.Visible = true
end

function InfoLine:SetVisible(vis)
    self.Visible = vis == true
    for _, part in ipairs(self.Parts) do
        part.Visible = self.Visible
    end
end

function InfoLine:Remove()
    for _, part in ipairs(self.Parts) do
        Draw.release(part)
    end
    table.clear(self.Parts)
    table.clear(self._widths)
    self.Visible = false
    self.Text = ""
    self._lastHp = nil
    self._lastDist = nil
    self._lastHpColor = nil
    self._lastDistColor = nil
    self._lastSize = nil
    self._segCount = 0
    self._totalW = 0
end

local function text(entry, key, value, position, color, o, restyle)
    local label = entry[key]
    if not label then
        label = Draw.acquire("Text", { Center = true, Outline = true })
        entry[key] = label
        restyle = true
    end
    if restyle then
        label.Size = o.TextSize
        label.Color = color
        label.Outline = o.Outline
        label.Transparency = o.Transparency
    end
    local txtKey = key .. "_txt"
    if entry[txtKey] ~= value then
        entry[txtKey] = value
        label.Text = value
    end
    label.Position = position
    label.Visible = true
end

local function styleChanged(entry, o, color)
    local boxColor = o.BoxColor or color
    local tracerColor = o.TracerColor or color
    local skelColor = o.SkeletonColor or color
    if entry.sColor == color and entry.sBoxColor == boxColor and entry.sTracerColor == tracerColor
        and entry.sSkelColor == skelColor and entry.sThickness == o.Thickness and entry.sOutline == o.Outline
        and entry.sTransparency == o.Transparency and entry.sTextSize == o.TextSize then
        return false
    end
    entry.sColor, entry.sBoxColor, entry.sTracerColor, entry.sSkelColor = color, boxColor, tracerColor, skelColor
    entry.sThickness, entry.sOutline = o.Thickness, o.Outline
    entry.sTransparency, entry.sTextSize = o.Transparency, o.TextSize
    return true
end

local NAME_INTERVAL = 2.5
local function cachedName(entry, now)
    local name = entry.opts.Name
    if type(name) == "string" then return name end
    if entry.nameValue == nil or now >= (entry.nextName or 0) then
        entry.nameValue = entryName(entry)
        entry.nextName = now + NAME_INTERVAL
    end
    return entry.nameValue
end

local sharedSkelPool = {}
for i = 1, 64 do
    sharedSkelPool[i] = { Vector2.new(0, 0), Vector2.new(0, 0) }
end
local sharedNodeCache = {}

local VEC_NECK = Vector3.new(0, 1.0, 0)
local VEC_PELVIS = Vector3.new(0, -1.0, 0)
local VEC_ARM_TOP = Vector3.new(0, 0.8, 0)
local VEC_ARM_BOT = Vector3.new(0, -0.9, 0)
local VEC_LEG_TOP = Vector3.new(0, 0.9, 0)
local VEC_LEG_BOT = Vector3.new(0, -0.9, 0)

local r6ScreenPts = {}
for i = 1, 15 do r6ScreenPts[i] = false end

local R6_BONES = {
    { 1, 2 },   -- Head -> Neck
    { 2, 3 },   -- Neck -> Pelvis (Spine)
    { 2, 4 },   -- Neck -> LShoulder (Clavicle)
    { 4, 5 },   -- LShoulder -> LElbow
    { 5, 6 },   -- LElbow -> LWrist
    { 2, 7 },   -- Neck -> RShoulder (Clavicle)
    { 7, 8 },   -- RShoulder -> RElbow
    { 8, 9 },   -- RElbow -> RWrist
    { 3, 10 },  -- Pelvis -> LHip
    { 10, 11 }, -- LHip -> LKnee
    { 11, 12 }, -- LKnee -> LAnkle
    { 3, 13 },  -- Pelvis -> RHip
    { 13, 14 }, -- RHip -> RKnee
    { 14, 15 }, -- RKnee -> RAnkle
}

local function updateEntry(entry, cam, now)
    local o, player = entry.opts, entry.player
    if player and ((ESP.CustomFilter and ESP.CustomFilter(player, entry.target) == false) or (o.CustomFilter and o.CustomFilter(player, entry.target) == false)) then
        entry.inRange = false
        return hide(entry)
    end
    if player and o.TeamCheck and sameTeam(player) then
        entry.inRange = false
        return hide(entry)
    end

    if player and player.Character ~= entry.target then
        removeEntry(entry)
        return
    end

    if o.AliveCheck ~= false then
        local hum = entry.humanoid
        if not hum and entry.target and entry.target:IsA("Model") then
            hum = entry.target:FindFirstChildOfClass("Humanoid")
            entry.humanoid = hum
        end
        if hum then
            if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
                entry.inRange = false
                return hide(entry)
            end
        end
        local hp = entryHealth(entry)
        if hp and hp <= 0 then
            entry.inRange = false
            return hide(entry)
        end
    end

    local root = entry.root or (entry.isPart and entry.target) or (entry.target:IsA("Model") and (entry.target.PrimaryPart or entry.target:FindFirstChild("HumanoidRootPart")))
    if root and root.Parent then
        local rPos = root.Position
        local toCam = rPos - ctx.camPos
        local dist = toCam.Magnitude
        if dist > o.MaxDistance then
            entry.distance = dist
            entry.inRange = false
            return hide(entry)
        end
        if toCam:Dot(ctx.camLook) < -5 and dist > 15 then
            entry.distance = dist
            entry.inRange = true
            return hide(entry)
        end
    end

    local worldPos, boxPos, boxSize = measure(entry, cam, now)
    if not worldPos then
        entry.inRange = false
        return hide(entry)
    end
    local distance = (ctx.camPos - worldPos).Magnitude
    entry.distance = distance
    entry.inRange = distance <= o.MaxDistance
    if not entry.inRange or not boxPos or not onViewport(boxPos, boxSize, ctx.viewport) then
        return hide(entry)
    end

    local color = entryColor(entry)
    local restyle = styleChanged(entry, o, color)
    entry.shown = true
    if entry.highlight and restyle then styleHighlight(entry, color) end

    if o.Box then
        if entry.box and entry.boxStyle ~= o.BoxStyle then releaseElement(entry, "box") end
        if not entry.box then
            entry.box = (o.BoxStyle == "Corner") and Draw.CornerBox() or Draw.Box()
            entry.boxStyle = o.BoxStyle
            styleComposite(entry.box, o, o.BoxColor or color)
        elseif restyle then
            styleComposite(entry.box, o, o.BoxColor or color)
        end
        entry.box:Update(boxPos, boxSize)
        entry.box:SetVisible(true)
    elseif entry.box then
        releaseElement(entry, "box")
    end

    local skelMaxDist = o.SkeletonMaxDistance or 1000
    if o.Skeleton and distance <= skelMaxDist and (entry.useAnatomicalR6 or entry.skelEdges) then
        local skelColor = o.SkeletonColor or color
        if not entry.skel then
            entry.skel = Draw.Skeleton()
            styleComposite(entry.skel, o, skelColor)
        elseif restyle then
            styleComposite(entry.skel, o, skelColor)
        end

        local segCount = 0
        if entry.useAnatomicalR6 then
            local char = entry.target
            local head = entry.head or char:FindFirstChild("Head")
            local torso = char:FindFirstChild("Torso")
            local lArm = char:FindFirstChild("Left Arm")
            local rArm = char:FindFirstChild("Right Arm")
            local lLeg = char:FindFirstChild("Left Leg")
            local rLeg = char:FindFirstChild("Right Leg")

            if torso then
                local tCF = torso.CFrame
                if head then
                    local p = cam:WorldToViewportPoint(head.Position)
                    r6ScreenPts[1] = (p.Z > 0) and Vector2.new(p.X, p.Y) or false
                else
                    r6ScreenPts[1] = false
                end
                local pNeck = cam:WorldToViewportPoint(tCF * VEC_NECK)
                r6ScreenPts[2] = (pNeck.Z > 0) and Vector2.new(pNeck.X, pNeck.Y) or false
                local pPelvis = cam:WorldToViewportPoint(tCF * VEC_PELVIS)
                r6ScreenPts[3] = (pPelvis.Z > 0) and Vector2.new(pPelvis.X, pPelvis.Y) or false

                if lArm then
                    local lCF = lArm.CFrame
                    local p1 = cam:WorldToViewportPoint(lCF * VEC_ARM_TOP)
                    r6ScreenPts[4] = (p1.Z > 0) and Vector2.new(p1.X, p1.Y) or false
                    local p2 = cam:WorldToViewportPoint(lArm.Position)
                    r6ScreenPts[5] = (p2.Z > 0) and Vector2.new(p2.X, p2.Y) or false
                    local p3 = cam:WorldToViewportPoint(lCF * VEC_ARM_BOT)
                    r6ScreenPts[6] = (p3.Z > 0) and Vector2.new(p3.X, p3.Y) or false
                else
                    r6ScreenPts[4] = false; r6ScreenPts[5] = false; r6ScreenPts[6] = false
                end

                if rArm then
                    local rCF = rArm.CFrame
                    local p1 = cam:WorldToViewportPoint(rCF * VEC_ARM_TOP)
                    r6ScreenPts[7] = (p1.Z > 0) and Vector2.new(p1.X, p1.Y) or false
                    local p2 = cam:WorldToViewportPoint(rArm.Position)
                    r6ScreenPts[8] = (p2.Z > 0) and Vector2.new(p2.X, p2.Y) or false
                    local p3 = cam:WorldToViewportPoint(rCF * VEC_ARM_BOT)
                    r6ScreenPts[9] = (p3.Z > 0) and Vector2.new(p3.X, p3.Y) or false
                else
                    r6ScreenPts[7] = false; r6ScreenPts[8] = false; r6ScreenPts[9] = false
                end

                if lLeg then
                    local llCF = lLeg.CFrame
                    local p1 = cam:WorldToViewportPoint(llCF * VEC_LEG_TOP)
                    r6ScreenPts[10] = (p1.Z > 0) and Vector2.new(p1.X, p1.Y) or false
                    local p2 = cam:WorldToViewportPoint(lLeg.Position)
                    r6ScreenPts[11] = (p2.Z > 0) and Vector2.new(p2.X, p2.Y) or false
                    local p3 = cam:WorldToViewportPoint(llCF * VEC_LEG_BOT)
                    r6ScreenPts[12] = (p3.Z > 0) and Vector2.new(p3.X, p3.Y) or false
                else
                    r6ScreenPts[10] = false; r6ScreenPts[11] = false; r6ScreenPts[12] = false
                end

                if rLeg then
                    local rlCF = rLeg.CFrame
                    local p1 = cam:WorldToViewportPoint(rlCF * VEC_LEG_TOP)
                    r6ScreenPts[13] = (p1.Z > 0) and Vector2.new(p1.X, p1.Y) or false
                    local p2 = cam:WorldToViewportPoint(rLeg.Position)
                    r6ScreenPts[14] = (p2.Z > 0) and Vector2.new(p2.X, p2.Y) or false
                    local p3 = cam:WorldToViewportPoint(rlCF * VEC_LEG_BOT)
                    r6ScreenPts[15] = (p3.Z > 0) and Vector2.new(p3.X, p3.Y) or false
                else
                    r6ScreenPts[13] = false; r6ScreenPts[14] = false; r6ScreenPts[15] = false
                end

                for i = 1, #R6_BONES do
                    local b = R6_BONES[i]
                    local pa = r6ScreenPts[b[1]]
                    local pb = r6ScreenPts[b[2]]
                    if pa and pb then
                        segCount = segCount + 1
                        local slot = sharedSkelPool[segCount]
                        if not slot then
                            slot = { pa, pb }
                            sharedSkelPool[segCount] = slot
                        else
                            slot[1] = pa
                            slot[2] = pb
                        end
                    end
                end
            end
        else
            table.clear(sharedNodeCache)
            for _, edge in ipairs(entry.skelEdges) do
                local a, b = edge[1], edge[2]
                if a.Parent and b.Parent then
                    local pa = sharedNodeCache[a]
                    if pa == nil then
                        local p = cam:WorldToViewportPoint(nodePosition(a))
                        pa = (p.Z > 0) and Vector2.new(p.X, p.Y) or false
                        sharedNodeCache[a] = pa
                    end
                    local pb = false
                    if pa then
                        pb = sharedNodeCache[b]
                        if pb == nil then
                            local p = cam:WorldToViewportPoint(nodePosition(b))
                            pb = (p.Z > 0) and Vector2.new(p.X, p.Y) or false
                            sharedNodeCache[b] = pb
                        end
                    end
                    if pa and pb then
                        segCount = segCount + 1
                        local slot = sharedSkelPool[segCount]
                        if not slot then
                            slot = { pa, pb }
                            sharedSkelPool[segCount] = slot
                        else
                            slot[1] = pa
                            slot[2] = pb
                        end
                    end
                end
            end
        end

        if segCount > 0 then
            entry.skel:SetVisible(true)
            entry.skel:Update(sharedSkelPool, segCount)
        else
            entry.skel:SetVisible(false)
        end
    elseif entry.skel then
        releaseElement(entry, "skel")
    end

    local hp, maxHp
    local showHealth = o.Health
    local style = o.HealthStyle or "Both"
    local wantBar = showHealth and (style == "Bar" or style == "Both" or style == "หลอดเลือด" or style == "ทั้งคู่")
    local wantText = showHealth and (style == "Text" or style == "Both" or style == "ตัวเลข" or style == "ทั้งคู่")

    if showHealth then hp, maxHp = entryHealth(entry) end
    if hp and maxHp and maxHp > 0 then
        local frac = math.clamp(hp / maxHp, 0, 1)
        if wantBar then
            if not entry.bar or restyle then
                entry.bar = entry.bar or Draw.HealthBar({ Width = o.HealthBarWidth or 2 })
                entry.bar.Options.Transparency = o.Transparency
                entry.bar.Options.Width = o.HealthBarWidth or 2
                entry.bar.Options.Color = o.HealthColor or false
                entry.bar:_style()
            end
            entry.bar:Update(boxPos, boxSize, frac)
            entry.bar:SetVisible(true)
        elseif entry.bar then
            releaseElement(entry, "bar")
        end

        entry.hpValue = wantText and math.floor(hp + 0.5) or nil
        entry.hpFraction = frac
    else
        if entry.bar then releaseElement(entry, "bar") end
        entry.hpValue = nil
        entry.hpFraction = nil
    end

    if o.Tracer then
        if not entry.tracer then
            entry.tracer = Draw.Tracer()
            styleComposite(entry.tracer, o, o.TracerColor or color)
        elseif restyle then
            styleComposite(entry.tracer, o, o.TracerColor or color)
        end
        local from
        local mode = o.TracerFrom
        if mode == "Center" then from = ctx.viewport / 2
        elseif mode == "Mouse" then from = ctx.mouse
        elseif mode == "Top" then from = Vector2.new(ctx.viewport.X / 2, 0)
        else from = Vector2.new(ctx.viewport.X / 2, ctx.viewport.Y) end
        entry.tracer:Update(from, Vector2.new(boxPos.X + boxSize.X / 2, boxPos.Y + boxSize.Y))
        entry.tracer:SetVisible(true)
    elseif entry.tracer then
        releaseElement(entry, "tracer")
    end

    local cx = boxPos.X + boxSize.X / 2
    if o.Name then
        local nameColor = o.NameColor or Color3.fromRGB(255, 255, 255)
        text(entry, "nameText", cachedName(entry, now), Vector2.new(cx, boxPos.Y - o.TextSize - 3), nameColor, o, restyle)
    elseif entry.nameText then
        releaseElement(entry, "nameText")
    end

    local hasDist = o.Distance
    local hasHp = entry.hpValue ~= nil
    if hasDist or hasHp then
        local distVal = hasDist and math.floor(distance + 0.5) or nil
        local hpVal = entry.hpValue
        local distColor = o.DistanceColor or Color3.fromRGB(255, 220, 60)
        local hpColor = o.HealthColor or (entry.hpFraction and Draw.HealthColor(entry.hpFraction)) or Color3.fromRGB(80, 230, 120)

        if not entry.infoText then
            entry.infoText = newInfoLine()
        end
        entry.infoText:Update(hasHp, hpVal, hpColor, hasDist, distVal, distColor, cx, boxPos.Y + boxSize.Y + 2, o)
    elseif entry.infoText then
        releaseElement(entry, "infoText")
    end
end

local removeEntry -- forward

local function assignChams()
    local wanted = {}
    for entry in pairs(entries) do
        if ESP.Enabled and entry.opts.Chams and entry.inRange then
            table.insert(wanted, entry)
        else
            releaseHighlight(entry)
        end
    end
    table.sort(wanted, function(a, b) return (a.distance or math.huge) < (b.distance or math.huge) end)
    local cap = math.max(0, ESP.MaxHighlights)
    for i = cap + 1, #wanted do releaseHighlight(wanted[i]) end
    for i = 1, math.min(cap, #wanted) do
        local entry = wanted[i]
        local fresh = entry.highlight == nil
        ensureHighlight(entry)
        if fresh then styleHighlight(entry, entryColor(entry)) end
    end
end

local function step()
    local now = os.clock()
    local rate = ESP.UpdateRate
    if rate and rate > 0 and now - lastUpdate < 1 / rate then return end
    lastUpdate = now
    local cam = Services.Workspace.CurrentCamera
    if not cam then return end
    local camCF = cam.CFrame
    ctx.viewport = cam.ViewportSize
    ctx.camPos = camCF.Position
    ctx.camLook = camCF.LookVector
    ctx.mouse = Draw.MousePosition()
    for entry in pairs(entries) do
        if entry.target.Parent == nil then
            removeEntry(entry)
        elseif entry.player and entry.player.Character ~= entry.target then
            removeEntry(entry)
        else
            local ok, err = pcall(updateEntry, entry, cam, now)
            if not ok then
                hide(entry)
                if not entry.warned then
                    entry.warned = true
                    warn("[B3] ESP error on " .. tostring(entry.target) .. ": " .. tostring(err))
                end
            end
        end
    end
    if now - lastChams >= CHAMS_INTERVAL then
        lastChams = now
        assignChams()
    end
end

local function syncLoop()
    local want = ESP.Enabled and entryCount > 0
    if want and not conn then
        lastUpdate = 0
        lastChams = 0
        conn = Services.RunService.RenderStepped:Connect(step)
    elseif not want and conn then
        conn:Disconnect()
        conn = nil
    end
end

local Entry = {}
Entry.__index = Entry

function Entry:Set(opts)
    for key, value in pairs(opts) do self.opts[key] = value end
    self.sColor = nil
    self.nameValue = nil
    self.nextResolve = 0
    return self
end

function Entry:Remove()
    removeEntry(self)
end
Entry.Destroy = Entry.Remove

local function addEntry(target, opts, player, group)
    local entry = setmetatable({
        target = target,
        opts = opts,
        player = player,
        group = group,
        isPart = target:IsA("BasePart"),
        shown = false,
        inRange = false,
    }, Entry)
    entries[entry] = true
    entryCount += 1
    syncLoop()
    return entry
end

function removeEntry(entry)
    if not entries[entry] then return end
    entries[entry] = nil
    entryCount -= 1
    releaseAll(entry)
    if byTarget[entry.target] == entry then byTarget[entry.target] = nil end
    local group = entry.group
    if group and group.entries[entry.target] == entry then group.entries[entry.target] = nil end
    syncLoop()
end

function ESP:Add(target, opts)
    assert(typeof(target) == "Instance", "[B3] ESP:Add expects a Model or BasePart")
    local old = byTarget[target]
    if old then removeEntry(old) end
    local entry = addEntry(target, makeOptions(opts), opts and opts.Player or nil, nil)
    byTarget[target] = entry
    return entry
end

local Group = {}
Group.__index = Group

local function newGroup(opts)
    local group = setmetatable({ opts = makeOptions(opts), entries = {}, conns = {}, playerConns = {} }, Group)
    groups[group] = true
    return group
end

function Group:_add(target, player)
    if self.Removed or target == nil then return end
    local old = self.entries[target]
    if old then removeEntry(old) end
    self.entries[target] = addEntry(target, self.opts, player, self)
end

function Group:_drop(target)
    local entry = target and self.entries[target]
    if entry then removeEntry(entry) end
end

function Group:_conn(connection)
    table.insert(self.conns, connection)
    return connection
end

function Group:Set(opts)
    for key, value in pairs(opts or {}) do self.opts[key] = value end
    for _, entry in pairs(self.entries) do
        entry.sColor = nil
        entry.nameValue = nil
        entry.nextResolve = 0
    end
    return self
end

function Group:Count()
    local n = 0
    for _ in pairs(self.entries) do n += 1 end
    return n
end

function Group:Remove()
    if self.Removed then return end
    self.Removed = true
    groups[self] = nil
    if playersGroup == self then playersGroup = nil end
    for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end
    for _, list in pairs(self.playerConns) do
        for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
    end
    table.clear(self.conns)
    table.clear(self.playerConns)
    local list = {}
    for _, entry in pairs(self.entries) do table.insert(list, entry) end
    for _, entry in ipairs(list) do removeEntry(entry) end
end
Group.Destroy = Group.Remove

function ESP:Players(opts)
    if playersGroup and not playersGroup.Removed then
        return playersGroup:Set(opts)
    end
    local group = newGroup(opts)
    playersGroup = group
    local Players = Services.Players

    local function watchPlayer(player)
        if player == LocalPlayer or group.playerConns[player] then return end
        group.playerConns[player] = {
            player.CharacterAdded:Connect(function(character) group:_add(character, player) end),
            player.CharacterRemoving:Connect(function(character) group:_drop(character) end),
        }
        if player.Character then group:_add(player.Character, player) end
    end

    for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
    group:_conn(Players.PlayerAdded:Connect(watchPlayer))
    group:_conn(Players.PlayerRemoving:Connect(function(player)
        local list = group.playerConns[player]
        if list then
            for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
            group.playerConns[player] = nil
        end
        for target, entry in pairs(group.entries) do
            if entry.player == player then group:_drop(target) end
        end
    end))
    return group
end

function ESP:Watch(container, filter, opts)
    assert(typeof(container) == "Instance", "[B3] ESP:Watch expects a container Instance")
    if type(filter) == "table" and opts == nil then
        opts, filter = filter, nil
    end
    filter = filter or function(child) return child:IsA("Model") or child:IsA("BasePart") end
    local group = newGroup(opts)
    local deep = opts and opts.Descendants

    local function consider(child)
        local ok, pass = pcall(filter, child)
        if ok and pass then group:_add(child) end
    end
    for _, child in ipairs(deep and container:GetDescendants() or container:GetChildren()) do consider(child) end
    if deep then
        group:_conn(container.DescendantAdded:Connect(consider))
        group:_conn(container.DescendantRemoving:Connect(function(child) group:_drop(child) end))
    else
        group:_conn(container.ChildAdded:Connect(consider))
        group:_conn(container.ChildRemoved:Connect(function(child) group:_drop(child) end))
    end
    return group
end

function ESP:SetEnabled(enabled)
    ESP.Enabled = enabled == true
    if not ESP.Enabled then
        for entry in pairs(entries) do
            hide(entry)
            releaseHighlight(entry)
        end
    end
    syncLoop()
end

function ESP:Count()
    return entryCount
end

function ESP:Clear()
    local list = {}
    for group in pairs(groups) do table.insert(list, group) end
    for _, group in ipairs(list) do group:Remove() end
    local rest = {}
    for entry in pairs(entries) do table.insert(rest, entry) end
    for _, entry in ipairs(rest) do removeEntry(entry) end
    for _, h in ipairs(freeHighlights) do pcall(function() h:Destroy() end) end
    table.clear(freeHighlights)
    highlightCount = 0
    if conn then
        conn:Disconnect()
        conn = nil
    end
end

function ESP:HighlightCount()
    return highlightCount
end

