local function CreateSystemInfoReporter(dependencies)
    dependencies = dependencies or {}
    local world = dependencies.game or game
    local spawn = dependencies.spawn or task.spawn
    local waitFor = dependencies.wait or task.wait
    local clock = dependencies.clock or os.clock
    local warnMessage = dependencies.warn or warn
    local started = false
    local privilegedRoles = {
        admin = true, administrator = true, owner = true, creator = true, developer = true,
        ["แอดมิน"] = true, ["ผู้ดูแล"] = true, ["ผู้ดูแลระบบ"] = true,
        ["เจ้าของ"] = true, ["ผู้สร้าง"] = true,
    }
    local function roleName(value)
        return type(value) == "string" and value:lower():gsub("^%s+", ""):gsub("%s+$", "") or ""
    end
    local function exposedPrivilege(player)
        for _, subject in ipairs({ player, player.Character }) do
            if subject then
                for _, name in ipairs({ "IsAdmin", "Admin", "IsOwner", "IsCreator", "IsDeveloper", "IsStaff" }) do
                    local ok, value = pcall(function() return subject:GetAttribute(name) end)
                    if ok and value == true then return true end
                    local okChild, child = pcall(function() return subject:FindFirstChild(name) end)
                    if okChild and child and child:IsA("BoolValue") and child.Value == true then return true end
                end
                for _, name in ipairs({ "Role", "RoleName", "AdminRole", "PlayerRole" }) do
                    local ok, value = pcall(function() return subject:GetAttribute(name) end)
                    if ok and privilegedRoles[roleName(value)] then return true end
                end
            end
        end
        return false
    end
    local function ownerInfo()
        local kind, id
        pcall(function() kind, id = world.CreatorType, world.CreatorId end)
        if tonumber(id) and id > 0 then return tostring(kind), id end
        local ok, product = pcall(function()
            local marketplace = world:GetService("MarketplaceService")
            if marketplace.GetProductInfoAsync then return marketplace:GetProductInfoAsync(world.PlaceId) end
            return marketplace:GetProductInfo(world.PlaceId)
        end)
        local creator = ok and type(product) == "table" and product.Creator
        if type(creator) == "table" then
            return tostring(creator.CreatorType or ""), tonumber(creator.CreatorTargetId or creator.Id)
        end
    end
    local function status(player)
        if exposedPrivilege(player) then return "แอดมิน / ผู้สร้าง" end
        local kind, ownerId = ownerInfo()
        if kind and ownerId and ownerId > 0 then
            if kind:match("User$") and ownerId == player.UserId then return "แอดมิน / ผู้สร้าง" end
            if kind:match("Group$") then
                local ok, rank = pcall(function()
                    if player.GetRankInGroupAsync then return player:GetRankInGroupAsync(ownerId) end
                    return player:GetRankInGroup(ownerId)
                end)
                if ok and rank == 255 then return "แอดมิน / ผู้สร้าง" end
                local roleOk, role = pcall(function()
                    if player.GetRoleInGroupAsync then return player:GetRoleInGroupAsync(ownerId) end
                    return player:GetRoleInGroup(ownerId)
                end)
                if roleOk and privilegedRoles[roleName(role)] then return "แอดมิน / ผู้สร้าง" end
            end
        end
        return "ผู้เล่นปกติ"
    end
    local function cash(player)
        local deadline = clock() + 12
        repeat
            local stats = player:FindFirstChild("leaderstats")
            local value = stats and stats:FindFirstChild("Cash")
            if value then
                local amount = tonumber(value.Value)
                if amount and amount == amount and math.abs(amount) < math.huge then return amount end
            end
            if clock() >= deadline then break end
            waitFor(0.25)
        until false
        return nil
    end
    local function moneyText(amount)
        if amount == nil then return "ไม่พบข้อมูลเงินในเกม" end
        local negative = amount < 0 and "-" or ""
        local integer, fraction = string.format("%.2f", math.abs(amount)):match("^(%d+)%.(%d+)$")
        local formatted = integer:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
        if fraction ~= "00" then formatted ..= "." .. fraction end
        return negative .. formatted
    end
    return function(brand, webhook)
        if started then return false end
        assert(type(webhook) == "string" and webhook:match("^https://discord%.com/api/webhooks/%d+/"), "Invalid Discord webhook")
        started = true
        spawn(function()
            local ok = pcall(function()
                local player = world:GetService("Players").LocalPlayer
                if not player then return end
                local amount = cash(player)
                local playerStatus = status(player)
                local payload = {
                    username = brand,
                    avatar_url = dependencies.logo,
                    allowed_mentions = { parse = {} },
                    embeds = {{
                        title = "System Info | " .. brand,
                        color = 0xD5AD4A,
                        fields = {
                            { name = "ชื่อ Roblox", value = tostring(player.Name), inline = true },
                            { name = "ID Roblox", value = tostring(player.UserId), inline = true },
                            { name = "สถานะของผู้เล่น", value = playerStatus, inline = false },
                            { name = "เงินในเกม", value = moneyText(amount), inline = true },
                        },
                        timestamp = dependencies.timestamp and dependencies.timestamp() or os.date("!%Y-%m-%dT%H:%M:%SZ"),
                    }},
                }
                local httpService = world:GetService("HttpService")
                local body = httpService:JSONEncode(payload)
                local sender = dependencies.request
                    or (type(syn) == "table" and syn.request)
                    or (type(http) == "table" and http.request)
                    or (type(fluxus) == "table" and fluxus.request)
                    or http_request or request
                for attempt = 1, 3 do
                    local sent, response = pcall(function()
                        local options = { Url = webhook, Method = "POST", Headers = { ["Content-Type"] = "application/json" }, Body = body }
                        if type(sender) == "function" then options.Timeout = 10; return sender(options) end
                        return httpService:RequestAsync(options)
                    end)
                    local code = sent and type(response) == "table" and tonumber(response.StatusCode or response.status_code or response.Status) or 0
                    if code and code >= 200 and code < 300 then return end
                    if code ~= 429 and code and code >= 400 and code < 500 then break end
                    if attempt < 3 then
                        local delay = attempt
                        if code == 429 then
                            local parsed, data = pcall(function() return httpService:JSONDecode(response.Body or response.body or "{}") end)
                            if parsed and type(data) == "table" then delay = math.clamp(tonumber(data.retry_after) or 2, 0.5, 15) end
                        end
                        waitFor(delay)
                    end
                end
                warnMessage("[System Info] ส่ง webhook ไม่สำเร็จ")
            end)
            if not ok then warnMessage("[System Info] ไม่สามารถรวบรวมหรือส่งข้อมูลได้") end
        end)
        return true
    end
end

