    function self:Update(position, size)
        local x, y, w, h = position.X, position.Y, size.X, size.Y
        local lw, lh = w * self.Options.Length, h * self.Options.Length
        local r, b = x + w, y + h
        for _, list in ipairs({ self.Outlines, self.Parts }) do
            local e = (list == self.Outlines) and 1 or 0 -- outline reaches one pixel past each end
            put(list, 1, Vector2.new(x - e, y), Vector2.new(x + lw + e, y))
            put(list, 2, Vector2.new(x, y - e), Vector2.new(x, y + lh + e))
            put(list, 3, Vector2.new(r + e, y), Vector2.new(r - lw - e, y))
            put(list, 4, Vector2.new(r, y - e), Vector2.new(r, y + lh + e))
            put(list, 5, Vector2.new(x - e, b), Vector2.new(x + lw + e, b))
            put(list, 6, Vector2.new(x, b + e), Vector2.new(x, b - lh - e))
            put(list, 7, Vector2.new(r + e, b), Vector2.new(r - lw - e, b))
            put(list, 8, Vector2.new(r, b + e), Vector2.new(r, b - lh - e))
        end
    end
    return finish(self)
end

local HEALTH_LOW = Color3.fromRGB(255, 70, 70)
local HEALTH_MID = Color3.fromRGB(255, 200, 60)
local HEALTH_HIGH = Color3.fromRGB(80, 230, 120)
function Draw.HealthColor(fraction)
    fraction = math.clamp(fraction, 0, 1)
    if fraction < 0.5 then return HEALTH_LOW:Lerp(HEALTH_MID, fraction * 2) end
    return HEALTH_MID:Lerp(HEALTH_HIGH, (fraction - 0.5) * 2)
end

function Draw.HealthBar(opts)
    local self = newComposite(opts, styled({ Width = 2, Side = "Left", Gap = 3, Color = false }))
    self._back = self:_part("Square", true)
    self._fill = self:_part("Square")
    self._back.Filled = true
    self._fill.Filled = true
    function self:_style()
        local o = self.Options
        self._back.Color = o.OutlineColor
        self._back.Transparency = o.Transparency * 0.8
        self._back.ZIndex = o.ZIndex or 1
        self._fill.Transparency = o.Transparency
        self._fill.ZIndex = (o.ZIndex or 1) + 1
    end
    self:_style()
    function self:Update(position, size, fraction)
        local o = self.Options
        fraction = math.clamp(tonumber(fraction) or 0, 0, 1)
        local w = o.Width
        local x = (o.Side == "Right") and (position.X + size.X + o.Gap) or (position.X - o.Gap - w)
        local h = size.Y
        self._back.Position = Vector2.new(x - 1, position.Y - 1)
        self._back.Size = Vector2.new(w + 2, h + 2)
        local fillH = math.floor(h * fraction + 0.5)
        self._fill.Position = Vector2.new(x, position.Y + h - fillH)
        self._fill.Size = Vector2.new(w, fillH)
        self._fill.Color = o.Color or Draw.HealthColor(fraction)
    end
    return finish(self)
end

function Draw.Tracer(opts)
    local self = newComposite(opts, styled())
    self._outline = self:_part("Line", true)
    self._main = self:_part("Line")
    self:_style()
    function self:Update(from, to)
        self._outline.From = from
        self._outline.To = to
        self._main.From = from
        self._main.To = to
    end
    return finish(self)
end

function Draw.Skeleton(opts)
    local self = newComposite(opts, styled())
    self._pairs = 0
    local function ensure(n)
        while self._pairs < n do
            self:_part("Line", true) -- outline
            self:_part("Line")       -- main line
            self._pairs = self._pairs + 1
        end
        self:_style()
    end
    function self:SetVisible(visible)
        self.Visible = visible == true
        if not self.Visible then
            for i = 1, self._pairs do
                self.Outlines[i].Visible = false
                self.Parts[i].Visible = false
            end
        end
    end
    function self:Update(segments, count)
        local n = count or (segments and #segments or 0)
        ensure(n)
        local showOutline = self.Visible and self.Options.Outline ~= false and not Library.IsMobile
        for i = 1, self._pairs do
            local seg = (i <= n) and segments[i] or nil
            local outline, main = self.Outlines[i], self.Parts[i]
            if seg and self.Visible then
                outline.From = seg[1] outline.To = seg[2] outline.Visible = showOutline
                main.From = seg[1] main.To = seg[2] main.Visible = true
            else
                outline.Visible = false
                main.Visible = false
            end
        end
    end
    return finish(self)
end

local followers = {}
local followCount = 0
local followConn = nil

local function followPoint(mode)
    if type(mode) == "function" then
        local ok, pos = pcall(mode)
        if ok and typeof(pos) == "Vector2" then return pos end
    end
    if mode == "Mouse" then return Draw.MousePosition() end
    return Draw.ScreenCenter()
end

local function stepFollowers()
    for item in pairs(followers) do
        local ok, err = pcall(item._refresh, item)
        if not ok then
            followers[item] = nil
            followCount -= 1
            warn("[B3] Draw follow error: " .. tostring(err))
        end
    end
    if followCount <= 0 and followConn then
        followConn:Disconnect()
        followConn = nil
    end
end

function Draw._follow(item)
    if followers[item] then return end
    followers[item] = true
    followCount += 1
    item._follow = true
    if not followConn then
        followConn = Services.RunService.RenderStepped:Connect(stepFollowers)
    end
end

function Draw._unfollow(item)
    if not followers[item] then return end
    followers[item] = nil
    followCount -= 1
    item._follow = false
    if followCount <= 0 and followConn then
        followConn:Disconnect()
        followConn = nil
    end
end

local function bindFollow(self)
    local function sync()
        if self.Removed then return end
        if self.Options.Follow and self.Visible then
            Draw._follow(self)
        else
            Draw._unfollow(self)
        end
    end
    local baseSetVisible = self.SetVisible
    function self:SetVisible(visible)
        baseSetVisible(self, visible)
        sync()
    end
    local baseSet = self.Set
    function self:Set(opts)
        baseSet(self, opts)
        sync()
        return self
    end
end

function Draw.FOVCircle(opts)
    local self = newComposite(opts, styled({ Radius = 120, Follow = "Center", Filled = false, Outline = true, NumSides = 64 }))
    self._outline = self:_part("Circle", true)
    self._main = self:_part("Circle")
    self:_style()
    self.Position = Draw.ScreenCenter()
    function self:_refresh()
        local o = self.Options
        local pos = o.Follow and followPoint(o.Follow) or (o.Position or self.Position)
        self.Position = pos
        for _, c in ipairs({ self._outline, self._main }) do
            c.Position = pos
            c.Radius = o.Radius
            c.NumSides = o.NumSides
        end
        self._main.Filled = o.Filled == true
        self._outline.Filled = false
    end
    function self:Contains(point)
        return (point - self.Position).Magnitude <= self.Options.Radius
    end
    bindFollow(self)
    self:_refresh()
    return finish(self)
end

function Draw.Crosshair(opts)
    local self = newComposite(opts, styled({
        Style = "Cross",
        Size = 10,
        Gap = 4,
        Thickness = 2,
        Follow = "Center",
        Dot = false,
        DotSize = 2,
    }))
    for _ = 1, 4 do self:_part("Line", true) end
    for _ = 1, 4 do self:_part("Line") end
    self._circleOutline = self:_part("Circle", true)
    self._circle = self:_part("Circle")
    self._dotOutline = self:_part("Circle", true)
    self._dot = self:_part("Circle")

    self:_style()
    self.Position = Draw.ScreenCenter()

    local dirs = { Vector2.new(1, 0), Vector2.new(-1, 0), Vector2.new(0, 1), Vector2.new(0, -1) }

    function self:SetVisible(visible)
        self.Visible = visible == true
        if not self.Visible then
            for _, p in ipairs(self.Parts) do p.Visible = false end
            for _, p in ipairs(self.Outlines) do p.Visible = false end
        else
            self:_refresh()
        end
    end

    function self:_refresh()
        local o = self.Options
        local pos = o.Follow and followPoint(o.Follow) or (o.Position or self.Position)
        self.Position = pos

        if not self.Visible then
            for _, p in ipairs(self.Parts) do p.Visible = false end
            for _, p in ipairs(self.Outlines) do p.Visible = false end
            return
        end

        local s = tostring(o.Style or "Cross"):lower()
        local isDot = s == "dot" or s == "จุดเดี่ยว"
        local isCircle = s == "circle" or s == "วงกลม"
        local isTShape = s == "t-shape" or s == "t_shape" or s == "t" or s == "รูปตัว t"
        local isCross = s == "cross" or s == "กากบาท" or (not isDot and not isCircle and not isTShape)

        local showOutline = o.Outline ~= false
        local size = o.Size or 10
        local gap = o.Gap or 4

        local showLines = isCross or isTShape
        for i, d in ipairs(dirs) do
            local showArm = showLines and (not isTShape or i ~= 4)
            local outline, main = self.Outlines[i], self.Parts[i]
            if showArm then
                local inner = pos + d * gap
                local outer = pos + d * (gap + size)
                outline.From = inner - d
                outline.To = outer + d
                outline.Visible = showOutline
                main.From = inner
                main.To = outer
                main.Visible = true
            else
                outline.Visible = false
                main.Visible = false
            end
        end

        local cOutline, cMain = self._circleOutline, self._circle
        if isCircle then
            local r = gap + size
            cOutline.Position = pos
            cOutline.Radius = r
            cOutline.Filled = false
            cOutline.Visible = showOutline
            cMain.Position = pos
            cMain.Radius = r
            cMain.Filled = false
            cMain.Visible = true
        else
            cOutline.Visible = false
            cMain.Visible = false
        end

        local dOutline, dMain = self._dotOutline, self._dot
        local showDot = (o.Dot == true or o.CenterDot == true or isDot)
        if showDot then
            local ds = o.DotSize or math.max(2, o.Thickness or 2)
            local r = math.max(1, ds * 0.5)
            dOutline.Position = pos
            dOutline.Radius = r + 1
            dOutline.Filled = true
            dOutline.Visible = showOutline
            dMain.Position = pos
            dMain.Radius = r
            dMain.Filled = true
            dMain.Visible = true
        else
            dOutline.Visible = false
            dMain.Visible = false
        end
    end

    function self:Update(pos)
        if pos then
            self.Position = pos
            self.Options.Position = pos
        end
        self:_refresh()
        return self
    end

    bindFollow(self)
    self:_refresh()
    return finish(self)
end

function Draw.Clear()
    for item in pairs(followers) do item._follow = false end
    table.clear(followers)
    followCount = 0
    if followConn then
        followConn:Disconnect()
        followConn = nil
    end
    local all = {}
    for obj in pairs(live) do table.insert(all, obj) end
    for _, obj in ipairs(all) do methods.Remove(obj) end
    for _, pool in pairs(pools) do table.clear(pool) end
    if layer then
        pcall(function() layer:Destroy() end)
        layer = nil
    end
end

