            entry.useAnatomicalR6 = false
            entry.skelEdges = resolveSkeleton(skelTarget)
        else
            local mode = entry.opts.SkeletonMode or "Auto"
            local isR6 = (entry.humanoid.RigType == Enum.HumanoidRigType.R6) or (t:FindFirstChild("Torso") and not t:FindFirstChild("UpperTorso"))
            entry.isR6 = isR6
            if mode == "Bones" or (not isR6 and mode ~= "Anatomical") then
