                entry.useAnatomicalR6 = isR6
                entry.skelEdges = not isR6 and resolveSkeleton(t) or nil
            end
        end
        if not entry.skelEdges and not entry.useAnatomicalR6 then
            entry.nextResolve = math.min(entry.nextResolve, now + 0.5)
        end
    else
        entry.skelEdges = nil
        entry.useAnatomicalR6 = false
    end
    local parts = {}
    for _, d in ipairs(t:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 0.95 and d.Name ~= "HumanoidRootPart"
            and d.Name ~= "RootPart" and d.Size.Magnitude > 0.2 and not d:FindFirstAncestorOfClass("Tool") then
