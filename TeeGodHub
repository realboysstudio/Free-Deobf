    if _mapName then return end
    _mapName = name
    local waiters = _mapWaiters
    _mapWaiters = nil
    for _, fn in ipairs(waiters or {}) do
        Util.callback(fn, name)
    end
end

function Util.prefetchMapName()
    if _mapName or _mapWaiters then return end
    _mapWaiters = {}
    task.spawn(function()
        resolveMapName(fetchMapName())
    end)
end

function Util.getMapName()
    if _mapName then return _mapName end
    if not coroutine.isyieldable() then
        Util.prefetchMapName()
        return "Game"
    end
    if _mapWaiters then
        local deadline = os.clock() + 10
        while not _mapName and os.clock() < deadline do
            task.wait()
        end
    end
    if not _mapName then
        resolveMapName(fetchMapName())
    end
    return _mapName
end

function Util.peekMapName()
    return _mapName
end

function Util.onMapName(fn)
    if _mapName then
        Util.callback(fn, _mapName)
        return
    end
    Util.prefetchMapName()
    table.insert(_mapWaiters, fn)
end

