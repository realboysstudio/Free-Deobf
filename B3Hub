        Parent = row,
    })
    local key = New("TextLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(0, 16),
        AutomaticSize = Enum.AutomaticSize.X,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextTransparency = 0.3,
        Theme = { TextColor3 = "Text", BackgroundColor3 = "Element" },
        BackgroundTransparency = 0,
        Corner = 4,
        Padding = { Left = 5, Right = 5 },
        Parent = row,
    })
    entry.Row, entry.Dot, entry.Label, entry.Key = row, dot, label, key
end

local function render(entry)
    if not list then return end
    local name, key, active = entry:GetInfo()
    local visible = key ~= nil and key ~= "None" and key ~= ""
    if not visible then
        if entry.Row then entry.Row.Visible = false end
        return
    end
    createRow(entry)
    entry.Row.Visible = true
    entry.Label.Text = name ~= "" and name or "Keybind"
    entry.Key.Text = tostring(key)
    if entry.LastActive ~= active then
        entry.LastActive = active
        Tween.play(entry.Label, { Position = UDim2.new(0, active and 11 or 0, 0.5, 0), TextTransparency = active and 0 or 0.4 }, 0.15)
        Tween.play(entry.Dot, { BackgroundTransparency = active and 0 or 1 }, 0.15)
    end
end

local function newEntry(getInfo)
    entryOrder = entryOrder + 1
    local entry = { Order = entryOrder, GetInfo = getInfo }
    function entry:Update()
        render(self)
    end
    function entry:Remove()
        local index = table.find(entries, self)
        if index then table.remove(entries, index) end
        if self.Row then self.Row:Destroy() self.Row = nil end
    end
    table.insert(entries, entry)
    render(entry)
    return entry
end

function Library:_AddKeybindEntry(core)
    return newEntry(function()
        return core.Name or "", core.Value, core.Toggled
    end)
end

function Library:KeybindList(title)
    if list then
        if title then Locale.bind(list.Title, "Text", title) end
        return list.Api
    end
    Gui.init()

    local frame = New("Frame", {
        Name = "KeybindList",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 16, 0.5, 0),
        Size = UDim2.fromOffset(WIDTH, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 0.05,
        Visible = false,
        Theme = { BackgroundColor3 = "Background" },
        Corner = 6,
        List = { Padding = 0 },
        Parent = Gui.Top,
    })
    Gui.scaleWith(frame)

    local top = New("Frame", {
        Name = "Top",
        Size = UDim2.new(1, 0, 0, 26),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
        Parent = frame,
    })
    local icon = New("ImageLabel", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 9, 0.5, 0),
        Size = UDim2.fromOffset(13, 13),
        Image = "rbxassetid://81598136527047",
        Parent = top,
    })
    Theme.gradient(icon)
    local titleLabel = New("TextLabel", {
        Position = UDim2.fromOffset(28, 0),
        Size = UDim2.new(1, -34, 1, 0),
        Translate = { Text = title or "Keybinds" },
        TextSize = 12,
        FontFace = Library.Fonts.Bold,
        Theme = { TextColor3 = "Text" },
        Parent = top,
    })
    local content = New("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 3,
        Padding = { Top = 0, Bottom = 7, Left = 9, Right = 7 },
        List = { Padding = 2 },
        Parent = frame,
    })

    local startPos
    Library.Maid:Give(Input.drag(frame, {
        threshold = 3,
        onStart = function() startPos = frame.Position end,
        onMove = function(delta)
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end,
    }))

    list = { Frame = frame, Content = content, Title = titleLabel }

    local api = {}
    function api:SetVisibility(visible)
        frame.Visible = visible and true or false
    end
    api.SetVisible = api.SetVisibility

    function api:Add(name, key)
        local info = { name = name or "", key = key or "", active = false }
        local entry = newEntry(function() return info.name, info.key, info.active end)
        local handle = {}
        function handle:Set(newName, newKey)
            info.name = newName or info.name
            info.key = newKey or info.key
            entry:Update()
        end
        function handle:SetStatus(active)
            info.active = active and true or false
            entry:Update()
        end
        function handle:Remove()
            entry:Remove()
        end
        return handle
    end

    list.Api = api
    Library.KeyList = api

    for _, entry in ipairs(entries) do
        render(entry)
    end
    return api
end

Library.Maid:Give(function()
    entries = {}
    list = nil
end)

return true
]]

