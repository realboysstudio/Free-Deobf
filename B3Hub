local Services = require("core/Services")
local Library = require("core/Library")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Gui = require("core/Gui")
local Locale = require("core/Locale")

local Tooltip = {}

local tooltipFrame
local tooltipLabel
local tooltipStroke
local currentTarget = nil
local showToken = 0

local function init()
    if tooltipFrame then return end
    Gui.init()

    tooltipFrame = New("Frame", {
        Name = "Tooltip",
        Size = UDim2.fromOffset(0, 0),
        AutomaticSize = Enum.AutomaticSize.XY,
        BackgroundTransparency = 1,
        Theme = { BackgroundColor3 = "Section Background" },
        Corner = 6,
        Stroke = { Color = "Outline", Thickness = 1, Transparency = 1 },
        Padding = { Top = 6, Bottom = 6, Left = 9, Right = 9 },
        ZIndex = 200,
        Visible = false,
        Parent = Gui.Top,
    })

    New("UISizeConstraint", {
        MaxSize = Vector2.new(260, 400),
        Parent = tooltipFrame,
    })

    tooltipLabel = New("TextLabel", {
        Name = "Text",
        Size = UDim2.fromOffset(0, 0),
        AutomaticSize = Enum.AutomaticSize.XY,
        BackgroundTransparency = 1,
        TextTransparency = 1,
        TextSize = 12,
        FontFace = Library.Fonts.Regular,
        TextWrapped = true,
        Theme = { TextColor3 = "Text" },
        ZIndex = 201,
        Parent = tooltipFrame,
    })

    tooltipStroke = tooltipFrame:FindFirstChildOfClass("UIStroke")
end

function Tooltip.show(target, text)
    if Library.IsMobile or not text or text == "" then return end
    init()

    currentTarget = target
    showToken = showToken + 1
    local myToken = showToken

    tooltipLabel.Text = tostring(Locale.t(text))
    tooltipFrame.Visible = true

    task.defer(function()
        if showToken ~= myToken or currentTarget ~= target then return end

        local mouse = Services.UserInputService:GetMouseLocation()
        local view = Gui.viewport()
        local size = tooltipFrame.AbsoluteSize

        local x = mouse.X + 12
        local y = mouse.Y + 14

        if x + size.X > view.X - 10 then
            x = math.max(10, mouse.X - size.X - 8)
        end
        if y + size.Y > view.Y - 10 then
            y = math.max(10, mouse.Y - size.Y - 8)
        end

        tooltipFrame.Position = UDim2.fromOffset(x, y)

        Tween.play(tooltipFrame, { BackgroundTransparency = 0.05 }, 0.12)
        Tween.play(tooltipLabel, { TextTransparency = 0 }, 0.12)
        if tooltipStroke then
            Tween.play(tooltipStroke, { Transparency = 0.3 }, 0.12)
        end
    end)
end

function Tooltip.hide(target)
    if target and currentTarget ~= target then return end
    currentTarget = nil
    showToken = showToken + 1

    if not tooltipFrame then return end
    Tween.play(tooltipFrame, { BackgroundTransparency = 1 }, 0.1)
    Tween.play(tooltipLabel, { TextTransparency = 1 }, 0.1)
    if tooltipStroke then
        Tween.play(tooltipStroke, { Transparency = 1 }, 0.1)
    end
    task.delay(0.12, function()
        if currentTarget == nil and tooltipFrame then
            tooltipFrame.Visible = false
        end
    end)
end

local attached = setmetatable({}, { __mode = "k" })

function Tooltip.attach(guiInstance, text)
    if not guiInstance then return end
    local existing = attached[guiInstance]
    if text == nil or text == "" then
        if existing then
            existing.Enter:Disconnect()
            existing.Leave:Disconnect()
            attached[guiInstance] = nil
            Tooltip.hide(guiInstance)
        end
        return
    end
    if existing then
        existing.Text = text
        if currentTarget == guiInstance then Tooltip.show(guiInstance, text) end
        return
    end
    if Library.IsMobile then return end

    local entry = { Text = text }
    entry.Enter = guiInstance.MouseEnter:Connect(function()
        Tooltip.show(guiInstance, entry.Text)
    end)
    entry.Leave = guiInstance.MouseLeave:Connect(function()
        Tooltip.hide(guiInstance)
    end)
    attached[guiInstance] = entry
end

return Tooltip
]]

__sources["core/Tween"] = [[
local Services = require("core/Services")
local Library = require("core/Library")

local Tween = {}

local active = {}

local function apply(instance, props)
    for property, value in pairs(props) do
        instance[property] = value
    end
end

local function stop(instance, props)
    local slots = active[instance]
    if not slots then return end
    for property in pairs(props) do
        local slot = slots[property]
        if slot then
            slot.tween:Cancel()
            for otherProperty, otherValue in pairs(slot.goal) do
                if props[otherProperty] == nil and slots[otherProperty] == slot then
                    slots[otherProperty] = nil
                    pcall(function() instance[otherProperty] = otherValue end)
                end
            end
            slots[property] = nil
        end
    end
    if next(slots) == nil then
        active[instance] = nil
    end
end

function Tween.play(instance, props, time, style, direction)
    if not instance then return nil end
    Library._ensureIdentity()
    time = time or Library.Tween.Time
    stop(instance, props)

    if not Library.Animations or time <= 0 or instance.Parent == nil then
        apply(instance, props)
        return nil
    end

    local info = TweenInfo.new(time, style or Library.Tween.Style, direction or Library.Tween.Direction)
    local ok, tween = pcall(Services.TweenService.Create, Services.TweenService, instance, info, props)
    if not ok then
        apply(instance, props)
        return nil
    end

    local slot = { tween = tween, goal = props }
    local slots = active[instance]
    if not slots then
        slots = {}
        active[instance] = slots
    end
    for property in pairs(props) do
        slots[property] = slot
    end

    tween.Completed:Connect(function()
        local current = active[instance]
        if not current then return end
        for property in pairs(props) do
            if current[property] == slot then
                current[property] = nil
            end
        end
        if next(current) == nil then
            active[instance] = nil
        end
    end)

    tween:Play()
    return tween
end

function Tween.set(instance, props)
    if not instance then return end
    Library._ensureIdentity()
    stop(instance, props)
    apply(instance, props)
end

local motions = {} -- key -> motion
local motionConn

local function easeOut(t) return 1 - (1 - t) ^ 4 end -- quart out: quick start, soft landing

local function runMotions()
    if motionConn then return end
    motionConn = Services.RunService.RenderStepped:Connect(function()
        local now = os.clock()
        for key, m in pairs(motions) do
            local t = math.clamp((now - m.start) / m.time, 0, 1)
            local ok = pcall(m.step, easeOut(t))
            if t >= 1 or not ok then
                motions[key] = nil
                if m.done then pcall(m.done) end
            end
        end
        if next(motions) == nil then
            motionConn:Disconnect()
            motionConn = nil
        end
    end)
end

local function startMotion(key, time, step, done)
    local previous = motions[key]
    motions[key] = nil
    if previous and previous.cancel then pcall(previous.cancel) end
    if not Library.Animations or time <= 0 then
        pcall(step, 1)
        if done then pcall(done) end
        return
    end
    motions[key] = { start = os.clock(), time = time, step = step, done = done }
    runMotions()
end

local function lerpUDim2(a, b, t)
    return UDim2.new(
        a.X.Scale + (b.X.Scale - a.X.Scale) * t, math.floor(a.X.Offset + (b.X.Offset - a.X.Offset) * t + 0.5),
        a.Y.Scale + (b.Y.Scale - a.Y.Scale) * t, math.floor(a.Y.Offset + (b.Y.Offset - a.Y.Offset) * t + 0.5)
    )
end

function Tween.slide(gui, from, to, time, done)
    gui.Position = from
    startMotion(gui, time or 0.18, function(t)
        gui.Position = lerpUDim2(from, to, t)
    end, done)
end

function Tween.resize(gui, to, time, done)
    local from = gui.Size
    startMotion(gui, time or 0.2, function(t)
        gui.Size = lerpUDim2(from, to, t)
    end, done)
end

function Tween.fold(frame, open, time, done, heightFn)
    local scale = math.max(Library.PopupScale or 1, 0.01)
    local layout = frame:FindFirstChildWhichIsA("UIListLayout")
    local function contentHeight()
        if heightFn then return heightFn() end
        if layout then return layout.AbsoluteContentSize.Y end
        return frame.AbsoluteSize.Y
    end
    local startHeight = frame.Visible and math.floor(frame.AbsoluteSize.Y / scale + 0.5) or 0
    frame.AutomaticSize = Enum.AutomaticSize.None
    frame.ClipsDescendants = true
    frame.Visible = true
    local function setHeight(h)
        frame.Size = UDim2.new(frame.Size.X.Scale, frame.Size.X.Offset, 0, h)
    end
    setHeight(startHeight)
    local target = open and math.floor(contentHeight() / scale + 0.5) or 0
    startMotion(frame, time or 0.2, function(t)
        setHeight(math.floor(startHeight + (target - startHeight) * t + 0.5))
    end, function()
        if open then
            frame.AutomaticSize = Enum.AutomaticSize.Y
            setHeight(0)
            frame.ClipsDescendants = false
        else
            frame.Visible = false
        end
        if done then done() end
    end)
end

function Tween.clear()
    for _, slots in pairs(active) do
        for _, slot in pairs(slots) do
            pcall(function() slot.tween:Cancel() end)
        end
    end
    active = {}
    motions = {}
    if motionConn then motionConn:Disconnect() motionConn = nil end
end

return Tween
]]

__sources["core/Util"] = [[
local Services = require("core/Services")
local Icons = require("core/Icons")

local Util = {}
Util.Icons = Icons

function Util.requireModule(moduleScript)
    if typeof(moduleScript) ~= "Instance" or not moduleScript:IsA("ModuleScript") then return nil end
    local candidates = {}
    if typeof(getgenv) == "function" then
        local ok, env = pcall(getgenv)
        if ok and type(env) == "table" and type(env.require) == "function" then table.insert(candidates, env.require) end
    end
    if typeof(getrenv) == "function" then
        local ok, env = pcall(getrenv)
        if ok and type(env) == "table" and type(env.require) == "function" then table.insert(candidates, env.require) end
    end
    for _, fn in ipairs(candidates) do
        local ok, res = pcall(fn, moduleScript)
        if ok then return res end
    end
    return nil
end

function Util.clamp(v, lo, hi)
    if v < lo then return lo end
    if v > hi then return hi end
    return v
end

function Util.round(v, step)
    step = step or 1
    if step <= 0 then return v end
    local r = math.floor(v / step + 0.5) * step
    local decimals = 0
    local s = tostring(step)
    local dot = string.find(s, ".", 1, true)
    if dot then decimals = #s - dot end
    if decimals > 0 then
        r = tonumber(string.format("%." .. decimals .. "f", r))
    end
    return r
end

function Util.formatNumber(v)
    if v == math.floor(v) then
        return tostring(math.floor(v))
    end
    return tostring(v)
end

function Util.escapePattern(s)
    return (string.gsub(s, "[%(%)%.%%%+%-%*%?%[%]%^%$]", "%%%0"))
end

function Util.asset(id)
    if id == nil or id == "" then return "" end
    id = tostring(id)
    if string.find(id, "://", 1, true) then return id end
    if tonumber(id) then
        return "rbxthumb://type=Asset&id=" .. id .. "&w=420&h=420"
    end
    local name = id
    if string.sub(name, 1, 7) == "lucide:" then
        name = string.sub(name, 8)
    end
    name = string.lower(name):gsub("_", "-")
    local resolved = Icons[name]
    if resolved then
        if type(resolved) == "number" or (type(resolved) == "string" and not string.find(resolved, "://")) then
            return "rbxassetid://" .. tostring(resolved)
        end
        return resolved
    end
    return "rbxassetid://" .. id
end

local _mapName = nil
local _mapWaiters = nil

local function fetchMapName()
    local name = "Game"
