function Window:_clampMiniIcon()
    local icon = self.MiniIcon
    local v = Gui.viewport()
    if v.X < 200 or v.Y < 200 then return end
    local wanted = self._miniIconWanted or Vector2.new(icon.Position.X.Offset, icon.Position.Y.Offset)
    local size = icon.AbsoluteSize -- the icon lives outside the window's UIScale
    icon.Position = UDim2.fromOffset(
        math.clamp(wanted.X, 0, math.max(0, v.X - size.X)),
        math.clamp(wanted.Y, 0, math.max(0, v.Y - size.Y))
    )
end

function Window:_setMiniIconVisible(visible)
    local icon = self.MiniIcon
    if not icon then return end
    if visible and not self._shown then return end
    if visible and self.MiniIconEnabled then
        if not icon.Visible then
            if not self._miniIconCustom and self._miniIconDefault then
                local p = self._miniIconDefault()
                self._miniIconWanted = Vector2.new(p.X.Offset, p.Y.Offset)
            end
            self:_clampMiniIcon()
            icon.Visible = true
            Tween.set(self.MiniIconScale, { Scale = 0.7 })
            Tween.play(self.MiniIconScale, { Scale = 1 }, 0.18, Enum.EasingStyle.Back)
        end
    else
        icon.Visible = false
    end
end

function Window:SetMiniIconEnabled(enabled)
    self.MiniIconEnabled = enabled and true or false
    if self.MiniIconEnabled and not self.MiniIcon then
        self:_createMiniIcon()
    end
    self:_setMiniIconVisible(not self.IsOpen)
end

function Window:_buildSettings(settings)
    local window = self

    local languageNames = {}
    for _, key in ipairs(Library:GetLanguages()) do
        table.insert(languageNames, Locale.DisplayNames[key] or key)
    end
    table.sort(languageNames, function(a, b)
        if a == "English" then return true end
        if b == "English" then return false end
        return a < b
    end)
    local languageDropdown = settings:Dropdown({
        Name = "Language",
        Flag = "Language",
        Default = Locale.DisplayNames[Locale.Current] or Locale.Current,
        Items = languageNames,
        NoTranslate = true, -- option names are shown as-is ("English", "ไทย")
        ImmediateCallback = true, -- visible selection and translated chrome must never diverge
        Callback = function(value)
            Locale.set(value)
        end,
    })
    Library.Maid:Give(Locale.onChanged(function(language)
        local display = Locale.DisplayNames[language] or language
        if languageDropdown.Value ~= display then
            languageDropdown:Set(display, true)
        end
    end))
    local previousAdd = Library.AddTranslations
    Library.AddTranslations = function(lib, language, dict)
        previousAdd(lib, language, dict)
        languageDropdown:Add(Locale.DisplayNames[language] or language)
    end

    local ThemeModule = Library.ThemeModule
    local accentPicker, gradientPicker
    local themeDropdown = settings:Dropdown({
        Name = "Theme",
        Flag = "ThemePreset",
        Default = ThemeModule.Current,
        Items = ThemeModule.ThemeNames,
        Callback = function(value)
            Library:SetTheme(value, true)
        end,
    })
    Library.OnThemeListChanged = function(name) themeDropdown:Add(name) end

    Library.NoSaveFlags.AccentPreset = true
    local accentDropdown
    local function samePair(a, b)
        return a:ToHex() == b:ToHex()
    end
    local function syncAccentDropdown()
        if not accentDropdown then return end
        local match
        for _, name in ipairs(ThemeModule.AccentNames) do
            local pair = ThemeModule.Accents[name]
            if samePair(pair[1], Library.Theme.Accent) and samePair(pair[2], Library.Theme.AccentGradient) then
                match = name
                break
            end
        end
        if accentDropdown.Value ~= match then accentDropdown:Set(match, true) end
    end
    accentDropdown = settings:Dropdown({
        Name = "Accent",
        Flag = "AccentPreset",
        Placeholder = "Custom",
        Items = ThemeModule.AccentNames,
        Callback = function(value)
            local pair = ThemeModule.Accents[value]
            if not pair then return end
            if accentPicker then accentPicker:Set(pair[1]) end
            if gradientPicker then gradientPicker:Set(pair[2]) end
        end,
    })

    accentPicker = settings:Label("Accent color"):Colorpicker({
        Flag = "AccentColor",
        Default = Library.Theme.Accent,
        Callback = function(color)
            Library:ChangeTheme("Accent", color)
            syncAccentDropdown()
        end,
    })

    gradientPicker = settings:Label("Accent gradient"):Colorpicker({
        Flag = "AccentGradientColor",
        Default = Library.Theme.AccentGradient,
        Callback = function(color)
            Library:ChangeTheme("AccentGradient", color)
            syncAccentDropdown()
        end,
    })
    syncAccentDropdown()
    local previousThemeHook = Library.OnThemeChanged
    Library.OnThemeChanged = function(map)
        if previousThemeHook then pcall(previousThemeHook, map) end
        if map.Accent or map.AccentGradient then syncAccentDropdown() end
    end

    window._layoutDropdown = settings:Dropdown({
        Name = "Layout",
        Flag = "MenuLayout",
        Default = window.Layout,
        Items = { "Sidebar", "Topbar" },
        Callback = function(value)
            window:SetLayout(value)
        end,
    })

    settings:Dropdown({
        Name = "Font weight",
        Flag = "FontStyle",
        Default = Library.FontName or "Medium",
        Items = { "Light", "Regular", "Medium", "SemiBold", "Bold" },
        Callback = function(value)
            local font = Library.Fonts[value]
            if font and font ~= Library.Font then
                Library.Font = font
                Library.FontName = value
                Config.setSavedFont(value)
                Library:UpdateText()
            end
        end,
    })

    settings:Dropdown({
        Name = "Notifications",
        Flag = "NotificationPosition",
        Default = "Right",
        Items = { "Right", "Left" },
        Callback = function(value)
            if Library.SetNotificationSide then
                Library:SetNotificationSide(value)
            end
        end,
    })

    settings:Slider({
        Name = "Transparency",
        Flag = "BackgroundTransparency",
        Min = 0,
        Max = 1,
        Decimals = 0.01,
        Default = Library.Flags.BackgroundTransparency or DEFAULT_TRANSPARENCY,
        Callback = function(value)
            window:SetTransparency(value)
        end,
    })

    settings:Slider({
        Name = "UI Size",
        Flag = "UIScale",
        Min = 0.3,
        Max = 2,
        Decimals = 0.01,
        Suffix = "x",
        Default = window.UserScale,
        Callback = function(value)
            window:SetUIScale(value)
        end,
    })

    settings:Toggle({
        Name = "Mini icon when minimized",
        Flag = "MiniIconEnabled",
        Default = window.MiniIconEnabled,
        Callback = function(value)
            window:SetMiniIconEnabled(value)
            if window._shown and not value and Library.IsMobile and Library.Notification then
                Library:Notification({
                    Title = "Mini icon hidden",
                    Description = "Swipe down from top edge to reopen",
                    Duration = 4,
                })
            end
        end,
    })

    settings:Keybind({
        Name = "Menu keybind",
        Flag = "MenuBind",
        Default = Library.MenuKeybind,
        Mode = "Toggle",
        ShowModes = false,
        NoKeybindList = true,
        Callback = function() end,
    })
end

Library.CreateWindow = function(self, data)
    return Library:Window(data)
end

return Window
]]

__sources["core/Aim"] = [[
local Library = require("core/Library")
local Services = require("core/Services")
local Draw = require("core/Draw")
local Util = require("core/Util")

local Players = Services.Players
local UserInputService = Services.UserInputService
local RunService = Services.RunService
local Workspace = Services.Workspace

local math_clamp = math.clamp
local math_max = math.max
local math_min = math.min
local math_acos = math.acos
local math_deg = math.deg
local math_random = math.random
local vector2_new = Vector2.new
local vector3_new = Vector3.new
local vector3_zero = Vector3.zero

local function getCamera()
    return Workspace.CurrentCamera or Workspace:FindFirstChildOfClass("Camera")
end

local Aim = {}
Aim.__index = Aim

Aim.Defaults = {
    Enabled = false,
    Aimbot = false,
    SilentAim = false,
    TargetBone = "Head", -- "Head" | "Torso" | "Closest" | "Random"
    Trigger = Library.IsMobile and "When Holding Weapon" or "Hold Right Click",
    Keybind = Enum.KeyCode.E,
    Smoothness = 2.0,
    FovRadius = 120,
    AimbotFovRadius = 80,
    SilentFovRadius = 160,
    MaxSilentFov = nil,
    DrawFov = false,
    DrawAimbotFov = false,
    DrawSilentFov = false,
    FovColor = nil,
    AimbotFovColor = Color3.fromRGB(100, 185, 255),
    SilentFovColor = Color3.fromRGB(180, 100, 255),
    MaxDistance = 1000,
    WallCheck = true,
    SilentWallCheck = true,
    SilentTargetBone = "Head",
    StickyLock = true,
    PredictMovement = false,
    HitChance = 100,
    MaxSilentAngle = 30,
    TargetFilter = nil,
    HeadOffset = vector3_new(0, 0.35, 0),
}

Aim.Config = {}
for k, v in pairs(Aim.Defaults) do Aim.Config[k] = v end

Aim.LockedPlayer = nil
Aim.LockedPart = nil
Aim.KeybindActive = false

local aimbotFovCircle = nil
local silentFovCircle = nil
local isBoundToRender = false
local renderConn = nil
local inputBeganConn = nil
local inputEndedConn = nil
local rayParams = nil
local AIMBOT_RENDER_STEP = "B3_Universal_Aimbot_" .. tostring(math.random(100000, 999999)) .. "_" .. tostring(math.floor(os.clock() * 1000))

local function getAimCenter()
    local cam = getCamera()
    if not cam then return vector2_new(640, 360) end
    local vp = cam.ViewportSize
    if vp.X <= 0 or vp.Y <= 0 then return vector2_new(640, 360) end

    return vector2_new(vp.X * 0.5, vp.Y * 0.5)
end

local function isPlayerAlive(player)
    if not player then return false end
    local char = player.Character
    if not char then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return false end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char.PrimaryPart
    return root ~= nil
end

Aim.Adapters = Aim.Adapters or {}
local adapterList = {}
local adapterCache, adapterCacheAt = nil, 0

function Aim:RegisterAdapter(name, def)
    if type(name) ~= "string" or type(def) ~= "table" then return self end
    for i, a in ipairs(adapterList) do
        if a.Name == name then table.remove(adapterList, i) break end
    end
    def.Name = name
    table.insert(adapterList, 1, def) -- latest registration wins on overlap
    Aim.Adapters[name] = def
    adapterCache, adapterCacheAt = nil, 0
    return self
end

local function getAdapter()
    local now = os.clock()
    if now - adapterCacheAt < 2 then return adapterCache end
    adapterCacheAt = now
    adapterCache = nil
    for _, a in ipairs(adapterList) do
        if type(a.Match) == "function" then
            local ok, hit = pcall(a.Match)
            if ok and hit then adapterCache = a break end
        end
    end
    return adapterCache
end

function Aim:GetAdapter()
    return getAdapter()
end

local function isHoldingWeapon()
    local ad = getAdapter()
    if ad and type(ad.IsHoldingWeapon) == "function" then
        local ok, res = pcall(ad.IsHoldingWeapon)
        if ok and res ~= nil then return res and true or false end
    end
    local lp = Players.LocalPlayer
    local char = lp and lp.Character
    if not char then return false end
    if char:FindFirstChildOfClass("Tool") then return true end
    local slot = char:GetAttribute("WeaponSlot")
    if slot and slot ~= 0 and slot ~= "0" and slot ~= "" and slot ~= "Melee" then return true end
    local weaponId = char:GetAttribute("CurrentWeaponId") or char:GetAttribute("ActiveWeapon")
    if weaponId then return true end
    if char:GetAttribute("WarZAnimationProfile") or char:GetAttribute("WarZSourceANM") then return true end
    if char:GetAttribute("CurrentGun") or char:GetAttribute("EquippedGun") or char:GetAttribute("Equipped") then return true end
    if char:FindFirstChild("BloxZWeaponVisual") or char:FindFirstChild("Weapon") or char:FindFirstChild("Gun") then return true end
    return false
end

local function isFiring()
    local ad = getAdapter()
    if ad and type(ad.IsFiring) == "function" then
        local ok, res = pcall(ad.IsFiring)
        if ok and res ~= nil then return res and true or false end
    end
    return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
end

local rightClickHeld = false
local activeTouches = {}

function Aim:IsTriggered()
    if not self.Config.Enabled then return false end
    if UserInputService:GetFocusedTextBox() then return false end

    local mode = self.Config.Trigger
    if mode == "Always" or mode == "ตลอดเวลา" or mode == "ล็อคตลอดเวลา" then
        return true
    elseif mode == "When Holding Weapon" or mode == "เมื่อถืออาวุธ" or mode == "ล็อคเมื่อถืออาวุธ" or mode == "ขณะถืออาวุธ" then
        return isHoldingWeapon()
    elseif mode == "When Firing" or mode == "ตอนกดยิง" then
        return isFiring()
    elseif mode == "Touch / Screen Hold" or mode == "แตะหน้าจอค้าง" or mode == "แตะหน้าจอ" then
        if Library.IsMobile or UserInputService.TouchEnabled then
            for inp in pairs(activeTouches) do
                local st = inp.UserInputState
                if st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
                    activeTouches[inp] = nil
                end
            end
            return next(activeTouches) ~= nil
        end
        return UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
    elseif mode == "Hold Right Click" or mode == "คลิกขวาค้าง" then
        if Library.IsMobile or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled) then
            return isHoldingWeapon()
        end
        if rightClickHeld or UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
            return true
        end
        local lp = Players.LocalPlayer
        local ps = lp and (lp:FindFirstChild("PlayerScripts") or lp.PlayerScripts)
        local feat = ps and ps:FindFirstChild("Features")
        local inp = feat and feat:FindFirstChild("Input")
        local icMod = inp and inp:FindFirstChild("InputController")
        if icMod and icMod:IsA("ModuleScript") then
            local ok, ic = pcall(Util.requireModule, icMod)
            if ok and ic and type(ic.IsActionHeld) == "function" and ic:IsActionHeld("Aim") then
                return true
            end
        end
        return false
    elseif mode == "Keybind" or mode == "ปุ่มคีย์ลัด" then
        return self.KeybindActive == true
    end

    return false
end

local HEAD_NAMES = { "Head", "Bip01_Head", "RegularGuy_head", "HeadPart" }
local TORSO_NAMES = { "HumanoidRootPart", "UpperTorso", "Torso", "Bip01_Spine", "Bip01_Spine1", "Bip01_Spine2", "RegularGuy_body", "Chest" }

local function findHeadPart(char)
    if not char then return nil end
    for _, name in ipairs(HEAD_NAMES) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    local highestHead = nil
    local maxY = -math.huge
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("BasePart") then
            local low = c.Name:lower()
            if low:find("head") or low:find("face") then
                if c.Position.Y > maxY then
                    maxY = c.Position.Y
                    highestHead = c
                end
            end
        end
    end
    if highestHead then return highestHead end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("BasePart") and c.Name:lower():find("helmet") then
            return c
        end
    end
    return nil
end

local function findTorsoPart(char)
    if not char then return nil end
    for _, name in ipairs(TORSO_NAMES) do
        local p = char:FindFirstChild(name)
        if p and p:IsA("BasePart") then return p end
    end
    for _, c in ipairs(char:GetChildren()) do
        if c:IsA("BasePart") then
            local low = c.Name:lower()
            if low:find("body") or low:find("torso") or low:find("chest") or low:find("root") then
                return c
            end
        end
    end
    return char.PrimaryPart
end

local boneCache = setmetatable({}, { __mode = "k" })
local HEAD_BONES = { "bip01_head", "head", "mixamorig:head", "mixamorighead" }
local TORSO_BONES = { "bip01_spine2", "spine2", "bip01_spine1", "upperchest", "chest", "bip01_spine", "spine1" }

local function findBones(char)
    local scanTarget = char
    if type(Aim.Config.GetBoneRig) == "function" then
        local ok, customRig = pcall(Aim.Config.GetBoneRig, char)
        if ok and typeof(customRig) == "Instance" and customRig.Parent then
            scanTarget = customRig
        end
    end
    local entry = boneCache[scanTarget]
    if entry then return entry end
    entry = { head = false, torso = false }
    local byName = {}
    for _, d in ipairs(scanTarget:GetDescendants()) do
        if d:IsA("Bone") then
            byName[string.lower(d.Name)] = d
        end
    end
    for _, name in ipairs(HEAD_BONES) do
        if byName[name] then entry.head = byName[name] break end
    end
    for _, name in ipairs(TORSO_BONES) do
        if byName[name] then entry.torso = byName[name] break end
    end
    if entry.head or entry.torso or scanTarget == char then
        boneCache[scanTarget] = entry
    end
    return entry
end

local function isHeadPart(part)
    local low = string.lower(part.Name)
    return low:find("head") ~= nil or low:find("face") ~= nil or low:find("helmet") ~= nil
end

local function aimPointFor(char, part, headOffset)
    local bones = findBones(char)
    if isHeadPart(part) then
        local bone = bones.head
        if bone and bone.Parent then
            local cf = bone.TransformedWorldCFrame
            local pos = (cf and cf.Position) or bone.WorldPosition
            return pos + (Aim.Config.BoneHeadOffset or vector3_new(0, 0.2, 0))
        end
        return part.Position + (headOffset or vector3_zero)
    end
    local bone = bones.torso
    if bone and bone.Parent then
        local cf = bone.TransformedWorldCFrame
        return (cf and cf.Position) or bone.WorldPosition
    end
    return part.Position
end

local function getTargetBone(char, boneMode, headOffset)
    if not char then return nil, nil end
    local mode = tostring(boneMode or "Head"):lower()

    local head = findHeadPart(char)
    local torso = findTorsoPart(char)

    local function result(part)
        if not part then return nil, nil end
        return part, aimPointFor(char, part, headOffset)
    end

    if mode == "random" or mode == "สุ่ม" then
        if math_random(1, 100) <= 30 and head then
            return result(head)
        end
        return result(torso or head)
    elseif mode == "torso" or mode == "ตัว" or mode == "ลำตัว" then
        return result(torso or head)
    elseif mode == "closest" or mode == "ใกล้สุด" then
        if head and torso then
            local cam = getCamera()
            if cam then
                local center = getAimCenter()
                local hp = aimPointFor(char, head, headOffset)
                local tp = aimPointFor(char, torso, headOffset)
                local sH, onH = cam:WorldToViewportPoint(hp)
                local sT, onT = cam:WorldToViewportPoint(tp)
                if onH and onT then
                    local dH = (vector2_new(sH.X, sH.Y) - center).Magnitude
                    local dT = (vector2_new(sT.X, sT.Y) - center).Magnitude
                    if dH <= dT then return head, hp end
                    return torso, tp
                end
            end
        end
        return result(head or torso)
    else
        return result(head or torso)
    end
end

local function checkLineOfSight(fromPos, toPos, targetChar)
    if not rayParams then
        rayParams = RaycastParams.new()
        rayParams.FilterType = Enum.RaycastFilterType.Exclude
        rayParams.IgnoreWater = true
    end

    local lp = Players.LocalPlayer
    local myChar = lp and lp.Character
    local cam = getCamera()
    local ignore = { myChar, cam }

    rayParams.FilterDescendantsInstances = ignore
    local dir = toPos - fromPos
    local dist = dir.Magnitude
    if dist < 0.1 then return true end

    local hit = Workspace:Raycast(fromPos, dir, rayParams)
    if not hit then return true end
    if targetChar and hit.Instance and hit.Instance:IsDescendantOf(targetChar) then
        return true
    end
    if hit.Instance and hit.Instance.Transparency >= 0.9 and not hit.Instance.CanCollide then
        return true
    end
    return false
end

local lastFullScanTime = 0
local cachedCandidate = nil

function Aim:GetTarget(mode)
    if not self.Config.Enabled then return nil, nil, nil end
    local now = os.clock()

    local cam = getCamera()
    if not cam then return nil, nil, nil end

    local camPos = cam.CFrame.Position
    local aimCenter = getAimCenter()

    local fov = self.Config.FovRadius or 120
    if mode == "Aimbot" then
        fov = self.Config.AimbotFovRadius or self.Config.FovRadius or 80
    elseif mode == "SilentAim" then
        fov = self.Config.SilentFovRadius or self.Config.FovRadius or 160
    end

    local maxDist = self.Config.MaxDistance or 1000
    local wallCheck = (mode == "SilentAim" and self.Config.SilentWallCheck ~= nil and self.Config.SilentWallCheck) or self.Config.WallCheck
    local boneMode = (mode == "SilentAim" and (self.Config.SilentTargetBone or self.Config.TargetBone)) or self.Config.TargetBone or "Head"
    local headOffset = self.Config.HeadOffset or vector3_zero
    local customFilter = self.Config.TargetFilter
    if not customFilter then
        local ad = getAdapter()
        if ad and type(ad.IsFriendly) == "function" then
            local isFriendly = ad.IsFriendly
            customFilter = function(p) return not isFriendly(p) end
        end
    end
    local lp = Players.LocalPlayer

    if self.Config.StickyLock and self.LockedPlayer and isPlayerAlive(self.LockedPlayer) then
        local p = self.LockedPlayer
        local char = p.Character
        if char and (not customFilter or customFilter(p, char) ~= false) then
            local part = self.LockedPart
            if not part or not part.Parent or not part:IsDescendantOf(char) then
                part, _ = getTargetBone(char, boneMode, headOffset)
            end
            local pos = part and aimPointFor(char, part, headOffset)
            if part and pos then
                local sPos, onScreen = cam:WorldToViewportPoint(pos)
                if onScreen and sPos.Z > 0 then
                    local dist = (vector2_new(sPos.X, sPos.Y) - aimCenter).Magnitude
                    if dist <= fov * 1.5 then
                        local worldDist = (pos - camPos).Magnitude
                        if worldDist <= maxDist then
                            local hasLos = not wallCheck or checkLineOfSight(camPos, pos, char)
                            if hasLos then
                                self.LockedPart = part
                                self.LastTargetTime = now
                                return part, pos, p
                            elseif self.LastTargetTime and (now - self.LastTargetTime) < 0.25 then
                                return part, pos, p
                            end
                        end
                    end
                end
            end
        end
    end

    self.LockedPlayer = nil
    self.LockedPart = nil

    lastFullScanTime = now
    local bestPlayer = nil
    local bestPart = nil
    local bestPos = nil
    local bestScreenDist = fov

    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= lp and isPlayerAlive(p) then
            local char = p.Character
            if char and (not customFilter or customFilter(p, char) ~= false) then
                local part, pos = getTargetBone(char, boneMode, headOffset)
                if part and pos then
                    local worldDist = (pos - camPos).Magnitude
                    if worldDist <= maxDist then
                        local sPos, onScreen = cam:WorldToViewportPoint(pos)
                        if onScreen and sPos.Z > 0 then
                            local sDist = (vector2_new(sPos.X, sPos.Y) - aimCenter).Magnitude
                            if sDist <= bestScreenDist then
                                if not wallCheck or checkLineOfSight(camPos, pos, char) then
                                    bestScreenDist = sDist
                                    bestPlayer = p
                                    bestPart = part
                                    bestPos = pos
                                end
                            end
                        end
                    end
                end
            end
        end
    end

    if bestPlayer and bestPart and bestPos then
        cachedCandidate = { player = bestPlayer, part = bestPart, pos = bestPos }
        if self.Config.StickyLock then
            self.LockedPlayer = bestPlayer
            self.LockedPart = bestPart
            self.LastTargetTime = now
        end
        return bestPart, bestPos, bestPlayer
    end

    cachedCandidate = nil
    return nil, nil, nil
end

local pointParams
function Aim:GetCrosshairPlayer(radius)
    local cam = getCamera()
    if not cam then return nil end
    local lp = Players.LocalPlayer
    local center = getAimCenter()
    local camPos = cam.CFrame.Position
    local customFilter = self.Config.TargetFilter
    local ad = getAdapter()
    local isFriendly = ad and type(ad.IsFriendly) == "function" and ad.IsFriendly or nil
    local function allowed(p)
        if p == lp or not isPlayerAlive(p) then return false end
        if isFriendly and isFriendly(p) then return false end
        if customFilter and customFilter(p, p.Character) == false then return false end
        return true
    end

    pointParams = pointParams or RaycastParams.new()
    pointParams.FilterType = Enum.RaycastFilterType.Exclude
    pointParams.IgnoreWater = true
    pointParams.FilterDescendantsInstances = { lp and lp.Character, cam }
    local ray = cam:ViewportPointToRay(center.X, center.Y)
    local hit = Workspace:Raycast(ray.Origin, ray.Direction * (self.Config.MaxDistance or 1000), pointParams)
    if hit and hit.Instance then
        local model = hit.Instance:FindFirstAncestorOfClass("Model")
        while model do
            local p = Players:GetPlayerFromCharacter(model)
            if p then
                if allowed(p) then return p end
                break
            end
            model = model:FindFirstAncestorOfClass("Model")
        end
    end

    local maxR = tonumber(radius) or 180
    local bestVis, bestVisDist = nil, maxR
    local bestAny, bestAnyDist = nil, maxR
    local headOffset = self.Config.HeadOffset
    for _, p in ipairs(Players:GetPlayers()) do
        if allowed(p) then
            local char = p.Character
            local headPart = findHeadPart(char)
            local torsoPart = findTorsoPart(char)
            for idx = 1, 2 do
                local part = (idx == 1) and headPart or torsoPart
                if part then
                    local pos = aimPointFor(char, part, headOffset)
                    local sp, onScreen = cam:WorldToViewportPoint(pos)
                    if onScreen and sp.Z > 0 then
                        local d = (vector2_new(sp.X, sp.Y) - center).Magnitude
                        if d < bestAnyDist then
                            bestAny, bestAnyDist = p, d
                        end
                        if d < bestVisDist and checkLineOfSight(camPos, pos, char) then
                            bestVis, bestVisDist = p, d
                        end
                    end
                end
            end
        end
    end
    return bestVis or bestAny
end
function Aim:GetSilentDirection(origin, opts)
    if not self.Config.Enabled or not self.Config.SilentAim then
        return nil, nil, nil
    end

    local chance = self.Config.HitChance or 100
    if chance < 100 and math_random(1, 100) > chance then
        return nil, nil, nil
    end

    local part, targetPos, player = self:GetTarget("SilentAim")
    if not part or not targetPos then
        return nil, nil, nil
    end

    local cam = getCamera()
    local camPos = cam and cam.CFrame.Position or vector3_zero
    local muzzlePos = origin or camPos

    local o = opts or {}
    local doPredict = o.Predict or self.Config.PredictMovement
    if doPredict and part then
        local vel = part.AssemblyLinearVelocity or part.Velocity or vector3_zero
        local speed = tonumber(o.Speed) or 2000
        local dist = (targetPos - muzzlePos).Magnitude
        local flyTime = dist / math_max(speed, 10)
        local lead = vector3_new(vel.X, vel.Y * 0.35, vel.Z) * flyTime
        if lead.Magnitude > 3.0 then lead = lead.Unit * 3.0 end
        targetPos = targetPos + lead
    end

    local dir = (targetPos - muzzlePos).Unit

    if cam then
        local camLook = cam.CFrame.LookVector
        local dot = math_clamp(camLook:Dot(dir), -1, 1)
        local angleDeg = math_deg(math_acos(dot))
        local maxAngle = self.Config.MaxSilentAngle or 30
        if angleDeg > maxAngle then
            return nil, nil, nil
        end
    end

    return dir, targetPos, player
end

function Aim:GetSilentTarget()
    local part, targetPos, player = self:GetTarget("SilentAim")
    return part, targetPos, player
end

local function syncFovCircle()
    local cfg = Aim.Config
    local follow = getAimCenter

    local showAimbot = (cfg.DrawAimbotFov or (cfg.DrawFov and (cfg.Aimbot or not cfg.SilentAim))) and cfg.Enabled and not Library.Unloaded
    local aimRadius = cfg.AimbotFovRadius or cfg.FovRadius or 120
    local aimColor = cfg.AimbotFovColor or Color3.fromRGB(100, 185, 255)

    if showAimbot then
        if not aimbotFovCircle then
            aimbotFovCircle = Draw.FOVCircle({
                Radius = aimRadius,
                Follow = follow,
                Color = aimColor,
                Thickness = 1,
                Outline = true,
                Visible = true,
            })
        else
            aimbotFovCircle:Set({
                Radius = aimRadius,
                Color = aimColor,
                Follow = follow,
                Visible = true,
            })
        end
    elseif aimbotFovCircle then
        aimbotFovCircle:SetVisible(false)
    end

    local showSilent = (cfg.DrawSilentFov or (cfg.DrawFov and cfg.SilentAim)) and cfg.Enabled and not Library.Unloaded
    local silentRadius = cfg.SilentFovRadius or 160
    local silentColor = cfg.SilentFovColor or Color3.fromRGB(255, 85, 85)

    if showSilent then
        if not silentFovCircle then
            silentFovCircle = Draw.FOVCircle({
                Radius = silentRadius,
                Follow = follow,
                Color = silentColor,
                Thickness = 1,
                Outline = true,
                Visible = true,
            })
        else
            silentFovCircle:Set({
                Radius = silentRadius,
                Color = silentColor,
                Follow = follow,
                Visible = true,
            })
        end
    elseif silentFovCircle then
        silentFovCircle:SetVisible(false)
    end
end

local gcCamCache = nil
local gcCamNextScan = 0
local gcCamMisses = 0

local function isLiveCameraObject(o, cam)
    if type(o) ~= "table" or rawget(o, "_camera") ~= cam then return false end
    if type(rawget(o, "_yaw")) ~= "number" or type(rawget(o, "_pitch")) ~= "number" then return false end
    local ch = rawget(o, "_character")
    if ch ~= nil and ch ~= Players.LocalPlayer.Character then return false end
    return true
end

local function findCameraByGc()
    local cam = workspace.CurrentCamera
    local c = gcCamCache
    if c and isLiveCameraObject(c, cam) then
        return c
    end
    gcCamCache = nil
    local now = os.clock()
    if now < gcCamNextScan or not getgc then return nil end
    gcCamNextScan = now + math.min(0.25 * (2 ^ gcCamMisses), 20) -- back off: getgc is heavy on phones
    gcCamMisses = gcCamMisses + 1
    local ok, list = pcall(getgc, true)
    if not ok or type(list) ~= "table" then return nil end
    for _, o in ipairs(list) do
        if isLiveCameraObject(o, cam) then
            local mt = getmetatable(o)
            local idx = mt and mt.__index
            if type(idx) == "table" and type(idx.AddViewAngles) == "function" then
                gcCamCache = o
                gcCamMisses = 0
                return o
            end
        end
    end
    return nil
end

local function getActiveTpsCamera()
    local lp = Players.LocalPlayer
    local ps = lp and (lp:FindFirstChild("PlayerScripts") or lp.PlayerScripts)
    local feat = ps and ps:FindFirstChild("Features")
    local mov = feat and feat:FindFirstChild("Movement")
    local mc = mov and mov:FindFirstChild("MovementController")
    if mc and mc:IsA("ModuleScript") then
        local ok, mod = pcall(Util.requireModule, mc)
        if ok and mod and type(mod.GetCamera) == "function" then
            local camObj = mod:GetCamera()
            if camObj and type(camObj.AddViewAngles) == "function" then
                return camObj
            end
        end
    end
    return findCameraByGc()
end

local function getActiveWarzCamera()
    local lp = Players.LocalPlayer
    local ps = lp and (lp:FindFirstChild("PlayerScripts") or lp.PlayerScripts)
    local clientFolder = ps and ps:FindFirstChild("Client")
    local worldFolder = clientFolder and clientFolder:FindFirstChild("world")
    local warzCam = worldFolder and worldFolder:FindFirstChild("WarzCamera")
    if warzCam and warzCam:IsA("ModuleScript") then
        local ok, mod = pcall(Util.requireModule, warzCam)
        if ok and type(mod) == "table" and type(mod.AddLookDelta) == "function" then
            return mod
        end
    end
    return nil
end

local lookPrefsCache = nil

local function getWarzLookSensitivity()
    if lookPrefsCache == nil then
        lookPrefsCache = false
        local lp = Players.LocalPlayer
        local ps = lp and lp:FindFirstChild("PlayerScripts")
        local client = ps and ps:FindFirstChild("Client")
        local input = client and client:FindFirstChild("input")
        local mod = input and input:FindFirstChild("LookPrefs")
        if mod and mod:IsA("ModuleScript") then
            local ok, res = pcall(Util.requireModule, mod)
            if ok and type(res) == "table" and type(res.Get) == "function" then lookPrefsCache = res end
        end
    end
    local sens = 1
    if lookPrefsCache then
        local ok, prefs = pcall(lookPrefsCache.Get)
        if ok and type(prefs) == "table" and tonumber(prefs.sens) then sens = tonumber(prefs.sens) end
    end
    return 0.0034 * sens
end

Aim:RegisterAdapter("WarZ", {
    Match = function() return getActiveWarzCamera() ~= nil end,
    SendLook = function(yawStep, pitchStep)
        local cam = getActiveWarzCamera()
        if not cam then return false end
        local sens = getWarzLookSensitivity()
        cam.AddLookDelta(-yawStep / sens, -pitchStep / sens)
    end,
})

Aim:RegisterAdapter("ViewAngles", {
    Match = function() return getActiveTpsCamera() ~= nil end,
    SendLook = function(yawStep, pitchStep)
        local cam = getActiveTpsCamera()
        if not cam then return false end
        cam:AddViewAngles(-math.deg(yawStep), math.deg(pitchStep))
    end,
})

local silentUninstall, silentInstalledFor = nil, nil
local function syncSilentAdapter()
    local cfg = Aim.Config
    local ad = getAdapter()
    local want = cfg.Enabled and cfg.SilentAim and ad and type(ad.InstallSilent) == "function" and not Library.Unloaded
    if silentUninstall and (not want or silentInstalledFor ~= ad) then
        pcall(silentUninstall)
        silentUninstall, silentInstalledFor = nil, nil
    end
    if want and not silentUninstall then
        local ok, un = pcall(ad.InstallSilent, function(origin, opts) return Aim:GetSilentDirection(origin, opts) end)
        if ok and type(un) == "function" then
            silentUninstall, silentInstalledFor = un, ad
        end
    end
end

local function stepAimbot(dt)
    if Library.Unloaded or not Aim.Config.Enabled then
        Aim:Disable()
        return
    end

    local lp = Players.LocalPlayer
    if not isPlayerAlive(lp) then
        Aim.LockedPlayer = nil
        Aim.LockedPart = nil
        return
    end

    if Aim.Config.Aimbot and Aim:IsTriggered() then
        local part, targetPos, targetPlayer = Aim:GetTarget("Aimbot")
        if part and targetPos and targetPlayer then
            local cam = getCamera()
            if cam then
                local cf = cam.CFrame
                local finalPos = targetPos
                if Aim.Config.PredictMovement then
                    local vel = part.AssemblyLinearVelocity or part.Velocity or vector3_zero
                    local horizVel = vector3_new(vel.X, math_max(0, vel.Y * 0.4), vel.Z)
                    local lead = horizVel * math_clamp(dt * 0.8, 0, 0.04)
                    if lead.Magnitude > 1.8 then lead = lead.Unit * 1.8 end
                    finalPos = finalPos + lead
                end

                local dir = finalPos - cf.Position
                if dir.Magnitude > 0.1 then
                    dir = dir.Unit
                    local loc = cf:VectorToObjectSpace(dir)
                    local yawErr = math.atan2(-loc.X, -loc.Z)
                    local pitchErr = math.asin(math_clamp(loc.Y, -1, 1))

                    local s = math_max(1, Aim.Config.Smoothness or 1)
                    local isInstant = (s <= 1.05)
                    local f = isInstant and 1 or 1 - (1 - 1 / s) ^ (math_min(dt or 1 / 60, 0.1) * 60)
                    local yawStep, pitchStep = yawErr * f, pitchErr * f

                    if not isInstant then
                        local step = math.sqrt(yawStep * yawStep + pitchStep * pitchStep)
                        local cap = math.rad(150) * math_min(dt or 1 / 60, 0.05)
                        if step > cap and step > 0 then
                            yawStep = yawStep * cap / step
                            pitchStep = pitchStep * cap / step
                        end
                    end

                    if yawStep ~= 0 or pitchStep ~= 0 then
                        local handled = false
                        local ad = getAdapter()
                        if ad and type(ad.SendLook) == "function" then
                            local ok, res = pcall(ad.SendLook, yawStep, pitchStep, cam)
                            handled = ok and res ~= false
                        end
                        if not handled then
                            local currentYaw = math.atan2(-cf.LookVector.X, -cf.LookVector.Z)
                            local currentPitch = math.asin(math_clamp(cf.LookVector.Y, -1, 1))
                            local newYaw = currentYaw + yawStep
                            local newPitch = math_clamp(currentPitch + pitchStep, -math.rad(85), math.rad(85))
                            cam.CFrame = CFrame.new(cf.Position) * CFrame.Angles(0, newYaw, 0) * CFrame.Angles(newPitch, 0, 0)
                        end
                    end
                end
            end
        else
            if not Aim.Config.StickyLock or not Aim:IsTriggered() then
                Aim.LockedPlayer = nil
                Aim.LockedPart = nil
            end
        end
    else
        if not Aim.Config.StickyLock or not Aim:IsTriggered() then
            Aim.LockedPlayer = nil
            Aim.LockedPart = nil
        end
    end
end

local function bindAimbotLoop()
    if isBoundToRender then return end
    if RunService.BindToRenderStep then
        local priority = Enum.RenderPriority.Last.Value
        local ok = pcall(function()
            RunService:BindToRenderStep(AIMBOT_RENDER_STEP, priority, stepAimbot)
        end)
        if ok then
            isBoundToRender = true
            return
        end
    end
    if not renderConn then
        renderConn = RunService.RenderStepped:Connect(stepAimbot)
    end
end

local function unbindAimbotLoop()
    if isBoundToRender then
        pcall(function()
            RunService:UnbindFromRenderStep(AIMBOT_RENDER_STEP)
        end)
        isBoundToRender = false
    end
    if renderConn then
        renderConn:Disconnect()
        renderConn = nil
    end
end

local function syncLoop()
    local cfg = Aim.Config
    local needLoop = cfg.Enabled and cfg.Aimbot
    if needLoop then
        bindAimbotLoop()
    else
        unbindAimbotLoop()
    end

    if cfg.Enabled and not inputBeganConn then
        inputBeganConn = UserInputService.InputBegan:Connect(function(input, gpe)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                rightClickHeld = true
            elseif input.UserInputType == Enum.UserInputType.Touch then
                activeTouches[input] = true
            end
            if gpe or not Aim.Config.Enabled then return end
            if input.KeyCode == Aim.Config.Keybind then
                Aim.KeybindActive = true
            end
        end)
        inputEndedConn = UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton2 then
                rightClickHeld = false
            elseif input.UserInputType == Enum.UserInputType.Touch then
                activeTouches[input] = nil
            end
            if input.KeyCode == Aim.Config.Keybind then
                Aim.KeybindActive = false
            end
        end)
    elseif not cfg.Enabled and inputBeganConn then
        inputBeganConn:Disconnect() inputBeganConn = nil
        inputEndedConn:Disconnect() inputEndedConn = nil
        Aim.KeybindActive = false
        rightClickHeld = false
    end

    syncFovCircle()
    syncSilentAdapter()
end

function Aim:Set(opts)
    if type(opts) ~= "table" then return self end
    for k, v in pairs(opts) do
        self.Config[k] = v
    end
    if opts.TargetBone or opts.SilentTargetBone then
        self.LockedPart = nil
    end
    syncLoop()
    return self
end

local TRIGGERS = {
    ["Holding weapon"] = "When Holding Weapon",
    ["When firing"] = "When Firing",
    ["Right click"] = "Hold Right Click",
    ["Hold key"] = "Keybind",
    ["Always"] = "Always",
    ["Touch hold"] = "Touch / Screen Hold",
}

function Aim:BuildAimbotMenu(section, opts)
    opts = opts or {}
    local prefix = opts.Flag or "B3Aimbot"
    local cfg = self.Config
    local function refresh(extra)
        extra = extra or {}
        extra.Enabled = (cfg.Aimbot or cfg.SilentAim or cfg.DrawAimbotFov or cfg.DrawSilentFov) and true or false
        Aim:Set(extra)
    end

    section:Toggle({
        Name = "Aimbot", Flag = prefix .. "_Enabled", Default = cfg.Aimbot,
        Translate = true,
        Callback = function(v) cfg.Aimbot = v and true or false refresh() end,
    })
    section:Dropdown({
        Name = "Target", Flag = prefix .. "_Bone", Items = { "Head", "Torso", "Closest" }, Default = cfg.TargetBone or "Head",
        Translate = true,
        Compact = true, Size = 100,
        Callback = function(v) Aim:Set({ TargetBone = v }) end,
    })

    local touchOnly = Library.IsMobile or (UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled)
    local items = touchOnly and { "Holding weapon", "When firing", "Touch hold", "Always" }
        or { "Holding weapon", "When firing", "Right click", "Hold key", "Always" }
    local triggerName = items[1]
    for _, name in ipairs(items) do
        if TRIGGERS[name] == cfg.Trigger then triggerName = name end
    end
    cfg.Trigger = TRIGGERS[triggerName]
    cfg.Keybind = false

    local keyRow
    section:Dropdown({
        Name = "Aim when", Flag = prefix .. "_Trigger", Items = items,
        Translate = true,
        Default = triggerName, Compact = true, Size = 135,
        Callback = function(v)
            if TRIGGERS[v] then Aim:Set({ Trigger = TRIGGERS[v] }) end
            if keyRow then keyRow.Visible = (v == "Hold key") end
        end,
    })
    if not touchOnly then
        local aimKey = section:Keybind({
            Name = "Aim key", Flag = prefix .. "_Key", Default = Enum.KeyCode.E, Mode = "Hold", ShowModes = false,
            Translate = true,
            Callback = function(active) Aim.KeybindActive = active and true or false end,
        })
        keyRow = aimKey and aimKey.Items and aimKey.Items.Label and aimKey.Items.Label.Instance
        if keyRow then keyRow.Visible = (triggerName == "Hold key") end
    end

    local cam = getCamera()
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local maxFov = math.max(200, math.floor(math.min(vp.X, vp.Y) * 0.5))

    section:Slider({
        Name = "FOV", Flag = prefix .. "_FOV", Min = 15, Max = maxFov, Default = math.clamp(cfg.AimbotFovRadius or 120, 15, maxFov), Suffix = " px",
        Translate = true,
        Callback = function(v) Aim:Set({ AimbotFovRadius = v, FovRadius = v }) end,
    })
    section:Slider({
        Name = "Smoothness", Flag = prefix .. "_Smooth", Min = 1, Max = 20, Default = cfg.Smoothness or 2, Decimals = 1, Suffix = "x",
        Translate = true,
        Callback = function(v) Aim:Set({ Smoothness = v }) end,
    })
    section:Toggle({
        Name = "Wall check", Flag = prefix .. "_Wall", Default = cfg.WallCheck,
        Translate = true,
        Callback = function(v) Aim:Set({ WallCheck = v and true or false }) end,
    })
    local fovToggle = section:Toggle({
        Name = "Show FOV circle", Flag = prefix .. "_Draw", Default = cfg.DrawAimbotFov,
        Translate = true,
        Callback = function(v) cfg.DrawAimbotFov = v and true or false refresh() end,
    })
    fovToggle:SubColorpicker({
        Flag = prefix .. "_FovColor", Default = cfg.AimbotFovColor or Color3.fromRGB(100, 185, 255),
        Callback = function(c) Aim:Set({ AimbotFovColor = c }) end,
    })
    return self
end

function Aim:BuildSilentAimMenu(section, opts)
    opts = opts or {}
    local prefix = opts.Flag or "B3Silent"
    local cfg = self.Config
    local function refresh(extra)
        extra = extra or {}
        extra.Enabled = (cfg.Aimbot or cfg.SilentAim or cfg.DrawAimbotFov or cfg.DrawSilentFov) and true or false
        Aim:Set(extra)
    end

    section:Toggle({
        Name = "Silent aim", Flag = prefix .. "_Enabled", Default = cfg.SilentAim,
        Translate = true,
        Callback = function(v) cfg.SilentAim = v and true or false refresh() end,
    })
    section:Dropdown({
        Name = "Target", Flag = prefix .. "_Bone", Items = { "Head", "Torso", "Closest" }, Default = cfg.SilentTargetBone or cfg.TargetBone or "Head",
        Translate = true,
        Compact = true, Size = 100,
        Callback = function(v) Aim:Set({ SilentTargetBone = v }) end,
    })
    local cam = getCamera()
    local vp = cam and cam.ViewportSize or Vector2.new(1280, 720)
    local maxFov = opts.MaxFov or cfg.MaxSilentFov or math.max(200, math.floor(math.min(vp.X, vp.Y) * 0.5))
    local minFov = math.min(15, maxFov)

    section:Slider({
        Name = "FOV", Flag = prefix .. "_FOV", Min = minFov, Max = maxFov, Default = math.clamp(cfg.SilentFovRadius or 160, minFov, maxFov), Suffix = " px",
        Translate = true,
        Callback = function(v) Aim:Set({ SilentFovRadius = v }) end,
    })
    section:Slider({
        Name = "Hit chance", Flag = prefix .. "_Hit", Min = 10, Max = 100, Default = cfg.HitChance or 100, Suffix = "%",
        Translate = true,
        Callback = function(v) Aim:Set({ HitChance = v }) end,
    })
    section:Toggle({
        Name = "Wall check", Flag = prefix .. "_Wall", Default = cfg.SilentWallCheck ~= nil and cfg.SilentWallCheck or cfg.WallCheck,
        Translate = true,
        Callback = function(v) Aim:Set({ SilentWallCheck = v and true or false }) end,
    })
    local fovToggle = section:Toggle({
        Name = "Show FOV circle", Flag = prefix .. "_Draw", Default = cfg.DrawSilentFov,
        Translate = true,
        Callback = function(v) cfg.DrawSilentFov = v and true or false refresh() end,
    })
    fovToggle:SubColorpicker({
        Flag = prefix .. "_FovColor", Default = cfg.SilentFovColor or Color3.fromRGB(180, 100, 255),
        Callback = function(c) Aim:Set({ SilentFovColor = c }) end,
    })
    return self
end

function Aim:BuildMenu(section, arg2, opts)
    if type(arg2) == "table" and arg2.Elements ~= nil then
        self:BuildAimbotMenu(section, opts)
        self:BuildSilentAimMenu(arg2, opts)
        return self
    end
    opts = (type(arg2) == "table") and arg2 or (opts or {})
    if opts.Mode == "Silent" or opts.Mode == "SilentAim" then
        return self:BuildSilentAimMenu(section, opts)
    end
    return self:BuildAimbotMenu(section, opts)
end
function Aim:Enable(opts)
    self.Config.Enabled = true
    if opts then
        for k, v in pairs(opts) do self.Config[k] = v end
    end
    syncLoop()
    return self
end

function Aim:Disable()
    self.Config.Enabled = false
    self.LockedPlayer = nil
    self.LockedPart = nil
    self.KeybindActive = false
    rightClickHeld = false
    table.clear(activeTouches)
    syncLoop()
    return self
end

function Aim:Clear()
    self.LockedPlayer = nil
    self.LockedPart = nil
    self.KeybindActive = false
    rightClickHeld = false
    table.clear(activeTouches)
    if aimbotFovCircle then
        aimbotFovCircle:Remove()
        aimbotFovCircle = nil
    end
    if silentFovCircle then
        silentFovCircle:Remove()
        silentFovCircle = nil
    end
    unbindAimbotLoop()
    if inputBeganConn then
        inputBeganConn:Disconnect() inputBeganConn = nil
        inputEndedConn:Disconnect() inputEndedConn = nil
    end
end

Library.Maid:Give(function()
    Aim:Clear()
end)

return Aim
]]

__sources["core/Config"] = [[
local Services = require("core/Services")
local Library = require("core/Library")
local Util = require("core/Util")

local FS = Util.FS
local Config = {}

local function cleanName(name)
    name = tostring(name or "")
    name = string.gsub(name, "[\\\\/:*?\"<>|]", "")
    name = string.gsub(name, "^%s+", "")
    name = string.gsub(name, "%s+$", "")
    if name == "" or name == "." or name == ".." then return nil end
    return name
end

local function encodeValue(value)
    local kind = typeof(value)
    if kind == "Color3" then
        return { Color = "#" .. value:ToHex() }
    elseif kind == "EnumItem" then
        return { Enum = tostring(value) }
    elseif type(value) == "table" then
        if value.Key ~= nil or value.Mode ~= nil then
            return { Key = value.Key and tostring(value.Key) or "None", Mode = value.Mode or "Toggle" }
        elseif value.Color ~= nil and typeof(value.Color) == "Color3" then
            return { Color = "#" .. value.Color:ToHex(), Alpha = value.Alpha or 0, Rainbow = value.Rainbow or nil }
        end
        local copy = {}
        for k, v in pairs(value) do
            if type(v) == "string" or type(v) == "number" or type(v) == "boolean" then
                copy[k] = v
            end
        end
        return copy
    elseif kind == "number" or kind == "string" or kind == "boolean" then
        return value
    end
    return nil
end

function Library:GetConfig()
    local data = {}
    for flag, value in pairs(Library.Flags) do
        if not Library.NoSaveFlags[flag] and Library.SetFlags[flag] then
            local encoded = encodeValue(value)
            if encoded ~= nil then
                data[flag] = encoded
            end
        end
    end
    return Services.HttpService:JSONEncode(data)
end

function Library:LoadConfig(json)
    local ok, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, json)
    if not ok or type(decoded) ~= "table" then
        return false, "invalid config"
    end
    Library.LoadingConfig = true
    local Theme = Library.ThemeModule
    for _, flag in ipairs({ "AccentColor", "AccentGradientColor" }) do
        local saved = decoded[flag]
        if Theme and type(saved) == "table" and type(saved.Color) == "string" then
            local ok, color = pcall(Color3.fromHex, (string.gsub(saved.Color, "#", "")))
            if ok and Theme.isLegacyAccent(color) then decoded[flag] = nil end
        end
    end
    for flag, value in pairs(decoded) do
        local setter = Library.SetFlags[flag]
        if setter and not Library.NoSaveFlags[flag] then
            local success, err = pcall(function()
                if type(value) == "table" and value.Color ~= nil then
                    setter(value.Color, value.Alpha, value.Rainbow)
                elseif type(value) == "table" and value.Enum ~= nil then
                    setter(value.Enum)
                else
                    setter(value)
                end
            end)
            if not success then
                warn("[B3] failed to load flag " .. tostring(flag) .. ": " .. tostring(err))
            end
        end
    end
    Library.LoadingConfig = false
    return true
end

function Config.path(name)
    name = cleanName(name)
    if not name then return nil end
    if not string.find(string.lower(name), "%.json$") then
        name = name .. ".json"
    end
    return Library.Folders.Configs .. "/" .. name
end

function Config.list()
    local list = {}
    if not FS.isfolder(Library.Folders.Configs) then return list end
    for _, file in ipairs(FS.list(Library.Folders.Configs)) do
        local name = string.match(file, "[^/\\]+$")
        if name and string.lower(string.sub(name, -5)) == ".json" then
            table.insert(list, name)
        end
    end
    table.sort(list)
    return list
end

function Config.save(name)
    local path = Config.path(name)
    if not path then return false, nil end
    FS.ensureFolder(Library.Folders.Configs)
    return FS.write(path, Library:GetConfig()), path
end

function Config.load(name)
    local path = Config.path(name)
    if not path then return false end
    local content = FS.read(path)
    if not content then return false end
    return Library:LoadConfig(content)
end

function Config.delete(name)
    local path = Config.path(name)
    return path and FS.delete(path) or false
end

function Config.getAutoload()
    local content = FS.read(Library.Folders.Configs .. "/autoload.txt")
    if not content or content == "" then return nil end
    return string.match(content, "[^/\\]+$")
end

function Config.setAutoload(name)
    FS.ensureFolder(Library.Folders.Configs)
    if name then
        local clean = cleanName(name)
        if not clean then return false end
        return FS.write(Library.Folders.Configs .. "/autoload.txt", clean)
    else
        return FS.delete(Library.Folders.Configs .. "/autoload.txt")
    end
end

function Config.getSilentLoad()
    return FS.read(Library.Folders.Configs .. "/silentload.txt") == "true"
end

function Config.setSilentLoad(value)
    FS.ensureFolder(Library.Folders.Configs)
    if value then
        FS.write(Library.Folders.Configs .. "/silentload.txt", "true")
    else
        FS.delete(Library.Folders.Configs .. "/silentload.txt")
    end
end

function Config.getSavedFont()
    local name = FS.read(Library.Folders.Configs .. "/font.txt")
    if name and name ~= "" and Library.Fonts[name] then
        return name
    end
    return nil
end

function Config.setSavedFont(name)
    FS.ensureFolder(Library.Folders.Configs)
    if name and Library.Fonts[name] then
        FS.write(Library.Folders.Configs .. "/font.txt", name)
    else
        FS.delete(Library.Folders.Configs .. "/font.txt")
    end
end

function Config.applySavedFont()
    local savedFont = Config.getSavedFont()
    if savedFont and Library.Fonts[savedFont] then
        Library.Font = Library.Fonts[savedFont]
        Library.FontName = savedFont
    end
end
Config.applySavedFont()

function Config.getLastPage()
    local name = FS.read(Library.Folders.Configs .. "/lastpage.txt")
    if name and name ~= "" then return name end
    return nil
end

function Config.setLastPage(name)
    if not name or name == "" then return end
    FS.ensureFolder(Library.Folders.Configs)
    FS.write(Library.Folders.Configs .. "/lastpage.txt", tostring(name))
end

function Config.getMiniIconPosition()
    local text = FS.read(Library.Folders.Configs .. "/miniicon.txt")
    local x, y = string.match(text or "", "^(%-?%d+),(%-?%d+)$")
    if x then return Vector2.new(tonumber(x), tonumber(y)) end
    return nil
end

function Config.setMiniIconPosition(x, y)
    FS.ensureFolder(Library.Folders.Configs)
    FS.write(Library.Folders.Configs .. "/miniicon.txt", string.format("%d,%d", math.floor(x), math.floor(y)))
end

Config.AutoSave = false
Config.AutoSaveTarget = nil
local autoSaveThread = nil

function Config.getAutosave()
    return FS.read(Library.Folders.Configs .. "/autosave.txt") ~= "false"
end

function Config.setAutosave(value)
    FS.ensureFolder(Library.Folders.Configs)
    FS.write(Library.Folders.Configs .. "/autosave.txt", value and "true" or "false")
    Config.AutoSave = value and true or false
end

function Config.getActive()
    return Config.getAutoload() or "Default"
end

function Config.setActive(name)
    return Config.setAutoload(name)
end

function Config.requestAutoSave()
    if not Config.AutoSave then return end
    local target = Config.AutoSaveTarget or Config.getActive()
    if not target or target == "" or target == "--" then return end
    if autoSaveThread then
        task.cancel(autoSaveThread)
    end
    autoSaveThread = task.delay(0.8, function()
        if not Library.Unloaded and Config.AutoSave then
            local currentTarget = Config.AutoSaveTarget or Config.getActive()
            if currentTarget and currentTarget ~= "" and currentTarget ~= "--" then
                if Config.save(currentTarget) and Config.OnSaved then
                    pcall(Config.OnSaved, currentTarget)
                end
            end
        end
    end)
end

Library.OnFlagChanged = function(flag, value)
    if Library.LoadingConfig then return end
    if not Library.NoSaveFlags[flag] then
        Config.requestAutoSave()
    end
end

function Library:DeleteConfig(name)
    return Config.delete(name)
end

function Library:SaveConfig(name)
    return Config.save(name)
end

function Library:LoadConfigFile(name)
    return Config.load(name)
end

function Library:RefreshConfigsList(element)
    if element and element.Refresh then
        element:Refresh(Config.list())
    end
end

Library.ConfigManager = Config
return Config
]]

__sources["core/Create"] = [[
local Theme = require("core/Theme")
local Library = require("core/Library")
local Locale = require("core/Locale")

local Defaults = {
    Frame = { BorderSizePixel = 0 },
    ScrollingFrame = { BorderSizePixel = 0, BackgroundTransparency = 1, ScrollBarThickness = 2, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y },
    TextLabel = { BorderSizePixel = 0, BackgroundTransparency = 1, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left },
    TextButton = { BorderSizePixel = 0, AutoButtonColor = false, Text = "", TextSize = 14 },
    TextBox = { BorderSizePixel = 0, ClearTextOnFocus = false, Text = "", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left },
    ImageLabel = { BorderSizePixel = 0, BackgroundTransparency = 1 },
    ImageButton = { BorderSizePixel = 0, AutoButtonColor = false },
}

local TextClasses = { TextLabel = true, TextButton = true, TextBox = true }

local MIN_FIT_SIZE = 10

local function fitText(instance)
    local base = instance.TextSize
    local busy = false
    local lastSet = nil -- deferred TextSize signals for our own changes must not reset base
    local function refit()
        if busy or instance.Parent == nil then return end
        busy = true
        local scale = math.max(Library.PopupScale or 1, 0.01)
        local width = instance.AbsoluteSize.X / scale
        local padding = instance:FindFirstChildOfClass("UIPadding")
        if padding then
            width = width - padding.PaddingLeft.Offset - padding.PaddingRight.Offset
        end
        if width > 0 then
            local size = base
            instance.TextSize = size
            while size > MIN_FIT_SIZE and instance.TextBounds.X > width + 0.5 do
                size = size - 1
                instance.TextSize = size
            end
            lastSet = size
        end
        busy = false
    end
    instance:GetPropertyChangedSignal("TextSize"):Connect(function()
        if not busy and instance.TextSize ~= lastSet then
            base = instance.TextSize
            refit()
        end
    end)
    instance:GetPropertyChangedSignal("Text"):Connect(refit)
    instance:GetPropertyChangedSignal("AbsoluteSize"):Connect(refit)
    instance:GetPropertyChangedSignal("FontFace"):Connect(refit)
    task.defer(refit)
end

local function New(className, props, children)
    Library._ensureIdentity()
    local instance = Instance.new(className)
    local defaults = Defaults[className]
    if defaults then
        for k, v in pairs(defaults) do
            instance[k] = v
        end
    end
    if TextClasses[className] then
        instance.AutoLocalize = false
        instance.FontFace = Library.Font
    end

    local parent
    local fitWanted = false
    if props then
        for key, value in pairs(props) do
            if key == "Parent" then
                parent = value
            elseif key == "FontFace" then
                instance.FontFace = value
                instance:SetAttribute("ExplicitFont", true)
            elseif key == "TextTruncate" and value == Enum.TextTruncate.AtEnd then
                instance.TextTruncate = Enum.TextTruncate.None
                fitWanted = true
            elseif key == "Theme" then
                Theme.bind(instance, value)
            elseif key == "Translate" then
                for property, text in pairs(value) do
                    Locale.bind(instance, property, text)
                end
            elseif key == "Corner" then
                local corner = Instance.new("UICorner")
                corner.CornerRadius = (typeof(value) == "UDim") and value or UDim.new(0, value)
                corner.Parent = instance
            elseif key == "Stroke" then
                local stroke = Instance.new("UIStroke")
                stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
                stroke.Thickness = value.Thickness or 1
                stroke.Transparency = value.Transparency or 0
                if type(value.Color) == "string" then
                    Theme.bind(stroke, { Color = value.Color })
                elseif value.Color then
                    stroke.Color = value.Color
                end
                stroke.Parent = instance
            elseif key == "Padding" then
                if className == "UIListLayout" then
                    instance.Padding = (typeof(value) == "UDim") and value or UDim.new(0, tonumber(value) or 0)
                else
                    local padding = Instance.new("UIPadding")
                    if type(value) == "number" then
                        local u = UDim.new(0, value)
                        padding.PaddingTop, padding.PaddingBottom, padding.PaddingLeft, padding.PaddingRight = u, u, u, u
                    elseif typeof(value) == "UDim" then
                        padding.PaddingTop, padding.PaddingBottom, padding.PaddingLeft, padding.PaddingRight = value, value, value, value
                    elseif type(value) == "table" then
                        padding.PaddingTop = UDim.new(0, value.Top or 0)
                        padding.PaddingBottom = UDim.new(0, value.Bottom or 0)
                        padding.PaddingLeft = UDim.new(0, value.Left or 0)
                        padding.PaddingRight = UDim.new(0, value.Right or 0)
                    end
                    padding.Parent = instance
                end
            elseif key == "List" then
                local layout = Instance.new("UIListLayout")
                layout.SortOrder = Enum.SortOrder.LayoutOrder
                layout.Padding = UDim.new(0, value.Padding or 0)
                if value.Horizontal then
                    layout.FillDirection = Enum.FillDirection.Horizontal
                end
                if value.HAlign then layout.HorizontalAlignment = value.HAlign end
                if value.VAlign then layout.VerticalAlignment = value.VAlign end
                if value.HFlex then layout.HorizontalFlex = value.HFlex end
                if value.VFlex then layout.VerticalFlex = value.VFlex end
                layout.Parent = instance
            else
                instance[key] = value
            end
        end
    end

    if children then
        for _, child in ipairs(children) do
            child.Parent = instance
        end
    end

    if parent then
        Library._setParent(instance, parent)
    end
    if fitWanted then fitText(instance) end
    return instance
end

return New
]]

__sources["core/Draw"] = [[
local Services = require("core/Services")
local Library = require("core/Library")
local Gui = require("core/Gui")

local Draw = {}

local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.new(0, 0, 0)
local ZERO = Vector2.new(0, 0)

local DEFAULTS = {
    Line = { Color = WHITE, Transparency = 1, Thickness = 1, ZIndex = 1, From = ZERO, To = ZERO },
    Square = { Color = WHITE, Transparency = 1, Thickness = 1, ZIndex = 1, Position = ZERO, Size = ZERO, Filled = false },
    Circle = { Color = WHITE, Transparency = 1, Thickness = 1, ZIndex = 1, Position = ZERO, Radius = 0, Filled = false, NumSides = 48 },
    Text = { Color = WHITE, Transparency = 1, ZIndex = 1, Position = ZERO, Text = "", Size = 13, Center = false,
        Outline = false, OutlineColor = BLACK, Font = 2 },
}
Draw.Defaults = DEFAULTS

local requested = "Auto"
local active = nil -- resolved backend name, nil until the first object is made

local function genv()
    return (typeof(getgenv) == "function") and getgenv() or _G
end

local function drawingWorks()
    local kind = typeof(Drawing)
    if kind ~= "table" and kind ~= "userdata" then return false end
    if type(Drawing.new) ~= "function" then return false end
    local ok = pcall(function()
        local probe = Drawing.new("Line")
        probe.Visible = false
        probe:Remove()
    end)
    return ok
end

local function resolve()
    local want = requested
    local forced = genv().B3_DRAW_BACKEND
    if want == "Auto" and (forced == "Drawing" or forced == "Gui") then
        want = forced
    end
    if want == "Drawing" then
        return drawingWorks() and "Drawing" or "Gui"
    end
    if want == "Gui" then return "Gui" end
    return drawingWorks() and "Drawing" or "Gui"
end

local function backend()
    if not active then active = resolve() end
    return active
end

local layer = nil
local rebuildAll -- forward

local function getLayer()
    if layer and layer.Parent then return layer end
    local hadLayer = layer ~= nil
    layer = Gui.newLayer(50)
    if hadLayer then rebuildAll("Gui") end
    return layer
end
Draw.getLayer = getLayer

local function z(n) return math.clamp(math.floor(tonumber(n) or 1), -1000, 1000) end

local function newFrame()
    local f = Instance.new("Frame")
    f.BorderSizePixel = 0
    f.Visible = false
    return f
end

local function newStroke(parent, sharpCorners)
    local s = Instance.new("UIStroke")
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    if sharpCorners then
        pcall(function() s.LineJoinMode = Enum.LineJoinMode.Miter end)
    end
    s.Parent = parent
    return s
end

local GuiShapes = {}
local dirty = {}
local flushQueued = false

local function flush()
    flushQueued = false
    for shape in pairs(dirty) do
        dirty[shape] = nil
        shape.queued = false
        if shape.dead then
        elseif shape.p.Visible then
            local ok, err = pcall(shape.layout, shape.p)
            if not ok then warn("[B3] Draw layout error: " .. tostring(err)) end
        else
            shape.stale = true
        end
    end
end
Draw.flush = flush

local function queue(shape)
    if shape.queued then return end
    shape.queued = true
    dirty[shape] = true
    if not flushQueued then
        flushQueued = true
        task.defer(flush)
    end
end

local function round(n) return math.floor(n + 0.5) end

local function placer(f)
    local last = {}
    return function(x, y, w, h, rotation)
        x, y, w, h = round(x), round(y), round(w), round(h)
        if last.x ~= x or last.y ~= y then
            last.x, last.y = x, y
            f.Position = UDim2.fromOffset(x, y)
        end
        if last.w ~= w or last.h ~= h then
            last.w, last.h = w, h
            f.Size = UDim2.fromOffset(w, h)
        end
        if rotation then
            rotation = math.floor(rotation * 10 + 0.5) / 10
            if last.r ~= rotation then
                last.r = rotation
                f.Rotation = rotation
            end
        end
    end
end

local function shapeApply(shape, geometry, style)
    return function(key, p)
        if geometry[key] then
            queue(shape)
        elseif key == "Visible" then
            shape.root.Visible = p.Visible
            if p.Visible and shape.stale then
                shape.stale = false
                queue(shape)
            end
        elseif key == "ZIndex" then
            shape.root.ZIndex = z(p.ZIndex)
        else
            style(key, p)
        end
    end
end

function GuiShapes.Line(p)
    local f = newFrame()
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    local place = placer(f)
    local shape = { root = f, p = p }
    function shape.layout(q)
        local from, to = q.From, q.To
        local dx, dy = to.X - from.X, to.Y - from.Y
        local thickness = math.max(q.Thickness, 1)
        local cx, cy = (from.X + to.X) / 2, (from.Y + to.Y) / 2
        if math.abs(dy) < 0.5 then
            place(cx, cy, math.abs(dx), thickness, 0)
        elseif math.abs(dx) < 0.5 then
            place(cx, cy, thickness, math.abs(dy), 0)
        else
            place(cx, cy, math.sqrt(dx * dx + dy * dy), thickness, math.deg(math.atan2(dy, dx)))
        end
    end
    shape.apply = shapeApply(shape, { From = true, To = true, Thickness = true }, function(key, q)
        if key == "Color" then f.BackgroundColor3 = q.Color
        elseif key == "Transparency" then f.BackgroundTransparency = 1 - q.Transparency end
    end)
    return shape
end

local function outlinedShape(p, round_)
    local f = newFrame()
    if round_ then
        f.AnchorPoint = Vector2.new(0.5, 0.5)
        local corner = Instance.new("UICorner")
        corner.CornerRadius = UDim.new(0.5, 0)
        corner.Parent = f
    end
    local stroke = newStroke(f, not round_)
    local place = placer(f)
    local shape = { root = f, p = p }
    function shape.layout(q)
        if round_ then
            place(q.Position.X, q.Position.Y, q.Radius * 2, q.Radius * 2)
        else
            place(q.Position.X, q.Position.Y, q.Size.X, q.Size.Y)
        end
    end
    local function fill(q)
        f.BackgroundTransparency = q.Filled and (1 - q.Transparency) or 1
        stroke.Enabled = not q.Filled
        stroke.Transparency = 1 - q.Transparency
    end
    local geometry = round_ and { Position = true, Radius = true } or { Position = true, Size = true }
    shape.apply = shapeApply(shape, geometry, function(key, q)
        if key == "Color" then f.BackgroundColor3 = q.Color stroke.Color = q.Color
        elseif key == "Thickness" then stroke.Thickness = math.max(q.Thickness, 1)
        elseif key == "Filled" or key == "Transparency" then fill(q) end
    end)
    return shape
end

function GuiShapes.Square(p) return outlinedShape(p, false) end
function GuiShapes.Circle(p) return outlinedShape(p, true) end

function GuiShapes.Text(p)
    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.BorderSizePixel = 0
    label.Visible = false
    label.RichText = false
    label.TextWrapped = false
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.TextYAlignment = Enum.TextYAlignment.Top
    label.FontFace = Library.Fonts and Library.Fonts.SemiBold or Library.Font
    label:SetAttribute("ExplicitFont", true)
    local lastX, lastY
    local shape = { root = label, p = p }
    function shape.layout(q)
        local x, y = round(q.Position.X), round(q.Position.Y)
        if x ~= lastX or y ~= lastY then
            lastX, lastY = x, y
            label.Position = UDim2.fromOffset(x, y)
        end
    end
    local function stroke(q)
        label.TextStrokeTransparency = q.Outline and (1 - q.Transparency) or 1
    end
    shape.apply = shapeApply(shape, { Position = true }, function(key, q)
        if key == "Text" then label.Text = tostring(q.Text)
        elseif key == "Size" then
            label.TextSize = q.Size
            label.Size = UDim2.fromOffset(0, q.Size)
        elseif key == "Center" then
            label.AnchorPoint = Vector2.new(q.Center and 0.5 or 0, 0)
            label.TextXAlignment = q.Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left
        elseif key == "Color" then label.TextColor3 = q.Color
        elseif key == "OutlineColor" then label.TextStrokeColor3 = q.OutlineColor
        elseif key == "Outline" then stroke(q)
        elseif key == "Transparency" then label.TextTransparency = 1 - q.Transparency stroke(q) end
    end)
    return shape
end

local live = {} -- every object not yet removed: wrapper -> true
local liveCount = 0

local Object = {}
local methods = {}

local function applyDrawing(impl, key, value)
    pcall(function() impl[key] = value end)
end

local function createImpl(self, which)
    local kind = rawget(self, "_kind")
    local p = rawget(self, "_p")
    if which == "Drawing" then
        local ok, d = pcall(Drawing.new, kind)
        if not ok or d == nil then return false end
        for key, value in pairs(p) do
            if key ~= "Visible" then applyDrawing(d, key, value) end
        end
        applyDrawing(d, "Visible", p.Visible == true)
        rawset(self, "_impl", d)
        rawset(self, "_backend", "Drawing")
        return true
    end
    local shape = GuiShapes[kind](p)
    for key in pairs(p) do
        if key ~= "Visible" then shape.apply(key, p) end
    end
    shape.apply("Visible", p)
    shape.root.Parent = getLayer()
    rawset(self, "_impl", shape)
    rawset(self, "_backend", "Gui")
    return true
end

local function destroyImpl(self)
    local impl = rawget(self, "_impl")
    if not impl then return end
    rawset(self, "_impl", nil)
    if rawget(self, "_backend") == "Drawing" then
        pcall(function() impl:Remove() end)
    else
        impl.dead = true
        pcall(function() impl.root:Destroy() end)
    end
end

local function setProp(self, key, value)
    local p = rawget(self, "_p")
    if p == nil then return end -- removed
    if p[key] == value then return end
    p[key] = value
    local impl = rawget(self, "_impl")
    if not impl then return end
    if rawget(self, "_backend") == "Drawing" then
        applyDrawing(impl, key, value)
    else
        impl.apply(key, p)
    end
end

Object.__index = function(self, key)
    local m = methods[key]
    if m then return m end
    if key == "TextBounds" then return methods.GetTextBounds(self) end
    if key == "Backend" then return rawget(self, "_backend") end
    local p = rawget(self, "_p")
    return p and p[key]
end
Object.__newindex = setProp
Object.__tostring = function(self) return "B3Draw." .. tostring(rawget(self, "_kind")) end

function methods.Set(self, props)
    for key, value in pairs(props) do setProp(self, key, value) end
    return self
end

function methods.GetTextBounds(self)
    local impl = rawget(self, "_impl")
    if not impl then return ZERO end
    local ok, bounds
    if rawget(self, "_backend") == "Drawing" then
        ok, bounds = pcall(function() return impl.TextBounds end)
    else
        ok, bounds = pcall(function() return impl.root.TextBounds end)
    end
    if ok and typeof(bounds) == "Vector2" then return bounds end
    local p = rawget(self, "_p")
    local size = p and p.Size or 13
    return Vector2.new(#tostring(p and p.Text or "") * size * 0.5, size)
end

function methods.Remove(self)
    if rawget(self, "_p") == nil then return end
    destroyImpl(self)
    rawset(self, "_p", nil)
    if live[self] then
        live[self] = nil
        liveCount -= 1
    end
end
methods.Destroy = methods.Remove

local function newObject(kind, props)
    assert(DEFAULTS[kind], "[B3] Draw: unknown shape " .. tostring(kind))
    local p = { Visible = false }
    for key, value in pairs(DEFAULTS[kind]) do p[key] = value end
    if props then
        for key, value in pairs(props) do p[key] = value end
    end
    local self = setmetatable({ _kind = kind, _p = p }, Object)
    if not createImpl(self, backend()) then
        active = "Gui"
        rebuildAll("Gui")
        createImpl(self, "Gui")
    end
    live[self] = true
    liveCount += 1
    return self
end

function rebuildAll(which)
    for obj in pairs(live) do
        if rawget(obj, "_backend") ~= which or which == "Gui" then
            destroyImpl(obj)
            createImpl(obj, which)
        end
    end
end

function Draw.new(kind, props) return newObject(kind, props) end
function Draw.Line(props) return newObject("Line", props) end
function Draw.Square(props) return newObject("Square", props) end
function Draw.Circle(props) return newObject("Circle", props) end
function Draw.Text(props) return newObject("Text", props) end

function Draw.SetBackend(name)
    assert(name == "Auto" or name == "Drawing" or name == "Gui", "[B3] Draw.SetBackend: Auto, Drawing or Gui")
    requested = name
    local nextBackend = resolve()
    if nextBackend == active then return active end
    active = nextBackend
    for obj in pairs(live) do
        destroyImpl(obj)
        createImpl(obj, nextBackend)
    end
    return active
end

function Draw.GetBackend() return backend() end
function Draw.HasDrawing() return drawingWorks() end
function Draw.Count() return liveCount end

local pools = { Line = {}, Square = {}, Circle = {}, Text = {} }
local POOL_MAX = 256

function Draw.acquire(kind, props)
    local pool = pools[kind]
    local obj = pool[#pool]
    if obj and rawget(obj, "_p") then
        pool[#pool] = nil
        for key, value in pairs(DEFAULTS[kind]) do setProp(obj, key, value) end
        if props then
            for key, value in pairs(props) do setProp(obj, key, value) end
        end
        return obj
    end
    if obj then pool[#pool] = nil end
    return newObject(kind, props)
end

function Draw.release(obj)
    if obj == nil or rawget(obj, "_p") == nil then return end
    setProp(obj, "Visible", false)
    local pool = pools[rawget(obj, "_kind")]
    if #pool < POOL_MAX then
        table.insert(pool, obj)
    else
        methods.Remove(obj)
    end
end

local function camera() return Services.Workspace.CurrentCamera end

function Draw.ViewportSize()
    local cam = camera()
    return cam and cam.ViewportSize or Vector2.new(1280, 720)
end

function Draw.ScreenCenter()
    return Draw.ViewportSize() / 2
end

function Draw.MousePosition()
    local ok, pos = pcall(function() return Services.UserInputService:GetMouseLocation() end)
    return ok and pos or Draw.ScreenCenter()
end

function Draw.WorldToScreen(point)
    local cam = camera()
    if not cam then return ZERO, false, 0 end
    local pos, onScreen = cam:WorldToViewportPoint(point)
    return Vector2.new(pos.X, pos.Y), onScreen and pos.Z > 0, pos.Z
end

local Composite = {}
Composite.__index = Composite

local function newComposite(opts, defaults)
    local o = {}
    for key, value in pairs(defaults) do o[key] = value end
    if opts then
        for key, value in pairs(opts) do
            if key ~= "Visible" then o[key] = value end
        end
    end
    return setmetatable({ Options = o, Parts = {}, Outlines = {}, Visible = false, _startVisible = opts and opts.Visible == true }, Composite)
end

local function finish(self)
    if self._startVisible then self:SetVisible(true) end
    return self
end

function Composite:_part(kind, outline)
    local list = outline and self.Outlines or self.Parts
    local obj = Draw.acquire(kind)
    table.insert(list, obj)
    return obj
end

function Composite:_style()
    local o = self.Options
    for _, part in ipairs(self.Parts) do
        part.Color = o.Color
        part.Transparency = o.Transparency
        part.ZIndex = (o.ZIndex or 1) + 1
        if rawget(part, "_kind") ~= "Text" then part.Thickness = o.Thickness end
    end
    for _, part in ipairs(self.Outlines) do
        part.Color = o.OutlineColor
        part.Transparency = o.Transparency
        part.ZIndex = o.ZIndex or 1
        if rawget(part, "_kind") ~= "Text" then part.Thickness = o.Thickness + 2 end
    end
end

function Composite:Set(opts)
    for key, value in pairs(opts) do
        if key ~= "Visible" then self.Options[key] = value end
    end
    self:_style()
    if self._refresh then self:_refresh() end
    local visible = opts.Visible
    if visible == nil then visible = self.Visible end
    self._visibleSet = false -- re-apply so an Outline change shows at once
    self:SetVisible(visible)
    return self
end

function Composite:SetVisible(visible)
    visible = visible == true
    if self.Visible == visible and self._visibleSet then return end
    self.Visible = visible
    self._visibleSet = true
    local showOutline = visible and self.Options.Outline ~= false
    for _, part in ipairs(self.Parts) do part.Visible = visible end
    for _, part in ipairs(self.Outlines) do part.Visible = showOutline end
end

function Composite:Remove()
    if self.Removed then return end
    self.Removed = true
    if self._follow then Draw._unfollow(self) end
    for _, part in ipairs(self.Parts) do Draw.release(part) end
    for _, part in ipairs(self.Outlines) do Draw.release(part) end
    table.clear(self.Parts)
    table.clear(self.Outlines)
end
Composite.Destroy = Composite.Remove

local STYLE = { Color = WHITE, Transparency = 1, Thickness = 1, ZIndex = 1, Outline = true, OutlineColor = BLACK }
local function styled(extra)
    local t = {}
    for key, value in pairs(STYLE) do t[key] = value end
    for key, value in pairs(extra or {}) do t[key] = value end
    return t
end

function Draw.Box(opts)
    local self = newComposite(opts, styled())
    self._outline = self:_part("Square", true)
    self._main = self:_part("Square")
    self:_style()
    function self:Update(position, size)
        self._outline.Position = position
        self._outline.Size = size
        self._main.Position = position
        self._main.Size = size
    end
    return finish(self)
end

function Draw.CornerBox(opts)
    local self = newComposite(opts, styled({ Length = 0.25 }))
    for _ = 1, 8 do self:_part("Line", true) end
    for _ = 1, 8 do self:_part("Line") end
    self:_style()
    local function put(list, i, from, to)
        local line = list[i]
        line.From = from
        line.To = to
    end
    function self:Update(position, size)
        local x, y, w, h = position.X, position.Y, size.X, size.Y
        local lw, lh = w * self.Options.Length, h * self.Options.Length
        local r, b = x + w, y + h
        for _, list in ipairs({ self.Outlines, self.Parts }) do
            local e = (list == self.Outlines) and 1 or 0 -- outline reaches one pixel past each end
            put(list, 1, Vector2.new(x - e, y), Vector2.new(x + lw + e, y))
            put(list, 2, Vector2.new(x, y - e), Vector2.new(x, y + lh + e))
            put(list, 3, Vector2.new(r + e, y), Vector2.new(r - lw - e, y))
            put(list, 4, Vector2.new(r, y - e), Vector2.new(r, y + lh + e))
            put(list, 5, Vector2.new(x - e, b), Vector2.new(x + lw + e, b))
            put(list, 6, Vector2.new(x, b + e), Vector2.new(x, b - lh - e))
            put(list, 7, Vector2.new(r + e, b), Vector2.new(r - lw - e, b))
            put(list, 8, Vector2.new(r, b + e), Vector2.new(r, b - lh - e))
        end
    end
    return finish(self)
end

local HEALTH_LOW = Color3.fromRGB(255, 70, 70)
local HEALTH_MID = Color3.fromRGB(255, 200, 60)
local HEALTH_HIGH = Color3.fromRGB(80, 230, 120)
function Draw.HealthColor(fraction)
    fraction = math.clamp(fraction, 0, 1)
    if fraction < 0.5 then return HEALTH_LOW:Lerp(HEALTH_MID, fraction * 2) end
    return HEALTH_MID:Lerp(HEALTH_HIGH, (fraction - 0.5) * 2)
end

function Draw.HealthBar(opts)
    local self = newComposite(opts, styled({ Width = 2, Side = "Left", Gap = 3, Color = false }))
    self._back = self:_part("Square", true)
    self._fill = self:_part("Square")
    self._back.Filled = true
    self._fill.Filled = true
    function self:_style()
        local o = self.Options
        self._back.Color = o.OutlineColor
        self._back.Transparency = o.Transparency * 0.8
        self._back.ZIndex = o.ZIndex or 1
        self._fill.Transparency = o.Transparency
        self._fill.ZIndex = (o.ZIndex or 1) + 1
    end
    self:_style()
    function self:Update(position, size, fraction)
        local o = self.Options
        fraction = math.clamp(tonumber(fraction) or 0, 0, 1)
        local w = o.Width
        local x = (o.Side == "Right") and (position.X + size.X + o.Gap) or (position.X - o.Gap - w)
        local h = size.Y
        self._back.Position = Vector2.new(x - 1, position.Y - 1)
        self._back.Size = Vector2.new(w + 2, h + 2)
        local fillH = math.floor(h * fraction + 0.5)
        self._fill.Position = Vector2.new(x, position.Y + h - fillH)
        self._fill.Size = Vector2.new(w, fillH)
        self._fill.Color = o.Color or Draw.HealthColor(fraction)
    end
    return finish(self)
end

function Draw.Tracer(opts)
    local self = newComposite(opts, styled())
    self._outline = self:_part("Line", true)
    self._main = self:_part("Line")
    self:_style()
    function self:Update(from, to)
        self._outline.From = from
        self._outline.To = to
        self._main.From = from
        self._main.To = to
    end
    return finish(self)
end

function Draw.Skeleton(opts)
    local self = newComposite(opts, styled())
    self._pairs = 0
    local function ensure(n)
        while self._pairs < n do
            self:_part("Line", true) -- outline
            self:_part("Line")       -- main line
            self._pairs = self._pairs + 1
        end
        self:_style()
    end
    function self:SetVisible(visible)
        self.Visible = visible == true
        if not self.Visible then
            for i = 1, self._pairs do
                self.Outlines[i].Visible = false
                self.Parts[i].Visible = false
            end
        end
    end
    function self:Update(segments, count)
        local n = count or (segments and #segments or 0)
        ensure(n)
        local showOutline = self.Visible and self.Options.Outline ~= false and not Library.IsMobile
        for i = 1, self._pairs do
            local seg = (i <= n) and segments[i] or nil
            local outline, main = self.Outlines[i], self.Parts[i]
            if seg and self.Visible then
                outline.From = seg[1] outline.To = seg[2] outline.Visible = showOutline
                main.From = seg[1] main.To = seg[2] main.Visible = true
            else
                outline.Visible = false
                main.Visible = false
            end
        end
    end
    return finish(self)
end

local followers = {}
local followCount = 0
local followConn = nil

local function followPoint(mode)
    if type(mode) == "function" then
        local ok, pos = pcall(mode)
        if ok and typeof(pos) == "Vector2" then return pos end
    end
    if mode == "Mouse" then return Draw.MousePosition() end
    return Draw.ScreenCenter()
end

local function stepFollowers()
    for item in pairs(followers) do
        local ok, err = pcall(item._refresh, item)
        if not ok then
            followers[item] = nil
            followCount -= 1
            warn("[B3] Draw follow error: " .. tostring(err))
        end
    end
    if followCount <= 0 and followConn then
        followConn:Disconnect()
        followConn = nil
    end
end

function Draw._follow(item)
    if followers[item] then return end
    followers[item] = true
    followCount += 1
    item._follow = true
    if not followConn then
        followConn = Services.RunService.RenderStepped:Connect(stepFollowers)
    end
end

function Draw._unfollow(item)
    if not followers[item] then return end
    followers[item] = nil
    followCount -= 1
    item._follow = false
    if followCount <= 0 and followConn then
        followConn:Disconnect()
        followConn = nil
    end
end

local function bindFollow(self)
    local function sync()
        if self.Removed then return end
        if self.Options.Follow and self.Visible then
            Draw._follow(self)
        else
            Draw._unfollow(self)
        end
    end
    local baseSetVisible = self.SetVisible
    function self:SetVisible(visible)
        baseSetVisible(self, visible)
        sync()
    end
    local baseSet = self.Set
    function self:Set(opts)
        baseSet(self, opts)
        sync()
        return self
    end
end

function Draw.FOVCircle(opts)
    local self = newComposite(opts, styled({ Radius = 120, Follow = "Center", Filled = false, Outline = true, NumSides = 64 }))
    self._outline = self:_part("Circle", true)
    self._main = self:_part("Circle")
    self:_style()
    self.Position = Draw.ScreenCenter()
    function self:_refresh()
        local o = self.Options
        local pos = o.Follow and followPoint(o.Follow) or (o.Position or self.Position)
        self.Position = pos
        for _, c in ipairs({ self._outline, self._main }) do
            c.Position = pos
            c.Radius = o.Radius
            c.NumSides = o.NumSides
        end
        self._main.Filled = o.Filled == true
        self._outline.Filled = false
    end
    function self:Contains(point)
        return (point - self.Position).Magnitude <= self.Options.Radius
    end
    bindFollow(self)
    self:_refresh()
    return finish(self)
end

function Draw.Crosshair(opts)
    local self = newComposite(opts, styled({
        Style = "Cross",
        Size = 10,
        Gap = 4,
        Thickness = 2,
        Follow = "Center",
        Dot = false,
        DotSize = 2,
    }))
    for _ = 1, 4 do self:_part("Line", true) end
    for _ = 1, 4 do self:_part("Line") end
    self._circleOutline = self:_part("Circle", true)
    self._circle = self:_part("Circle")
    self._dotOutline = self:_part("Circle", true)
    self._dot = self:_part("Circle")

    self:_style()
    self.Position = Draw.ScreenCenter()

    local dirs = { Vector2.new(1, 0), Vector2.new(-1, 0), Vector2.new(0, 1), Vector2.new(0, -1) }

    function self:SetVisible(visible)
        self.Visible = visible == true
        if not self.Visible then
            for _, p in ipairs(self.Parts) do p.Visible = false end
            for _, p in ipairs(self.Outlines) do p.Visible = false end
        else
            self:_refresh()
        end
    end

    function self:_refresh()
        local o = self.Options
        local pos = o.Follow and followPoint(o.Follow) or (o.Position or self.Position)
        self.Position = pos

        if not self.Visible then
            for _, p in ipairs(self.Parts) do p.Visible = false end
            for _, p in ipairs(self.Outlines) do p.Visible = false end
            return
        end

        local s = tostring(o.Style or "Cross"):lower()
        local isDot = s == "dot" or s == "จุดเดี่ยว"
        local isCircle = s == "circle" or s == "วงกลม"
        local isTShape = s == "t-shape" or s == "t_shape" or s == "t" or s == "รูปตัว t"
        local isCross = s == "cross" or s == "กากบาท" or (not isDot and not isCircle and not isTShape)

        local showOutline = o.Outline ~= false
        local size = o.Size or 10
        local gap = o.Gap or 4

        local showLines = isCross or isTShape
        for i, d in ipairs(dirs) do
            local showArm = showLines and (not isTShape or i ~= 4)
            local outline, main = self.Outlines[i], self.Parts[i]
            if showArm then
                local inner = pos + d * gap
                local outer = pos + d * (gap + size)
                outline.From = inner - d
                outline.To = outer + d
                outline.Visible = showOutline
                main.From = inner
                main.To = outer
                main.Visible = true
            else
                outline.Visible = false
                main.Visible = false
            end
        end

        local cOutline, cMain = self._circleOutline, self._circle
        if isCircle then
            local r = gap + size
            cOutline.Position = pos
            cOutline.Radius = r
            cOutline.Filled = false
            cOutline.Visible = showOutline
            cMain.Position = pos
            cMain.Radius = r
            cMain.Filled = false
            cMain.Visible = true
        else
            cOutline.Visible = false
            cMain.Visible = false
        end

        local dOutline, dMain = self._dotOutline, self._dot
        local showDot = (o.Dot == true or o.CenterDot == true or isDot)
        if showDot then
            local ds = o.DotSize or math.max(2, o.Thickness or 2)
            local r = math.max(1, ds * 0.5)
            dOutline.Position = pos
            dOutline.Radius = r + 1
            dOutline.Filled = true
            dOutline.Visible = showOutline
            dMain.Position = pos
            dMain.Radius = r
            dMain.Filled = true
            dMain.Visible = true
        else
            dOutline.Visible = false
            dMain.Visible = false
        end
    end

    function self:Update(pos)
        if pos then
            self.Position = pos
            self.Options.Position = pos
        end
        self:_refresh()
        return self
    end

    bindFollow(self)
    self:_refresh()
    return finish(self)
end

function Draw.Clear()
    for item in pairs(followers) do item._follow = false end
    table.clear(followers)
    followCount = 0
    if followConn then
        followConn:Disconnect()
        followConn = nil
    end
    local all = {}
    for obj in pairs(live) do table.insert(all, obj) end
    for _, obj in ipairs(all) do methods.Remove(obj) end
    for _, pool in pairs(pools) do table.clear(pool) end
    if layer then
        pcall(function() layer:Destroy() end)
        layer = nil
    end
end

Library.Maid:Give(function()
    Draw.Clear()
    active = nil
    requested = "Auto"
end)

do
    local INERT = setmetatable({}, {
        __index = function(t) return function() return t end end,
        __newindex = function() end,
    })
    for _, name in ipairs({ "new", "Line", "Square", "Circle", "Text", "acquire", "Box", "CornerBox", "HealthBar", "Tracer", "Skeleton", "FOVCircle", "Crosshair" }) do
        local original = Draw[name]
        if type(original) == "function" then
            Draw[name] = function(...)
                if Library.Unloaded then return INERT end
                return original(...)
            end
        end
    end
end

return Draw
]]

__sources["core/ESP"] = [=[
local Services = require("core/Services")
local Library = require("core/Library")
local Draw = require("core/Draw")

local ESP = {
    Enabled = true,
    UpdateRate = Library.IsMobile and 30 or 60,
    MaxHighlights = 25,
    HighlightParent = nil,
}

ESP.Defaults = {
    Color = Color3.fromRGB(128, 170, 255),
    NameColor = Color3.fromRGB(255, 255, 255),
    DistanceColor = Color3.fromRGB(255, 220, 60),
    BracketColor = Color3.fromRGB(255, 255, 255),
    HealthBarWidth = 2,
    Box = true,
    BoxStyle = "Full", -- "Full" | "Corner"
    BoxRatio = 0.6, -- width / height of a character box
    Name = true, -- true = player / object name, a string, or function(target, player) -> string
    Distance = true,
    Health = true, -- bar beside the box when a Humanoid (or GetHealth) is found
    HealthStyle = "Both", -- "Both" | "Bar" | "Text"
    HealthText = true, -- the HP number next to the bar (only when Health is on)
    GetHealth = nil, -- function(target) -> health, maxHealth
    AliveCheck = true, -- hide dead players / humanoids with Health <= 0
    Skeleton = false, -- lines along the character's bones (any rig: built from its Motor6Ds)
    SkeletonColor = nil, -- defaults to Color
    SkeletonMode = "Auto", -- "Auto" | "Anatomical" | "Bones"
    SkeletonMaxDistance = 1000, -- LOD distance cutoff for skeleton (preserves 144 FPS)
    Tracer = false,
    TracerFrom = "Bottom", -- "Bottom" | "Center" | "Mouse" | "Top"
    Chams = false,
    ChamsColor = nil, -- defaults to Color
    FillTransparency = 0.65,
    OutlineTransparency = 0,
    TeamCheck = false, -- hide players on your team
    TeamColor = false, -- colour players by their team
    MaxDistance = 2000,
    TextSize = 13,
    Thickness = 1,
    Outline = true,
    Transparency = 1,
}

local entries = {} -- entry -> true
local byTarget = {} -- target -> entry (ESP:Add only; groups keep their own index)
local entryCount = 0
local groups = {}
local playersGroup = nil

local conn = nil
local lastUpdate = 0
local lastChams = 0
local CHAMS_INTERVAL = 0.5
local BOUNDS_INTERVAL = 2.5

local LocalPlayer = Services.Players.LocalPlayer

local function makeOptions(opts, base)
    local o = setmetatable({}, { __index = base or ESP.Defaults })
    if opts then
        for key, value in pairs(opts) do o[key] = value end
    end
    return o
end

local freeHighlights = {}
local highlightCount = 0

local function highlightParent()
    if ESP.HighlightParent then return ESP.HighlightParent end
    return Draw.getLayer()
end

local function releaseHighlight(entry)
    local h = entry.highlight
    if not h then return end
    entry.highlight = nil
    entry.hl = nil
    highlightCount -= 1
    pcall(function()
        h.Enabled = false
        h.Adornee = nil
    end)
    table.insert(freeHighlights, h)
end

local function ensureHighlight(entry)
    if entry.highlight then return entry.highlight end
    local h = table.remove(freeHighlights)
    if h and h.Parent == nil then h = nil end -- its parent layer was destroyed
    if not h then
        h = Instance.new("Highlight")
        h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Parent = highlightParent()
    end
    h.Adornee = entry.target
    h.Enabled = true
    entry.highlight = h
    entry.hl = {}
    highlightCount += 1
    return h
end

local function styleHighlight(entry, color)
    local h, cache, o = entry.highlight, entry.hl, entry.opts
    if not h then return end
    local fill = o.ChamsColor or color
    if cache.fill ~= fill then cache.fill = fill h.FillColor = fill end
    if cache.outline ~= color then cache.outline = color h.OutlineColor = color end
    if cache.ft ~= o.FillTransparency then cache.ft = o.FillTransparency h.FillTransparency = o.FillTransparency end
    if cache.ot ~= o.OutlineTransparency then cache.ot = o.OutlineTransparency h.OutlineTransparency = o.OutlineTransparency end
end

local function releaseElement(entry, key)
    local item = entry[key]
    if item == nil then return end
    entry[key] = nil
    if item.Remove and getmetatable(item) and rawget(item, "Options") ~= nil then
        item:Remove() -- composite
    else
        Draw.release(item)
    end
end

local ELEMENTS = { "box", "bar", "skel", "tracer", "nameText", "infoText" }

local function hide(entry)
    releaseHighlight(entry)
    if not entry.shown then return end
    entry.shown = false
    for _, key in ipairs(ELEMENTS) do
        local item = entry[key]
        if item then
            if item.SetVisible then item:SetVisible(false) else item.Visible = false end
        end
    end
end

local function releaseAll(entry)
    for _, key in ipairs(ELEMENTS) do releaseElement(entry, key) end
    releaseHighlight(entry)
    entry.shown = false
end

local SKEL_MAX = 40
local SKEL_SKIP = {
    "finger", "toe", "twist", "roll", "prop", "weapon", "nub", "ik", "dummy", "accessory",
    "hair", "clothes", "cloth", "face", "armor", "gear", "hat", "helmet", "vest", "wing",
    "cape", "tail", "horn", "shield", "gun", "back",
}
local function skelNoise(name)
    local low = string.lower(name)
    for _, word in ipairs(SKEL_SKIP) do
        if string.find(low, word, 1, true) then return true end
    end
    return false
end

local function validSkelJoint(joint, a, b)
    if not a or not b or not a:IsA("BasePart") or not b:IsA("BasePart") then return false end
    if a == b or a.Name == "HumanoidRootPart" or b.Name == "HumanoidRootPart" or a.Name == "RootPart" or b.Name == "RootPart" then
        return false
    end
    if joint:FindFirstAncestorOfClass("Tool") or joint:FindFirstAncestorOfClass("Accessory") then return false end
    if skelNoise(joint.Name) or skelNoise(a.Name) or skelNoise(b.Name) then return false end
    return true
end

local function resolveSkeleton(character)
    local edges = {}

    for _, d in ipairs(character:GetDescendants()) do
        if #edges >= SKEL_MAX then break end
        if d:IsA("AnimationConstraint") then
            local att0, att1 = d.Attachment0, d.Attachment1
            local p0 = att0 and att0.Parent
            local p1 = att1 and att1.Parent
            if validSkelJoint(d, p0, p1) then
                edges[#edges + 1] = { p0, p1 }
            end
        end
    end

    if #edges == 0 then
        for _, d in ipairs(character:GetDescendants()) do
            if #edges >= SKEL_MAX then break end
            if d:IsA("Motor6D") and validSkelJoint(d, d.Part0, d.Part1) then
                edges[#edges + 1] = { d.Part0, d.Part1 }
            end
        end
    end

    if #edges == 0 then
        local head = character:FindFirstChild("Head")
        local upperTorso = character:FindFirstChild("UpperTorso")
        local lowerTorso = character:FindFirstChild("LowerTorso")
        local torso = character:FindFirstChild("Torso")
        local lArm = character:FindFirstChild("LeftUpperArm") or character:FindFirstChild("Left Arm")
        local rArm = character:FindFirstChild("RightUpperArm") or character:FindFirstChild("Right Arm")
        local lLeg = character:FindFirstChild("LeftUpperLeg") or character:FindFirstChild("Left Leg")
        local rLeg = character:FindFirstChild("RightUpperLeg") or character:FindFirstChild("Right Leg")
        local lElbow = character:FindFirstChild("LeftLowerArm")
        local rElbow = character:FindFirstChild("RightLowerArm")
        local lHand = character:FindFirstChild("LeftHand")
        local rHand = character:FindFirstChild("RightHand")
        local lKnee = character:FindFirstChild("LeftLowerLeg")
        local rKnee = character:FindFirstChild("RightLowerLeg")
        local lFoot = character:FindFirstChild("LeftFoot")
        local rFoot = character:FindFirstChild("RightFoot")

        local chest = upperTorso or torso
        local pelvis = lowerTorso or torso
        if chest and head then edges[#edges + 1] = { chest, head } end
        if upperTorso and lowerTorso then edges[#edges + 1] = { upperTorso, lowerTorso } end
        if chest and lArm then edges[#edges + 1] = { chest, lArm } end
        if chest and rArm then edges[#edges + 1] = { chest, rArm } end
        if lArm and lElbow then edges[#edges + 1] = { lArm, lElbow } end
        if lElbow and lHand then edges[#edges + 1] = { lElbow, lHand } end
        if rArm and rElbow then edges[#edges + 1] = { rArm, rElbow } end
        if rElbow and rHand then edges[#edges + 1] = { rElbow, rHand } end
        if pelvis and lLeg then edges[#edges + 1] = { pelvis, lLeg } end
        if pelvis and rLeg then edges[#edges + 1] = { pelvis, rLeg } end
        if lLeg and lKnee then edges[#edges + 1] = { lLeg, lKnee } end
        if lKnee and lFoot then edges[#edges + 1] = { lKnee, lFoot } end
        if rLeg and rKnee then edges[#edges + 1] = { rLeg, rKnee } end
        if rKnee and rFoot then edges[#edges + 1] = { rKnee, rFoot } end
    end

    if #edges == 0 then
        for _, d in ipairs(character:GetDescendants()) do
            if #edges >= SKEL_MAX then break end
            if d.ClassName == "Bone" and not d:FindFirstAncestorOfClass("Tool") then
                local parent = d.Parent
                if parent and parent.ClassName == "Bone" and not skelNoise(d.Name) then
                    edges[#edges + 1] = { d, parent }
                end
            end
        end
    end
    return (#edges > 0) and edges or nil
end

local function nodePosition(node)
    if node.ClassName == "Bone" then
        local cf = node.TransformedWorldCFrame
        return (cf and cf.Position) or node.WorldPosition
    end
    return node.Position
end

local function resolveParts(entry, now)
    local t = entry.target
    if entry.isPart then return end
    local root = entry.root
    if root and root.Parent ~= nil and (entry.nextResolve or 0) > now then return end
    entry.nextResolve = now + BOUNDS_INTERVAL
    entry.humanoid = t:FindFirstChildOfClass("Humanoid")
    root = t:FindFirstChild("HumanoidRootPart") or t.PrimaryPart
    entry.root = root
    entry.head = entry.humanoid and t:FindFirstChild("Head") or nil
    local skelTarget = t
    if entry.humanoid and type(ESP.GetSkeletonRig) == "function" then
        local okRig, customRig = pcall(ESP.GetSkeletonRig, t, entry.player)
        if okRig and typeof(customRig) == "Instance" and customRig.Parent then
            skelTarget = customRig
        end
    end
    if skelTarget ~= t and entry.humanoid then
        local allBones = {}
        for _, d in ipairs(skelTarget:GetDescendants()) do
            if d.ClassName == "Bone" and not d:FindFirstAncestorOfClass("Tool") and not skelNoise(d.Name) then
                allBones[#allBones + 1] = d
            end
        end
        if #allBones > 8 then
            local sampled = {}
            local stepIdx = (#allBones - 1) / 7
            for i = 0, 7 do
                sampled[#sampled + 1] = allBones[math.floor(1 + i * stepIdx + 0.5)]
            end
            entry.skelBones = sampled
        else
            entry.skelBones = (#allBones > 0) and allBones or nil
        end
    else
        entry.skelBones = nil
    end

    if entry.opts.Skeleton and entry.humanoid then
        if skelTarget ~= t then
            entry.useAnatomicalR6 = false
            entry.skelEdges = resolveSkeleton(skelTarget)
        else
            local mode = entry.opts.SkeletonMode or "Auto"
            local isR6 = (entry.humanoid.RigType == Enum.HumanoidRigType.R6) or (t:FindFirstChild("Torso") and not t:FindFirstChild("UpperTorso"))
            entry.isR6 = isR6
            if mode == "Bones" or (not isR6 and mode ~= "Anatomical") then
                entry.useAnatomicalR6 = false
                entry.skelEdges = resolveSkeleton(t)
            else
                entry.useAnatomicalR6 = isR6
                entry.skelEdges = not isR6 and resolveSkeleton(t) or nil
            end
        end
        if not entry.skelEdges and not entry.useAnatomicalR6 then
            entry.nextResolve = math.min(entry.nextResolve, now + 0.5)
        end
    else
        entry.skelEdges = nil
        entry.useAnatomicalR6 = false
    end
    local parts = {}
    for _, d in ipairs(t:GetDescendants()) do
        if d:IsA("BasePart") and d.Transparency < 0.95 and d.Name ~= "HumanoidRootPart"
            and d.Name ~= "RootPart" and d.Size.Magnitude > 0.2 and not d:FindFirstAncestorOfClass("Tool") then
            parts[#parts + 1] = d
        end
    end
    entry.bodyParts = (#parts > 0) and parts or nil
    if not entry.humanoid then
        local ok, cf, size = pcall(function() return t:GetBoundingBox() end)
        if ok and cf then
            entry.boundsSize = size
            entry.boundsOffset = t:GetPivot():ToObjectSpace(cf)
        end
    end
end

local corners = {}
for x = -1, 1, 2 do
    for y = -1, 1, 2 do
        for z = -1, 1, 2 do table.insert(corners, Vector3.new(x, y, z) * 0.5) end
    end
end

local function projectBox(cam, cf, size)
    local minX, minY, maxX, maxY = math.huge, math.huge, -math.huge, -math.huge
    local any, behind = false, 0
    for _, c in ipairs(corners) do
        local p = cam:WorldToViewportPoint(cf * (c * size))
        if p.Z > 0 then
            any = true
            if p.X < minX then minX = p.X end
            if p.X > maxX then maxX = p.X end
            if p.Y < minY then minY = p.Y end
            if p.Y > maxY then maxY = p.Y end
        else
            behind = behind + 1
        end
    end
    if not any then return nil end
    return Vector2.new(minX, minY), Vector2.new(maxX - minX, maxY - minY), behind
end

local function measure(entry, cam, now)
    local t = entry.target
    if entry.isPart then
        local pos = t.Position
        if not entry.opts.Box and not entry.opts.Health then
            local sp = cam:WorldToViewportPoint(pos)
            if sp.Z <= 0 then return pos, nil end
            return pos, Vector2.new(sp.X - 6, sp.Y - 6), Vector2.new(12, 12)
        end
        local cf = t.CFrame
        local boxPos, size = projectBox(cam, cf, t.Size)
        return cf.Position, boxPos, size
    end
    resolveParts(entry, now)
    local root = entry.root
    if not entry.opts.Box and not entry.opts.Health and root and root.Parent then
        local pos = root.Position
        local sp = cam:WorldToViewportPoint(pos)
        if sp.Z <= 0 then return pos, nil end
        return pos, Vector2.new(sp.X - 10, sp.Y - 14), Vector2.new(20, 28)
    end

    local skelBones = entry.skelBones
    if skelBones and (not root or (cam.CFrame.Position - root.Position).Magnitude <= 350) then
        local minX, minY, minZ = math.huge, math.huge, math.huge
        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
        local count = 0
        for i = 1, #skelBones do
            local b = skelBones[i]
            if b.Parent then
                local p = nodePosition(b)
                if p.X < minX then minX = p.X end
                if p.X > maxX then maxX = p.X end
                if p.Y < minY then minY = p.Y end
                if p.Y > maxY then maxY = p.Y end
                if p.Z < minZ then minZ = p.Z end
                if p.Z > maxZ then maxZ = p.Z end
                count = count + 1
            end
        end
        if count > 0 then
            minX, maxX = minX - 0.55, maxX + 0.55
            minY, maxY = minY - 0.35, maxY + 0.7
            minZ, maxZ = minZ - 0.55, maxZ + 0.55
            local center = Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
            local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
            local pos, sz, behind = projectBox(cam, CFrame.new(center), size)
            if pos and behind == 0 then
                local w = math.min(sz.X, sz.Y * entry.opts.BoxRatio * 1.15)
                return center, Vector2.new(pos.X + (sz.X - w) / 2, pos.Y), Vector2.new(w, sz.Y)
            end
            if not pos then return center, nil end
        end
    end
    local bodyParts = entry.bodyParts
    if bodyParts then
        local minX, minY, minZ = math.huge, math.huge, math.huge
        local maxX, maxY, maxZ = -math.huge, -math.huge, -math.huge
        local count = 0
        for i = 1, #bodyParts do
            local p = bodyParts[i]
            if p.Parent then
                local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = p.CFrame:GetComponents()
                local s = p.Size
                local hx, hy, hz = s.X / 2, s.Y / 2, s.Z / 2
                local ex = math.abs(r00) * hx + math.abs(r01) * hy + math.abs(r02) * hz
                local ey = math.abs(r10) * hx + math.abs(r11) * hy + math.abs(r12) * hz
                local ez = math.abs(r20) * hx + math.abs(r21) * hy + math.abs(r22) * hz
                if x - ex < minX then minX = x - ex end
                if x + ex > maxX then maxX = x + ex end
                if y - ey < minY then minY = y - ey end
                if y + ey > maxY then maxY = y + ey end
                if z - ez < minZ then minZ = z - ez end
                if z + ez > maxZ then maxZ = z + ez end
                count = count + 1
            end
        end
        if count > 0 then
            local center = Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2)
            local size = Vector3.new(maxX - minX, maxY - minY, maxZ - minZ)
            local pos, sz, behind = projectBox(cam, CFrame.new(center), size)
            if pos and behind == 0 then
                local w = math.min(sz.X, sz.Y * entry.opts.BoxRatio * 1.15)
                return center, Vector2.new(pos.X + (sz.X - w) / 2, pos.Y), Vector2.new(w, sz.Y)
            end
            if not pos then return center, nil end
        end
    end
    if entry.boundsSize and entry.boundsOffset then
        local cf = t:GetPivot() * entry.boundsOffset
        local pos, size = projectBox(cam, cf, entry.boundsSize)
        return cf.Position, pos, size
    end
    if root then
        local pos, size = projectBox(cam, root.CFrame, root.Size)
        return root.Position, pos, size
    end
    return nil
end

local function onViewport(pos, size, viewport)
    return pos.X + size.X >= 0 and pos.Y + size.Y >= 0 and pos.X <= viewport.X and pos.Y <= viewport.Y
end

local function sameTeam(player)
    local mine = LocalPlayer and LocalPlayer.Team
    return mine ~= nil and player.Team == mine
end

local function entryColor(entry)
    local o, player = entry.opts, entry.player
    local color = o.Color
    if type(color) == "function" then color = color(entry.target, player) end
    if player and o.TeamColor and player.Team then
        color = player.TeamColor.Color
    end
    return color
end

local function entryName(entry)
    local name, player, t = entry.opts.Name, entry.player, entry.target
    if type(name) == "string" then return name end
    if type(name) == "function" then
        local ok, text = pcall(name, t, player)
        return ok and tostring(text or "") or ""
    end
    if player then return player.DisplayName end
    return t.Name
end

local function entryHealth(entry)
    local o = entry.opts
    if o.GetHealth then
        local ok, hp, max = pcall(o.GetHealth, entry.target)
        if ok and hp then return hp, max or 100 end
        return nil
    end
    local hum = entry.humanoid
    if hum and hum.Parent then return hum.Health, hum.MaxHealth end
    return nil
end

local ctx = { viewport = Vector2.new(1280, 720), camPos = Vector3.new(0, 0, 0), mouse = Vector2.new(0, 0) }

local function styleComposite(item, o, color)
    local opts = item.Options
    opts.Color = color
    opts.Thickness = o.Thickness
    opts.Outline = o.Outline
    opts.Transparency = o.Transparency
    item:_style()
end

local InfoLine = {}
InfoLine.__index = InfoLine

local function newInfoLine()
    return setmetatable({
        Options = {},
        Parts = {},
        Text = "",
        Visible = false,
        _lastHp = nil,
        _lastDist = nil,
        _lastHpColor = nil,
        _lastDistColor = nil,
        _lastSize = nil,
        _widths = {},
        _totalW = 0,
        _segCount = 0,
    }, InfoLine)
end

function InfoLine:Update(hasHp, hpVal, hpColor, hasDist, distVal, distColor, cx, y, o)
    local changed = (self._lastHp ~= hpVal) or (self._lastDist ~= distVal)
        or (self._lastHpColor ~= hpColor) or (self._lastDistColor ~= distColor)
        or (self._lastSize ~= o.TextSize)

    if changed then
        self._lastHp = hpVal
        self._lastDist = distVal
        self._lastHpColor = hpColor
        self._lastDistColor = distColor
        self._lastSize = o.TextSize

        local segCount = 0
        if hasHp and hasDist then
            segCount = 3
            self._seg1Text = string.format("%dHP", hpVal)
            self._seg1Color = hpColor
            self._seg2Text = " | "
            self._seg2Color = o.BracketColor or Color3.fromRGB(255, 255, 255)
            self._seg3Text = string.format("%dM", distVal)
            self._seg3Color = distColor
            self.Text = self._seg1Text .. " | " .. self._seg3Text
        elseif hasHp then
            segCount = 1
            self._seg1Text = string.format("%dHP", hpVal)
            self._seg1Color = hpColor
            self.Text = self._seg1Text
        else
            segCount = 1
            self._seg1Text = string.format("%dM", distVal)
            self._seg1Color = distColor
            self.Text = self._seg1Text
        end
        self._segCount = segCount

        local totalW = 0
        for i = 1, segCount do
            local label = self.Parts[i]
            if not label then
                label = Draw.acquire("Text", { Center = false, Outline = o.Outline ~= false })
                self.Parts[i] = label
            end
            local t = (i == 1 and self._seg1Text) or (i == 2 and self._seg2Text) or self._seg3Text
            local c = (i == 1 and self._seg1Color) or (i == 2 and self._seg2Color) or self._seg3Color
            label.Text = t
            label.Size = o.TextSize
            label.Color = c
            label.Outline = o.Outline ~= false
            label.Transparency = o.Transparency
            local w = label.TextBounds.X
            self._widths[i] = w
            totalW = totalW + w
        end
        self._totalW = totalW

        for i = segCount + 1, #self.Parts do
            Draw.release(self.Parts[i])
            self.Parts[i] = nil
            self._widths[i] = nil
        end
    end

    local curX = cx - self._totalW / 2
    for i = 1, self._segCount do
        local label = self.Parts[i]
        label.Position = Vector2.new(math.floor(curX + 0.5), y)
        label.Visible = true
        curX = curX + self._widths[i]
    end
    self.Visible = true
end

function InfoLine:SetVisible(vis)
    self.Visible = vis == true
    for _, part in ipairs(self.Parts) do
        part.Visible = self.Visible
    end
end

function InfoLine:Remove()
    for _, part in ipairs(self.Parts) do
        Draw.release(part)
    end
    table.clear(self.Parts)
    table.clear(self._widths)
    self.Visible = false
    self.Text = ""
    self._lastHp = nil
    self._lastDist = nil
    self._lastHpColor = nil
    self._lastDistColor = nil
    self._lastSize = nil
    self._segCount = 0
    self._totalW = 0
end

local function text(entry, key, value, position, color, o, restyle)
    local label = entry[key]
    if not label then
        label = Draw.acquire("Text", { Center = true, Outline = true })
        entry[key] = label
        restyle = true
    end
    if restyle then
        label.Size = o.TextSize
        label.Color = color
        label.Outline = o.Outline
        label.Transparency = o.Transparency
    end
    local txtKey = key .. "_txt"
    if entry[txtKey] ~= value then
        entry[txtKey] = value
        label.Text = value
    end
    label.Position = position
    label.Visible = true
end

local function styleChanged(entry, o, color)
    local boxColor = o.BoxColor or color
    local tracerColor = o.TracerColor or color
    local skelColor = o.SkeletonColor or color
    if entry.sColor == color and entry.sBoxColor == boxColor and entry.sTracerColor == tracerColor
        and entry.sSkelColor == skelColor and entry.sThickness == o.Thickness and entry.sOutline == o.Outline
        and entry.sTransparency == o.Transparency and entry.sTextSize == o.TextSize then
        return false
    end
    entry.sColor, entry.sBoxColor, entry.sTracerColor, entry.sSkelColor = color, boxColor, tracerColor, skelColor
    entry.sThickness, entry.sOutline = o.Thickness, o.Outline
    entry.sTransparency, entry.sTextSize = o.Transparency, o.TextSize
    return true
end

local NAME_INTERVAL = 2.5
local function cachedName(entry, now)
    local name = entry.opts.Name
    if type(name) == "string" then return name end
    if entry.nameValue == nil or now >= (entry.nextName or 0) then
        entry.nameValue = entryName(entry)
        entry.nextName = now + NAME_INTERVAL
    end
    return entry.nameValue
end

local sharedSkelPool = {}
for i = 1, 64 do
    sharedSkelPool[i] = { Vector2.new(0, 0), Vector2.new(0, 0) }
end
local sharedNodeCache = {}

local VEC_NECK = Vector3.new(0, 1.0, 0)
local VEC_PELVIS = Vector3.new(0, -1.0, 0)
local VEC_ARM_TOP = Vector3.new(0, 0.8, 0)
local VEC_ARM_BOT = Vector3.new(0, -0.9, 0)
local VEC_LEG_TOP = Vector3.new(0, 0.9, 0)
local VEC_LEG_BOT = Vector3.new(0, -0.9, 0)

local r6ScreenPts = {}
for i = 1, 15 do r6ScreenPts[i] = false end

local R6_BONES = {
    { 1, 2 },   -- Head -> Neck
    { 2, 3 },   -- Neck -> Pelvis (Spine)
    { 2, 4 },   -- Neck -> LShoulder (Clavicle)
    { 4, 5 },   -- LShoulder -> LElbow
    { 5, 6 },   -- LElbow -> LWrist
    { 2, 7 },   -- Neck -> RShoulder (Clavicle)
    { 7, 8 },   -- RShoulder -> RElbow
    { 8, 9 },   -- RElbow -> RWrist
    { 3, 10 },  -- Pelvis -> LHip
    { 10, 11 }, -- LHip -> LKnee
    { 11, 12 }, -- LKnee -> LAnkle
    { 3, 13 },  -- Pelvis -> RHip
    { 13, 14 }, -- RHip -> RKnee
    { 14, 15 }, -- RKnee -> RAnkle
}

local function updateEntry(entry, cam, now)
    local o, player = entry.opts, entry.player
    if player and ((ESP.CustomFilter and ESP.CustomFilter(player, entry.target) == false) or (o.CustomFilter and o.CustomFilter(player, entry.target) == false)) then
        entry.inRange = false
        return hide(entry)
    end
    if player and o.TeamCheck and sameTeam(player) then
        entry.inRange = false
        return hide(entry)
    end

    if player and player.Character ~= entry.target then
        removeEntry(entry)
        return
    end

    if o.AliveCheck ~= false then
        local hum = entry.humanoid
        if not hum and entry.target and entry.target:IsA("Model") then
            hum = entry.target:FindFirstChildOfClass("Humanoid")
            entry.humanoid = hum
        end
        if hum then
            if hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
                entry.inRange = false
                return hide(entry)
            end
        end
        local hp = entryHealth(entry)
        if hp and hp <= 0 then
            entry.inRange = false
            return hide(entry)
        end
    end

    local root = entry.root or (entry.isPart and entry.target) or (entry.target:IsA("Model") and (entry.target.PrimaryPart or entry.target:FindFirstChild("HumanoidRootPart")))
    if root and root.Parent then
        local rPos = root.Position
        local toCam = rPos - ctx.camPos
        local dist = toCam.Magnitude
        if dist > o.MaxDistance then
            entry.distance = dist
            entry.inRange = false
            return hide(entry)
        end
        if toCam:Dot(ctx.camLook) < -5 and dist > 15 then
            entry.distance = dist
            entry.inRange = true
            return hide(entry)
        end
    end

    local worldPos, boxPos, boxSize = measure(entry, cam, now)
    if not worldPos then
        entry.inRange = false
        return hide(entry)
    end
    local distance = (ctx.camPos - worldPos).Magnitude
    entry.distance = distance
    entry.inRange = distance <= o.MaxDistance
    if not entry.inRange or not boxPos or not onViewport(boxPos, boxSize, ctx.viewport) then
        return hide(entry)
    end

    local color = entryColor(entry)
    local restyle = styleChanged(entry, o, color)
    entry.shown = true
    if entry.highlight and restyle then styleHighlight(entry, color) end

    if o.Box then
        if entry.box and entry.boxStyle ~= o.BoxStyle then releaseElement(entry, "box") end
        if not entry.box then
            entry.box = (o.BoxStyle == "Corner") and Draw.CornerBox() or Draw.Box()
            entry.boxStyle = o.BoxStyle
            styleComposite(entry.box, o, o.BoxColor or color)
        elseif restyle then
            styleComposite(entry.box, o, o.BoxColor or color)
        end
        entry.box:Update(boxPos, boxSize)
        entry.box:SetVisible(true)
    elseif entry.box then
        releaseElement(entry, "box")
    end

    local skelMaxDist = o.SkeletonMaxDistance or 1000
    if o.Skeleton and distance <= skelMaxDist and (entry.useAnatomicalR6 or entry.skelEdges) then
        local skelColor = o.SkeletonColor or color
        if not entry.skel then
            entry.skel = Draw.Skeleton()
            styleComposite(entry.skel, o, skelColor)
        elseif restyle then
            styleComposite(entry.skel, o, skelColor)
        end

        local segCount = 0
        if entry.useAnatomicalR6 then
            local char = entry.target
            local head = entry.head or char:FindFirstChild("Head")
            local torso = char:FindFirstChild("Torso")
            local lArm = char:FindFirstChild("Left Arm")
            local rArm = char:FindFirstChild("Right Arm")
            local lLeg = char:FindFirstChild("Left Leg")
            local rLeg = char:FindFirstChild("Right Leg")

            if torso then
                local tCF = torso.CFrame
                if head then
                    local p = cam:WorldToViewportPoint(head.Position)
                    r6ScreenPts[1] = (p.Z > 0) and Vector2.new(p.X, p.Y) or false
                else
                    r6ScreenPts[1] = false
                end
                local pNeck = cam:WorldToViewportPoint(tCF * VEC_NECK)
                r6ScreenPts[2] = (pNeck.Z > 0) and Vector2.new(pNeck.X, pNeck.Y) or false
                local pPelvis = cam:WorldToViewportPoint(tCF * VEC_PELVIS)
                r6ScreenPts[3] = (pPelvis.Z > 0) and Vector2.new(pPelvis.X, pPelvis.Y) or false

                if lArm then
                    local lCF = lArm.CFrame
                    local p1 = cam:WorldToViewportPoint(lCF * VEC_ARM_TOP)
                    r6ScreenPts[4] = (p1.Z > 0) and Vector2.new(p1.X, p1.Y) or false
                    local p2 = cam:WorldToViewportPoint(lArm.Position)
                    r6ScreenPts[5] = (p2.Z > 0) and Vector2.new(p2.X, p2.Y) or false
                    local p3 = cam:WorldToViewportPoint(lCF * VEC_ARM_BOT)
