        TextTruncate = Enum.TextTruncate.AtEnd,
        Visible = false,
        Theme = { TextColor3 = "SubText" },
        LayoutOrder = 3,
        Parent = body,
    })

    local defaultButtonText = data.ButtonText or data.LoginText or data.VerifyText or "Login"
    local verify = New("TextButton", {
        Name = "Verify",
        Size = UDim2.new(1, 0, 0, 32),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Text = "",
        Corner = 5,
        LayoutOrder = 4,
        Parent = body,
    })
    Theme.gradient(verify, -100)

    local verifyLabel = New("TextLabel", {
        Name = "ButtonLabel",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        Text = defaultButtonText,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
        FontFace = Library.Fonts.Bold,
        TextColor3 = Color3.fromRGB(255, 255, 255),
        Parent = verify,
    })

    local links = {}
    if data.KeyLink or data.keylink then
        table.insert(links, { Name = "Get key", Url = data.KeyLink or data.keylink })
    end
    for _, link in ipairs(data.Links or data.links or {}) do
        table.insert(links, { Name = link.Name or link.name or "Link", Url = link.Url or link.url or "" })
    end

    if #links > 0 then
        local row = New("Frame", {
            Name = "Links",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 28),
            List = { Padding = 8, Horizontal = true, HFlex = Enum.UIFlexAlignment.Fill, VAlign = Enum.VerticalAlignment.Center },
            LayoutOrder = 3,
            Parent = root,
        })
        for index, link in ipairs(links) do
            local button = New("TextButton", {
                Size = UDim2.new(0, 100, 1, 0),
                Translate = { Text = link.Name },
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Center,
                Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
                Corner = 6,
                LayoutOrder = index,
                Parent = row,
            })
            Base.hoverBackground(button)
            button.Activated:Connect(function()
                prompt:CopyText(link.Url, link.Name)
            end)
        end
        prompt.Items.Links = { Instance = row }
    end

    local checking = false

    local function setStatus(text, kind)
        Locale.bind(status, "Text", text or "")
        Theme.bind(status, { TextColor3 = (kind == "error" and "Danger") or (kind == "success" and "Accent") or "SubText" })
        status.Visible = status.Text ~= ""
    end
    prompt.SetStatus = function(_, text, kind) setStatus(text, kind) end

    local function setBusy(busy)
        checking = busy
        verify.Interactable = not busy
        if autoVerifyHitbox then
            autoVerifyHitbox.Interactable = not busy
        end
        verifyLabel.Text = busy and (Locale.t("Checking key") or "Checking key") or defaultButtonText
        Tween.play(verify, { BackgroundTransparency = busy and 0.35 or 0 }, 0.12)
    end

    local function renderAutoVerify(animate)
        if not showAutoVerify then return end
        local on = autoVerify == true
        if animate and Library.Animations then
            Tween.play(autoVerifyFill, { BackgroundTransparency = on and 0 or 1 }, 0.12)
            Base.fadeCheck(autoVerifyCheckBars, on and 0 or 1, 0.12)
            Tween.play(autoVerifyLabel, { TextTransparency = on and 0 or 0.35 }, 0.12)
        else
            autoVerifyFill.BackgroundTransparency = on and 0 or 1
            Base.fadeCheck(autoVerifyCheckBars, on and 0 or 1, 0)
            autoVerifyLabel.TextTransparency = on and 0 or 0.35
        end
    end

    local function setAutoVerify(value)
        autoVerify = value and true or false
        prompt.AutoVerify = autoVerify
        prompt.AutoLogin = autoVerify
        renderAutoVerify(true)
        if saveKey then
            Util.FS.ensureFolder(Library.Folders.Configs)
            Util.FS.write(autoVerifyPath, autoVerify and "1" or "0")
            if legacyAutoVerifyPath and legacyAutoVerifyPath ~= autoVerifyPath then
                Util.FS.delete(legacyAutoVerifyPath)
            end
        end
    end

    if showAutoVerify then
        autoVerifyHitbox.Activated:Connect(function()
            if checking then return end
            setAutoVerify(not autoVerify)
        end)

        Base.hover(autoVerifyHitbox, function()
            if not autoVerify and not checking then
                Tween.play(autoVerifyLabel, { TextTransparency = 0.15 }, 0.12)
                Tween.play(autoVerifyBox, { BackgroundColor3 = Library.Theme["Element Hover"] }, 0.12)
            end
        end, function()
            if not autoVerify and not checking then
                Tween.play(autoVerifyLabel, { TextTransparency = 0.35 }, 0.12)
                Tween.play(autoVerifyBox, { BackgroundColor3 = Library.Theme["Element"] }, 0.12)
            end
        end)
    end

    local function shake()
        if not Library.Animations then return end
        local base = root.Position
        task.spawn(function()
            for _, dx in ipairs({ 9, -7, 5, -3, 0 }) do
                Tween.play(root, { Position = UDim2.new(base.X.Scale, base.X.Offset + dx, base.Y.Scale, base.Y.Offset) }, 0.045)
                task.wait(0.045)
            end
            Tween.set(root, { Position = base })
        end)
    end

    function prompt:CopyText(text, label)
        if not ClipboardSet then
            setStatus("Clipboard not supported", "error")
            return false
        end
        pcall(ClipboardSet, tostring(text or ""))
        setStatus((label and (label .. ": ") or "") .. Locale.t("Copied"), "info")
        return true
    end

    function prompt:Attempt(key)
        if checking then return end
        key = trim(key)
        if key == "" then
            setStatus("Enter your key", "error")
            shake()
            return
        end
        setBusy(true)
        setStatus("Checking key", "info")
        local info = {
            HWID = Util.hwid(),
            PlaceId = game.PlaceId,
            GameId = game.GameId,
            JobId = game.JobId,
        }
        task.spawn(function()
            local ok, message, keepSaved
            local ran, err = pcall(function()
                ok, message, keepSaved = verifier(key, info)
            end)
            if not ran then
                warn("[B3] key verify error: " .. tostring(err))
                ok, message, keepSaved = false, "Verification failed", true
            end
            if prompt.Closed then return end
            setBusy(false)
            if ok then
                prompt.Verified = true
                prompt.Key = key
                if saveKey then
                    Util.FS.ensureFolder(Library.Folders.Configs)
                    Util.FS.write(savePath, encodeSavedKey(key))
                    if showAutoVerify then
                        Util.FS.write(autoVerifyPath, autoVerify and "1" or "0")
                    end
                end
                setStatus(message or "Key verified", "success")
                task.wait(0.35)
                prompt:Close()
                Library._ensureIdentity(true)
                Util.callback(data.Callback or data.callback, key)
            else
                if saveKey and not keepSaved then
                    Util.FS.delete(savePath)
                    if showAutoVerify then
                        Util.FS.delete(autoVerifyPath)
                        setAutoVerify(false)
                    end
                end
                setStatus(message or "Invalid key", "error")
                shake()
                Util.callback(data.OnFail or data.onfail, message or "Invalid key")
            end
        end)
    end

    function prompt:Set(key)
        input.Text = tostring(key or "")
    end

    local function targetScale()
        local view = Gui.viewport()
        local natural = root.AbsoluteSize.Y / math.max(scale.Scale, 0.01)
        if natural <= 0 then natural = 240 end
        local fit = math.min(tonumber(Library.Flags.UIScale) or 1,
            (view.X - 24) / WIDTH, (view.Y - 24) / natural)
        return math.max(0.4, math.floor(fit * 100) / 100)
    end

    function prompt:Close()
        if self.Closed then return end
        self.Closed = true
        local genv = (typeof(getgenv) == "function") and getgenv() or _G
        if genv._B3_ACTIVE_KEYPROMPT == self then genv._B3_ACTIVE_KEYPROMPT = nil end
        if genv._B3_KEYPROMPT_ROOT == root then genv._B3_KEYPROMPT_ROOT = nil end
        Tween.slide(root, root.Position, UDim2.new(0.5, 0, 0.5, 8), 0.12, function()
            root.Visible = false
            root:Destroy()
        end)
    end

    function prompt:Destroy()
        if self.Closed then return end
        self.Closed = true
        local genv = (typeof(getgenv) == "function") and getgenv() or _G
        if genv._B3_ACTIVE_KEYPROMPT == self then genv._B3_ACTIVE_KEYPROMPT = nil end
        if genv._B3_KEYPROMPT_ROOT == root then genv._B3_KEYPROMPT_ROOT = nil end
        root:Destroy()
    end

    verify.Activated:Connect(function()
        prompt:Attempt(input.Text)
    end)
    input.FocusLost:Connect(function(enterPressed)
        if enterPressed then prompt:Attempt(input.Text) end
    end)
    if paste then
        paste.Activated:Connect(function()
            local ok, text = pcall(ClipboardGet)
            if ok and type(text) == "string" and text ~= "" then
                input.Text = trim(text)
            else
                setStatus("Clipboard is empty", "error")
            end
        end)
    end
    close.Activated:Connect(function()
        prompt:Close()
        if data.OnClose or data.onclose then
            Util.callback(data.OnClose or data.onclose)
        else
            Library:Unload()
        end
    end)
    Base.hover(close, function()
        Theme.bind(close, { TextColor3 = "Danger" })
    end, function()
        Theme.bind(close, { TextColor3 = "SubText" })
    end)

    local dragStart
    Library.Maid:Give(Input.drag(brand, {
        onStart = function()
            dragStart = root.Position
        end,
        onMove = function(delta)
            root.Position = UDim2.new(
                dragStart.X.Scale, dragStart.X.Offset + delta.X,
                dragStart.Y.Scale, dragStart.Y.Offset + delta.Y
            )
        end,
    }))

    Library.Maid:Give(root)

    prompt.Root = root
    prompt.Items.Root = { Instance = root }
    prompt.Items.Brand = { Instance = brand }
    prompt.Items.Card = { Instance = card }
    prompt.Items.Input = { Instance = input }
    prompt.Items.Verify = { Instance = verify }
    prompt.Items.Status = { Instance = status }
    prompt.Items.Close = { Instance = close }
    prompt.Items.Title = { Instance = title }
    if paste then prompt.Items.Paste = { Instance = paste } end
    if showAutoVerify then
        prompt.Items.AutoLogin = { Instance = autoVerifyRow, Box = autoVerifyBox, Fill = autoVerifyFill, Label = autoVerifyLabel }
        prompt.Items.AutoVerify = prompt.Items.AutoLogin
    end
    prompt.AutoVerify = autoVerify
    prompt.AutoLogin = autoVerify
    prompt.SetAutoVerify = function(_, val) setAutoVerify(val) end
    prompt.SetAutoLogin = prompt.SetAutoVerify
    Library.KeyPrompt = prompt
    genv._B3_ACTIVE_KEYPROMPT = prompt
    genv._B3_KEYPROMPT_ROOT = root

    root.Visible = true
    local shown = targetScale()
    Tween.set(scale, { Scale = shown })
    Tween.slide(root, UDim2.new(0.5, 0, 0.5, 10), UDim2.fromScale(0.5, 0.5), 0.2)

    task.delay(0.2, function()
        if not prompt.Closed and root.Parent then
            Tween.set(scale, { Scale = targetScale() })
        end
    end)

    Library.Maid:Give(Gui.Main:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        if not prompt.Closed then Tween.set(scale, { Scale = targetScale() }) end
    end))

    if saveKey then
        local decodedOk, decodedKey = pcall(decodeSavedKey, trim(Util.FS.read(savePath)))
        local saved = trim(decodedOk and decodedKey or "")
        if saved ~= "" then
            input.Text = saved
            if autoVerify or data.ResumeSession == true then
                prompt:Attempt(saved)
            end
        end
    end

    return prompt
end

function Library:GetHWID()
    return Util.hwid()
end

return true
]]

__sources["components/KeyValue"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

function Section:KeyValue(data)
    if type(data) == "string" then
        data = { Key = data, Value = "" }
    end
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local keyText = data.Key or data.key or data.Name or data.name or ""
    local valText = data.Value or data.value or ""

    local kvObj = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Key = keyText,
        Value = valText,
        Items = {},
    }

    local row = Base.row(container, 24, {
        AutomaticSize = Enum.AutomaticSize.Y,
    })

    local valLabel = New("TextLabel", {
        Name = "Value",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0, 0, 0, 20),
        AutomaticSize = Enum.AutomaticSize.X,
        Text = tostring(valText),
        TextSize = 14,
        FontFace = Library.Fonts.Regular,
        Theme = (typeof(data.Color) ~= "Color3") and { TextColor3 = (type(data.Color) == "string" and data.Color) or (data.Badge and "Accent" or "SubText") } or nil,
        TextColor3 = typeof(data.Color) == "Color3" and data.Color or nil,
        TextTruncate = Enum.TextTruncate.None,
        TextXAlignment = Enum.TextXAlignment.Right,
        Parent = row,
    })

    local keyLabel = New("TextLabel", {
        Name = "Key",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.new(1, -100, 0, 20),
        [translate and "Translate" or "Text"] = translate and { Text = tostring(keyText) } or tostring(keyText),
        TextSize = 14,
        FontFace = Library.Fonts.Regular,
        Theme = { TextColor3 = "Text" },
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextXAlignment = Enum.TextXAlignment.Left,
        Parent = row,
    })

    local function updateKeyWidth()
        local valW = valLabel.AbsoluteSize.X / math.max(Library.PopupScale or 1, 0.01)
        keyLabel.Size = UDim2.new(1, -(valW + 8), 0, 20)
    end
    valLabel:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateKeyWidth)
    task.defer(updateKeyWidth)

    function kvObj:Set(value, key, color)
        if value ~= nil then
            self.Value = tostring(value)
            valLabel.Text = self.Value
        end
        if key ~= nil then
            self.Key = tostring(key)
            if translate then
                Locale.bind(keyLabel, "Text", self.Key)
            else
                keyLabel.Text = self.Key
            end
        end
        if color ~= nil then
            if typeof(color) == "Color3" then
                Theme.unbind(valLabel, "TextColor3")
                valLabel.TextColor3 = color
            elseif type(color) == "string" then
                Theme.bind(valLabel, { TextColor3 = color })
            end
        end
    end

    function kvObj:SetValue(value, color)
        self:Set(value, nil, color)
    end

    kvObj.Items = { Row = { Instance = row }, Key = { Instance = keyLabel }, Value = { Instance = valLabel } }
    Base.finish(kvObj, container, row, data)
    return kvObj
end

return Section
]]

__sources["components/Label"] = [[
local Library = require("core/Library")
local New = require("core/Create")
local Base = require("components/Base")
local Locale = require("core/Locale")
local Colorpicker = require("components/Colorpicker")

local Section = Library.SectionClass

function Section:Label(text, data)
    if type(text) == "table" then
        data = text
        text = data.Text or data.Name or data.name or "Label"
    end
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local labelObj = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = tostring(text or "Label"),
    }

    local row = Base.row(container, 18, { AutomaticSize = Enum.AutomaticSize.Y })

    local right = New("Frame", {
        Name = "Right",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 1),
        Size = UDim2.fromOffset(0, 16),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        List = { Padding = 6, Horizontal = true, HAlign = Enum.HorizontalAlignment.Right, VAlign = Enum.VerticalAlignment.Center },
        Parent = row,
    })

    local label = Base.text(row, labelObj.Name, {
        Size = UDim2.new(1, 0, 0, 18),
        AutomaticSize = Enum.AutomaticSize.Y,
        TextWrapped = true,
        RichText = true,
        TextXAlignment = data.Center and Enum.TextXAlignment.Center or Enum.TextXAlignment.Left,
    }, translate)

    right:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        local s = math.max(Library.PopupScale or 1, 0.01)
        local w = right.AbsoluteSize.X / s
        label.Size = UDim2.new(1, w > 0 and -(w + 8) or 0, 0, 18)
    end)

    labelObj.Items = { Label = { Instance = row }, Text = { Instance = label } }

    function labelObj:SetText(newText)
        self.Name = tostring(newText)
        Locale.setText(label, "Text", self.Name)
    end

    function labelObj:Colorpicker(pickerData)
        pickerData = pickerData or {}
        return Base.maid(labelObj):Give(Colorpicker.new({
            Parent = right,
            Size = UDim2.fromOffset(28, 14),
            Flag = pickerData.Flag or pickerData.flag,
            Default = pickerData.Default or pickerData.default,
            Alpha = pickerData.Alpha or pickerData.alpha,
            Callback = pickerData.Callback or pickerData.callback,
            PopupParent = container.PopupOwner,
        }))
    end

    function labelObj:RefreshPosition() end

    return Base.finish(labelObj, container, row, data)
end

return true
]]

__sources["components/LogBox"] = [[
local Library = require("core/Library")
local New = require("core/Create")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local KIND_COLOR = {
    Info = "Text",
    Success = "Success",
    Warning = "Warning",
    Error = "Danger",
}

local function escape(text)
    text = string.gsub(text, "&", "&amp;")
    text = string.gsub(text, "<", "&lt;")
    text = string.gsub(text, ">", "&gt;")
    return text
end

local function hex(color)
    return string.format("#%02X%02X%02X", math.floor(color.R * 255 + 0.5), math.floor(color.G * 255 + 0.5), math.floor(color.B * 255 + 0.5))
end

local function clock()
    local ok, text = pcall(os.date, "%H:%M:%S")
    return ok and type(text) == "string" and text or ""
end

function Section:LogBox(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local log = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Log"),
        Max = math.max(tonumber(Base.opt(data, "Max", 100)) or 100, 1),
        Lines = {},
    }
    local showTime = Base.opt(data, "Time", true) ~= false
    local height = math.max(tonumber(Base.opt(data, "Height", 130)) or 130, 60)

    local row = Base.row(container, height + 24)
    local label = Base.text(row, log.Name, {
        Size = UDim2.new(1, -100, 0, 16),
        TextSize = 14,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)

    local actions = New("Frame", {
        Name = "Actions",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, -1),
        Size = UDim2.fromOffset(100, 18),
        BackgroundTransparency = 1,
        List = { Padding = 4, Horizontal = true, HAlign = Enum.HorizontalAlignment.Right, VAlign = Enum.VerticalAlignment.Center },
        Parent = row,
    })
    local function action(text, order)
        local b = New("TextButton", {
            Name = text,
            Size = UDim2.fromOffset(0, 18),
            AutomaticSize = Enum.AutomaticSize.X,
            Translate = { Text = text },
            TextSize = 12,
            TextTransparency = 0.25,
            LayoutOrder = order,
            Padding = { Left = 6, Right = 6 },
            Corner = 4,
            Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
            Parent = actions,
        })
        Base.hoverBackground(b)
        return b
    end
    local copyButton = action("Copy", 1)
    local clearButton = action("Clear", 2)

    local box = New("Frame", {
        Name = "Box",
        Position = UDim2.fromOffset(0, 22),
        Size = UDim2.new(1, 0, 0, height),
        Theme = { BackgroundColor3 = "Element" },
        Corner = 5,
        Parent = row,
    })
    local scroll = New("ScrollingFrame", {
        Name = "Lines",
        Size = UDim2.fromScale(1, 1),
        ScrollBarThickness = 2,
        Theme = { ScrollBarImageColor3 = "Accent" },
        Padding = { Top = 5, Bottom = 5, Left = 8, Right = 8 },
        List = { Padding = 2 },
        Parent = box,
    })
    local empty = New("TextLabel", {
        Name = "Empty",
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, -16, 0, 16),
        TextXAlignment = Enum.TextXAlignment.Center,
        Translate = { Text = "Nothing here yet" },
        TextSize = 12,
        TextTransparency = 0.4,
        Theme = { TextColor3 = "SubText" },
        Parent = box,
    })

    local order = 0
    local function atBottom()
        local maxY = scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteSize.Y
        return maxY <= 0 or scroll.CanvasPosition.Y >= maxY - 8
    end

    local function lineText(entry)
        local color = Library.Theme[KIND_COLOR[entry.Kind] or "Text"] or Color3.new(1, 1, 1)
        local body = '<font color="' .. hex(color) .. '">' .. escape(entry.Text) .. "</font>"
        if showTime and entry.Time ~= "" then
            local sub = Library.Theme.SubText or Color3.fromRGB(160, 160, 170)
            body = '<font color="' .. hex(sub) .. '">' .. entry.Time .. "</font>  " .. body
        end
        return body
    end

    function log:Add(text, kind)
        if Library.Unloaded then return end
        kind = KIND_COLOR[kind] and kind or "Info"
        local stick = atBottom()
        order = order + 1
        local entry = { Text = tostring(text), Kind = kind, Time = showTime and clock() or "" }
        entry.Label = New("TextLabel", {
            Name = "Line",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            RichText = true,
            TextWrapped = true,
            TextSize = 12,
            TextTransparency = 0.05,
            LayoutOrder = order,
            Theme = { Text = function() return lineText(entry) end },
            Parent = scroll,
        })
        table.insert(self.Lines, entry)
        while #self.Lines > self.Max do
            local old = table.remove(self.Lines, 1)
            if old.Label then old.Label:Destroy() end
        end
        empty.Visible = false
        if stick then
            task.defer(function()
                if scroll.Parent then scroll.CanvasPosition = Vector2.new(0, math.max(scroll.AbsoluteCanvasSize.Y, 0) + 1000) end
            end)
        end
        return entry
    end

    function log:Clear()
        for _, entry in ipairs(self.Lines) do
            if entry.Label then entry.Label:Destroy() end
        end
        table.clear(self.Lines)
        empty.Visible = true
    end

    function log:GetLines()
        local out = {}
        for _, entry in ipairs(self.Lines) do
            local prefix = entry.Time ~= "" and (entry.Time .. " ") or ""
            table.insert(out, prefix .. "[" .. entry.Kind .. "] " .. entry.Text)
        end
        return out
    end

    function log:Copy()
        local text = table.concat(self:GetLines(), "\n")
        if typeof(setclipboard) == "function" then
            pcall(setclipboard, text)
            Library:Notification({ Title = Locale.t("Copied"), Description = tostring(#self.Lines) .. " " .. Locale.t("lines"), Duration = 2 })
            return true
        end
        Library:Notification({ Title = Locale.t("Copy"), Description = Locale.t("Your executor cannot copy text"), Duration = 3, Type = "Warning" })
        return false
    end

    function log:SetText(text)
        self.Name = tostring(text)
        Locale.setText(label, "Text", self.Name)
    end

    copyButton.Activated:Connect(function() log:Copy() end)
    clearButton.Activated:Connect(function() log:Clear() end)
    log.Items = { LogBox = { Instance = row }, Text = { Instance = label }, Lines = { Instance = scroll }, Copy = { Instance = copyButton }, Clear = { Instance = clearButton } }
    return Base.finish(log, container, row, data)
end

return true
]]

__sources["components/Notification"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Gui = require("core/Gui")
local Locale = require("core/Locale")

local DEFAULT_ICON = "73789337996373"
local WIDTH = 260
local MAX_VISIBLE = 6

local holder
local side = "Right"
local active = {}

local function getHolder()
    if holder then return holder end
    Gui.init()
    holder = New("Frame", {
        Name = "Notifications",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -12, 0, 12),
        Size = UDim2.new(0, WIDTH, 1, -24),
        BackgroundTransparency = 1,
        List = { Padding = 8, VAlign = Enum.VerticalAlignment.Top },
        Parent = Gui.Top,
    })
    Gui.scaleWith(holder)
    return holder
end

function Library:SetNotificationSide(value)
    side = (value == "Left") and "Left" or "Right"
    local h = getHolder()
    if side == "Left" then
        h.AnchorPoint = Vector2.new(0, 0)
        h.Position = UDim2.new(0, 12, 0, 12)
    else
        h.AnchorPoint = Vector2.new(1, 0)
        h.Position = UDim2.new(1, -12, 0, 12)
    end
end

local TYPE_COLORS = { Success = "Success", Warning = "Warning", Error = "Danger", Danger = "Danger" }

function Library:Notification(data)
    Library._ensureIdentity(true)
    if type(data) == "string" then data = { Title = data } end
    data = data or {}
    if Library.Unloaded then return end
    local parent = getHolder()
    local rawDuration = data.Duration
    if rawDuration == nil then rawDuration = data.Time end
    local persistent = rawDuration == false or rawDuration == 0
    local duration = persistent and 0 or (tonumber(rawDuration) or 3)
    local typeKey = TYPE_COLORS[data.Type or ""]

    if #active >= MAX_VISIBLE then
        for _, h in ipairs(active) do
            if not h.Persistent then h:Close(false) break end
        end
        if #active >= MAX_VISIBLE and active[1] then active[1]:Close(false) end
    end

    local wrapper = New("Frame", {
        Name = "Notification",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = math.floor(os.clock() * 1000) % 2000000000,
        Parent = parent,
    })

    local card = New("TextButton", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Position = UDim2.fromOffset(side == "Left" and -(WIDTH + 20) or (WIDTH + 20), 0),
        BackgroundTransparency = 0.05,
        Theme = { BackgroundColor3 = "Background" },
        Corner = 6,
        Padding = { Top = 10, Bottom = 14, Left = 12, Right = 12 },
        Parent = wrapper,
    })
    local stroke = New("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 1, Transparency = 0.5, Parent = card })
    Theme.bind(stroke, { Color = typeKey or "Outline" })

    local window = Library.MainWindow
    local logo = (not data.Icon) and window and window.Logo or nil
    local icon = New("ImageLabel", {
        Position = UDim2.fromOffset(0, 1),
        Size = UDim2.fromOffset(16, 16),
        ScaleType = Enum.ScaleType.Fit,
        Image = Util.asset(data.Icon or logo or DEFAULT_ICON),
        Parent = card,
    })
    if data.IconColor and data.IconColor.Start then
        New("UIGradient", {
            Rotation = -115,
            Color = ColorSequence.new(data.IconColor.Start, data.IconColor.End or data.IconColor.Start),
            Parent = icon,
        })
    elseif typeKey then
        Theme.bind(icon, { ImageColor3 = typeKey })
    elseif not logo or window.LogoGradient then
        Theme.gradient(icon)
    end

    local closable = data.Closable ~= false
    local text = New("Frame", {
        Position = UDim2.fromOffset(24, 0),
        Size = UDim2.new(1, closable and -44 or -24, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        List = { Padding = 3 },
        Parent = card,
    })

    if data.App and data.App ~= "" then
        New("TextLabel", {
            Name = "App",
            Size = UDim2.new(1, 0, 0, 11),
            Text = string.upper(Locale.t(tostring(data.App))),
            TextSize = 10,
            FontFace = Library.Fonts.SemiBold,
            LayoutOrder = 0,
            Theme = { TextColor3 = "SubText" },
            Parent = text,
        })
    end

    local titleLabel = New("TextLabel", {
        Name = "Title",
        Size = UDim2.new(1, 0, 0, 16),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = Locale.t(tostring(data.Title or "Notification")),
        TextWrapped = true,
        LayoutOrder = 1,
        Theme = { TextColor3 = "Text" },
        Parent = text,
    })

    local descLabel = New("TextLabel", {
        Name = "Description",
        Size = UDim2.new(1, 0, 0, 14),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = Locale.t(tostring(data.Description or "")),
        TextSize = 13,
        TextWrapped = true,
        RichText = data.RichText == true,
        LayoutOrder = 2,
        Visible = data.Description ~= nil and data.Description ~= "",
        Theme = { TextColor3 = "SubText" },
        Parent = text,
    })

    local handle = { Closed = false, Persistent = persistent, Instance = wrapper }

    if type(data.Buttons) == "table" and #data.Buttons > 0 then
        local buttonBar = New("Frame", {
            Name = "Buttons",
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
            LayoutOrder = 3,
            List = { Padding = 6, Horizontal = true, HFlex = Enum.UIFlexAlignment.Fill },
            Parent = text,
        })
        for i, info in ipairs(data.Buttons) do
            local b = New("TextButton", {
                Size = UDim2.new(0, 0, 1, 0),
                LayoutOrder = i,
                Text = Locale.t(tostring(info.Name or info[1] or "OK")),
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Center,
                Theme = { BackgroundColor3 = "Element", TextColor3 = info.Danger and "Danger" or "Text" },
                Corner = 4,
                Parent = buttonBar,
            })
            b.Activated:Connect(function()
                Util.callback(info.Callback or info[2], handle)
                if info.KeepOpen ~= true then handle:Close(true) end
            end)
        end
    end

    if closable then
        local closeButton = New("TextButton", {
            Name = "Close",
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, 4, 0, -4),
            Size = UDim2.fromOffset(22, 22),
            BackgroundTransparency = 1,
            Text = "\u{00D7}",
            TextSize = 18,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTransparency = 0.4,
            Theme = { TextColor3 = "SubText" },
            Parent = card,
        })
        closeButton.Activated:Connect(function() handle:Close(true) end)
        handle.CloseButton = closeButton
    end

    local bar = New("Frame", {
        Name = "Timer",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, 10),
        Size = UDim2.new(1, 0, 0, 2),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Corner = UDim.new(1, 0),
        Visible = not persistent,
        Parent = card,
    })
    if typeKey then
        Theme.bind(bar, { BackgroundColor3 = typeKey })
    else
        Theme.gradient(bar, 0)
    end

    table.insert(active, handle)
    local timerToken = 0

    function handle:Close(fromUser)
        if self.Closed then return end
        self.Closed = true
        timerToken = timerToken + 1
        local index = table.find(active, self)
        if index then table.remove(active, index) end
        Tween.play(card, { Position = UDim2.fromOffset(side == "Left" and -(WIDTH + 20) or (WIDTH + 20), 0) }, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        task.delay(Library.Animations and 0.21 or 0, function()
            wrapper:Destroy()
        end)
        Util.callback(data.Closed or data.OnClose, fromUser and true or false)
        if self.OnClosed then Util.callback(self.OnClosed, fromUser and true or false) end
    end

    local function startTimer(seconds)
        timerToken = timerToken + 1
        local mine = timerToken
        if not seconds or seconds <= 0 then
            bar.Visible = false
            handle.Persistent = true
            return
        end
        handle.Persistent = false
        bar.Visible = true
        Tween.set(bar, { Size = UDim2.new(1, 0, 0, 2) })
        Tween.play(bar, { Size = UDim2.new(0, 0, 0, 2) }, seconds, Enum.EasingStyle.Linear)
        task.delay(seconds, function()
            if timerToken == mine then handle:Close(false) end
        end)
    end

    function handle:Update(new)
        if self.Closed or type(new) ~= "table" then return end
        if new.Title ~= nil then titleLabel.Text = Locale.t(tostring(new.Title)) end
        if new.Description ~= nil then
            descLabel.Text = Locale.t(tostring(new.Description))
            descLabel.Visible = new.Description ~= ""
        end
        if new.Duration ~= nil then
            startTimer(new.Duration ~= false and tonumber(new.Duration) or 0)
        end
    end
    function handle:SetTitle(t) self:Update({ Title = t }) end
    function handle:SetDescription(t) self:Update({ Description = t }) end

    card.Activated:Connect(function()
        if data.Callback then
            Util.callback(data.Callback, handle)
            handle:Close(true)
        end
    end)

    Tween.play(card, { Position = UDim2.fromOffset(0, 0) }, 0.25, Enum.EasingStyle.Quint)
    startTimer(duration)
    return handle
end

function Library:ClearNotifications()
    for _, h in ipairs(table.clone(active)) do h:Close(false) end
end

Library.Maid:Give(function()
    holder = nil
    active = {}
end)

return true
]]

__sources["components/Page"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Popup = require("core/Popup")
local Locale = require("core/Locale")
local Config = require("core/Config")
local Tooltip = require("core/Tooltip")

local Page = {}
Page.__index = Page
Library.PageClass = Page
setmetatable(Library.Pages, { __index = Page })

local TAB_GLOW = NumberSequence.new({
    NumberSequenceKeypoint.new(0, 0.4),
    NumberSequenceKeypoint.new(0.45, 0.78),
    NumberSequenceKeypoint.new(0.75, 0.94),
    NumberSequenceKeypoint.new(1, 1),
})

function Library.WindowClass:Page(data)
    data = data or {}
    local window = self

    local page = setmetatable({
        Window = window,
        Name = data.Name or data.name or "Page",
        Icon = data.Icon or data.icon,
        Description = data.Description or data.description,
        Translate = data.Translate,
        Columns = math.max(1, data.Columns or data.columns or 2),
        Sections = {},
        SectionList = {},
        ColumnsData = {},
        Active = false,
        Items = {},
    }, Page)

    window._order = window._order + 1

    page.Category = window._category

    local group = data.Group
    page.Group = group
    if group then
        group._order = group._order + 1
        table.insert(group.Pages, page)
    end

    local tab = New("TextButton", {
        Name = "Tab",
        Size = UDim2.new(1, 0, 0, group and 30 or 36),
        BackgroundTransparency = 1,
        LayoutOrder = group and group._order or window._order,
        Theme = { BackgroundColor3 = "Accent" },
        Corner = 6,
        Parent = group and group.Content or window.Tabs,
    })
    New("UIGradient", { Transparency = TAB_GLOW, Parent = tab })

    local textX = 12
    local icon
    if page.Icon then
        icon = New("ImageLabel", {
            Name = "Icon",
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 11, 0.5, 0),
            Size = UDim2.fromOffset(18, 18),
            Image = Util.asset(page.Icon),
            ImageTransparency = 0.3,
            Parent = tab,
        })
        Theme.gradient(icon)
        textX = 38
    end

    local label = New("TextLabel", {
        Name = "Text",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, textX, 0.5, 0),
        Size = UDim2.new(1, -(textX + 6), 0, 16),
        [page.Translate and "Translate" or "Text"] = page.Translate and { Text = page.Name } or page.Name,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextTransparency = 0.35,
        Theme = { TextColor3 = "Text" },
        Parent = tab,
    })

    if not Library.IsMobile then
        tab.MouseEnter:Connect(function()
            if not page.Active then Tween.play(label, { TextTransparency = 0.1 }, 0.12) end
        end)
        tab.MouseLeave:Connect(function()
            if not page.Active then Tween.play(label, { TextTransparency = page._restTransparency or 0.35 }, 0.12) end
        end)
    end

    local holder = New("Frame", {
        Name = "Page",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Visible = false,
        Padding = 10,
        List = { Padding = 10, Horizontal = true, HFlex = Enum.UIFlexAlignment.Fill },
        Parent = window.Content,
    })

    for index = 1, page.Columns do
        local column = New("ScrollingFrame", {
            Name = "Column" .. index,
            Size = UDim2.new(0, 100, 1, 0),
            LayoutOrder = index,
            ScrollBarThickness = 2,
            ScrollBarImageTransparency = 1,
            VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
            Theme = { ScrollBarImageColor3 = "Accent" },
            Padding = { Top = 1, Bottom = 1, Left = 1, Right = 1 },
            List = { Padding = 10 },
            Parent = holder,
        })
        page.ColumnsData[index] = { Instance = column }

        local hideThread
        column:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
            if not column.Parent then return end
            Tween.play(column, { ScrollBarImageTransparency = 0.2 }, 0.15)
            if hideThread then
                task.cancel(hideThread)
            end
            hideThread = task.delay(0.8, function()
                if not Library.Unloaded and column and column.Parent then
                    Tween.play(column, { ScrollBarImageTransparency = 1 }, 0.35)
                end
            end)
        end)
    end

    page.Tab = tab
    page.Holder = holder
    page.Items = {
        Inactive = { Instance = tab },
        Icon = icon and { Instance = icon } or nil,
        Text = { Instance = label },
        Page = { Instance = holder },
    }

    tab.Activated:Connect(function()
        window:SelectPage(page)
    end)
    if window.Layout == "Topbar" and not group then
        page:_styleTab()
    end

    table.insert(window.Pages, page)
    if #window.Pages == 1 then
        page:Turn(true)
    end
    return page
end

local CHEVRON_IMAGE = "rbxassetid://123317177279443"

function Library.WindowClass:TabGroup(data)
    data = data or {}
    local window = self
    window._order = window._order + 1
    local translate = data.Translate

    local group = {
        Window = window,
        Name = data.Name or data.name or "Group",
        Icon = data.Icon or data.icon,
        Translate = translate,
        Pages = {},
        Collapsed = (data.Collapsed or data.collapsed) and true or false,
        _order = 0,
    }

    local holder = New("Frame", {
        Name = "TabGroup",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = window._order,
        List = { Padding = 2 },
        Parent = window.Tabs,
    })

    local header = New("TextButton", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 36),
        BackgroundTransparency = 1,
        LayoutOrder = 0,
        Theme = { BackgroundColor3 = "Element" },
        Corner = 6,
        Parent = holder,
    })
    local textX = 12
    local icon
    if group.Icon then
        icon = New("ImageLabel", {
            Name = "Icon",
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 11, 0.5, 0),
            Size = UDim2.fromOffset(18, 18),
            Image = Util.asset(group.Icon),
            ImageTransparency = 0.3,
            Parent = header,
        })
        Theme.gradient(icon)
        textX = 38
    end
    local label = New("TextLabel", {
        Name = "Text",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, textX, 0.5, 0),
        Size = UDim2.new(1, -(textX + 28), 0, 16),
        [translate and "Translate" or "Text"] = translate and { Text = group.Name } or group.Name,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextTransparency = 0.2,
        Theme = { TextColor3 = "Text" },
        Parent = header,
    })
    local chevron = New("ImageLabel", {
        Name = "Chevron",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -10, 0.5, 0),
        Size = UDim2.fromOffset(11, 6),
        Image = CHEVRON_IMAGE,
        ImageTransparency = 0.35,
        Rotation = group.Collapsed and -90 or 0,
        Theme = { ImageColor3 = "Text" },
        Parent = header,
    })

    local list = New("Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Visible = not group.Collapsed,
        Parent = holder,
    })
    New("Frame", {
        Name = "Guide",
        Position = UDim2.fromOffset(19, 2),
        Size = UDim2.new(0, 1, 1, -4),
        BackgroundTransparency = 0.4,
        Theme = { BackgroundColor3 = "Outline" },
        Parent = list,
    })
    local content = New("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(26, 0),
        Size = UDim2.new(1, -26, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        List = { Padding = 2 },
        Parent = list,
    })
    group.Content = content
    group.Holder = holder
    group.Items = {
        Header = { Instance = header }, Text = { Instance = label }, Icon = icon and { Instance = icon } or nil,
        Chevron = { Instance = chevron }, List = { Instance = list },
    }

    if not Library.IsMobile then
        header.MouseEnter:Connect(function()
            Tween.play(header, { BackgroundTransparency = 0.5 }, 0.12)
            Tween.play(chevron, { ImageTransparency = 0 }, 0.12)
        end)
        header.MouseLeave:Connect(function()
            Tween.play(header, { BackgroundTransparency = 1 }, 0.12)
            Tween.play(chevron, { ImageTransparency = 0.35 }, 0.12)
        end)
    end

    function group:SetCollapsed(collapsed)
        collapsed = collapsed and true or false
        self.Collapsed = collapsed
        Tween.play(chevron, { Rotation = collapsed and -90 or 0 }, 0.15)
        Tween.fold(list, not collapsed, 0.2, nil, function()
            return content.AbsoluteSize.Y
        end)
        local hasActive = false
        for _, p in ipairs(self.Pages) do
            if p.Active then hasActive = true end
        end
        Tween.play(label, { TextTransparency = (collapsed and hasActive) and 0 or 0.2 }, 0.15)
        if self.OnCollapse then Util.callback(self.OnCollapse, collapsed) end
    end
    function group:Toggle() self:SetCollapsed(not self.Collapsed) end
    function group:Page(pageData)
        pageData = pageData or {}
        pageData.Group = self
        if pageData.Translate == nil then pageData.Translate = self.Translate end
        return window:Page(pageData)
    end
    function group:SetText(text)
        self.Name = tostring(text)
        Locale.setText(label, "Text", self.Name)
    end
    function group:SetVisibility(visible)
        holder.Visible = visible and true or false
    end

    local menuPopup
    local function openMenu()
        if not menuPopup then
            local frame = New("Frame", {
                Name = "TabGroupMenu",
                Size = UDim2.fromOffset(180, 40),
                Theme = { BackgroundColor3 = "Popup" },
                Corner = 6,
                Padding = 4,
                List = { Padding = 2 },
            })
            menuPopup = Popup.new({ Frame = frame, Anchor = header, Gap = 4 })
            menuPopup.OnOpen = function()
                for _, child in ipairs(frame:GetChildren()) do
                    if child:IsA("TextButton") then child:Destroy() end
                end
                for i, p in ipairs(group.Pages) do
                    local b = New("TextButton", {
                        Size = UDim2.new(1, 0, 0, 28),
                        LayoutOrder = i,
                        Text = p.Translate and Locale.t(p.Name) or p.Name,
                        TextSize = 13,
                        TextTransparency = p.Active and 0 or 0.25,
                        BackgroundTransparency = p.Active and 0.72 or 1,
                        Theme = { BackgroundColor3 = "Accent", TextColor3 = "Text" },
                        Corner = 4,
                        Padding = { Left = 10 },
                        Parent = frame,
                    })
                    b.Activated:Connect(function()
                        menuPopup:Close()
                        window:SelectPage(p)
                    end)
                end
                frame.Size = UDim2.fromOffset(180, #group.Pages * 30 + 8)
            end
        end
        menuPopup:Toggle()
    end

    function group:_refreshActive()
        local hasActive = false
        for _, p in ipairs(self.Pages) do
            if p.Active then hasActive = true end
        end
        local topbar = window.Layout == "Topbar"
        if topbar then
            local compact = icon ~= nil and not hasActive
            window:_styleTab(header, label, 36, 26, compact, translate and Locale.t(self.Name) or self.Name, true)
            chevron.Visible = not compact
        else
            chevron.Visible = true
        end
        Tween.play(label, { TextTransparency = (hasActive and (self.Collapsed or topbar)) and 0 or 0.2 }, 0.15)
        Theme.bind(header, { BackgroundColor3 = (topbar and hasActive) and "Accent" or "Element" })
        Tween.play(header, { BackgroundTransparency = (topbar and hasActive) and 0.72 or 1 }, 0.15)
    end

    function group:_applyLayout()
        local topbar = window.Layout == "Topbar"
        holder.AutomaticSize = topbar and Enum.AutomaticSize.X or Enum.AutomaticSize.Y
        holder.Size = topbar and UDim2.new(0, 0, 0, 30) or UDim2.new(1, 0, 0, 0)
        window:_styleTab(header, label, 36, 26)
        chevron.Rotation = topbar and 0 or (self.Collapsed and -90 or 0)
        list.Visible = (not topbar) and not self.Collapsed
        if not topbar then
            list.AutomaticSize = Enum.AutomaticSize.Y
            list.Size = UDim2.new(1, 0, 0, 0)
        end
        if menuPopup and not topbar then menuPopup:Close() end
        self:_refreshActive()
    end

    header.Activated:Connect(function()
        if window.Layout == "Topbar" then
            openMenu()
        else
            group:Toggle()
        end
    end)
    if window.Layout == "Topbar" then group:_applyLayout() end

    window.TabGroups = window.TabGroups or {}
    table.insert(window.TabGroups, group)
    return group
end
Library.WindowClass.Group = Library.WindowClass.TabGroup

function Library.WindowClass:SelectPage(page)
    if type(page) == "string" then
        for _, p in ipairs(self.Pages) do
            if p.Name == page then page = p break end
        end
    end
    if type(page) ~= "table" or page.Active then return end
    Popup.closeAll()
    Tooltip.hide() -- the hovered row is on the page being hidden
    for _, p in ipairs(self.Pages) do
        if p ~= page and p.Active then
            p:Turn(false)
        end
    end
    page:Turn(true)
    if page.Group and page.Group.Collapsed and self.Layout ~= "Topbar" then
        page.Group:SetCollapsed(false)
    end
    if self._initialized and not Library.Unloaded then
        task.spawn(Config.setLastPage, page.Name)
    end
end

function Page:Turn(active)
    active = active and true or false
    local wasActive = self.Active
    self.Active = active
    self.Holder.Visible = active
    if active and not wasActive and self.Window._shown then
        Tween.slide(self.Holder, UDim2.fromOffset(0, 10), UDim2.fromOffset(0, 0), 0.2)
    end
    if active then
        self.Window.ActivePage = self
        self:_renderHeading()
        if self.Window.NoResults then
            self.Window.NoResults.Visible = false
        end
    end
    if self.Group and self.Group._refreshActive then self.Group:_refreshActive() end
    if not self.Group and self.Window.Layout == "Topbar" then self:_styleTab(true) end
    Tween.play(self.Tab, { BackgroundTransparency = active and 0.72 or 1 }, 0.15)
    Tween.play(self.Items.Text.Instance, { TextTransparency = active and 0 or (self._restTransparency or 0.35) }, 0.15)
    if self.Items.Icon then
        Tween.play(self.Items.Icon.Instance, { ImageTransparency = active and 0 or 0.3 }, 0.15)
    end
end

function Page:_renderHeading()
    local window = self.Window
    if not window.PageTitle or window.ActivePage ~= self then return end
    local function show(text, translate)
        text = tostring(text or "")
        return translate and Locale.t(text) or text
    end
    Locale.unbind(window.PageTitle, "Text")
    window.PageTitle.Text = show(self.Name, self.Translate)
    Locale.unbind(window.PageDescription, "Text")
    window.PageDescription.Text = ""
    window.PageDescription.Visible = false
    window.PageIcon.Visible = false

    local description = self.Description
    Tooltip.attach(window.PageInfo, description and description ~= "" and show(description, self.Translate) or nil)
    window._layoutHeading()
end

function Page:_styleTab(animate)
    local compact = self.Window.Layout == "Topbar" and self.Icon ~= nil and not self.Active
    local name = self.Translate and Locale.t(self.Name) or self.Name
    self.Window:_styleTab(self.Tab, self.Items.Text.Instance, 36, nil, compact, name, animate)
end

function Page:_setSearchState(searching, count)
    self.SearchCount = count
    self._restTransparency = (searching and count == 0) and 0.75 or 0.35
    if not self.Active then
        Tween.play(self.Items.Text.Instance, { TextTransparency = self._restTransparency }, 0.12)
    end
end

function Page:Select()
    self.Window:SelectPage(self)
end

return Page
]]

__sources["components/PlayerDropdown"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local Services = require("core/Services")
local Base = require("components/Base")

local Section = Library.SectionClass

local function headShot(player)
    return "rbxthumb://type=AvatarHeadShot&id=" .. tostring(player.UserId) .. "&w=48&h=48"
end

local function itemFor(player)
    local display = player.DisplayName
    local text = player.Name
    if type(display) == "string" and display ~= "" and display ~= player.Name then
        text = display .. " (@" .. player.Name .. ")"
    end
    return { Name = player.Name, Text = text, Image = headShot(player) }
end

function Section:PlayerDropdown(data)
    data = table.clone(data or {})
    local Players = Services.Players
    local localPlayer = Players.LocalPlayer
    local includeSelf = Base.opt(data, "IncludeSelf", false) == true
    local function wanted(player)
        return includeSelf or player ~= localPlayer
    end

    local items = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if wanted(player) then table.insert(items, itemFor(player)) end
    end
    table.sort(items, function(a, b) return string.lower(a.Text) < string.lower(b.Text) end)

    data.Name = Base.opt(data, "Name", "Player")
    data.Items = items
    data.NoTranslate = true -- player names are never translated
    if data.Search == nil then data.Search = true end
    if data.Placeholder == nil and not data.Multi then data.Placeholder = "Select player" end

    local dropdown = self:Dropdown(data)
    local maid = Base.maid(dropdown)

    local function track(connection)
        maid:Give(connection)
        Library.Maid:Give(connection)
    end
    track(Players.PlayerAdded:Connect(function(player)
        if Library.Unloaded or not wanted(player) then return end
        dropdown:Add(itemFor(player))
    end))
    track(Players.PlayerRemoving:Connect(function(player)
        if Library.Unloaded then return end
        local wasSelected = dropdown:IsSelected(player.Name)
        dropdown:Remove(player.Name)
        if wasSelected then Util.callback(dropdown.Callback, dropdown:Get()) end
    end))

    function dropdown:GetPlayer()
        if self.Multi then
            local list = {}
            for _, name in ipairs(self.Value) do
                local player = Players:FindFirstChild(name)
                if player then table.insert(list, player) end
            end
            return list
        end
        return self.Value and Players:FindFirstChild(self.Value) or nil
    end

    function dropdown:RefreshPlayers()
        local fresh = {}
        for _, player in ipairs(Players:GetPlayers()) do
            if wanted(player) then table.insert(fresh, itemFor(player)) end
        end
        table.sort(fresh, function(a, b) return string.lower(a.Text) < string.lower(b.Text) end)
        self:Refresh(fresh)
    end

    return dropdown
end

return true
]]

__sources["components/PopupContainer"] = [[
local Library = require("core/Library")
local New = require("core/Create")
local Popup = require("core/Popup")

local PopupContainer = {}

function PopupContainer.new(opts)
    local width = opts.Width or 250
    local maxHeight = opts.MaxHeight or 320

    local frame = New("Frame", {
        Name = "SettingsPopup",
        Size = UDim2.fromOffset(width, 40),
        Theme = { BackgroundColor3 = "Popup" },
        Corner = 6,
    })

    local scroll = New("ScrollingFrame", {
        Name = "Scroll",
        Size = UDim2.new(1, 0, 1, 0),
        ScrollBarThickness = 2,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        Theme = { ScrollBarImageColor3 = "Accent" },
        Parent = frame,
    })

    local content = New("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Padding = { Top = 10, Bottom = 10, Left = 10, Right = 10 },
        List = { Padding = 8 },
        Parent = scroll,
    })

    local layout = content:FindFirstChildOfClass("UIListLayout")

    local container = {
        Window = opts.Window,
        Content = content,
        Frame = frame,
        Elements = {},
        IsSettings = true,
        Translate = opts.Translate,
        Items = { Settings = { Instance = frame }, Content = { Instance = content } },
    }

    local popup = Popup.new({
        Frame = frame,
        Anchor = opts.Anchor,
        Parent = opts.Parent,
        Align = opts.Align or "Right",
        Side = opts.Side or "Bottom",
        Gap = 6,
    })
    container.Popup = popup
    container.PopupOwner = popup

    local function resize()
        local h = math.min(layout.AbsoluteContentSize.Y / math.max(Library.PopupScale or 1, 0.01) + 20, maxHeight)
        frame.Size = UDim2.fromOffset(width, math.max(40, h))
    end
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize)
    resize()

    function container:SetOpen(open)
        if open then popup:Open() else popup:Close() end
        self.IsOpen = popup.IsOpen
    end

    function container:Destroy()
        for _, element in ipairs(table.clone(self.Elements)) do
            if element.Destroy then element:Destroy() end
        end
        popup:Destroy()
    end

    function container:ToggleOpen()
        self:SetOpen(not popup.IsOpen)
    end

    popup.OnOpen = function()
        container.IsOpen = true
        resize()
    end
    popup.OnClose = function()
        container.IsOpen = false
    end

    return setmetatable(container, Library.SectionClass)
end

return PopupContainer
]]

__sources["components/ProgressBar"] = [[
local Library = require("core/Library")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local SUFFIXES = { { 1e12, "T" }, { 1e9, "B" }, { 1e6, "M" }, { 1e4, "K" } }
local function short(n)
    local a = math.abs(n)
    for _, s in ipairs(SUFFIXES) do
        if a >= s[1] then
            local v = n / s[1]
            local text = string.format(v >= 100 and "%.0f" or "%.1f", v)
            text = string.gsub(text, "%.0$", "")
            return text .. s[2]
        end
    end
    if n == math.floor(n) then return tostring(math.floor(n)) end
    return (string.gsub(string.format("%.2f", n), "0+$", ""))
end

function Section:ProgressBar(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local bar = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Progress"),
        Max = tonumber(Base.opt(data, "Max", 1)) or 1,
        Suffix = Base.opt(data, "Suffix", ""),
        Format = Base.opt(data, "Format", nil),
        Value = 0,
    }
    local showText = Base.opt(data, "ShowText", true) ~= false

    local row = Base.row(container, 32)
    local label = Base.text(row, bar.Name, {
        Size = UDim2.new(1, -90, 0, 16),
        TextSize = 14,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)
    local valueLabel = New("TextLabel", {
        Name = "Value",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(90, 16),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextSize = 13,
        TextTransparency = 0.2,
        Visible = showText,
        Theme = { TextColor3 = "SubText" },
        Parent = row,
    })
    local track = New("Frame", {
        Name = "Track",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 0, 1, -2),
        Size = UDim2.new(1, 0, 0, 8),
        Theme = { BackgroundColor3 = "Element" },
        Corner = UDim.new(1, 0),
        ClipsDescendants = true,
        Parent = row,
    })
    local fill = New("Frame", {
        Name = "Fill",
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Corner = UDim.new(1, 0),
        Parent = track,
    })
    local gradient

    function bar:SetColor(color)
        if gradient then gradient:Destroy() gradient = nil end
        Theme.unbind(fill, "BackgroundColor3")
        if typeof(color) == "Color3" then
            fill.BackgroundColor3 = color
        elseif type(color) == "string" and Library.Theme[color] then
            Theme.bind(fill, { BackgroundColor3 = color })
        else
            fill.BackgroundColor3 = Color3.new(1, 1, 1)
            gradient = Theme.gradient(fill, -100)
        end
    end
    bar:SetColor(Base.opt(data, "Color", nil))

    local customText
    local function render(animate)
        local ratio = bar.Max > 0 and math.clamp(bar.Value / bar.Max, 0, 1) or 0
        local size = UDim2.fromScale(ratio, 1)
        if animate then Tween.play(fill, { Size = size }, 0.2) else Tween.set(fill, { Size = size }) end
        local text = customText
        if text == nil and bar.Format then
            local ok, out = pcall(bar.Format, bar.Value, bar.Max)
            if ok and out ~= nil then text = tostring(out) end
        end
        if text == nil then
            if bar.Max == 1 then
                text = tostring(math.floor(ratio * 100 + 0.5)) .. "%"
            else
                text = short(bar.Value) .. "/" .. short(bar.Max) .. bar.Suffix
            end
        end
        valueLabel.Text = text
    end

    function bar:Set(value, text)
        self.Value = math.max(tonumber(value) or 0, 0)
        customText = text ~= nil and tostring(text) or nil
        render(true)
        return self
    end
    function bar:Get() return self.Value end
    function bar:GetRatio() return self.Max > 0 and math.clamp(self.Value / self.Max, 0, 1) or 0 end
    function bar:SetMax(max)
        self.Max = math.max(tonumber(max) or 1, 0)
        render(false)
        return self
    end
    function bar:Reset() return self:Set(0) end
    function bar:SetText(text)
        self.Name = tostring(text)
        Locale.setText(label, "Text", self.Name)
    end

    bar.Items = { ProgressBar = { Instance = row }, Text = { Instance = label }, Value = { Instance = valueLabel }, Fill = { Instance = fill } }
    Base.finish(bar, container, row, data)
    bar.Value = math.max(tonumber(Base.opt(data, "Value", 0)) or 0, 0)
    render(false)
    return bar
end

return true
]]

__sources["components/Radio"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local function normalize(item)
    if type(item) == "table" then
        return {
            Name = tostring(item.Name or item.name or item[1] or ""),
            Description = item.Description or item.description,
            Icon = item.Icon or item.icon,
        }
    end
    return { Name = tostring(item) }
end

function Section:Radio(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end
    local cards = Base.opt(data, "Cards", false) and true or false
    local columns = math.max(1, tonumber(Base.opt(data, "Columns", cards and 2 or 1)) or 1)

    local radio = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", nil),
        Callback = Base.opt(data, "Callback", nil),
        Value = nil,
        Options = {},
        OptionsWithIndexes = {},
    }

    local hasName = radio.Name ~= nil and radio.Name ~= ""
    local row = Base.row(container, 0, { AutomaticSize = Enum.AutomaticSize.Y })
    New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6), Parent = row })
    if hasName then
        Base.text(row, radio.Name, { LayoutOrder = 0, TextSize = 14 }, translate)
    end

    local holder = New("Frame", {
        Name = "Options",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = 1,
        Parent = row,
    })
    local spacing = 6
    if cards then
        New("UIGridLayout", {
            SortOrder = Enum.SortOrder.LayoutOrder,
            CellPadding = UDim2.fromOffset(spacing, spacing),
            CellSize = UDim2.new(1 / columns, -math.ceil(spacing * (columns - 1) / columns), 0, Base.opt(data, "CardHeight", 52)),
            Parent = holder,
        })
    else
        New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 4), Parent = holder })
    end

    local order = 0

    local function render(option, instant)
        local on = option.Name == radio.Value
        local t = instant and 0 or 0.12
        Tween.play(option.Dot, { Size = on and UDim2.fromOffset(8, 8) or UDim2.fromOffset(0, 0) }, t)
        Tween.play(option.Ring, { BackgroundTransparency = on and 0 or 1 }, t)
        Tween.play(option.Label, { TextTransparency = on and 0 or 0.25 }, t)
        if option.Card then
            Theme.bind(option.Card, { BackgroundColor3 = on and "Element Hover" or "Element" })
            if option.CardStroke then
                Tween.play(option.CardStroke, { Transparency = on and 0 or 1 }, t)
            end
        end
    end

    local function renderAll(instant)
        for _, option in ipairs(radio.OptionsWithIndexes) do render(option, instant) end
    end

    function radio:Get()
        return self.Value
    end

    function radio:GetIndex()
        for i, option in ipairs(self.OptionsWithIndexes) do
            if option.Name == self.Value then return i end
        end
        return nil
    end

    function radio:Set(value, silent)
        if type(value) == "number" and self.OptionsWithIndexes[value] then
            value = self.OptionsWithIndexes[value].Name
        end
        if value ~= nil then
            value = tostring(value)
            if not self.Options[value] then return end
        end
        local changed = value ~= self.Value
        self.Value = value
        Library.Flags[self.Flag] = value
        if changed then Library:NotifyFlagChanged(self.Flag, value) end
        renderAll()
        if changed and not silent then
            Util.callback(self.Callback, value)
        end
    end

    function radio:Add(item)
        local info = normalize(item)
        local name = info.Name
        if name == "" or self.Options[name] then return self.Options[name] end
        order = order + 1

        local button = New("TextButton", {
            Name = "Option",
            Size = cards and UDim2.fromScale(1, 1) or UDim2.new(1, 0, 0, 20),
            BackgroundTransparency = cards and 0 or 1,
            LayoutOrder = order,
            Corner = cards and 6 or nil,
            Theme = cards and { BackgroundColor3 = "Element" } or nil,
            Parent = holder,
        })
        local stroke
        if cards then
            stroke = New("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 1, Transparency = 1, Parent = button })
            Theme.bind(stroke, { Color = "Accent" })
        end

        local ringX = cards and 10 or 0
        local ring = New("Frame", {
            Name = "Ring",
            AnchorPoint = Vector2.new(0, cards and 0 or 0.5),
            Position = cards and UDim2.fromOffset(ringX, 10) or UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1,
            Corner = UDim.new(1, 0),
            Parent = button,
        })
        Theme.gradient(ring)
        local ringStroke = New("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, Thickness = 1, Parent = ring })
        Theme.bind(ringStroke, { Color = "SubText" })
        local dot = New("Frame", {
            Name = "Dot",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(0, 0),
            Theme = { BackgroundColor3 = "Dark" },
            Corner = UDim.new(1, 0),
            Parent = ring,
        })
        ring:GetPropertyChangedSignal("BackgroundTransparency"):Connect(function()
            ringStroke.Transparency = 1 - ring.BackgroundTransparency
        end)

        local textX = (cards and ringX or 0) + 24
        local iconImage
        if info.Icon and cards then
            iconImage = New("ImageLabel", {
                AnchorPoint = Vector2.new(1, 0),
                Position = UDim2.new(1, -10, 0, 10),
                Size = UDim2.fromOffset(16, 16),
                Image = Util.asset(info.Icon),
                ImageTransparency = 0.2,
                Theme = { ImageColor3 = "Text" },
                Parent = button,
            })
        end
        local label = New("TextLabel", {
            Name = "Text",
            Position = cards and UDim2.fromOffset(textX, 9) or UDim2.new(0, textX, 0, 2),
            Size = UDim2.new(1, -(textX + (iconImage and 32 or 8)), 0, 16),
            [translate and "Translate" or "Text"] = translate and { Text = name } or name,
            TextSize = 14,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextTransparency = 0.25,
            Theme = { TextColor3 = "Text" },
            Parent = button,
        })
        if cards and info.Description then
            New("TextLabel", {
                Name = "Description",
                Position = UDim2.fromOffset(textX, 27),
                Size = UDim2.new(1, -(textX + 8), 1, -31),
                [translate and "Translate" or "Text"] = translate and { Text = tostring(info.Description) } or tostring(info.Description),
                TextSize = 12,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextYAlignment = Enum.TextYAlignment.Top,
                Theme = { TextColor3 = "SubText" },
                Parent = button,
            })
        end

        local option = {
            Name = name, Button = button, Ring = ring, Dot = dot, Label = label,
            Card = cards and button or nil, CardStroke = stroke,
        }
        Base.hover(button, function()
            if name ~= radio.Value then Tween.play(label, { TextTransparency = 0.05 }, 0.1) end
        end, function()
            if name ~= radio.Value then Tween.play(label, { TextTransparency = 0.25 }, 0.1) end
        end)
        button.Activated:Connect(function()
            radio:Set(name)
        end)

        self.Options[name] = option
        table.insert(self.OptionsWithIndexes, option)
        render(option, true)
        return option
    end

    function radio:Remove(name)
        name = tostring(name)
        local option = self.Options[name]
        if not option then return end
        option.Button:Destroy()
        self.Options[name] = nil
        table.remove(self.OptionsWithIndexes, table.find(self.OptionsWithIndexes, option))
        if self.Value == name then self:Set(nil, true) end
    end

    function radio:Refresh(items, default)
        local previous = self.Value
        for _, option in ipairs(table.clone(self.OptionsWithIndexes)) do option.Button:Destroy() end
        self.Options, self.OptionsWithIndexes, self.Value = {}, {}, nil
        for _, item in ipairs(items or {}) do self:Add(item) end
        if default ~= nil then self:Set(default) else self:Set(previous, true) end
    end

    function radio:GetItems()
        local names = {}
        for _, option in ipairs(self.OptionsWithIndexes) do table.insert(names, option.Name) end
        return names
    end

    function radio:SetText(text)
        self.Name = tostring(text)
    end
    function radio:RefreshPosition() end

    radio.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        radio:Set(value)
    end)

    for _, item in ipairs(Base.opt(data, "Items", Base.opt(data, "Options", {}))) do
        radio:Add(item)
    end

    radio.Items = { Radio = { Instance = row }, Holder = { Instance = holder } }
    function radio:_matches(query)
        if Locale.matches(self.Name, query) then return true end
        for _, option in ipairs(self.OptionsWithIndexes) do
            if Locale.matches(option.Name, query) then return true end
        end
        return false
    end
    Base.finish(radio, container, row, data)

    local default = Base.opt(data, "Default", nil)
    if default ~= nil then
        radio:Set(default)
    else
        Library.Flags[radio.Flag] = nil
    end
    return radio
end
Section.RadioGroup = Section.Radio

function Section:Stepper(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local stepper = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Stepper"),
        Min = tonumber(Base.opt(data, "Min", -math.huge)) or -math.huge,
        Max = tonumber(Base.opt(data, "Max", math.huge)) or math.huge,
        Step = tonumber(Base.opt(data, "Step", 1)) or 1,
        Suffix = Base.opt(data, "Suffix", ""),
        Callback = Base.opt(data, "Callback", nil),
        Value = nil,
    }
    if stepper.Max < stepper.Min then stepper.Min, stepper.Max = stepper.Max, stepper.Min end

    local row = Base.row(container, 24)
    local label = Base.text(row, stepper.Name, {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.new(1, -126, 0, 16),
        TextSize = 14,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)

    local box = New("Frame", {
        Name = "Stepper",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.fromScale(1, 0.5),
        Size = UDim2.fromOffset(118, 24),
        Theme = { BackgroundColor3 = "Element" },
        Corner = 6,
        Parent = row,
    })
    local function stepButton(text, left)
        local b = New("TextButton", {
            AnchorPoint = Vector2.new(left and 0 or 1, 0),
            Position = UDim2.fromScale(left and 0 or 1, 0),
            Size = UDim2.fromOffset(26, 24),
            BackgroundTransparency = 1,
            Text = text,
            TextSize = 16,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTransparency = 0.25,
            Theme = { TextColor3 = "Text", BackgroundColor3 = "Element Hover" },
            Corner = 6,
            Parent = box,
        })
        Base.hover(b, function()
            Tween.play(b, { BackgroundTransparency = 0, TextTransparency = 0 }, 0.1)
        end, function()
            Tween.play(b, { BackgroundTransparency = 1, TextTransparency = 0.25 }, 0.1)
        end)
        return b
    end
    local minus = stepButton("-", true)
    local plus = stepButton("+", false)
    local valueBox = New("TextBox", {
        Name = "Value",
        Position = UDim2.fromOffset(26, 0),
        Size = UDim2.new(1, -52, 1, 0),
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextSize = 13,
        Theme = { TextColor3 = "Text" },
        Parent = box,
    })

    local digits = 0
    do
        local s = tostring(stepper.Step)
        local dot = string.find(s, ".", 1, true)
        if dot then digits = #s - dot end
    end
    local function format(v)
        if digits == 0 then return tostring(math.floor(v + 0.5)) .. stepper.Suffix end
        return string.format("%." .. digits .. "f", v) .. stepper.Suffix
    end

    function stepper:Get() return self.Value end
    function stepper:Set(value)
        value = tonumber(value)
        if not value then return end
        value = Util.round(math.clamp(value, self.Min, self.Max), self.Step)
        value = math.clamp(value, self.Min, self.Max)
        local changed = value ~= self.Value
        self.Value = value
        Library.Flags[self.Flag] = value
        if not valueBox:IsFocused() then valueBox.Text = format(value) end
        minus.TextTransparency = value <= self.Min and 0.7 or 0.25
        plus.TextTransparency = value >= self.Max and 0.7 or 0.25
        if changed then
            Library:NotifyFlagChanged(self.Flag, value)
            Util.callback(self.Callback, value)
        end
    end
    function stepper:Increment() self:Set((self.Value or 0) + self.Step) end
    function stepper:Decrement() self:Set((self.Value or 0) - self.Step) end
    function stepper:SetMin(v) self.Min = tonumber(v) or self.Min if self.Max < self.Min then self.Max = self.Min end self:Set(self.Value) end
    function stepper:SetMax(v) self.Max = tonumber(v) or self.Max if self.Min > self.Max then self.Min = self.Max end self:Set(self.Value) end
    function stepper:SetText(text) self.Name = tostring(text) Locale.setText(label, "Text", self.Name) end
    function stepper:RefreshPosition() end

    local function holdRepeat(button, fn)
        local token = 0
        local offEnded
        local function stop()
            token = token + 1
            if offEnded then offEnded() offEnded = nil end
        end
        button.MouseButton1Down:Connect(function()
            stop()
            local mine = token
            fn()
            offEnded = Base.Input.on("Ended", function(io)
                local t = io.UserInputType
                if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then stop() end
            end)
            task.delay(0.4, function()
                local started = os.clock()
                while token == mine and not Library.Unloaded do
                    fn()
                    if os.clock() - started > 8 then stop() break end
                    task.wait(0.06)
                end
            end)
        end)
        button.MouseButton1Up:Connect(stop)
        button.MouseLeave:Connect(stop)
    end
    holdRepeat(minus, function() stepper:Decrement() end)
    holdRepeat(plus, function() stepper:Increment() end)

    valueBox.FocusLost:Connect(function()
        local n = tonumber((string.gsub(valueBox.Text, "[^%d%.%-]", "")))
        if n then stepper:Set(n) end
        valueBox.Text = format(stepper.Value)
    end)

    stepper.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        stepper:Set(value)
    end)
    stepper.Items = { Stepper = { Instance = row }, Text = { Instance = label }, Value = { Instance = valueBox } }
    Base.finish(stepper, container, row, data)
    local default = Base.opt(data, "Default", nil)
    if default == nil then
        default = (stepper.Min > -math.huge) and stepper.Min or 0
    end
    stepper:Set(default)
    return stepper
end

function Section:Row(data)
    data = data or {}
    local container = self
    local row = Base.row(container, 0, { AutomaticSize = Enum.AutomaticSize.Y })
    local content = New("Frame", {
        Name = "Row",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Parent = row,
    })
    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        SortOrder = Enum.SortOrder.LayoutOrder,
        HorizontalFlex = Enum.UIFlexAlignment.Fill,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, tonumber(data.Padding) or 8),
        Parent = content,
    })

    local children = {}
    local sub = setmetatable({
        Window = container.Window,
        Page = container.Page,
        Name = container.Name,
        Translate = data.Translate == nil and container.Translate or data.Translate,
        Content = content,
        Elements = children,
        PopupOwner = container.PopupOwner,
        IsRow = true,
    }, { __index = Library.SectionClass })

    local rowObj = { Name = data.Name or "", Container = sub, Children = children, Items = { Row = { Instance = row } } }
    function rowObj:_matches(query)
        if Locale.matches(self.Name, query) then return true end
        for _, child in ipairs(children) do
            if child._matches then
                if child:_matches(query) then return true end
            elseif Locale.matches(child.Name, query) then
                return true
            end
        end
        return false
    end
    Base.finish(rowObj, container, row, nil)
    local baseDestroy = rowObj.Destroy
    function rowObj:Destroy()
        for _, child in ipairs(table.clone(children)) do
            if child.Destroy then pcall(child.Destroy, child) end
        end
        baseDestroy(self)
    end
    content.ChildAdded:Connect(function(child)
        if child:IsA("GuiObject") then
            child.Size = UDim2.new(0, 0, child.Size.Y.Scale, child.Size.Y.Offset)
        end
    end)
    setmetatable(rowObj, { __index = sub })
    return rowObj
end

return true
]]

__sources["components/RangeSlider"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Input = require("core/Input")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local function decimalsOf(step)
    local s = tostring(step)
    local dot = string.find(s, ".", 1, true)
    return dot and (#s - dot) or 0
end

function Section:RangeSlider(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local range = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Range"),
        Min = tonumber(Base.opt(data, "Min", 0)) or 0,
        Max = tonumber(Base.opt(data, "Max", 100)) or 100,
        Decimals = tonumber(Base.opt(data, "Decimals", 1)) or 1,
        Suffix = Base.opt(data, "Suffix", ""),
        MinGap = math.max(tonumber(Base.opt(data, "MinGap", 0)) or 0, 0),
        Callback = Base.opt(data, "Callback", nil),
        Finished = Base.opt(data, "Finished", false),
        Low = nil,
        High = nil,
        Sliding = false,
    }
    if range.Max < range.Min then range.Min, range.Max = range.Max, range.Min end
    local digits = decimalsOf(range.Decimals)

    local row = Base.row(container, 34)
    local label = Base.text(row, range.Name, {
        Size = UDim2.new(1, -110, 0, 16),
        TextSize = 14,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)
    local valueLabel = New("TextLabel", {
        Name = "Value",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(110, 16),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextSize = 14,
        TextTransparency = 0.2,
        Theme = { TextColor3 = "Text" },
        Parent = row,
    })

    local hitbox = New("TextButton", {
        Name = "Track",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 6, 1, -8),
        Size = UDim2.new(1, -12, 0, 18),
        BackgroundTransparency = 1,
        Parent = row,
    })
    local track = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.new(1, 0, 0, 6),
        Theme = { BackgroundColor3 = "Element" },
        Corner = UDim.new(1, 0),
        Parent = hitbox,
    })
    local fill = New("Frame", {
        Name = "Fill",
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Corner = UDim.new(1, 0),
        Parent = track,
    })
    Theme.gradient(fill, -100)
    local function knob(name)
        local k = New("Frame", {
            Name = name,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(12, 12),
            Theme = { BackgroundColor3 = "Text" },
            Corner = UDim.new(1, 0),
            ZIndex = 3,
            Parent = track,
        })
        return k, New("UIScale", { Parent = k })
    end
    local lowKnob, lowScale = knob("LowKnob")
    local highKnob, highScale = knob("HighKnob")

    local function format(v)
        if digits == 0 or v == math.floor(v) then
            return tostring(math.floor(v))
        end
        return string.format("%." .. digits .. "f", v)
    end

    local function alphaOf(v)
        local span = range.Max - range.Min
        return span > 0 and (v - range.Min) / span or 0
    end

    local function render(animate)
        local a, b = alphaOf(range.Low), alphaOf(range.High)
        local props = {
            [fill] = { Position = UDim2.fromScale(a, 0), Size = UDim2.fromScale(b - a, 1) },
            [lowKnob] = { Position = UDim2.fromScale(a, 0.5) },
            [highKnob] = { Position = UDim2.fromScale(b, 0.5) },
        }
        for gui, p in pairs(props) do
            if animate then Tween.play(gui, p, 0.1) else Tween.set(gui, p) end
        end
        valueLabel.Text = format(range.Low) .. " - " .. format(range.High) .. range.Suffix
    end

    local function snap(v)
        v = Util.round(math.clamp(tonumber(v) or range.Min, range.Min, range.Max), range.Decimals)
        return math.clamp(v, range.Min, range.Max)
    end

    function range:Get()
        return self.Low, self.High
    end

    function range:Set(low, high, silent)
        if type(low) == "table" then
            low, high, silent = low[1] or low.Low or low.Min, low[2] or low.High or low.Max, high
        end
        local newLow = snap(low ~= nil and low or self.Low or self.Min)
        local newHigh = snap(high ~= nil and high or self.High or self.Max)
        if newLow > newHigh then newLow, newHigh = newHigh, newLow end
        local gap = math.min(self.MinGap, self.Max - self.Min)
        if newHigh - newLow < gap then
            if newLow + gap <= self.Max then newHigh = snap(newLow + gap) else newLow = snap(newHigh - gap) end
        end
        local changed = newLow ~= self.Low or newHigh ~= self.High
        self.Low, self.High = newLow, newHigh
        Library.Flags[self.Flag] = { newLow, newHigh }
        render(self.Sliding)
        if changed then
            Library:NotifyFlagChanged(self.Flag, { newLow, newHigh })
            if not silent and not (self.Finished and self.Sliding) then
                Util.callback(self.Callback, newLow, newHigh)
            end
        end
        return self
    end

    function range:Random()
        local low, high = self.Low or self.Min, self.High or self.Max
        return low + math.random() * (high - low)
    end

    function range:SetText(text)
        self.Name = tostring(text)
        Locale.setText(label, "Text", self.Name)
    end
    function range:RefreshPosition() end

    range.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        if type(value) == "table" then range:Set(value) end
    end)

    local active -- "Low" | "High" while dragging
    local function valueAt(pos)
        pos = Input.toGui(track, pos)
        local ap, as = track.AbsolutePosition, track.AbsoluteSize
        if as.X <= 0 then return nil end
        local alpha = math.clamp((pos.X - ap.X) / as.X, 0, 1)
        return range.Min + (range.Max - range.Min) * alpha
    end
    local function moveTo(pos)
        local v = valueAt(pos)
        if not v or not active then return end
        if active == "Low" then
            range:Set(math.min(v, range.High), range.High)
        else
            range:Set(range.Low, math.max(v, range.Low))
        end
    end

    Base.maid(range):Give(Input.drag(hitbox, {
        onStart = function(pos)
            local v = valueAt(pos)
            if not v then return false end
            local dLow, dHigh = math.abs(v - range.Low), math.abs(v - range.High)
            if dLow < dHigh or (dLow == dHigh and v < range.Low) then active = "Low" else active = "High" end
            range.Sliding = true
            Base.lockScroll(row, true)
            Tween.play(active == "Low" and lowScale or highScale, { Scale = 1.25 }, 0.1)
            moveTo(pos)
        end,
        onMove = function(_, pos)
            moveTo(pos)
        end,
        onEnd = function()
            range.Sliding = false
            Base.lockScroll(row, false)
            Tween.play(lowScale, { Scale = 1 }, 0.1)
            Tween.play(highScale, { Scale = 1 }, 0.1)
            active = nil
            if range.Finished then
                Util.callback(range.Callback, range.Low, range.High)
            end
        end,
    }))

    range.Items = { RangeSlider = { Instance = row }, Text = { Instance = label }, Value = { Instance = valueLabel },
        Track = { Instance = track }, LowKnob = { Instance = lowKnob }, HighKnob = { Instance = highKnob } }
    Base.finish(range, container, row, data)

    local default = Base.opt(data, "Default", nil)
    if type(default) ~= "table" then default = { range.Min, range.Max } end
    range:Set(default[1], default[2])
    return range
end

return true
]]

__sources["components/Section"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")

local Section = {}
Section.__index = Section
Library.SectionClass = Section
setmetatable(Library.Sections, { __index = Section })

function Library.PageClass:Section(data)
    data = data or {}
    local page = self
    local side = math.clamp(data.Side or data.side or 1, 1, #page.ColumnsData)
    local column = page.ColumnsData[side].Instance

    local translate = data.Translate
    if translate == nil then translate = page.Translate end

    local isCollapsible = (data.Collapsible or data.collapsible) and true or false
    local isCollapsed = (data.Collapsed or data.collapsed) and true or false

    local section = setmetatable({
        Window = page.Window,
        Page = page,
        Name = data.Name or data.name or "Section",
        Description = data.Description or data.description or "",
        Translate = translate,
        Icon = data.Icon or data.icon,
        Side = side,
        EnableToggle = (data.EnableToggle or data.enabletoggle) and true or false,
        Collapsible = isCollapsible,
        IsCollapsed = isCollapsed,
        IsActive = true,
        Elements = {},
        Items = {},
    }, Section)

    page._order = (page._order or 0) + 1

    local hasDescription = section.Description ~= ""
    local headerHeight = hasDescription and 46 or 34

    local frame = New("Frame", {
        Name = "Section",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = page._order,
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = Library.Flags.BackgroundTransparency or 0,
        Corner = 8,
        List = { Padding = 0 },
        Parent = column,
    })
    local shade = New("UIGradient", { Rotation = 90, Parent = frame })
    local function paintShade()
        local h = frame.AbsoluteSize.Y / math.max(Library.PopupScale or 1, 0.01)
        local split = math.clamp(headerHeight / math.max(h, 1), 0.001, 0.998)
        local top, body = Library.Theme["Section Top"], Library.Theme["Section Background 2"]
        return ColorSequence.new({
            ColorSequenceKeypoint.new(0, top),
            ColorSequenceKeypoint.new(split, top),
            ColorSequenceKeypoint.new(math.min(split + 0.001, 0.999), body),
            ColorSequenceKeypoint.new(1, body),
        })
    end
    Theme.bind(shade, { Color = paintShade })
    frame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        shade.Color = paintShade()
    end)
    section.Shade = shade

    local header = New("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, headerHeight),
        LayoutOrder = 1,
        BackgroundTransparency = 1,
        Parent = frame,
    })
    local cornerFill = New("Frame", {
        Name = "CornerFill",
        Size = UDim2.new(1, 0, 0, 0),
        BackgroundTransparency = 1,
        Visible = false,
        Parent = header,
    })

    local textX = 12
    if section.Icon then
        local icon = New("ImageLabel", {
            Name = "Icon",
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 12, 0.5, 0),
            Size = UDim2.fromOffset(15, 15),
            Image = Util.asset(section.Icon),
            Parent = header,
        })
        Theme.gradient(icon, 0)
        section.Items.Icon = { Instance = icon }
        textX = 34
    end

    local rightOffset = (section.EnableToggle and 50) or (isCollapsible and 32) or 12

    local title = New("TextLabel", {
        Name = "Title",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, textX, 0.5, hasDescription and -8 or 0),
        Size = UDim2.new(1, -(textX + rightOffset), 0, 16),
        [section.Translate and "Translate" or "Text"] = section.Translate and { Text = section.Name } or section.Name,
        TextSize = 14,
        FontFace = Library.Fonts.SemiBold,
        TextTruncate = Enum.TextTruncate.None,
        Theme = { TextColor3 = "Text" },
        Parent = header,
    })

    local description = New("TextLabel", {
        Name = "Description",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, textX, 0.5, 8),
        Size = UDim2.new(1, -(textX + rightOffset), 0, 14),
        [section.Translate and "Translate" or "Text"] = section.Translate and { Text = section.Description } or section.Description,
        TextSize = 12,
        TextTruncate = Enum.TextTruncate.None,
        Visible = hasDescription,
        Theme = { TextColor3 = "SubText" },
        Parent = header,
    })

    local body = New("Frame", {
        Name = "Body",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Visible = not isCollapsed,
        LayoutOrder = 2,
        Parent = frame,
    })

    local content = New("Frame", {
        Name = "Content",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        Padding = { Top = 9, Bottom = 11, Left = 10, Right = 10 },
        List = { Padding = 6 },
        Parent = body,
    })

    local fade = New("TextButton", {
        Name = "Fade",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 0.35,
        Visible = false,
        ZIndex = 10,
        Theme = { BackgroundColor3 = "Section Background" },
        Corner = 8,
        Parent = body,
    })

    section.Frame = frame
    section.Content = content
    section.Items.Section = { Instance = frame }
    section.Items.Header = { Instance = header }
    section.Items.CornerFill = { Instance = cornerFill }
    section.Items.Body = { Instance = body }
    section.Items.Content = { Instance = content }
    section.Items.Title = { Instance = title }
    section.Items.Description = { Instance = description }
    section.Items.Fade = { Instance = fade }

    if isCollapsible and not section.EnableToggle then
        local chevron = New("ImageLabel", {
            Name = "Chevron",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(11, 6),
            Image = "rbxassetid://123317177279443",
            ImageTransparency = 0.35,
            Theme = { ImageColor3 = "Text" },
            Rotation = isCollapsed and -90 or 0,
            Parent = header,
        })
        section.Items.Chevron = { Instance = chevron }

        local headerBtn = New("TextButton", {
            Name = "HeaderClick",
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Text = "",
            ZIndex = 2,
            Parent = header,
        })

        if not Library.IsMobile then
            headerBtn.MouseEnter:Connect(function()
                Tween.play(chevron, { ImageTransparency = 0 }, 0.12)
            end)
            headerBtn.MouseLeave:Connect(function()
                Tween.play(chevron, { ImageTransparency = 0.35 }, 0.12)
            end)
        end

        headerBtn.Activated:Connect(function()
            section:SetCollapsed(not section.IsCollapsed)
        end)
    end

    if section.EnableToggle then
        local switch = New("TextButton", {
            Name = "Switch",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -12, 0.5, 0),
            Size = UDim2.fromOffset(30, 16),
            BackgroundColor3 = Color3.new(1, 1, 1),
            Corner = UDim.new(1, 0),
            Parent = header,
        })
        local gradient = Theme.gradient(switch)
        local knob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(10, 10),
            Theme = { BackgroundColor3 = "Dark" },
            Corner = UDim.new(1, 0),
            Parent = switch,
        })
        section.Items.Toggle = { Instance = switch }

        section._renderSwitch = function(active)
            gradient.Enabled = active
            if active then
                Theme.unbind(switch, "BackgroundColor3")
                switch.BackgroundColor3 = Color3.new(1, 1, 1)
                Theme.bind(knob, { BackgroundColor3 = "Dark" })
            else
                Theme.bind(switch, { BackgroundColor3 = "Element Hover" })
                Theme.bind(knob, { BackgroundColor3 = "SubText" })
            end
            Tween.play(knob, { Position = UDim2.new(active and 1 or 0, active and -8 or 8, 0.5, 0) }, 0.15)
        end

        switch.Activated:Connect(function()
            section:SetActive(not section.IsActive)
        end)

        local flag = data.Flag or data.flag
        if flag then
            section.Flag = Library:RegisterFlag(flag, function(value)
                section:SetActive(value)
            end)
            Library.Flags[flag] = true
        end
    end

    section.Callback = data.Callback or data.callback

    page.Sections[section.Name] = section
    table.insert(page.SectionList, section)
    return section
end

function Section:SetActive(active)
    active = active and true or false
    if self.IsActive == active and self._activeSet then return end
    self._activeSet = true
    self.IsActive = active

    local fade = self.Items.Fade.Instance
    fade.Visible = not active
    if self._renderSwitch then
        self._renderSwitch(active)
    end
    if self.Flag then
        Library.Flags[self.Flag] = active
        Library:NotifyFlagChanged(self.Flag, active) -- so autosave picks it up
    end
    Util.callback(self.Callback, active)
end

function Section:ToggleBackground()
    self:SetActive(not self.IsActive)
end

function Section:SetCollapsed(collapsed)
    collapsed = collapsed and true or false
    self.IsCollapsed = collapsed
    if self.Items.Body then
        local content = self.Content
        Tween.fold(self.Items.Body.Instance, not collapsed, 0.2, nil, function()
            return content.AbsoluteSize.Y
        end)
    end
    if self.Items.Chevron then
        Tween.play(self.Items.Chevron.Instance, { Rotation = collapsed and -90 or 0 }, 0.15)
    end
    if self.OnCollapse then
        Util.callback(self.OnCollapse, collapsed)
    end
end

function Section:TweenElements() end

function Section:Spacer(height)
    local row = New("Frame", {
        Name = "Spacer",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, tonumber(height) or 8),
        Parent = self.Content,
    })
    self._order = (self._order or 0) + 10
    row.LayoutOrder = self._order
    return row
end

function Section:Divider(height)
    local row = self:Spacer(height or 10)
    row.Name = "Divider"
    local line = New("Frame", {
        Name = "Line",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.new(1, 0, 0, 1),
        BorderSizePixel = 0,
        BackgroundTransparency = 0.75,
        Theme = { BackgroundColor3 = "SubText" },
        Parent = row,
    })
    return row
end

function Section:SetVisibility(visible)
    self._hidden = not visible
    if self.Frame then self.Frame.Visible = visible and true or false end
end

return Section
]]

__sources["components/Segmented"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local BAR_HEIGHT = 30
local GAP = 2

function Section:Segmented(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local control = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", nil),
        Callback = Base.opt(data, "Callback", nil),
        Value = nil,
        Options = {},
        OptionsWithIndexes = {},
    }

    local hasName = control.Name ~= nil and control.Name ~= ""
    local row = Base.row(container, 0, { AutomaticSize = Enum.AutomaticSize.Y })
    New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5), Parent = row })
    if hasName then
        Base.text(row, control.Name, { LayoutOrder = 0, TextSize = 14 }, translate)
    end

    local bar = New("Frame", {
        Name = "Segments",
        Size = UDim2.new(1, 0, 0, BAR_HEIGHT),
        LayoutOrder = 1,
        Corner = 7,
        Padding = 3,
        Theme = { BackgroundColor3 = "Element" },
        Parent = row,
    })
    local grid = New("UIGridLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        CellPadding = UDim2.fromOffset(GAP, 0),
        CellSize = UDim2.new(1, 0, 1, 0),
        Parent = bar,
    })

    local function relayout()
        local n = math.max(#control.OptionsWithIndexes, 1)
        grid.CellSize = UDim2.new(1 / n, -math.ceil(GAP * (n - 1) / n), 1, 0)
    end

    local function render(option, instant)
        local on = option.Name == control.Value
        local t = instant and 0 or 0.12
        Tween.play(option.Button, { BackgroundTransparency = on and 0 or 1 }, t)
        Tween.play(option.Button, { TextTransparency = on and 0 or 0.3 }, t)
    end

    local function renderAll(instant)
        for _, option in ipairs(control.OptionsWithIndexes) do render(option, instant) end
    end

    function control:Get()
        return self.Value
    end

    function control:GetIndex()
        for i, option in ipairs(self.OptionsWithIndexes) do
            if option.Name == self.Value then return i end
        end
        return nil
    end

    function control:Set(value, silent)
        if type(value) == "number" and self.OptionsWithIndexes[value] then
            value = self.OptionsWithIndexes[value].Name
        end
        if value ~= nil then
            value = tostring(value)
            if not self.Options[value] then return end
        end
        local changed = value ~= self.Value
        self.Value = value
        Library.Flags[self.Flag] = value
        if changed then Library:NotifyFlagChanged(self.Flag, value) end
        renderAll()
        if changed and not silent then
            Util.callback(self.Callback, value)
        end
    end

    function control:Add(item)
        local name = tostring(type(item) == "table" and (item.Name or item.name or item[1]) or item)
        if name == "" or self.Options[name] then return self.Options[name] end

        local props = {
            Name = name,
            LayoutOrder = #self.OptionsWithIndexes + 1,
            AutoButtonColor = false,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            BackgroundTransparency = 1,
            Corner = 5,
            Theme = { BackgroundColor3 = "Accent", TextColor3 = "Text" },
            Parent = bar,
        }
        if translate ~= false then props.Translate = { Text = name } else props.Text = name end
        local button = New("TextButton", props)

        local option = { Name = name, Button = button }
        button.Activated:Connect(function()
            control:Set(name)
        end)
        self.Options[name] = option
        table.insert(self.OptionsWithIndexes, option)
        relayout()
        render(option, true)
        return option
    end

    function control:Refresh(items, default)
        local previous = self.Value
        for _, option in ipairs(table.clone(self.OptionsWithIndexes)) do option.Button:Destroy() end
        self.Options, self.OptionsWithIndexes, self.Value = {}, {}, nil
        for _, item in ipairs(items or {}) do self:Add(item) end
        if default ~= nil then self:Set(default) else self:Set(previous, true) end
    end

    function control:GetItems()
        local names = {}
        for _, option in ipairs(self.OptionsWithIndexes) do table.insert(names, option.Name) end
        return names
    end

    function control:SetText(text)
        self.Name = tostring(text)
    end
    function control:RefreshPosition() end

    control.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        control:Set(value)
    end)

    for _, item in ipairs(Base.opt(data, "Items", Base.opt(data, "Options", {}))) do
        control:Add(item)
    end

    control.Items = { Segmented = { Instance = row }, Bar = { Instance = bar } }
    function control:_matches(query)
        if Locale.matches(self.Name, query) then return true end
        for _, option in ipairs(self.OptionsWithIndexes) do
            if Locale.matches(option.Name, query) then return true end
        end
        return false
    end
    Base.finish(control, container, row, data)

    local default = Base.opt(data, "Default", nil)
    if default ~= nil then
        control:Set(default)
    else
        Library.Flags[control.Flag] = nil
    end
    return control
end

return true
]]

__sources["components/SettingsPage"] = [[
local Services = require("core/Services")
local FrameRate = require("core/FrameRate")
local Library = require("core/Library")
local Config = require("core/Config")
local Util = require("core/Util")
local Locale = require("core/Locale")

local function notify(title, description, detail)
    local text = Locale.t(description)
    if detail then text = text .. " " .. detail end
    Library:Notification({ Title = Locale.t(title), Description = text, Duration = 2 })
end

local function fetchServers()
    local url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"
    local ok, result = pcall(function()
        return Services.HttpService:JSONDecode(game:HttpGet(url))
    end)
    if ok and type(result) == "table" and type(result.data) == "table" then
        return result.data
    end
    return nil
end

local function teleportTo(serverId)
    local ok = pcall(function()
        Services.TeleportService:TeleportToPlaceInstance(game.PlaceId, serverId, Services.Players.LocalPlayer)
    end)
    return ok
end

function Library:CreateSettingsPage(window, keybindList)
    window = window or Library.MainWindow
    local page = window:Page({ Name = "Settings", Icon = "133220441796193", Columns = 2, Translate = true })

    local configs = page:Section({
        Name = "Configs",
        Icon = "74468149216972",
        Side = 1,
        Collapsible = true,
    })

    local function strip(name)
        return (string.gsub(tostring(name or ""), "%.json$", ""))
    end

    local function activeName()
        return strip(Config.getActive())
    end

    local statusLabel
    local function setStatus(text)
        if statusLabel then statusLabel:SetText(text) end
    end
    local function showSaved()
        setStatus(Locale.t("Saved to") .. " <b>" .. activeName() .. "</b> · " .. os.date("%H:%M"))
    end
    local function showIdle()
        setStatus(Locale.t("Changes save to") .. " <b>" .. activeName() .. "</b> " .. Locale.t("automatically"))
    end

    local function listNames()
        local names = {}
        for _, file in ipairs(Config.list()) do
            local name = strip(file)
            if name ~= "" then table.insert(names, name) end
        end
        if not table.find(names, activeName()) then
            table.insert(names, 1, activeName())
        end
        return names
    end

    local configDropdown
    local switching = false
    local function refresh()
        switching = true
        configDropdown:Refresh(listNames(), activeName())
        switching = false
        showIdle()
    end

    configDropdown = configs:Dropdown({
        Name = "",
        FullWidth = true,
        Flag = "ConfigsSelected",
        Items = listNames(),
        Default = activeName(),
        Callback = function(value)
            if switching or not value or value == activeName() then return end
            Config.save(activeName())
            Config.setActive(value)
            if Util.FS.isfile(Config.path(value)) then
                if Config.load(value) then
                    notify("Config", "Loaded", value)
                end
            else
                Config.save(value)
            end
            showIdle()
        end,
    })

    local nameBox = configs:Textbox({
        Flag = "ConfigsName",
        Placeholder = "New config name",
        MaxLength = 40,
    })

    Config.AutoSave = true

    local deleteArmed = 0
    local newButton, deleteButton = configs:Buttons(
        {
            Name = "New",
            Callback = function()
                local name = strip(nameBox:Get())
                name = string.gsub(name, "[\\/:%*%?\"<>|]", "")
                if name == "" then
                    notify("Config", "Type a name first")
                    nameBox:Focus()
                    return
                end
                local ok = Config.save(name)
                if not ok then
                    notify("Config", "Your executor does not support files")
                    return
                end
                Config.setActive(name)
                nameBox:Set("")
                refresh()
                notify("Config", "Created", name)
            end,
        },
        {
            Name = "Delete",
            Danger = true,
            Callback = function()
                local name = activeName()
                if os.clock() - deleteArmed > 3 then
                    deleteArmed = os.clock()
                    deleteButton:SetText(Locale.t("Click again to delete"))
                    task.delay(3, function()
                        if os.clock() - deleteArmed >= 2.9 then deleteButton:SetText(Locale.t("Delete")) end
                    end)
                    return
                end
                deleteArmed = 0
                deleteButton:SetText(Locale.t("Delete"))
                Config.delete(name)
                local rest = Config.list()
                Config.setActive(rest[1] and strip(rest[1]) or "Default")
                if rest[1] then Config.load(strip(rest[1])) end
                refresh()
                notify("Config", "Deleted", name)
            end,
        }
    )

    local resetArmed = 0
    local resetButton
    resetButton = configs:Button({
        Name = "Reset to default",
        Danger = true,
        Callback = function()
            if os.clock() - resetArmed > 3 then
                resetArmed = os.clock()
                resetButton:SetText(Locale.t("Click again to reset"))
                task.delay(3, function()
                    if os.clock() - resetArmed >= 2.9 then resetButton:SetText(Locale.t("Reset to default")) end
                end)
                return
            end
            resetArmed = 0
            resetButton:SetText(Locale.t("Reset to default"))
            local defaults = Library.DefaultConfig
            if not defaults then
                notify("Config", "Nothing to reset")
                return
            end
            local ok, decoded = pcall(Services.HttpService.JSONDecode, Services.HttpService, defaults)
            if ok and type(decoded) == "table" then
                decoded.ConfigsSelected = nil
                decoded.ConfigsName = nil
                defaults = Services.HttpService:JSONEncode(decoded)
            end
            if Library:LoadConfig(defaults) then
                Config.save(activeName())
                notify("Config", "Reset to default", activeName())
            end
        end,
    })

    statusLabel = configs:Label("", { Translate = false })

    Config.OnSaved = function() showSaved() end
    Library.Maid:Give(function() Config.OnSaved = nil end)
    Library.Maid:Give(Locale.onChanged(function() showIdle() end))

    Config.AutoSaveTarget = nil -- the active config is the target

    Util.FS.ensureFolder(Library.Folders.Configs)
    refresh()

    local server = page:Section({
        Name = "Server",
        Icon = "137536208031314",
        Side = 1,
        Collapsible = true,
    })

    server:Button({
        Name = "Rejoin",
        Callback = function()
            if not teleportTo(game.JobId) then
                notify("Rejoin", "Failed to rejoin")
            end
        end,
    })

    server:Button({
        Name = "Server hop",
        Callback = function()
            notify("Server hop", "Searching")
            local servers = fetchServers()
            if servers then
                for _, s in ipairs(servers) do
                    if s.id ~= game.JobId and tonumber(s.playing) and tonumber(s.maxPlayers) and s.playing < s.maxPlayers then
                        if teleportTo(s.id) then return end
                    end
                end
            end
            notify("Server hop", "No server found")
        end,
    })

    server:Button({
        Name = "Join smallest server",
        Callback = function()
            notify("Server hop", "Searching")
            local servers = fetchServers()
            local best
            if servers then
                for _, s in ipairs(servers) do
                    if s.id ~= game.JobId and tonumber(s.playing) and tonumber(s.maxPlayers) and s.playing < s.maxPlayers then
                        if not best or s.playing < best.playing then best = s end
                    end
                end
            end
            if not (best and teleportTo(best.id)) then
                notify("Server hop", "No server found")
            end
        end,
    })

    local menu = page:Section({
        Name = "Menu",
        Icon = "123876321379439",
        Side = 2,
        Collapsible = true,
    })

    local function ensureWatermark()
        if not Library._watermarkRunning then
            Library._watermarkRunning = true
            local genv = (typeof(getgenv) == "function") and getgenv() or _G
            local session = genv.B3_SESSION or {}
            local hubName = session.HubName or "B3 HUB"
            local gameName = session.GameName or Util.getMapName()

            local function getPing()
                local ping = 0
                pcall(function()
                    local stats = game:GetService("Stats")
                    local perf = stats and stats.PerformanceStats
                    local p = perf and perf.Ping
                    if p then ping = math.floor(p:GetValue() + 0.5) end
                end)
                return tostring(ping)
            end

            local function update()
                if Library.Unloaded then return end
                Library:Watermark({
                    hubName,
                    gameName,
                    tostring(FrameRate.get()) .. " fps",
                    getPing() .. " ms",
                    os.date("%H:%M"),
                })
            end
            update()

            task.spawn(function()
                while not Library.Unloaded do
                    if Library.WatermarkFrame and Library.WatermarkFrame.Instance and Library.WatermarkFrame.Instance.Visible then
                        pcall(update)
                    end
                    task.wait(1)
                end
            end)
        end
    end

    menu:Toggle({
        Name = "Watermark",
        Flag = "WatermarkToggle",
        Default = false,
        Callback = function(value)
            if value then
                ensureWatermark()
                Library:SetWatermarkVisible(true)
            else
                Library:SetWatermarkVisible(false)
            end
        end,
    })

    menu:Toggle({
        Name = "Keybind list",
        Flag = "KeybindListToggle",
        Default = false,
        Callback = function(value)
            local target = keybindList or Library.KeyList
            if not target and value then
                target = Library:KeybindList("Keybinds")
            end
            if target then target:SetVisibility(value) end
        end,
    })

    menu:Toggle({
        Name = "Start minimized",
        Flag = "SilentLoadToggle",
        Default = Config.getSilentLoad(),
        Callback = function(value)
            if value ~= Config.getSilentLoad() then
                Config.setSilentLoad(value)
            end
        end,
    })

    menu:Toggle({
        Name = "Animations",
        Flag = "AnimationsToggle",
        Default = true,
        Callback = function(value)
            Library.Animations = value
        end,
    })

    menu:Button({
        Name = "Unload",
        Danger = true,
        Callback = function()
            if window.UnloadConfirm then
                window.UnloadConfirm:Open()
            else
                Library:Unload()
            end
        end,
    })

    return page
end

return true
]]

__sources["components/Slider"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Input = require("core/Input")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local function decimalsOf(step)
    local s = tostring(step)
    local dot = string.find(s, ".", 1, true)
    return dot and (#s - dot) or 0
end

function Section:Slider(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local slider = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Slider"),
        Min = Base.opt(data, "Min", 0),
        Max = Base.opt(data, "Max", 100),
        Decimals = Base.opt(data, "Decimals", 1),
        Suffix = Base.opt(data, "Suffix", ""),
        Callback = Base.opt(data, "Callback", nil),
        Finished = Base.opt(data, "Finished", false),
        Format = Base.opt(data, "Format", nil),
        Parse = Base.opt(data, "Parse", nil),
        AllowOverMax = Base.opt(data, "AllowOverMax", false),
        Value = nil,
        Sliding = false,
    }
    if slider.Max < slider.Min then
        slider.Min, slider.Max = slider.Max, slider.Min
    end
    local digits = decimalsOf(slider.Decimals)

    local row = Base.row(container, 34)

    local label = Base.text(row, slider.Name, {
        Size = UDim2.new(1, -60, 0, 16),
        TextSize = 14,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)

    local valueBox = New("TextBox", {
        Name = "Value",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(130, 16),
        BackgroundTransparency = 1,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextSize = 14,
        TextTransparency = 0.2,
        Theme = { TextColor3 = "Text" },
        Parent = row,
    })

    local function stepButton(text, anchorX, posX)
        local b = New("TextButton", {
            AnchorPoint = Vector2.new(anchorX, 0.5),
            Position = UDim2.new(posX, 0, 1, -8),
            Size = UDim2.fromOffset(16, 16),
            BackgroundTransparency = 1,
            Text = text,
            TextSize = 14,
            TextTransparency = 0.35,
            Theme = { TextColor3 = "Text" },
            Parent = row,
        })
        Base.hover(b, function()
            Tween.play(b, { TextTransparency = 0 }, 0.1)
        end, function()
            Tween.play(b, { TextTransparency = 0.35 }, 0.1)
        end)
        return b
    end
    local minus = stepButton("-", 0, 0)
    local plus = stepButton("+", 1, 1)

    local hitbox = New("TextButton", {
        Name = "Track",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 22, 1, -8),
        Size = UDim2.new(1, -44, 0, 16),
        BackgroundTransparency = 1,
        Parent = row,
    })

    local track = New("Frame", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.new(1, 0, 0, 6),
        Theme = { BackgroundColor3 = "Element" },
        Corner = UDim.new(1, 0),
        Parent = hitbox,
    })

    local fill = New("Frame", {
        Size = UDim2.fromScale(0, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        Corner = UDim.new(1, 0),
        Parent = track,
    })
    Theme.gradient(fill, -100)

    local knob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0, 0.5),
        Size = UDim2.fromOffset(12, 12),
        Theme = { BackgroundColor3 = "Text" },
        Corner = UDim.new(1, 0),
        Parent = track,
    })
    local knobScale = New("UIScale", { Parent = knob })

    local function layoutLabel()
        local valueWidth = math.min(valueBox.TextBounds.X, 130)
        label.Size = UDim2.new(1, -(math.ceil(valueWidth) + 10), 0, 16)
    end
    valueBox:GetPropertyChangedSignal("TextBounds"):Connect(layoutLabel)
    task.defer(layoutLabel)

    slider.Items = { Slider = { Instance = row }, Text = { Instance = label }, RealSlider = { Instance = track }, Accent = { Instance = fill }, Value = { Instance = valueBox } }

    Base.hover(hitbox, function()
        Tween.play(knobScale, { Scale = 1.2 }, 0.1)
    end, function()
        if not slider.Sliding then Tween.play(knobScale, { Scale = 1 }, 0.1) end
    end)

    local function format(v)
        if slider.Format then
            local ok, custom = pcall(slider.Format, v)
            if ok and custom ~= nil then return tostring(custom) end
        end
        if digits == 0 or v == math.floor(v) then
            return tostring(math.floor(v)) .. slider.Suffix
        end
        return string.format("%." .. digits .. "f", v) .. slider.Suffix
    end

    function slider:Get()
        return self.Value
    end

    function slider:Set(value, animate)
        value = tonumber(value)
        if not value then return end
        if self.AllowOverMax and value > self.Max then
            self.Max = value
        end
        value = Util.round(math.clamp(value, self.Min, self.Max), self.Decimals)
        value = math.clamp(value, self.Min, self.Max)
        local changed = value ~= self.Value
        self.Value = value
        Library.Flags[self.Flag] = value
        if changed then
            Library:NotifyFlagChanged(self.Flag, value)
        end

        local range = self.Max - self.Min
        local alpha = range > 0 and (value - self.Min) / range or 0
        if animate then
            Tween.play(fill, { Size = UDim2.fromScale(alpha, 1) }, 0.1)
            Tween.play(knob, { Position = UDim2.fromScale(alpha, 0.5) }, 0.1)
        else
            Tween.set(fill, { Size = UDim2.fromScale(alpha, 1) })
            Tween.set(knob, { Position = UDim2.fromScale(alpha, 0.5) })
        end
        if not valueBox:IsFocused() then
            valueBox.Text = format(value)
        end
        if changed then
            if not (self.Finished and self.Sliding) then
                Util.callback(self.Callback, value)
            end
        end
    end

    function slider:SetMin(min)
        min = tonumber(min) or self.Min
        self.Min = min
        if self.Max < min then self.Max = min end
        self:Set(self.Value)
    end
    function slider:SetMax(max)
        max = tonumber(max) or self.Max
        self.Max = max
        if self.Min > max then self.Min = max end
        self:Set(self.Value)
    end
    function slider:SetText(text) self.Name = tostring(text) Locale.setText(label, "Text", self.Name) end
    function slider:RefreshPosition() end

    slider.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        slider:Set(value)
    end)

    local function fromPosition(pos)
        pos = Input.toGui(track, pos)
        local ap, as = track.AbsolutePosition, track.AbsoluteSize
        if as.X <= 0 then return end
        local alpha = math.clamp((pos.X - ap.X) / as.X, 0, 1)
        slider:Set(slider.Min + (slider.Max - slider.Min) * alpha)
    end

    Base.maid(slider):Give(Input.drag(hitbox, {
        onStart = function(pos)
            slider.Sliding = true
            Base.lockScroll(row, true)
            Tween.play(knobScale, { Scale = 1.2 }, 0.1)
            fromPosition(pos)
        end,
        onMove = function(_, pos)
            fromPosition(pos)
        end,
        onEnd = function()
            slider.Sliding = false
            Base.lockScroll(row, false)
            Tween.play(knobScale, { Scale = 1 }, 0.1)
            if slider.Finished then
                Util.callback(slider.Callback, slider.Value)
            end
        end,
    }))

    minus.Activated:Connect(function()
        slider:Set((slider.Value or slider.Min) - slider.Decimals, true)
    end)
    plus.Activated:Connect(function()
        slider:Set((slider.Value or slider.Min) + slider.Decimals, true)
    end)

    local SUFFIX_SCALE_MAP = {
        k = 1e3, m = 1e6, b = 1e9, t = 1e12,
        qa = 1e15, q = 1e15, qi = 1e18, sx = 1e21,
        sp = 1e24, oc = 1e27, no = 1e30, n = 1e30,
        dc = 1e33, ud = 1e36, dd = 1e39, td = 1e42,
        qtd = 1e45, qid = 1e48, sxd = 1e51, spd = 1e54,
        ocd = 1e57, nod = 1e60, vg = 1e63,
    }

    local function parseInputText(rawText)
        if type(rawText) ~= "string" then return tonumber(rawText) end
        if slider.Parse then
            local ok, parsed = pcall(slider.Parse, rawText)
            if ok and typeof(parsed) == "number" then return parsed end
        end
        local clean = string.lower(string.gsub(rawText, "[$%s,]", ""))
        if clean == "" or clean == "0" then return 0 end

        local plainNum = tonumber(clean)
        if plainNum then return plainNum end

        local numPart, suffixPart = string.match(clean, "^([%d%.]+)%s*([%a]+)$")
        if numPart and suffixPart then
            local base = tonumber(numPart)
            local multi = SUFFIX_SCALE_MAP[suffixPart]
            if base and multi then
                return base * multi
            end
        end
        return tonumber((string.gsub(rawText, "[^%d%.%-]", "")))
    end

    valueBox.Focused:Connect(function()
        if slider.Format then
            valueBox.Text = format(slider.Value)
        else
            valueBox.Text = Util.formatNumber(slider.Value)
        end
    end)
    valueBox.FocusLost:Connect(function()
        local number = parseInputText(valueBox.Text)
        if number then
            if slider.AllowOverMax and number > slider.Max then
                slider.Max = number
            end
            slider:Set(number, true)
        end
        valueBox.Text = format(slider.Value)
    end)

    Base.finish(slider, container, row, data)
    slider:Set(Base.opt(data, "Default", slider.Min))
    return slider
end

return true
]]

__sources["components/StatGrid"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Base = require("components/Base")

local Section = Library.SectionClass

function Section:StatGrid(data)
    data = data or {}
    local container = self
    local rawCards = data.Cards or data.cards or (type(data) == "table" and not data.Cards and data) or {}

    local gridObj = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Cards = {},
        Items = {},
    }

    local row = Base.row(container, 0, {
        AutomaticSize = Enum.AutomaticSize.Y,
    })

    local columns = data.Columns or data.columns or (Library.IsMobile and 2 or 3)
    local cellHeight = data.CellHeight or 46

    local grid = New("Frame", {
        Name = "Grid",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        Parent = row,
    })

    local spacing = 6
    local layout = New("UIGridLayout", {
        CellPadding = UDim2.fromOffset(spacing, spacing),
        CellSize = UDim2.new(1 / columns, -math.floor(spacing * (columns - 1) / columns), 0, cellHeight),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = grid,
    })

    local function createCard(index, cardData)
        local id = cardData.Id or cardData.id or cardData.Title or cardData.title or tostring(index)
        local titleText = cardData.Title or cardData.title or cardData.Name or cardData.name or ""
        local valueText = cardData.Value or cardData.value or "-"

        local cardFrame = New("Frame", {
            Name = "Card_" .. tostring(id),
            Theme = { BackgroundColor3 = "Element" },
            Corner = 6,
            LayoutOrder = index,
            Padding = { Top = 6, Bottom = 6, Left = 8, Right = 8 },
            List = { Padding = 2, VAlign = Enum.VerticalAlignment.Center },
            Parent = grid,
        })

        local valueLabel = New("TextLabel", {
            Name = "Value",
            Size = UDim2.new(1, 0, 0, 16),
            Text = tostring(valueText),
            TextSize = 14,
            FontFace = Library.Fonts.Bold,
            Theme = { TextColor3 = "Text" },
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = cardFrame,
        })

        local titleLabel = New("TextLabel", {
            Name = "Title",
            Size = UDim2.new(1, 0, 0, 13),
            Text = tostring(titleText),
            TextSize = 11,
            FontFace = Library.Fonts.Regular,
            Theme = { TextColor3 = "SubText" },
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = cardFrame,
        })

        local entry = {
            Id = id,
            Frame = cardFrame,
            ValueLabel = valueLabel,
            TitleLabel = titleLabel,
            Value = valueText,
            Title = titleText,
        }
        gridObj.Cards[id] = entry
        return entry
    end

    local count = 0
    for idx, c in ipairs(rawCards) do
        count = count + 1
        createCard(count, c)
    end

    function gridObj:Set(id, value, title)
        local c = self.Cards[id]
        if not c then
            count = count + 1
            c = createCard(count, { Id = id, Title = title or id, Value = value })
        end
        if value ~= nil then
            c.Value = tostring(value)
            c.ValueLabel.Text = c.Value
        end
        if title ~= nil then
            c.Title = tostring(title)
            c.TitleLabel.Text = c.Title
        end
    end

    function gridObj:SetValue(id, value)
        self:Set(id, value)
    end

    function gridObj:SetTitle(id, title)
        self:Set(id, nil, title)
    end

    function gridObj:Get(id)
        local c = self.Cards[id]
        return c and c.Value or nil
    end

    gridObj.Items = { Row = { Instance = row }, Grid = { Instance = grid } }
    Base.finish(gridObj, container, row, data)
    return gridObj
end

return Section
]]

__sources["components/TargetInfo"] = [[
local Library = require("core/Library")
local New = require("core/Create")
local Theme = require("core/Theme")
local Input = require("core/Input")
local Util = require("core/Util")
local Gui = require("core/Gui")
local Services = require("core/Services")

local Players = Services.Players
local RunService = Services.RunService

local PANEL_WIDTH = 196
local ICON_SIZE = 34
local SCALE_MIN, SCALE_MAX = 0.5, 3
local SLOT_TRANSPARENCY = 0.5 -- item slots: visible tint, not solid
local UPDATE_INTERVAL = 1 / 15
local TARGET_GRACE = 0.6 -- keep showing a target this long after the lock drops (no flicker)
local STUDS_TO_METERS = 0.28
local DEFAULT_POS = { x = 0.80, y = 0.40 }

local TI = {
    Config = {
        Enabled = false,
        Preview = false, -- shows the panel with sample data (never your own) so it can be placed
        HideWithoutTarget = true,
        LockPosition = false,
        Meters = true,
        GripStyle = "Dots", -- resize handle: "Dots" | "Corner"
        PointRadius = 180, -- px around the screen centre that counts as looking at a player
        Scale = 1,
        Opacity = 0.9,
        Show = {},
    },
    TargetProvider = nil, -- function() -> player, part (default: Library.Aim lock)
    Fields = {}, -- ordered field definitions
}
Library.TargetInfo = TI

local frame, header, content, scaleObj, stroke, grip
local avatarImage, nameLabel, userLabel
local rows = {}
local conn
local pos = { x = DEFAULT_POS.x, y = DEFAULT_POS.y }
local posFlag
local lastTarget, lastSeen = nil, 0
local lastTick = 0
local shownUserId

local function fieldShown(def)
    local v = TI.Config.Show[def.id]
    if v == nil then return def.default ~= false end
    return v
end

local function fmtDistance(studs)
    if TI.Config.Meters then return string.format("%d m", math.floor(studs * STUDS_TO_METERS + 0.5)) end
    return string.format("%d studs", math.floor(studs + 0.5))
end

local function addBuiltin(id, label, kind, default, get)
    table.insert(TI.Fields, { id = id, label = label, kind = kind, default = default, get = get, builtin = true })
end

addBuiltin("Header", "Player", "head", true) -- avatar + name + username
addBuiltin("Health", "Health", "bar", true, function(ctx)
    local hum = ctx.hum
    if not hum then return "-", 0 end
    local max = math.max(hum.MaxHealth, 1)
    return string.format("%d / %d", math.floor(hum.Health + 0.5), math.floor(max + 0.5)), math.clamp(hum.Health / max, 0, 1)
end)
addBuiltin("Distance", "Distance", "row", true, function(ctx)
    if not (ctx.root and ctx.camera) then return "-" end
    return fmtDistance((ctx.root.Position - ctx.camera.CFrame.Position).Magnitude)
end)

function TI:AddField(id, label, getter, default)
    if type(id) ~= "string" or type(getter) ~= "function" then return self end
    for i, def in ipairs(self.Fields) do
        if def.id == id then
            if rows[id] then rows[id].frame:Destroy() rows[id] = nil end
            table.remove(self.Fields, i)
            break
        end
    end
    table.insert(self.Fields, { id = id, label = label or id, kind = "row", default = default ~= false, get = getter })
    return self
end

function TI:RemoveField(id)
    for i, def in ipairs(self.Fields) do
        if def.id == id and not def.builtin then
            if rows[id] then rows[id].frame:Destroy() rows[id] = nil end
            table.remove(self.Fields, i)
            break
        end
    end
    return self
end

local adapters = {}
local adapterCache, adapterCacheAt = nil, -10

function TI:RegisterAdapter(name, def)
    if type(name) ~= "string" or type(def) ~= "table" then return self end
    for i, a in ipairs(adapters) do
        if a.Name == name then table.remove(adapters, i) break end
    end
    def.Name = name
    table.insert(adapters, 1, def)
    adapterCache, adapterCacheAt = nil, -10
    return self
end

function TI:GetAdapter()
    local now = os.clock()
    if now - adapterCacheAt < 2 then return adapterCache end
    adapterCacheAt = now
    adapterCache = nil
    for _, a in ipairs(adapters) do
        if type(a.Match) == "function" then
            local ok, hit = pcall(a.Match)
            if ok and hit then adapterCache = a break end
        end
    end
    return adapterCache
end

local fieldList = {}
function TI:GetFields()
    table.clear(fieldList)
    for _, def in ipairs(self.Fields) do
        if def.builtin then table.insert(fieldList, def) end
    end
    local ad = self:GetAdapter()
    if ad and type(ad.Fields) == "table" then
        for _, def in ipairs(ad.Fields) do
            def.kind = def.kind or "row"
            table.insert(fieldList, def)
        end
    end
    for _, def in ipairs(self.Fields) do
        if not def.builtin then table.insert(fieldList, def) end
    end
    return fieldList
end

local function applyPosition()
    if not frame then return end
    frame.Position = UDim2.fromScale(pos.x, pos.y)
end

local function clampPosition()
    if not frame then return end
    local vp = Gui.viewport()
    local size = frame.AbsoluteSize
    local scale = scaleObj and scaleObj.Scale or 1
    local maxX = math.max(0, 1 - (size.X) / math.max(vp.X, 1))
    local maxY = math.max(0, 1 - (size.Y) / math.max(vp.Y, 1))
    pos.x = math.clamp(pos.x, 0, maxX)
    pos.y = math.clamp(pos.y, 0, maxY)
    applyPosition()
end

local function savePosition()
    if not posFlag then return end
    Library.Flags[posFlag] = { x = pos.x, y = pos.y }
    Library:NotifyFlagChanged(posFlag, Library.Flags[posFlag])
end

local function ensureFlag()
    if posFlag then return end
    posFlag = Library:RegisterFlag("B3TI_Position", function(value)
        if type(value) == "table" and tonumber(value.x) and tonumber(value.y) then
            pos.x, pos.y = tonumber(value.x), tonumber(value.y)
            if frame then clampPosition() end
        end
    end)
    Library.Flags[posFlag] = { x = pos.x, y = pos.y }
end

local function makeRow(def)
    if def.kind == "icons" then
        local row = New("Frame", {
            Name = def.id,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 10,
            List = { Padding = 2 },
            Parent = content,
        })
        if not def.hideLabel then
            New("TextLabel", {
                Size = UDim2.new(1, 0, 0, 14),
                LayoutOrder = 1,
                Text = def.label,
                TextSize = 12,
                TextTransparency = 0.25,
                Theme = { TextColor3 = "SubText" },
                Parent = row,
            })
        end
        local grid = New("Frame", {
            Name = "Items",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            Parent = row,
        })
        if def.captions then
            local layout = Instance.new("UIListLayout")
            layout.Padding = UDim.new(0, 3)
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.Parent = grid
        else
            local layout = Instance.new("UIGridLayout")
            if def.columns then
                local gap = 4
                layout.CellSize = UDim2.new(1 / def.columns, -(gap * (def.columns - 1) + 3) / def.columns, 0, def.cellHeight or ICON_SIZE)
            else
                layout.CellSize = UDim2.fromOffset(ICON_SIZE, ICON_SIZE)
            end
            layout.CellPadding = UDim2.fromOffset(4, 4)
            layout.SortOrder = Enum.SortOrder.LayoutOrder
            layout.Parent = grid
        end
        return { frame = row, grid = grid, cells = {}, sig = "", isIcons = true }
    end

    if def.wrap then
        local row = New("Frame", {
            Name = def.id,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 10,
            List = { Padding = 1 },
            Parent = content,
        })
        New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 14),
            LayoutOrder = 1,
            Text = def.label,
            TextSize = 12,
            TextTransparency = 0.25,
            Theme = { TextColor3 = "SubText" },
            Parent = row,
        })
        local value = New("TextLabel", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            LayoutOrder = 2,
            TextSize = 12,
            TextWrapped = true,
            TextYAlignment = Enum.TextYAlignment.Top,
            Theme = { TextColor3 = "Text" },
            Parent = row,
        })
        return { frame = row, value = value, text = "" }
    end

    local row = New("Frame", {
        Name = def.id,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, def.kind == "bar" and 28 or 16),
        LayoutOrder = 10,
        Parent = content,
    })
    New("TextLabel", {
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(0.45, 0, 0, 14),
        Text = def.label,
        TextSize = 12,
        TextTransparency = 0.25,
        Theme = { TextColor3 = "SubText" },
        Parent = row,
    })
    local value = New("TextLabel", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.new(0.55, 0, 0, 14),
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Theme = { TextColor3 = "Text" },
        Parent = row,
    })
    local entry = { frame = row, value = value, text = "", fill = nil }
    if def.kind == "bar" then
        local track = New("Frame", {
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.new(0, 0, 1, 0),
            Size = UDim2.new(1, 0, 0, 8),
            Corner = 3,
            Theme = { BackgroundColor3 = "Element" },
            Parent = row,
        })
        entry.fill = New("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.fromRGB(80, 220, 100),
            Corner = 3,
            Parent = track,
        })
    end
    return entry
end

local function setIcons(entry, def, list)
    local parts = table.create(#list)
    for i, item in ipairs(list) do parts[i] = tostring(item.image) .. "|" .. tostring(item.name) end
    local sig = table.concat(parts, ";")
    if sig == entry.sig then return end
    entry.sig = sig
    for _, cell in ipairs(entry.cells) do cell:Destroy() end
    table.clear(entry.cells)
    for i, item in ipairs(list) do
        local cell = New("Frame", {
            Name = "Item",
            LayoutOrder = i,
            Size = def.captions and UDim2.new(1, 0, 0, ICON_SIZE) or UDim2.fromOffset(ICON_SIZE, ICON_SIZE),
            Corner = 4,
            BackgroundTransparency = SLOT_TRANSPARENCY,
            Theme = { BackgroundColor3 = "Element" },
            Parent = entry.grid,
        })
        local hasImage = type(item.image) == "string" and item.image ~= ""
        if hasImage then
            local centered = not def.captions
            New("ImageLabel", {
                AnchorPoint = centered and Vector2.new(0.5, 0.5) or Vector2.new(0, 0.5),
                Position = centered and UDim2.fromScale(0.5, 0.5) or UDim2.new(0, 4, 0.5, 0),
                Size = centered and UDim2.new(1, -6, 1, -6) or UDim2.fromOffset(56, ICON_SIZE - 8),
                Image = item.image,
                ScaleType = Enum.ScaleType.Fit,
                Parent = cell,
            })
        end
        if (def.captions or not hasImage) and not def.noNames and item.name then
            New("TextLabel", {
                AnchorPoint = def.captions and Vector2.new(1, 0.5) or Vector2.new(0.5, 0.5),
                Position = def.captions and UDim2.new(1, -4, 0.5, 0) or UDim2.fromScale(0.5, 0.5),
                Size = def.captions and UDim2.new(1, -66, 1, 0) or UDim2.new(1, -4, 1, 0),
                Text = tostring(item.name or "?"),
                TextSize = def.captions and 12 or 9,
                TextWrapped = true,
                TextTruncate = Enum.TextTruncate.AtEnd,
                TextXAlignment = def.captions and Enum.TextXAlignment.Left or Enum.TextXAlignment.Center,
                Theme = { TextColor3 = "Text" },
                Parent = cell,
            })
        end
        table.insert(entry.cells, cell)
    end
end

function TI:_DrawGrip()
    if not grip then return end
    for _, child in ipairs(grip:GetChildren()) do child:Destroy() end
    local style = self.Config.GripStyle or "Dots"
    local function mark(x, y, w, h, key)
        New("Frame", {
            AnchorPoint = Vector2.new(1, 1),
            Position = UDim2.new(1, -x, 1, -y),
            Size = UDim2.fromOffset(w, h),
            BackgroundTransparency = style == "Dots" and 0.35 or 0.1,
            ZIndex = 11,
            Corner = 1,
            Theme = { BackgroundColor3 = key },
            Parent = grip,
        })
    end
    if style == "Corner" then
        mark(4, 4, 9, 2, "Accent") -- bottom edge of the L
        mark(4, 4, 2, 9, "Accent") -- right edge of the L
    else
        for _, d in ipairs({ { 0, 0 }, { 4, 0 }, { 8, 0 }, { 0, 4 }, { 4, 4 }, { 0, 8 } }) do
            mark(4 + d[1], 4 + d[2], 2, 2, "SubText")
        end
    end
end

local function build()    if frame then return end
    Gui.init()
    ensureFlag()

    frame = New("Frame", {
        Name = "TargetInfo",
        AnchorPoint = Vector2.new(0, 0),
        Size = UDim2.fromOffset(PANEL_WIDTH, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 0.1,
        Visible = false,
        Active = true,
        Theme = { BackgroundColor3 = "Background" },
        Corner = 6,
        Stroke = { Color = "Outline", Thickness = 1, Transparency = 0.5 },
        List = { Padding = 0 },
        Parent = Gui.Top,
    })
    stroke = frame:FindFirstChildOfClass("UIStroke")
    scaleObj = Instance.new("UIScale")
    scaleObj.Parent = frame

    header = New("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 46),
        BackgroundTransparency = 1,
        LayoutOrder = 1,
        Parent = frame,
    })
    avatarImage = New("ImageLabel", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        Size = UDim2.fromOffset(34, 34),
        Corner = 6,
        Theme = { BackgroundColor3 = "Element" },
        BackgroundTransparency = 0,
        Parent = header,
    })
    nameLabel = New("TextLabel", {
        Position = UDim2.fromOffset(50, 7),
        Size = UDim2.new(1, -56, 0, 18),
        TextSize = 14,
        FontFace = Library.Fonts.Bold,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Theme = { TextColor3 = "Text" },
        Parent = header,
    })
    userLabel = New("TextLabel", {
        Position = UDim2.fromOffset(50, 25),
        Size = UDim2.new(1, -56, 0, 14),
        TextSize = 11,
        TextTransparency = 0.3,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Theme = { TextColor3 = "SubText" },
        Parent = header,
    })

    content = New("Frame", {
        Name = "Content",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        LayoutOrder = 2,
        Padding = { Top = 0, Bottom = 8, Left = 10, Right = 10 },
        List = { Padding = 4 },
        Parent = frame,
    })

    local startPos
    Library.Maid:Give(Input.drag(frame, {
        threshold = 3,
        onStart = function()
            if TI.Config.LockPosition then return false end
            startPos = { x = pos.x, y = pos.y }
        end,
        onMove = function(delta)
            local vp = Gui.viewport()
            pos.x = startPos.x + delta.X / math.max(vp.X, 1)
            pos.y = startPos.y + delta.Y / math.max(vp.Y, 1)
            clampPosition()
        end,
        onEnd = function(moved)
            if moved then savePosition() end
        end,
    }))

    local gripHolder = New("Frame", {
        Name = "GripHolder",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 0),
        LayoutOrder = 99,
        Parent = frame,
    })
    grip = New("TextButton", {
        Name = "ResizeGrip",
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -2, 0, -2),
        Size = UDim2.fromOffset(20, 20),
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Visible = false,
        ZIndex = 10,
        Parent = gripHolder,
    })
    TI:_DrawGrip()
    local startScale, startWidth
    Library.Maid:Give(Input.drag(grip, {
        threshold = 2,
        onStart = function()
            startScale = math.clamp(tonumber(TI.Config.Scale) or 1, SCALE_MIN, SCALE_MAX)
            startWidth = math.max(frame.AbsoluteSize.X, 40)
        end,
        onMove = function(delta)
            local width = math.max(startWidth + delta.X, 40)
            TI:Set({ Scale = math.clamp(startScale * width / startWidth, SCALE_MIN, SCALE_MAX) })
        end,
        onEnd = function(moved)
            if not moved then return end
            task.defer(function()
                clampPosition()
                savePosition()
                local setter = TI.ScaleFlag and Library.SetFlags[TI.ScaleFlag]
                if setter then setter(math.floor(TI.Config.Scale * 10 + 0.5) / 10) end
            end)
        end,
    }))

    applyPosition()
end

local PREVIEW_PLAYER = { Name = "preview", DisplayName = "Preview", UserId = 0, Parent = true, IsPreview = true }

local function resolveContext(player, part)
    if player == PREVIEW_PLAYER then
        local camera = Services.Workspace.CurrentCamera
        return {
            player = player,
            hum = { Health = 100, MaxHealth = 100 },
            root = camera and { Position = camera.CFrame.Position + camera.CFrame.LookVector * 50 } or nil,
            camera = camera,
            preview = true,
        }
    end
    local char = player and player.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and (char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso") or char.PrimaryPart)
    return {
        player = player,
        char = char,
        hum = hum,
        root = root,
        part = part,
        camera = Services.Workspace.CurrentCamera,
    }
end

local function currentTarget()
    if TI.TargetProvider then
        local ok, p, part = pcall(TI.TargetProvider)
        if ok and p then return p, part end
        return nil
    end
    local aim = Library.Aim
    if aim then
        if aim.LockedPlayer then return aim.LockedPlayer, aim.LockedPart end
        if type(aim.GetCrosshairPlayer) == "function" then
            local ok, p = pcall(aim.GetCrosshairPlayer, aim, TI.Config.PointRadius)
            if ok and p then return p, nil end
        end
    end
    return nil
end

local function setText(label, text)
    if label.Text ~= text then label.Text = text end
end

local function updateAppearance()
    local cfg = TI.Config
    local scale = math.clamp(tonumber(cfg.Scale) or 1, SCALE_MIN, SCALE_MAX) * (Gui.Scale or 1)
    if scaleObj.Scale ~= scale then scaleObj.Scale = scale end
    local bg = 1 - math.clamp(tonumber(cfg.Opacity) or 0.9, 0.1, 1)
    if frame.BackgroundTransparency ~= bg then frame.BackgroundTransparency = bg end
    if stroke then
        local movable = cfg.Preview and not cfg.LockPosition
        stroke.Transparency = movable and 0 or 0.5
        stroke.Thickness = movable and 2 or 1
    end
    if grip then grip.Visible = (cfg.Preview and not cfg.LockPosition) and true or false end
end

local function render()
    local cfg = TI.Config
    if Library.Unloaded or not cfg.Enabled then
        if frame then frame.Visible = false end
        return
    end
    build()

    local now = os.clock()
    local player, part = currentTarget()
    local preview = false
    if player then
        lastTarget, lastSeen = { player = player, part = part }, now
    elseif lastTarget and now - lastSeen < TARGET_GRACE then
        player, part = lastTarget.player, lastTarget.part
    elseif cfg.Preview then
        player, part, preview = PREVIEW_PLAYER, nil, true
    end

    if not player or not player.Parent then
        if cfg.HideWithoutTarget then
            frame.Visible = false
            return
        end
        frame.Visible = true
        updateAppearance()
        applyPosition()
        header.Visible = true
        avatarImage.Visible = false
        nameLabel.Visible = true
        userLabel.Visible = false
        nameLabel.Position = UDim2.fromOffset(10, 14)
        nameLabel.Size = UDim2.new(1, -16, 0, 18)
        setText(nameLabel, "No target")
        for _, entry in pairs(rows) do entry.frame.Visible = false end
        shownUserId = nil
        return
    end
    frame.Visible = true
    updateAppearance()
    applyPosition()

    local ctx = resolveContext(player, part)

    local fields = TI:GetFields()
    local showAvatar, showName, showUser = false, false, false
    for _, def in ipairs(fields) do
        if def.kind == "head" and fieldShown(def) then
            showAvatar, showName, showUser = true, true, true
        end
    end
    header.Visible = showAvatar or showName or showUser
    avatarImage.Visible = showAvatar
    nameLabel.Visible = showName
    userLabel.Visible = showUser
    local textX = showAvatar and 50 or 10
    nameLabel.Position = UDim2.fromOffset(textX, showUser and 7 or 14)
    userLabel.Position = UDim2.fromOffset(textX, showName and 25 or 16)
    nameLabel.Size = UDim2.new(1, -(textX + 6), 0, 18)
    userLabel.Size = UDim2.new(1, -(textX + 6), 0, 14)
    if preview then
        shownUserId = nil
        if avatarImage.Image ~= "" then avatarImage.Image = "" end
    elseif showAvatar and shownUserId ~= player.UserId then
        shownUserId = player.UserId
        avatarImage.Image = string.format("rbxthumb://type=AvatarHeadShot&id=%d&w=150&h=150", player.UserId)
    end
    setText(nameLabel, player.DisplayName ~= "" and player.DisplayName or player.Name)
    setText(userLabel, preview and "drag to move" or ("@" .. player.Name))

    local order = 10
    local fields = TI:GetFields()
    for id, entry in pairs(rows) do entry.stale = true end
    for _, def in ipairs(fields) do
        if def.kind ~= "head" then
            local entry = rows[def.id]
            local text, ratio, list
            if fieldShown(def) then
                local ok, a, b = pcall(def.get, ctx)
                if preview and def.sample then ok, a, b = true, def.sample(), nil end
                if ok and def.kind == "icons" then
                    if type(a) == "table" and #a > 0 then list = a end
                elseif ok and a ~= nil and a ~= "" then
                    text, ratio = tostring(a), b
                end
            end
            if list then
                if not entry then
                    entry = makeRow(def)
                    rows[def.id] = entry
                end
                entry.stale = false
                order = order + 1
                entry.frame.LayoutOrder = order
                entry.frame.Visible = true
                setIcons(entry, def, list)
            elseif text then
                if not entry then
                    entry = makeRow(def)
                    rows[def.id] = entry
                end
                entry.stale = false
                order = order + 1
                entry.frame.LayoutOrder = order
                entry.frame.Visible = true
                setText(entry.value, text)
                if entry.fill and type(ratio) == "number" then
                    entry.fill.Size = UDim2.fromScale(math.clamp(ratio, 0, 1), 1)
                    entry.fill.BackgroundColor3 = Color3.fromRGB(235, 70, 70):Lerp(Color3.fromRGB(80, 220, 100), math.clamp(ratio, 0, 1))
                end
            elseif entry then
                entry.frame.Visible = false
                entry.stale = false
            end
        end
    end
    for _, entry in pairs(rows) do
        if entry.stale then entry.frame.Visible = false end
    end
end

local function connectLoop()
    if conn then return end
    conn = RunService.RenderStepped:Connect(function()
        local now = os.clock()
        if now - lastTick < UPDATE_INTERVAL then return end
        lastTick = now
        local ok, err = pcall(render)
        if not ok then warn("[B3] TargetInfo: " .. tostring(err)) end
    end)
    Library.Maid:Give(conn)
end

local function disconnectLoop()
    if conn then conn:Disconnect() conn = nil end
end

local function sync()
    if Library.Unloaded then return end
    if TI.Config.Enabled then
        connectLoop()
        lastTick = 0
        local ok, err = pcall(render)
        if not ok then warn("[B3] TargetInfo: " .. tostring(err)) end
    else
        disconnectLoop()
        if frame then frame.Visible = false end
    end
end

function TI:Set(opts)
    if type(opts) ~= "table" then return self end
    for k, v in pairs(opts) do
        if k == "Show" and type(v) == "table" then
            for id, on in pairs(v) do self.Config.Show[id] = on and true or false end
        else
            self.Config[k] = v
        end
    end
    if opts.GripStyle then self:_DrawGrip() end
    sync()
    return self
end

function TI:Enable() return self:Set({ Enabled = true }) end
function TI:Disable() return self:Set({ Enabled = false }) end
function TI:SetField(id, on) return self:Set({ Show = { [id] = on } }) end

function TI:SetPosition(x, y)
    pos.x, pos.y = tonumber(x) or pos.x, tonumber(y) or pos.y
    ensureFlag()
    if frame then clampPosition() end
    savePosition()
    return self
end

function TI:ResetPosition()
    return self:SetPosition(DEFAULT_POS.x, DEFAULT_POS.y)
end

function TI:GetFrame()
    return frame
end

function TI:BuildMenu(section, opts)
    opts = opts or {}
    local prefix = opts.Flag or "B3TI"
    local cfg = self.Config

    TI.ScaleFlag = prefix .. "_Scale"
    local enable = section:Toggle({
        Name = "Target info", Flag = prefix .. "_Enabled", Default = cfg.Enabled,
        Translate = true,
        Callback = function(v) TI:Set({ Enabled = v }) end,
    })
    if opts.Keybind and enable and enable.SubKeybind then
        pcall(enable.SubKeybind, enable, { Flag = prefix .. "_Key", Mode = "Toggle" })
    end
    section:Toggle({
        Name = "Move panel", Flag = prefix .. "_Preview", Default = cfg.Preview,
        Translate = true,
        Callback = function(v) TI:Set({ Preview = v }) end,
    })
    section:Slider({
        Name = "Panel size", Flag = prefix .. "_Scale", Min = SCALE_MIN, Max = SCALE_MAX, Default = cfg.Scale, Decimals = 1, Suffix = "x",
        Translate = true,
        Callback = function(v) TI:Set({ Scale = v }) end,
    })
    for _, def in ipairs(table.clone(self:GetFields())) do
        local id = def.id
        section:Toggle({
            Name = def.label, Flag = prefix .. "_Show_" .. id, Default = fieldShown(def),
            Translate = true,
            Callback = function(v) TI:SetField(id, v) end,
        })
    end
    return self
end
local catalogCache -- table | false
local function warzCatalog()
    if catalogCache ~= nil then return catalogCache or nil end
    catalogCache = false
    local rs = Services.ReplicatedStorage
    local mod = rs and rs:FindFirstChild("ItemCatalogData", true)
    if mod and mod:IsA("ModuleScript") then
        local ok, res = pcall(Util.requireModule, mod)
        if ok and type(res) == "table" then catalogCache = res end
    end
    return catalogCache or nil
end

local function itemName(id)
    local cat = warzCatalog()
    local item = cat and (cat[id] or cat[tostring(id)])
    if type(item) == "table" and item.Name then
        return (string.gsub(tostring(item.Name), "^%l", string.upper))
    end
    return "#" .. tostring(id)
end

local function splitIds(value)
    local ids = {}
    for token in string.gmatch(tostring(value or ""), "%d+") do
        local id = tonumber(token)
        if id and id > 0 then table.insert(ids, id) end
    end
    return ids
end

local function heldSlot(char)
    local slot = char and char:GetAttribute("WeaponSlot")
    slot = tonumber(slot)
    if slot and slot > 0 then return slot end
    return nil
end

local function namesOf(ids)
    local out = {}
    for _, id in ipairs(ids) do table.insert(out, itemName(id)) end
    return table.concat(out, ", ")
end

local iconAssets -- table | false
local function warzIconAssets()
    if iconAssets ~= nil then return iconAssets or nil end
    iconAssets = false
    local rs = Services.ReplicatedStorage
    if not rs then return nil end
    local candidates = {}
    local core = rs:FindFirstChild("Core")
    local assets = core and core:FindFirstChild("Assets")
    local direct = assets and assets:FindFirstChild("Inventory")
    if direct then table.insert(candidates, direct) end
    for _, d in ipairs(rs:GetDescendants()) do
        if d.Name == "Inventory" and d:IsA("ModuleScript") and d ~= direct then table.insert(candidates, d) end
    end
    for _, mod in ipairs(candidates) do
        if mod:IsA("ModuleScript") then
            local ok, res = pcall(Util.requireModule, mod)
            if ok and type(res) == "table" and type(res.Items) == "table" then
                iconAssets = res.Items
                break
            end
        end
    end
    return iconAssets or nil
end

local function itemIcon(id)
    local assets = warzIconAssets()
    local cat = warzCatalog()
    local item = cat and (cat[id] or cat[tostring(id)])
    local file = type(item) == "table" and type(item.Icon) == "string" and string.match(item.Icon, "([^/]+)$")
    local image = assets and (assets[file or ("Item_" .. tostring(id) .. ".png")])
    if type(image) == "number" then image = "rbxassetid://" .. image end
    if type(image) == "string" and image ~= "" then return image end
    return nil
end

local function itemsOf(ids)
    local list = {}
    for _, id in ipairs(ids) do table.insert(list, { image = itemIcon(id), name = itemName(id) }) end
    return list
end

local gearByMesh -- [meshId string] = item id | false
local function gearItemId(part)
    if not part or not part:IsA("MeshPart") then return nil end
    if gearByMesh == nil then
        gearByMesh = false
        local rs = Services.ReplicatedStorage
        local mod = rs and rs:FindFirstChild("GearModelData", true)
        if mod and mod:IsA("ModuleScript") then
            local ok, res = pcall(Util.requireModule, mod)
            if ok and type(res) == "table" then
                gearByMesh = {}
                for id, data in pairs(res) do
                    if type(data) == "table" and data.MeshId then
                        gearByMesh[tostring(data.MeshId)] = tonumber(id) or id
                    end
                end
            end
        end
    end
    return gearByMesh and gearByMesh[tostring(part.MeshId)] or nil
end

local function gearItem(char, partName)
    local part = char and char:FindFirstChild(partName)
    local id = gearItemId(part)
    if not id then return nil end
    return itemsOf({ id })
end

TI:RegisterAdapter("WarZ", {
    Match = function()
        local lp = Players.LocalPlayer
        local char = lp and lp.Character
        if char and (char:GetAttribute("WeaponSlot") ~= nil or char:GetAttribute("Weapon1") ~= nil) then return true end
        local ps = lp and lp:FindFirstChild("PlayerScripts")
        local client = ps and ps:FindFirstChild("Client")
        return client ~= nil and client:FindFirstChild("world") ~= nil and warzCatalog() ~= nil
    end,
    Fields = {
        { id = "Loadout", label = "Loadout", kind = "icons", columns = 3, cellHeight = 40, hideLabel = true,
          noNames = true, default = true, sample = function() return { {}, {}, {} } end, get = function(ctx)
            local weapon
            local slot = heldSlot(ctx.char)
            local id = slot and tonumber(ctx.char:GetAttribute("Weapon" .. slot))
            if id and id > 0 then weapon = itemsOf({ id })[1] end
            local armor = gearItem(ctx.char, "GearArmor")
            local helmet = gearItem(ctx.char, "GearHelmet")
            if not (weapon or armor or helmet) then return nil end
            return { weapon or {}, armor and armor[1] or {}, helmet and helmet[1] or {} }
        end },    },
})

local pvpConfigCache -- table | false
local pvpPreloaded = false
local pvpSlotCache = {}

local function preloadAssets(urls)
    if #urls == 0 then return end
    task.spawn(function()
        local okCp, cp = pcall(game.GetService, game, "ContentProvider")
        if not okCp or not cp then return end
        local batch = {}
        for i = 1, #urls do
            batch[#batch + 1] = urls[i]
            if #batch >= 25 or i == #urls then
                pcall(cp.PreloadAsync, cp, batch)
                table.clear(batch)
                task.wait(0.05)
            end
        end
    end)
end

local function preloadWarzPvpIcons(cfg)
    if pvpPreloaded then return end
    pvpPreloaded = true
    local urls, seenUrl = {}, {}
    if type(cfg.Shop) == "table" then
        for id, item in pairs(cfg.Shop) do
            local icon = (cfg.StoreIcon and cfg.StoreIcon(id)) or (type(item) == "table" and item.StoreIcon)
            if type(icon) == "string" and icon ~= "" and not seenUrl[icon] then
                seenUrl[icon] = true
                urls[#urls + 1] = icon
            end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p.UserId > 0 then
            local thumb = "rbxthumb://type=AvatarHeadShot&id=" .. tostring(p.UserId) .. "&w=100&h=100"
            if not seenUrl[thumb] then
                seenUrl[thumb] = true
                urls[#urls + 1] = thumb
            end
        end
    end
    preloadAssets(urls)
end

local function warzPvpConfig()
    if pvpConfigCache ~= nil then return pvpConfigCache or nil end
    pvpConfigCache = false
    local rs = Services.ReplicatedStorage
    local shared = rs and rs:FindFirstChild("Shared")
    local mod = shared and shared:FindFirstChild("Config")
    if mod and mod:IsA("ModuleScript") then
        local ok, res = pcall(Util.requireModule, mod)
        if ok and type(res) == "table" and type(res.Shop) == "table" then
            pvpConfigCache = res
            preloadWarzPvpIcons(res)
        end
    end
    return pvpConfigCache or nil
end

local function pvpSlot(id)
    if type(id) ~= "string" or id == "" or id == "Unarmed" then return nil end
    local cached = pvpSlotCache[id]
    if cached ~= nil then return cached end
    local cfg = warzPvpConfig()
    if not cfg then return { name = id } end
    local item = (cfg.ShopItem and cfg.ShopItem(id)) or cfg.Shop[id]
    local icon = (cfg.StoreIcon and cfg.StoreIcon(id)) or (item and item.StoreIcon)
    local label = (cfg.WeaponLabel and cfg.WeaponLabel(id)) or (item and item.Name) or id
    if type(icon) ~= "string" or icon == "" then icon = nil end
    local entry = { image = icon, name = label }
    pvpSlotCache[id] = entry
    return entry
end

TI:RegisterAdapter("WarZPVP", {
    Match = function()
        local rs = Services.ReplicatedStorage
        local shared = rs and rs:FindFirstChild("Shared")
        if shared and shared:FindFirstChild("warz") and warzPvpConfig() then return true end
        local lp = Players.LocalPlayer
        local char = lp and lp.Character
        return char ~= nil and (char:GetAttribute("WarzHero") ~= nil or char:GetAttribute("WarzCatalogId") ~= nil) and warzPvpConfig() ~= nil
    end,
    Fields = {
        { id = "Loadout", label = "Loadout", kind = "icons", columns = 3, cellHeight = 40, hideLabel = true,
          noNames = true, default = true, sample = function() return { {}, {}, {} } end, get = function(ctx)
            local char = ctx.char
            if not char then return nil end
            local wId = char:GetAttribute("WarzCatalogId")
            if type(wId) ~= "string" or wId == "" or wId == "Unarmed" then
                wId = char:GetAttribute("WarzPrimarySlotId")
            end
            local weapon = pvpSlot(wId)
            local armor = pvpSlot(char:GetAttribute("WarzArmorId"))
            local helmet = pvpSlot(char:GetAttribute("WarzHelmetId"))
            if not (weapon or armor or helmet) then return nil end
            return { weapon or {}, armor or {}, helmet or {} }
        end },
    },
})

Library.Maid:Give(function()
    frame, header, content, scaleObj, stroke, grip = nil, nil, nil, nil, nil, nil
    avatarImage, nameLabel, userLabel = nil, nil, nil
    rows = {}
    conn = nil
    posFlag = nil
    lastTarget, shownUserId = nil, nil
    catalogCache = nil
    pvpConfigCache = nil
    pvpPreloaded = false
    table.clear(pvpSlotCache)
    iconAssets = nil
    gearByMesh = nil
    adapterCache, adapterCacheAt = nil, -10
    TI.Config.Enabled = false
end)

return true
]]

__sources["components/Textbox"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Tween = require("core/Tween")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

function Section:Textbox(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local textbox = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", nil),
        Placeholder = Base.opt(data, "Placeholder", "Type here"),
        Numeric = Base.opt(data, "Numeric", false),
        Finished = Base.opt(data, "Finished", false),
        ClearOnFocus = Base.opt(data, "ClearTextOnFocus", false),
        Callback = Base.opt(data, "Callback", nil),
        MaxLength = tonumber(Base.opt(data, "MaxLength", nil)),
        Password = Base.opt(data, "Password", false) and true or false,
        MultiLine = Base.opt(data, "MultiLine", false) and true or false,
        Value = "",
    }

    local hasName = textbox.Name ~= nil and textbox.Name ~= ""
    local lines = textbox.MultiLine and math.max(2, tonumber(Base.opt(data, "Lines", 3)) or 3) or 1
    local boxHeight = textbox.MultiLine and (lines * 16 + 10) or 26
    local row = Base.row(container, (hasName and 20 or 0) + boxHeight)

    if hasName then
        Base.text(row, textbox.Name, { Size = UDim2.new(1, 0, 0, 16), TextSize = 14 }, translate)
    end

    local background = New("Frame", {
        Name = "Background",
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.fromScale(0, 1),
        Size = UDim2.new(1, 0, 0, boxHeight),
        Theme = { BackgroundColor3 = "Element" },
        Corner = 6,
        Parent = row,
    })

    local hasButton = data.Button ~= nil
    local btnWidth = hasButton and 44 or 0

    local input = New("TextBox", {
        Name = "Input",
        Position = UDim2.fromOffset(10, 0),
        Size = UDim2.new(1, -(20 + btnWidth), 1, 0),
        BackgroundTransparency = 1,
        Text = "",
        TextSize = 14,
        [translate and "Translate" or "PlaceholderText"] = translate and { PlaceholderText = textbox.Placeholder } or textbox.Placeholder,
        ClearTextOnFocus = textbox.ClearOnFocus,
        TextTruncate = textbox.MultiLine and Enum.TextTruncate.None or Enum.TextTruncate.AtEnd,
        MultiLine = textbox.MultiLine,
        TextWrapped = textbox.MultiLine,
        TextYAlignment = textbox.MultiLine and Enum.TextYAlignment.Top or Enum.TextYAlignment.Center,
        Theme = { TextColor3 = "Text", PlaceholderColor3 = "SubText" },
        Parent = background,
    })

    if hasButton then
        local btnName = data.Button.Name or "Max"
        local btn = New("TextButton", {
            Name = "Button",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -4, 0.5, 0),
            Size = UDim2.fromOffset(36, 18),
            Theme = { BackgroundColor3 = "Accent", TextColor3 = "Text" },
            Corner = 4,
            [translate and "Translate" or "Text"] = translate and { Text = btnName } or btnName,
            TextSize = 11,
            ZIndex = 5,
            AutoButtonColor = true,
            Parent = background,
        })
        Base.hover(btn, function()
            Tween.play(btn, { BackgroundTransparency = 0.2 }, 0.12)
        end, function()
            Tween.play(btn, { BackgroundTransparency = 0 }, 0.12)
        end)

        local lastClick = 0
        local function triggerBtn()
            local now = os.clock()
            if now - lastClick < 0.1 then return end
            lastClick = now
            if type(data.Button.Callback) == "function" then
                pcall(data.Button.Callback, textbox)
            end
        end

        btn.Activated:Connect(triggerBtn)
        btn.MouseButton1Click:Connect(triggerBtn)
    end

    textbox.Items = { Textbox = { Instance = row }, Background = { Instance = background }, Input = { Instance = input } }

    local settingText = false

    local function masked(value)
        return string.rep(utf8.char(0x2022), utf8.len(value) or #value)
    end
    local shownText = nil
    local function showText(value)
        settingText = true
        if textbox.Password and not input:IsFocused() then
            input.Text = masked(value)
        else
            input.Text = value
        end
        shownText = input.Text
        settingText = false
    end
    local function limit(value)
        if textbox.MaxLength and (utf8.len(value) or #value) > textbox.MaxLength then
            local cut = utf8.offset(value, textbox.MaxLength + 1)
            return cut and string.sub(value, 1, cut - 1) or string.sub(value, 1, textbox.MaxLength)
        end
        return value
    end

    local function commit(value)
        textbox.Value = value
        Library.Flags[textbox.Flag] = value
        Library:NotifyFlagChanged(textbox.Flag, value)
        Util.callback(textbox.Callback, value)
    end

    function textbox:Get()
        return self.Value
    end

    function textbox:Set(value)
        value = tostring(value == nil and "" or value)
        if self.Numeric and value ~= "" and not tonumber(value) then
            value = string.gsub(value, "[^%d%.%-]", "")
        end
        value = limit(value)
        showText(value)
        commit(value)
    end

    function textbox:Focus() input:CaptureFocus() end
    function textbox:Clear() self:Set("") end

    function textbox:SetPlaceholder(text)
        input.PlaceholderText = tostring(text)
    end

    function textbox:RefreshPosition() end

    textbox.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        textbox:Set(value)
    end)

    input:GetPropertyChangedSignal("Text"):Connect(function()
        if settingText then return end
        if input.Text == shownText then return end
        shownText = nil
        if textbox.Password and not input:IsFocused() then return end
        if textbox.MaxLength then
            local cut = limit(input.Text)
            if cut ~= input.Text then
                settingText = true
                input.Text = cut
                settingText = false
                shownText = input.Text
            end
        end
        if textbox.Numeric then
            local filtered = string.gsub(input.Text, "[^%d%.%-]", "")
            if filtered ~= input.Text then
                settingText = true
                input.Text = filtered
                settingText = false
                shownText = input.Text
            end
        end
        if not textbox.Finished then
            commit(input.Text)
        else
            Library.Flags[textbox.Flag] = input.Text
            Library:NotifyFlagChanged(textbox.Flag, input.Text)
        end
    end)

    input.Focused:Connect(function()
        if textbox.Password then showText(textbox.Value) end
        Tween.play(background, { BackgroundColor3 = Library.Theme["Element Hover"] }, 0.12)
    end)
    input.FocusLost:Connect(function()
        Tween.play(background, { BackgroundColor3 = Library.Theme.Element }, 0.12)
        if textbox.Finished then
            commit(input.Text)
        elseif textbox.Password then
            textbox.Value = input.Text
        end
        if textbox.Password then showText(textbox.Value) end
    end)

    Base.finish(textbox, container, row, data)
    local default = Base.opt(data, "Default", "")
    if default ~= "" then
        textbox:Set(default)
    else
        Library.Flags[textbox.Flag] = ""
    end
    return textbox
end

return true
]]

__sources["components/Toggle"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Base = require("components/Base")
local KeybindCore = require("components/KeybindCore")
local Colorpicker = require("components/Colorpicker")
local PopupContainer = require("components/PopupContainer")
local Popup = require("core/Popup")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local GEAR_IMAGE = "rbxassetid://101500482366184"

function Section:Toggle(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local toggle = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Toggle"),
        Callback = Base.opt(data, "Callback", nil),
        Value = false,
        SubColorpickerCount = 0,
        Items = {},
    }

    local row = Base.row(container, 20)

    local button = New("TextButton", {
        Name = "Hitbox",
        BackgroundTransparency = 1,
        Size = UDim2.fromScale(1, 1),
        Parent = row,
    })

    local box = New("Frame", {
        Name = "Box",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(16, 16),
        Theme = { BackgroundColor3 = "Element" },
        Corner = 4,
        Parent = row,
    })

    local fill = New("Frame", {
        Name = "Fill",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Corner = 4,
        Parent = box,
    })
    Theme.gradient(fill)

    local check, checkBars = Base.checkmark(fill, "Dark", 11)
    Base.fadeCheck(checkBars, 1, 0)

    local right = New("Frame", {
        Name = "Right",
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.fromOffset(0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        List = { Padding = 6, Horizontal = true, HAlign = Enum.HorizontalAlignment.Right, VAlign = Enum.VerticalAlignment.Center },
        Parent = row,
    })

    local label = New("TextLabel", {
        Name = "Text",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 24, 0.5, 0),
        Size = UDim2.new(1, -24, 0, 16),
        [translate and "Translate" or "Text"] = translate and { Text = toggle.Name } or toggle.Name,
        TextTruncate = Enum.TextTruncate.AtEnd,
        TextSize = 14,
        TextTransparency = 0.25,
        Theme = { TextColor3 = "Text" },
        Parent = row,
    })

    right:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
        local s = math.max(Library.PopupScale or 1, 0.01)
        label.Size = UDim2.new(1, -(24 + right.AbsoluteSize.X / s + 6), 0, 16)
    end)

    toggle.Items = {
        Toggle = { Instance = row }, Indicator = { Instance = box }, Accent = { Instance = fill },
        CheckImage = { Instance = check }, Text = { Instance = label }, RightContainer = { Instance = right },
    }

    Base.hover(button, function()
        Tween.play(label, { TextTransparency = 0 }, 0.12)
    end, function()
        Tween.play(label, { TextTransparency = toggle.Value and 0 or 0.25 }, 0.12)
    end)

    local function render()
        local on = toggle.Value
        Tween.play(fill, { BackgroundTransparency = on and 0 or 1 }, 0.12)
        Base.fadeCheck(checkBars, on and 0 or 1, 0.12)
        Tween.play(label, { TextTransparency = on and 0 or 0.25 }, 0.12)
    end

    function toggle:Get()
        return self.Value
    end

    function toggle:Set(value)
        value = value and true or false
        self.Value = value
        Library.Flags[self.Flag] = value
        Library:NotifyFlagChanged(self.Flag, value)
        render()
        if self.SubKeybindRef then
            self.SubKeybindRef.Core:SetToggled(value, true)
        end
        Util.callback(self.Callback, value)
    end

    toggle.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        toggle:Set(value)
    end)

    button.Activated:Connect(function()
        toggle:Set(not toggle.Value)
    end)

    function toggle:SubKeybind(subData)
        subData = subData or {}
        if self.SubKeybindRef then return self.SubKeybindRef end

        local keyBox = New("TextButton", {
            Name = "SubKeybind",
            Size = UDim2.fromOffset(0, 16),
            AutomaticSize = Enum.AutomaticSize.X,
            LayoutOrder = 100,
            Text = "None",
            TextSize = 12,
            TextTransparency = 0.2,
            TextXAlignment = Enum.TextXAlignment.Center,
            Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
            Corner = 4,
            Padding = { Left = 7, Right = 7 },
            Parent = right,
        })

        local sub = { Items = { Container = { Instance = keyBox } } }

        local core
        core = KeybindCore.new({
            Flag = subData.Flag or subData.flag,
            Default = subData.Default or subData.default,
            Mode = subData.Mode or subData.mode or "Toggle",
            Name = toggle.Name,
            OnChanged = function(c)
                Locale.bind(keyBox, "Text", c.Picking and "Press a key" or c.Value)
            end,
            OnState = function(state, c)
                if c.Mode == "Toggle" then
                    toggle:Set(not toggle.Value)
                else
                    toggle:Set(state)
                end
            end,
        })
        sub.Core = core
        sub.Flag = core.Flag
        Base.maid(toggle):Give(core)

        keyBox.Activated:Connect(function()
            core:StartPicking()
        end)

        local menu = New("Frame", {
            Name = "ModeMenu",
            Size = UDim2.fromOffset(84, 58),
            Theme = { BackgroundColor3 = "Popup" },
            Corner = 5,
            Padding = 4,
            List = { Padding = 2 },
        })
        local menuPopup = Popup.new({ Frame = menu, Anchor = keyBox, Parent = container.PopupOwner, Align = "Right" })
        Base.maid(toggle):Give(menuPopup)
        local optionLabels = {}
        for i, mode in ipairs({ "Toggle", "Hold" }) do
            local option = New("TextButton", {
                Size = UDim2.new(1, 0, 0, 24),
                BackgroundTransparency = 1,
                LayoutOrder = i,
                Translate = { Text = mode },
                TextSize = 13,
                TextXAlignment = Enum.TextXAlignment.Left,
                Theme = { TextColor3 = "Text" },
                Corner = 4,
                Padding = { Left = 8 },
                Parent = menu,
            })
            optionLabels[mode] = option
            option.Activated:Connect(function()
                core:SetMode(mode)
                menuPopup:Close()
            end)
        end
        local function renderModes()
            for mode, option in pairs(optionLabels) do
                local selected = core.Mode == mode
                option.TextTransparency = selected and 0 or 0.45
                Theme.bind(option, { TextColor3 = selected and "Accent" or "Text" })
            end
        end
        menuPopup.OnOpen = renderModes

        keyBox.MouseButton2Click:Connect(function()
            menuPopup:Toggle()
        end)
        keyBox.TouchLongPress:Connect(function()
            menuPopup:Open()
        end)

        function sub:Get() return core.Key, core.Value, core.Mode end
        function sub:Set(key) core:Set(key) end
        function sub:SetMode(mode) core:SetMode(mode) end

        toggle.SubKeybindRef = sub
        core:SetToggled(toggle.Value, true)
        return sub
    end

    function toggle:SubColorpicker(subData)
        subData = subData or {}
        if self.SubColorpickerCount >= 7 then return nil end
        self.SubColorpickerCount = self.SubColorpickerCount + 1
        return Base.maid(toggle):Give(Colorpicker.new({
            Parent = right,
            LayoutOrder = self.SubColorpickerCount,
            Size = UDim2.fromOffset(14, 14),
            Flag = subData.Flag or subData.flag,
            Default = subData.Default or subData.default,
            Alpha = subData.Alpha or subData.alpha,
            Callback = subData.Callback or subData.callback,
            PopupParent = container.PopupOwner,
        }))
    end

    local subRow
    local function getSubRow()
        if subRow then return subRow end
        Base.maid(toggle):Give(function() if subRow then subRow:Destroy() end end)
        subRow = New("Frame", {
            Name = "SubElements",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 28),
            LayoutOrder = row.LayoutOrder + 1,
            Parent = container.Content,
        })
        row:GetPropertyChangedSignal("Visible"):Connect(function()
            subRow.Visible = row.Visible
        end)
        New("Frame", {
            Name = "Background",
            Size = UDim2.fromScale(1, 1),
            Theme = { BackgroundColor3 = "Element" },
            Corner = 5,
            Padding = { Left = 8, Right = 8 },
            List = { Padding = 8, Horizontal = true, VAlign = Enum.VerticalAlignment.Center },
            Parent = subRow,
        })
        return subRow
    end

    function toggle:Colorpicker(subData)
        subData = subData or {}
        local holder = getSubRow().Background
        return Base.maid(toggle):Give(Colorpicker.new({
            Parent = holder,
            Size = UDim2.fromOffset(40, 16),
            Flag = subData.Flag or subData.flag,
            Default = subData.Default or subData.default,
            Alpha = subData.Alpha or subData.alpha,
            Callback = subData.Callback or subData.callback,
            PopupParent = container.PopupOwner,
        }))
    end

    function toggle:Keybind(subData)
        subData = subData or {}
        local holder = getSubRow().Background
        local keyButton = New("TextButton", {
            Size = UDim2.fromOffset(0, 18),
            AutomaticSize = Enum.AutomaticSize.X,
            Text = "None",
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Center,
            Theme = { BackgroundColor3 = "Element Hover", TextColor3 = "Text" },
            Corner = 4,
            Padding = { Left = 8, Right = 8 },
            Parent = holder,
        })
        local modeLabel = New("TextLabel", {
            Size = UDim2.fromOffset(0, 18),
            AutomaticSize = Enum.AutomaticSize.X,
            TextSize = 12,
            Theme = { TextColor3 = "SubText" },
            Parent = holder,
        })
        local userCallback = subData.Callback or subData.callback
        local core = KeybindCore.new({
            Flag = subData.Flag or subData.flag,
            Default = subData.Default or subData.default,
            Mode = subData.Mode or subData.mode or "Toggle",
            Name = toggle.Name,
            OnChanged = function(c)
                Locale.bind(keyButton, "Text", c.Picking and "Press a key" or c.Value)
                Locale.bind(modeLabel, "Text", c.Mode)
            end,
            OnState = function(state, c)
                if userCallback then
                    Util.callback(userCallback, state)
                elseif c.Mode == "Toggle" then
                    toggle:Set(not toggle.Value)
                else
                    toggle:Set(state)
                end
            end,
        })
        keyButton.Activated:Connect(function() core:StartPicking() end)
        Locale.bind(modeLabel, "Text", core.Mode)
        Base.maid(toggle):Give(core)

        local api = { Core = core, Flag = core.Flag }
        function api:Get() return core.Key, core.Value, core.Mode end
        function api:Set(key) core:Set(key) end
        function api:SetMode(mode) core:SetMode(mode) end
        return api
    end

    function toggle:Settings(size)
        if self.SettingsPopup then return self.SettingsPopup end
        local gear = New("ImageButton", {
            Name = "Settings",
            Size = UDim2.fromOffset(14, 14),
            LayoutOrder = -1,
            BackgroundTransparency = 1,
            Image = GEAR_IMAGE,
            ImageTransparency = 0.3,
            Theme = { ImageColor3 = "Text" },
            Parent = right,
        })
        local settings = PopupContainer.new({
            Anchor = gear,
            Parent = container.PopupOwner,
            Width = 240,
            MaxHeight = (type(size) == "number" and size) or 300,
            Window = container.Window,
            Align = "Right",
        })
        gear.Activated:Connect(function()
            settings:ToggleOpen()
        end)
        Base.maid(toggle):Give(settings)
        Base.hover(gear, function()
            Tween.play(gear, { ImageTransparency = 0 }, 0.12)
        end, function()
            Tween.play(gear, { ImageTransparency = 0.3 }, 0.12)
        end)
        self.SettingsPopup = settings
        self.Items.SettingsIcon = { Instance = gear }
        return settings
    end

    function toggle:SetText(text)
        self.Name = tostring(text)
        Locale.setText(label, "Text", self.Name)
    end

    function toggle:RefreshPosition() end

    Base.finish(toggle, container, row, data)
    local default = Base.opt(data, "Default", false)
    toggle:Set(default)
    return toggle
end

return true
]]

__sources["components/Watermark"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Input = require("core/Input")
local Gui = require("core/Gui")

local frame, content
local items = {}

local function build()
    Gui.init()
    frame = New("Frame", {
        Name = "Watermark",
        AnchorPoint = Vector2.new(0.5, 0),
        Position = UDim2.new(0.5, 0, 0, 20),
        Size = UDim2.fromOffset(0, 30),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 0.12,
        Visible = false,
        Theme = { BackgroundColor3 = "Background" },
        Corner = 6,
        Parent = Gui.Top,
    })
    Gui.scaleWith(frame)

    content = New("Frame", {
        Size = UDim2.new(0, 0, 1, 0),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        Padding = { Left = 12, Right = 12, Top = 0, Bottom = 0 },
        List = { Padding = 10, Horizontal = true, VAlign = Enum.VerticalAlignment.Center },
        Parent = frame,
    })

    local startPos
    Library.Maid:Give(Input.drag(frame, {
        threshold = 3,
        onStart = function() startPos = frame.Position end,
        onMove = function(delta)
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end,
    }))

    Library.WatermarkFrame = { Instance = frame }
end

local function isImage(value)
    return type(value) == "number" or (type(value) == "string" and string.find(value, "rbxassetid", 1, true) ~= nil)
end

function Library:Watermark(data)
    if Library.Unloaded then return end
    if not frame then build() end
    if data == nil or data == "auto" then
        data = { "B3 HUB", Util.getMapName(), "60 fps", "42 ms", os.date("%H:%M") }
    elseif type(data) == "string" then
        data = { data == "auto" and Util.getMapName() or data }
    end
    data = data or {}

    local count = #data
    for index = 1, count do
        local value = data[index]
        if value == "auto" then
            value = Util.getMapName()
        end
        local slot = items[index]
        local wantImage = isImage(value)

        if slot and slot.isImage ~= wantImage then
            slot.item:Destroy()
            if slot.sep then slot.sep:Destroy() end
            slot = nil
        end

        local isFirst = (index == 1)

        if not slot then
            slot = { isImage = wantImage }
            if index > 1 then
                slot.sep = New("Frame", {
                    Size = UDim2.fromOffset(1, 14),
                    BorderSizePixel = 0,
                    LayoutOrder = index * 2 - 1,
                    BackgroundTransparency = 0.4,
                    Theme = { BackgroundColor3 = "Outline" },
                    Parent = content,
                })
            end
            if wantImage then
                slot.item = New("ImageLabel", {
                    Size = UDim2.fromOffset(14, 14),
                    LayoutOrder = index * 2,
                    Parent = content,
                })
            else
                slot.item = New("TextLabel", {
                    Size = UDim2.new(0, 0, 1, 0),
                    AutomaticSize = Enum.AutomaticSize.X,
                    TextSize = 14,
                    FontFace = isFirst and Library.Fonts.Bold or Library.Fonts.Regular,
                    LayoutOrder = index * 2,
                    Theme = { TextColor3 = isFirst and "Accent" or "SubText" },
                    Parent = content,
                })
            end
            items[index] = slot
        end

        if wantImage then
            local image = Util.asset(value)
            if slot.item.Image ~= image then slot.item.Image = image end
        else
            local text = tostring(value)
            if slot.item.Text ~= text then slot.item.Text = text end
        end
    end

    for index = #items, count + 1, -1 do
        local slot = items[index]
        slot.item:Destroy()
        if slot.sep then slot.sep:Destroy() end
        items[index] = nil
    end

    return Library.WatermarkFrame
end

function Library:SetWatermarkVisible(visible)
    if not frame then build() end
    frame.Visible = visible and true or false
end

Library.Maid:Give(function()
    frame, content = nil, nil
    items = {}
    Library.WatermarkFrame = nil
end)

return true
]]

__sources["components/Window"] = [[
local Services = require("core/Services")
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Input = require("core/Input")
local Popup = require("core/Popup")
local Gui = require("core/Gui")
local Config = require("core/Config")
local Locale = require("core/Locale")
local KeyTimer = require("core/KeyTimer")
local Tooltip = require("core/Tooltip")
local Stealth = require("core/Stealth")
local PopupContainer = require("components/PopupContainer")
local Base = require("components/Base")

local EXPIRE_PREFIX = '<font color="rgb(160, 165, 175)">Expires: </font><font color="%s">%s</font>'
local EXPIRE_LIFETIME_COLOR = "rgb(80, 200, 120)"
local EXPIRE_LOW_COLOR = "rgb(255, 75, 75)"

local Icons = {
    Close = "rbxassetid://130510492706892",
    Settings = "rbxassetid://122669828593160",
}

local SIDEBAR_WIDTH = 200
local HEADER_HEIGHT = 50
local BRAND_HEIGHT = 58
local SEARCH_WIDTH = 190
local TOPTABS_HEIGHT = 40 -- the tab strip under the header in the Topbar layout
local DEFAULT_TRANSPARENCY = 0.04

local Window = {}
Window.__index = function(self, key)
    local value = Window[key]
    if value ~= nil then return value end
    return Library[key]
end
Library.WindowClass = Window

local function headerButton(parent, icon, xOffset, hoverKey)
    local button = New("TextButton", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, xOffset, 0.5, 0),
        Size = UDim2.fromOffset(30, 30),
        Theme = { BackgroundColor3 = "Element" },
        Corner = 6,
        Parent = parent,
    })
    local image
    if icon == "minimize" then
        image = New("Frame", {
            Name = "Icon",
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(12, 2),
            BackgroundTransparency = 0.25,
            Theme = { BackgroundColor3 = "Text" },
            Corner = UDim.new(1, 0),
            Parent = button,
        })
    else
        image = New("ImageLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(13, 13),
            Image = icon,
            ImageTransparency = 0.25,
            Theme = { ImageColor3 = "Text" },
            Parent = button,
        })
    end
    local fadeProp = image:IsA("Frame") and "BackgroundTransparency" or "ImageTransparency"
    if not Library.IsMobile then
        button.MouseEnter:Connect(function()
            Tween.play(button, { BackgroundColor3 = Library.Theme[hoverKey or "Element Hover"] }, 0.12)
            Tween.play(image, { [fadeProp] = 0 }, 0.12)
        end)
        button.MouseLeave:Connect(function()
            Tween.play(button, { BackgroundColor3 = Library.Theme.Element }, 0.12)
            Tween.play(image, { [fadeProp] = 0.25 }, 0.12)
        end)
    end
    return button, image
end

function Library:Window(data)
    Library._ensureIdentity()
    data = data or {}
    Base.pace()
    Config.applySavedFont()
    Gui.init()
    Popup.init()

    if data.Stealth == true and data.Blindfold ~= false then
        pcall(function()
            local wantFirewall = (data.Firewall == true) or (type(data.Firewall) == "table") or (type(data.BlockRemotes) == "table")
            Stealth:Enable({
                Blindfold = true,
                Firewall = wantFirewall,
                Keywords = data.Keywords,
            })
            local remotesToBlock = (type(data.BlockRemotes) == "table" and data.BlockRemotes) or (type(data.Firewall) == "table" and data.Firewall)
            if remotesToBlock then
                for _, rName in ipairs(remotesToBlock) do
                    Stealth:BlockRemote(rName)
                end
            end
        end)
    end

    local genv = (typeof(getgenv) == "function") and getgenv() or _G
    local name = data.Name or data.name or "Window"
    genv.ROUI_Loaded = genv.ROUI_Loaded or {}
    local previous = genv.ROUI_Loaded[name]
    if previous and previous ~= Library and not previous.Unloaded and type(previous.Unload) == "function" then
        pcall(previous.Unload, previous)
    end
    genv.ROUI_Loaded[name] = Library

    local rawSub = (data.SubName ~= nil) and data.SubName or data.subname
    local resolvedSub = ""
    local waitForMapName = false
    if rawSub == nil or rawSub == "auto" then
        resolvedSub = Util.peekMapName()
        if not resolvedSub then
            resolvedSub = " "
            waitForMapName = true
        end
    elseif rawSub == false then
        resolvedSub = ""
    else
        resolvedSub = tostring(rawSub)
    end

    local window = setmetatable({
        Name = name,
        SubName = resolvedSub,
        Logo = data.Logo or data.logo,
        LogoGradient = data.LogoGradient ~= false,
        MiniIconEnabled = data.MiniIcon ~= false,
        Pages = {},
        IsOpen = false,
        Items = {},
        SearchQuery = "",
        _gen = 0,
        _order = 0,
        Layout = "Sidebar",
    }, Window)
    table.insert(Library.Windows, window)
    Library.MainWindow = Library.MainWindow or window

    local showClose = data.CloseButton == true
    local buttonShift = showClose and 0 or 36 -- header buttons slide right into the X's spot
    local mainSize = data.Size
    local mainWidth, mainHeight = 533, 535 -- 733 x 535 with the sidebar
    if typeof(mainSize) == "UDim2" then
        mainWidth, mainHeight = mainSize.X.Offset, mainSize.Y.Offset
    elseif typeof(mainSize) == "Vector2" then
        mainWidth, mainHeight = mainSize.X, mainSize.Y
    elseif Library.IsMobile then
        local view = Gui.viewport()
        local fit = 0.85
        mainHeight = math.clamp(math.floor((view.Y - 24) / fit), 320, mainHeight)
        mainWidth = math.clamp(math.floor((view.X - 24) / fit) - SIDEBAR_WIDTH, 380, mainWidth)
    end
    window.MinSize = Vector2.new(SIDEBAR_WIDTH + 380, 320)

    local transparency = data.Transparency or DEFAULT_TRANSPARENCY
    Library.Flags.BackgroundTransparency = Library.Flags.BackgroundTransparency or transparency

    if data.Language then
        Locale.set(data.Language)
    end

    local root = New("Frame", {
        Name = "Window",
        Size = UDim2.fromOffset(SIDEBAR_WIDTH + mainWidth, mainHeight),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = Library.IsMobile and 0 or Library.Flags.BackgroundTransparency,
        Active = true,
        Visible = false,
        Corner = 8,
        Parent = Gui.Main,
    })
    if Library.IsMobile then
        New("Frame", {
            Name = "MobileSolidBacking",
            Size = UDim2.fromScale(1, 1),
            Position = UDim2.fromScale(0, 0),
            Theme = { BackgroundColor3 = "Background" },
            BackgroundTransparency = 0,
            BorderSizePixel = 0,
            ZIndex = 0,
            Active = true,
            Corner = 8,
            Parent = root,
        })
    end
    local modalUnlock = New("TextButton", {
        Name = "ModalUnlock",
        BackgroundTransparency = 1,
        Text = "",
        Size = UDim2.fromOffset(0, 0),
        Position = UDim2.fromOffset(0, 0),
        Visible = true,
        Modal = false, -- see Window:_syncModal
        Parent = root,
    })
    local scale = New("UIScale", { Parent = root })
    local shade = New("UIGradient", { Parent = root })

    local function paintShade()
        local topbar = window.Layout == "Topbar"
        shade.Rotation = topbar and 90 or 0
        local length = topbar and root.Size.Y.Offset or root.Size.X.Offset
        local band = topbar and (HEADER_HEIGHT + TOPTABS_HEIGHT) or SIDEBAR_WIDTH
        local split = math.clamp(band / math.max(length, 1), 0.01, 0.98)
        local sidebarColor, mainColor = Library.Theme.Sidebar, Library.Theme.Background
        return ColorSequence.new({
