Locale.DisplayNames = { English = "English", Thai = "ไทย" }

Locale.Current = "English"
Library.Language = "English"

local registry = {}
local listeners = {}
local registryCount, pruneAt = 0, 512
local detached = {} -- seen without a Parent at the last prune (see Theme.lua)

function Locale.t(text)
    if type(text) ~= "string" then return text end
    local dict = Locale.Languages[Locale.Current]
    local translated = dict and dict[text]
    return translated or text
end

function Locale.bind(instance, property, text)
    local entry = registry[instance]
    if not entry then
        entry = {}
        registry[instance] = entry
        registryCount = registryCount + 1
        if registryCount >= pruneAt then
            local stillDetached = {}
            for other in pairs(registry) do
                if other.Parent == nil then
                    if detached[other] then
                        registry[other] = nil
                        registryCount = registryCount - 1
                    else
                        stillDetached[other] = true
                    end
                end
            end
            detached = stillDetached
            pruneAt = math.max(512, registryCount * 2)
        end
    end
    entry[property] = text
    instance[property] = Locale.t(text) or ""
    return instance
end

function Locale.setText(instance, property, text)
    local entry = registry[instance]
    if entry and entry[property] ~= nil then
        Locale.bind(instance, property, text)
    else
        instance[property] = text
    end
end

function Locale.unbind(instance, property)
    local entry = registry[instance]
    if entry then
        entry[property] = nil
    end
end

function Locale.onChanged(fn)
    table.insert(listeners, fn)
    return function()
        local i = table.find(listeners, fn)
        if i then table.remove(listeners, i) end
    end
end

function Locale.matches(text, query)
    if type(text) ~= "string" or text == "" then return false end
    if string.find(string.lower(text), query, 1, true) then return true end
    local translated = Locale.t(text)
    return translated ~= text and string.find(string.lower(translated), query, 1, true) ~= nil
end

function Locale.set(language)
    if not Locale.Languages[language] then
        for key, display in pairs(Locale.DisplayNames) do
            if display == language then language = key break end
        end
    end
    if not Locale.Languages[language] then return false end
    Locale.Current = language
    Library.Language = language
    for instance, entry in pairs(registry) do
        if instance.Parent == nil then
            registry[instance] = nil
            registryCount = registryCount - 1
        else
            for property, text in pairs(entry) do
                instance[property] = Locale.t(text) or ""
            end
        end
    end
    for _, fn in ipairs(table.clone(listeners)) do
        local ok, err = pcall(fn, language)
        if not ok then warn("[B3] language listener error: " .. tostring(err)) end
    end
    return true
end

function Locale.clear()
    registry = {}
    registryCount, pruneAt = 0, 512
    detached = {}
    listeners = {}
end

function Library:SetLanguage(language)
    return Locale.set(language)
end

function Library:AddTranslations(language, dict)
    Locale.Languages[language] = Locale.Languages[language] or {}
    for key, value in pairs(dict) do
        Locale.Languages[language][key] = value
    end
    if not Locale.DisplayNames[language] then
        Locale.DisplayNames[language] = language
    end
    if Locale.Current == language then
        Locale.set(language)
    end
end

function Library:GetLanguages()
    local list = {}
    for key in pairs(Locale.Languages) do table.insert(list, key) end
    table.sort(list)
    return list
end

function Library:Translate(text)
    return Locale.t(text)
end

Library.Locale = Locale
return Locale
]]

