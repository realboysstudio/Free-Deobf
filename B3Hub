    if Library.OnThemeListChanged then pcall(Library.OnThemeListChanged, name) end
end

function Library:GetThemes()
    return table.clone(Theme.ThemeNames)
end

Library.ThemeModule = Theme

function Library:AddToTheme(item, properties)
    Theme.bind(item.Instance or item, properties)
end

function Library:ChangeItemTheme(item, properties)
    Theme.bind(item.Instance or item, properties)
end

return Theme
