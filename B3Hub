__sources["core/Input"] = [[
local Services = require("core/Services")
local Library = require("core/Library")

local UIS = Services.UserInputService
local GuiService = Services.GuiService

local Input = {}

local listeners = { Began = {}, Changed = {}, Ended = {} }
local started = false

local function dispatch(kind, io, processed)
    Library._ensureIdentity()
    local list = listeners[kind]
    local snapshot = table.clone(list)
    for i = 1, #snapshot do
        local ok, err = pcall(snapshot[i], io, processed)
        if not ok then
            warn("[B3] input handler error: " .. tostring(err))
        end
    end
end

function Input.start()
    if started then return end
    started = true
    Library.Maid:Give(UIS.InputBegan:Connect(function(io, processed) dispatch("Began", io, processed) end))
    Library.Maid:Give(UIS.InputChanged:Connect(function(io, processed) dispatch("Changed", io, processed) end))
    Library.Maid:Give(UIS.InputEnded:Connect(function(io, processed) dispatch("Ended", io, processed) end))
end

function Input.on(kind, fn)
    Input.start()
    local list = listeners[kind]
    table.insert(list, fn)
    return function()
        local index = table.find(list, fn)
        if index then
            table.remove(list, index)
        end
    end
end

function Input.clear()
    listeners = { Began = {}, Changed = {}, Ended = {} }
end

function Input.isPointerDown(io)
    local t = io.UserInputType
    return t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
end

function Input.isPointerMove(io)
    local t = io.UserInputType
    return t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.Touch
end

local MouseTypes = {
    [Enum.UserInputType.MouseButton1] = true,
    [Enum.UserInputType.MouseButton2] = true,
    [Enum.UserInputType.MouseButton3] = true,
    [Enum.UserInputType.MouseMovement] = true,
    [Enum.UserInputType.MouseWheel] = true,
}
local learnedOffset

function Input.toScreen(io)
    local raw = Vector2.new(io.Position.X, io.Position.Y)
    if MouseTypes[io.UserInputType] then
        local mouse = UIS:GetMouseLocation()
        learnedOffset = mouse - raw
        return mouse
    end
    if learnedOffset then
        return raw + learnedOffset
    end
    local inset = GuiService:GetGuiInset()
    return raw + inset
end

function Input.candidates(io)
    local raw = Vector2.new(io.Position.X, io.Position.Y)
    local list = {}
    if MouseTypes[io.UserInputType] then
        local ok, mouse = pcall(function() return UIS:GetMouseLocation() end)
        if ok and typeof(mouse) == "Vector2" then table.insert(list, mouse) end
        table.insert(list, raw)
    else
        table.insert(list, raw)
        local ok, inset = pcall(function() return GuiService:GetGuiInset() end)
        if ok and typeof(inset) == "Vector2" then table.insert(list, raw + inset) end
        if learnedOffset then table.insert(list, raw + learnedOffset) end
    end
    return list
end

function Input.toGui(gui, point)
    local layer = gui and gui:FindFirstAncestorWhichIsA("LayerCollector")
    if layer and layer:IsA("ScreenGui") then
        local ok, origin = pcall(function() return layer.AbsolutePosition end)
        if ok and typeof(origin) == "Vector2" then
            return point + origin
        end
    end
    return point
end

function Input.mouse()
    return UIS:GetMouseLocation()
end

function Input.isInside(gui, point)
    if not gui or not gui.Parent then return false end
    local pos, size = gui.AbsolutePosition, gui.AbsoluteSize
    return point.X >= pos.X and point.X <= pos.X + size.X and point.Y >= pos.Y and point.Y <= pos.Y + size.Y
end

function Input.isTyping()
    return UIS:GetFocusedTextBox() ~= nil
end

function Input.drag(handle, opts)
    local threshold = opts.threshold or 0
    local state
    local offChanged, offEnded

    local function stopListening()
        if offChanged then offChanged() offChanged = nil end
        if offEnded then offEnded() offEnded = nil end
    end

    local function onChanged(io)
        if not state then return end
        if io ~= state.input and not (state.isMouse and io.UserInputType == Enum.UserInputType.MouseMovement) then
            return
        end
        local pos = Input.toScreen(io)
        state.last = pos
        local delta = pos - state.start
        if not state.moved and delta.Magnitude >= threshold then
            state.moved = true
        end
        if state.moved and opts.onMove then
            opts.onMove(delta, pos)
        end
    end

    local function onEnded(io)
        if not state then return end
        if io == state.input or (state.isMouse and io.UserInputType == Enum.UserInputType.MouseButton1) then
            local finished = state
            state = nil
            stopListening()
            if opts.onEnd then
                opts.onEnd(finished.moved, finished.last)
            end
        end
    end

    local c1 = handle.InputBegan:Connect(function(io)
        if not Input.isPointerDown(io) then return end
        if state then
            if io == state.input then return end
            stopListening()
            state = nil
        end
        local pos = Input.toScreen(io)
        if opts.onStart and opts.onStart(pos, io) == false then return end
        state = {
            input = io,
            isMouse = io.UserInputType == Enum.UserInputType.MouseButton1,
            start = pos,
            last = pos,
            moved = threshold <= 0,
        }
        stopListening()
        offChanged = Input.on("Changed", onChanged)
        offEnded = Input.on("Ended", onEnded)
    end)

    return function()
        c1:Disconnect()
        stopListening()
        state = nil
    end
end

return Input
]]

__sources["core/KeyTimer"] = [[
local Library = require("core/Library")
local Util = require("core/Util")

local KeyTimer = {}
local listeners = {}
local running = false
local expired = false -- per library copy: every copy that is still open closes itself

local function genv()
    return (typeof(getgenv) == "function") and getgenv() or _G
end

local function state()
    local s = genv().ROUI_KeyExpiry
    return type(s) == "table" and s or nil
end

function KeyTimer.format(seconds)
    if seconds == nil then return "Lifetime" end
    seconds = math.max(0, math.floor(seconds))
    local d = math.floor(seconds / 86400)
    local h = math.floor((seconds % 86400) / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if d > 0 then
        return string.format("%dd %02dh", d, h)
    elseif h > 0 then
        return string.format("%dh %02dm", h, m)
    elseif m > 0 then
        return string.format("%dm %02ds", m, s)
    end
    return string.format("%ds", s)
end

function KeyTimer.left()
    local s = state()
    if not s then return nil, false end
    if s.Lifetime then return nil, true end
    return math.max(0, s.Deadline - os.clock()), true
end

local function notifyAll()
    local left, has = KeyTimer.left()
    for _, fn in ipairs(listeners) do
        Util.callback(fn, left, has)
    end
end

local function expire(s)
    if expired then return end
    expired = true
    if not s.Fired then
        s.Fired = true
        Util.callback(s.OnExpire)
    end
    if s.AutoUnload == false then return end
    pcall(function()
        Library:Notification({
            Title = "Key expired",
            Description = "Your key time is up. Closing the script.",
            Duration = 4,
        })
    end)
    task.wait(3)
    if not Library.Unloaded then
        Library:Unload()
    end
    if genv().ROUI_KeyExpiry == s then
        genv().ROUI_KeyExpiry = nil
    end
end

function KeyTimer.start()
    if running or Library.Unloaded or not state() then return end
    running = true
    task.spawn(function()
        while not Library.Unloaded do
            local s = state()
            if not s then break end
            local left = KeyTimer.left()
            notifyAll()
            if left then
                if s.WarnAt and not s.Warned and left <= s.WarnAt and left > 0 then
                    s.Warned = true
                    pcall(function()
                        Library:Notification({
                            Title = "Key expiring soon",
                            Description = "Your key expires in " .. KeyTimer.format(left) .. ".",
                            Duration = 5,
                        })
                    end)
                end
                if left <= 0 then
                    expire(s)
                    break
                end
            elseif s.Lifetime then
                break -- nothing to count; listeners already got nil once
            end
            task.wait(1)
        end
        running = false
    end)
end

function KeyTimer.listen(fn)
    table.insert(listeners, fn)
    local left, has = KeyTimer.left()
    if has then Util.callback(fn, left, has) end
    KeyTimer.start()
end

function Library:SetKeyExpiry(secondsLeft, options)
    options = options or {}
    local s = {
        AutoUnload = options.AutoUnload ~= false,
        WarnAt = tonumber(options.WarnAt) or 60, -- WarnAt = false: no warning
        OnExpire = options.OnExpire,
    }
    if options.WarnAt == false then s.WarnAt = nil end
    local seconds = tonumber(secondsLeft)
    if seconds then
        s.Deadline = os.clock() + seconds
    else
        s.Lifetime = true
    end
    genv().ROUI_KeyExpiry = s
    expired = false
    notifyAll()
    KeyTimer.start()
end

function Library:ClearKeyExpiry()
    genv().ROUI_KeyExpiry = nil
    notifyAll()
end

function Library:GetKeyTimeLeft()
    return KeyTimer.left()
end

function Library:FormatTime(seconds)
    return KeyTimer.format(seconds)
end

Library.KeyTimer = KeyTimer

task.defer(KeyTimer.start)

return KeyTimer
]]

