__sources["core/Stealth"] = [[
local Library = require("core/Library")

local Stealth = {
    Enabled = false,
    Keywords = {},
}

local function g(name)
    local ok, fn = pcall(function() return _G[name] end)
    if ok and type(fn) == "function" then return fn end
    local okv, genv = pcall(function() return getgenv and getgenv() end)
    if okv and type(genv) == "table" and type(genv[name]) == "function" then return genv[name] end
    return nil
end

local hookmetamethod = g("hookmetamethod")
local checkcaller = g("checkcaller")
local newcclosure = g("newcclosure") or function(f) return f end
local getnamecallmethod = g("getnamecallmethod")
local setnamecallmethod = g("setnamecallmethod")

local function genvTable()
    return (typeof(getgenv) == "function") and getgenv() or _G
end

local function ourRoots()
    local list = genvTable()._B3_ALL_GUIS
    local set = {}
    if type(list) == "table" then
        for _, gui in ipairs(list) do set[gui] = true end
    end
    return set
end

local blindfoldOld = nil
local verdict = setmetatable({}, { __mode = "k" })

local function readRaw(self, key)
    if blindfoldOld then
        return blindfoldOld(self, key)
    end
    return self[key]
end

local function isOurs(self)
    local cached = verdict[self]
    if cached ~= nil then return cached end
    local roots = nil
    local node, hops, result = self, 0, false
    while node and hops < 16 do
        if roots == nil and hops == 0 then roots = ourRoots() end
        if roots[node] then result = true break end
        local okParent, parent = pcall(readRaw, node, "Parent")
        if not okParent then break end
        node = parent
        hops = hops + 1
    end
    verdict[self] = result
    return result
end

local BLIND_KEYS = { Text = true, ContentText = true }

local function matchesKeyword(text)
    if type(text) ~= "string" or #Stealth.Keywords == 0 then return false end
    local low = string.lower(text)
    for _, word in ipairs(Stealth.Keywords) do
        if string.find(low, word, 1, true) then return true end
    end
    return false
end

function Stealth:_installBlindfold()
    if blindfoldOld or not (hookmetamethod and checkcaller) then return false end
    blindfoldOld = hookmetamethod(game, "__index", newcclosure(function(self, key)
        if BLIND_KEYS[key] and typeof(self) == "Instance" and not Library.Unloaded and not checkcaller() then
            local ok, isGui = pcall(function()
                return self:IsA("TextLabel") or self:IsA("TextButton") or self:IsA("TextBox")
            end)
            if ok and isGui then
                if isOurs(self) then
                    return ""
                end
                if #Stealth.Keywords > 0 then
                    local real = blindfoldOld(self, key)
                    if matchesKeyword(real) then return "" end
                    return real
                end
            end
        end
        return blindfoldOld(self, key)
    end))
    return blindfoldOld ~= nil
end

function Stealth:_removeBlindfold()
    if not blindfoldOld then return end
    pcall(hookmetamethod, game, "__index", blindfoldOld)
    blindfoldOld = nil
    table.clear(verdict)
end

local firewallOld = nil
local blocked = {}

function Stealth:BlockRemote(...)
    for _, name in ipairs({ ... }) do
        if type(name) == "string" then blocked[name] = true end
    end
    self:_installFirewall()
    self.Enabled = true
    return self
end

function Stealth:UnblockRemote(name)
    blocked[name] = nil
    return self
end

function Stealth:_installFirewall()
    if firewallOld or not (hookmetamethod and getnamecallmethod) then return false end
    firewallOld = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
        if not Library.Unloaded then
            local method = getnamecallmethod()
            if method == "FireServer" or method == "InvokeServer" then
                local ok, name = pcall(function() return self.Name end)
                if ok and type(name) == "string" and blocked[name] then
                    return nil -- drop the report / kick call
                end
            end
        end
        return firewallOld(self, ...)
    end))
    return firewallOld ~= nil
end

function Stealth:_removeFirewall()
    if not firewallOld then return end
    pcall(hookmetamethod, game, "__namecall", firewallOld)
    firewallOld = nil
end

function Stealth:Enable(opts)
    opts = opts or {}
    if opts.Keywords then
        for _, word in ipairs(opts.Keywords) do
            table.insert(self.Keywords, string.lower(word))
        end
    end
    local wantBlindfold = opts.Blindfold ~= false
    local wantFirewall = opts.Firewall == true
    local any = false
    if wantBlindfold and self:_installBlindfold() then any = true end
    if wantFirewall and self:_installFirewall() then any = true end
    self.Enabled = self.Enabled or any
    return any
end

function Stealth:Disable()
    self:_removeBlindfold()
    self:_removeFirewall()
    self.Enabled = false
end

function Stealth:IsSupported()
    return hookmetamethod ~= nil and checkcaller ~= nil
end

function Stealth:_WouldBlank(instance)
    if typeof(instance) ~= "Instance" then return false end
    local ok, isGui = pcall(function()
        return instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox")
    end)
    if not (ok and isGui) then return false end
    if isOurs(instance) then return true end
    if #Stealth.Keywords > 0 then
        local okText, real = pcall(function() return instance.Text end)
        if okText and matchesKeyword(real) then return true end
    end
    return false
end

function Stealth:Status()
    return {
        enabled = self.Enabled,
        blindfold = blindfoldOld ~= nil,
        firewall = firewallOld ~= nil,
        blocked = (function() local t = {} for k in pairs(blocked) do table.insert(t, k) end return t end)(),
        supported = self:IsSupported(),
    }
end

Library.Maid:Give(function()
    Stealth:Disable()
    table.clear(blocked)
    Stealth.Keywords = {}
end)

return Stealth
]]

