__sources["components/Base"] = [[
local Library = require("core/Library")
local New = require("core/Create")
local Tween = require("core/Tween")
local Input = require("core/Input")
local Maid = require("core/Maid")
local Locale = require("core/Locale")

local Base = {}

local BUILD_BUDGET = 0.008
local IDLE_GAP = 0.1
local sliceStart, lastCall = 0, 0

local frameStart = os.clock()
do
    local ok, RunService = pcall(game.GetService, game, "RunService")
    if ok and RunService then
        Library.Maid:Give(RunService.Heartbeat:Connect(function()
            frameStart = os.clock()
        end))
    end
end

function Base.pace()
    Library._ensureIdentity()
    local now = os.clock()
    if now - lastCall > IDLE_GAP then
        sliceStart = math.min(now, math.max(frameStart, now - 0.25))
    elseif now - sliceStart >= BUILD_BUDGET and coroutine.isyieldable() then
        task.wait()
        if Library.Unloaded then
            return
        end
        Library._ensureIdentity(true)
        now = os.clock()
        sliceStart = now
    end
    lastCall = now
end

function Base.isBuilding()
    return os.clock() - lastCall <= IDLE_GAP
end

function Base.row(container, height, props)
    Base.pace()
    container._order = (container._order or 0) + 10
    local row = New("Frame", {
        Name = "Element",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = container._order,
        Parent = container.Content,
    })
    if props then
        for k, v in pairs(props) do row[k] = v end
    end
    return row
end

function Base.text(parent, text, props, translate)
    local main = {
        Size = UDim2.new(1, 0, 0, 16),
        TextTransparency = 0.25,
        Theme = { TextColor3 = "Text" },
        Parent = parent,
    }
    if translate then
        main.Translate = { Text = text or "" }
    else
        main.Text = text or ""
    end
    if props then
        for k, v in pairs(props) do main[k] = v end
    end
    return New("TextLabel", main)
end

function Base.hover(gui, onEnter, onLeave)
    if Library.IsMobile then return end
    gui.MouseEnter:Connect(onEnter)
    gui.MouseLeave:Connect(onLeave)
end

function Base.hoverBackground(gui, normalKey, hoverKey)
    Base.hover(gui, function()
        Tween.play(gui, { BackgroundColor3 = Library.Theme[hoverKey or "Element Hover"] }, 0.12)
    end, function()
        Tween.play(gui, { BackgroundColor3 = Library.Theme[normalKey or "Element"] }, 0.12)
    end)
end

function Base.maid(element)
    if not element.Maid then
        element.Maid = Maid.new()
    end
    return element.Maid
end

function Base.finish(element, container, row, data)
    element.Instance = row
    element.Row = row

    function element:SetVisibility(visible)
        self._hidden = not visible
        row.Visible = (not self._hidden) and self._searchMatch ~= false
    end
    element.SetVisible = element.SetVisibility

    function element:_applySearch(match)
        self._searchMatch = match
        row.Visible = (not self._hidden) and match
    end

    local Tooltip = require("core/Tooltip")
    local tooltipText = data and (data.Tooltip or data.tooltip)
    if tooltipText and tooltipText ~= "" then
        element.Tooltip = tooltipText
        Tooltip.attach(row, tooltipText)
    end
    function element:SetTooltip(text)
        self.Tooltip = text
        Tooltip.attach(row, text)
    end

    function element:SetHighlight(colorOrBool)
        local labelInst = nil
        if self.Items then
            for _, k in ipairs({ "Text", "Title", "Label" }) do
                if self.Items[k] and self.Items[k].Instance then
                    labelInst = self.Items[k].Instance
                    break
                end
            end
        end

        if colorOrBool == false or colorOrBool == nil then
            if labelInst then
                local Theme = require("core/Theme")
                Theme.bind(labelInst, { TextColor3 = "Text" })
                labelInst.TextTransparency = 0.25
            end
            self.IsHighlighted = false
            return
        end

        self.IsHighlighted = true
        local color = Color3.fromRGB(255, 75, 75) -- default red as in user screenshot
        if typeof(colorOrBool) == "Color3" then
            color = colorOrBool
        elseif type(colorOrBool) == "string" then
            if Library.Theme[colorOrBool] then
                color = Library.Theme[colorOrBool]
            end
        end

        if labelInst then
            local Theme = require("core/Theme")
            Theme.unbind(labelInst, "TextColor3")
            labelInst.TextColor3 = color
            labelInst.TextTransparency = 0
        end
    end

    local highlightData = data and (data.Highlight or data.highlight or data.HighlightColor or data.highlightcolor)
    if highlightData then
        element:SetHighlight(highlightData)
    end

    function element:SetBadge(text, color)
        local labelInst = Base.labelOf(self)
        if labelInst then Base.badge(labelInst, text, color) end
        self.Badge = text
    end
    local badgeData = data and (data.Badge or data.badge)
    if badgeData then
        if type(badgeData) == "table" then
            element:SetBadge(badgeData.Text or badgeData[1], badgeData.Color)
        else
            element:SetBadge(badgeData, data.BadgeColor)
        end
    end

    if not element.Destroy then
        function element:Destroy()
            if self.Maid then self.Maid:Clean() end
            if self.Flag then
                Library.SetFlags[self.Flag] = nil
                Library.Flags[self.Flag] = nil
            end
            row:Destroy()
            local index = table.find(container.Elements, self)
            if index then table.remove(container.Elements, index) end
        end
    end

    table.insert(container.Elements, element)
    return element
end

function Base.labelOf(element)
    if not element.Items then return nil end
    for _, k in ipairs({ "Text", "Title", "Label" }) do
        local item = element.Items[k]
        local inst = item and item.Instance
        if inst and inst:IsA("TextLabel") then return inst end
    end
    return nil
end

local BADGE_COLORS = {
    NEW = "Accent",
    BETA = Color3.fromRGB(245, 158, 66),
    VIP = Color3.fromRGB(250, 204, 21),
    HOT = Color3.fromRGB(239, 83, 80),
    PREMIUM = Color3.fromRGB(250, 204, 21),
    FIX = Color3.fromRGB(52, 199, 120),
}

function Base.badge(label, text, color)
    local old = label:FindFirstChild("Badge")
    local padding = label:FindFirstChildOfClass("UIPadding")
    if old then old:Destroy() end
    if padding and padding:GetAttribute("B3Badge") then padding.PaddingRight = UDim.new(0, 0) end
    if text == nil or text == false or text == "" then return nil end
    text = tostring(text)

    local Theme = require("core/Theme")
    local pill = New("TextLabel", {
        Name = "Badge",
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 0, 0.5, 0),
        Size = UDim2.fromOffset(0, 14),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 0,
        Text = text,
        TextSize = 10,
        TextTransparency = 0,
        TextXAlignment = Enum.TextXAlignment.Center,
        TextColor3 = Color3.fromRGB(12, 12, 14),
        FontFace = (Library.Fonts and (Library.Fonts.Bold or Library.Fonts.SemiBold)) or Library.Font,
        Padding = { Left = 4, Right = 4 },
        Corner = 4,
        ZIndex = label.ZIndex + 1,
        Parent = label,
    })
    local key = color or BADGE_COLORS[string.upper(text)] or "Accent"
    if type(key) == "string" and Library.Theme[key] then
        Theme.bind(pill, { BackgroundColor3 = key })
    elseif typeof(key) == "Color3" then
        pill.BackgroundColor3 = key
    else
        Theme.bind(pill, { BackgroundColor3 = "Accent" })
    end

    if not padding then
        padding = Instance.new("UIPadding")
        padding.Parent = label
    end
    padding:SetAttribute("B3Badge", true)

    local function place()
        if pill.Parent ~= label then return end
        local scale = math.max(Library.PopupScale or 1, 0.01)
        local pillWidth = pill.AbsoluteSize.X / scale
        padding.PaddingRight = UDim.new(0, math.ceil(pillWidth) + 6)
        local inner = label.AbsoluteSize.X / scale - padding.PaddingLeft.Offset - padding.PaddingRight.Offset
        local textWidth = math.min(label.TextBounds.X, math.max(inner, 0))
        local x = padding.PaddingLeft.Offset + textWidth + 5
        if label.TextXAlignment == Enum.TextXAlignment.Center then
            x = padding.PaddingLeft.Offset + (inner + textWidth) / 2 + 5
        elseif label.TextXAlignment == Enum.TextXAlignment.Right then
            x = padding.PaddingLeft.Offset + inner + 5
        end
        pill.Position = UDim2.new(0, math.floor(x), 0.5, 0)
    end
    pill:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
    label:GetPropertyChangedSignal("TextBounds"):Connect(place)
    label:GetPropertyChangedSignal("AbsoluteSize"):Connect(place)
    task.defer(place)
    return pill
end

local scrollLocks = setmetatable({}, { __mode = "k" })
function Base.lockScroll(gui, locked)
    local node = gui and gui.Parent
    while node and not node:IsA("ScrollingFrame") do
        node = node.Parent
    end
    if not node then return end
    local count = (scrollLocks[node] or 0) + (locked and 1 or -1)
    if count <= 0 then
        scrollLocks[node] = nil
        node.ScrollingEnabled = true
    else
        scrollLocks[node] = count
        node.ScrollingEnabled = false
    end
end

local CHECK_IMAGE = "rbxassetid://93912665739148"

function Base.checkmark(parent, colorKey, size, props)
    size = size or 11
    local check = New("ImageLabel", {
        Name = "Check",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(size, size),
        Image = CHECK_IMAGE,
        ImageTransparency = 1,
        Theme = { ImageColor3 = colorKey or "Dark" },
        Parent = parent,
    })
    if props then
        for k, v in pairs(props) do check[k] = v end
    end
    return check, { check }
end

function Base.fadeCheck(bars, transparency, time)
    for _, item in ipairs(bars) do
        if item:IsA("ImageLabel") then
            Tween.play(item, { ImageTransparency = transparency }, time or 0.12)
        else
            Tween.play(item, { BackgroundTransparency = transparency }, time or 0.12)
        end
    end
end

function Base.opt(data, key, default)
    if data == nil then return default end
    local value = data[key]
    if value == nil then value = data[string.lower(key)] end
    if value == nil then return default end
    return value
end

Base.Input = Input
Base.Locale = Locale
return Base
]]

__sources["components/Blur"] = [[
local Services = require("core/Services")
local Library = require("core/Library")

local Blur = {}

local function planeIntersect(planePos, normal, origin, direction)
    local denominator = normal:Dot(direction)
    if math.abs(denominator) < 1e-6 then return origin end
    local t = -normal:Dot(origin - planePos) / denominator
    return origin + direction * t
end

function Blur.attach(window)
    local camera = Services.Workspace.CurrentCamera
    if not camera then return end

    local ok = pcall(function()
        local dof = Instance.new("DepthOfFieldEffect")
        dof.FarIntensity = 0
        dof.FocusDistance = 0
        dof.InFocusRadius = 1000
        dof.NearIntensity = 1
        dof.Enabled = false
        dof.Parent = Services.Lighting
        Library.Maid:Give(dof)

        local part = Instance.new("Part")
        part.Material = Enum.Material.Glass
        part.Transparency = 0.98
        part.Reflectance = 1
        part.CastShadow = false
        part.Anchored = true
        part.CanCollide = false
        part.CanQuery = false
        part.CanTouch = false
        part.Size = Vector3.new(1, 1, 1) * 0.01
        part.Color = Color3.new(0, 0, 0)
        local mesh = Instance.new("BlockMesh")
        mesh.Parent = part
        part.Parent = camera
        Library.Maid:Give(part)

        local function hide()
            dof.Enabled = false
            mesh.Scale = Vector3.new(0, 0, 0)
        end

        local lastCF, lastTopLeft, lastSize, lastNear
        Library.Maid:Give(Services.RunService.RenderStepped:Connect(function()
            local gui = window.Main
            if not window.IsOpen or not window.Root.Visible then
                if dof.Enabled then hide() end
                lastCF = nil
                return
            end
            dof.Enabled = true
            local cam = Services.Workspace.CurrentCamera
            if part.Parent ~= cam then part.Parent = cam end

            local cf = cam.CFrame
            local topLeft = gui.AbsolutePosition
            local size = gui.AbsoluteSize
            local near = cam.NearPlaneZ
            if lastCF == cf and lastTopLeft == topLeft and lastSize == size and lastNear == near then
                return
            end
            lastCF, lastTopLeft, lastSize, lastNear = cf, topLeft, size, near

            local bottomRight = topLeft + size
            local ray0 = cam:ViewportPointToRay(topLeft.X, topLeft.Y, 1)
            local ray1 = cam:ViewportPointToRay(bottomRight.X, bottomRight.Y, 1)
            local planePos = cf.Position + cf.LookVector * (0.05 - near)
            local p0 = cf:PointToObjectSpace(planeIntersect(planePos, cf.LookVector, ray0.Origin, ray0.Direction))
            local p1 = cf:PointToObjectSpace(planeIntersect(planePos, cf.LookVector, ray1.Origin, ray1.Direction))
            mesh.Offset = (p0 + p1) / 2
            mesh.Scale = (p1 - p0) / 0.0101
            part.CFrame = cf
        end))
    end)
    if not ok then
        warn("[B3] blur is not supported here")
    end
end

return Blur
]]

__sources["components/Button"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Base = require("components/Base")
local Locale = require("core/Locale")
local Input = require("core/Input")

local Section = Library.SectionClass

local HOLD_HINT = "Hold to confirm"

local function attachHold(obj, button, label, seconds, danger)
    seconds = math.max(tonumber(seconds) or 1, 0.2)
    obj.Hold = seconds
    local fill = New("Frame", {
        Name = "HoldFill",
        Size = UDim2.fromScale(0, 1),
        BackgroundTransparency = 0.6,
        Theme = { BackgroundColor3 = danger and "Danger" or "Accent" },
        Corner = 6,
        ZIndex = button.ZIndex,
        Parent = button,
    })
    local token, holding, offEnded, hintToken = 0, nil, nil, 0

    local function showHint()
        hintToken = hintToken + 1
        local mine = hintToken
        Locale.setText(label, "Text", HOLD_HINT)
        task.delay(1.2, function()
            if hintToken == mine and not Library.Unloaded then
                Locale.setText(label, "Text", obj.Name)
            end
        end)
    end

    local function stop()
        if offEnded then offEnded() offEnded = nil end
        holding = nil
        token = token + 1
    end

    obj.Maid = obj.Maid or require("core/Maid").new()
    obj.Maid:Give(button.InputBegan:Connect(function(io)
        if holding or not Input.isPointerDown(io) then return end
        token = token + 1
        local mine = token
        holding = io
        local started = os.clock()
        Tween.play(fill, { Size = UDim2.fromScale(1, 1) }, seconds, Enum.EasingStyle.Linear)
        offEnded = Input.on("Ended", function(endIo)
            if not holding then return end
            local sameMouse = endIo.UserInputType == Enum.UserInputType.MouseButton1
                and holding.UserInputType == Enum.UserInputType.MouseButton1
            if endIo ~= holding and not sameMouse then return end
            local early = os.clock() - started < seconds
            stop()
            Tween.play(fill, { Size = UDim2.fromScale(0, 1) }, 0.15)
            if early then showHint() end
        end)
        task.delay(seconds, function()
            if token ~= mine or not holding or Library.Unloaded then return end
            stop()
            Tween.play(fill, { Size = UDim2.fromScale(0, 1) }, 0.25)
            obj:Press()
        end)
    end))
end

function Section:Button(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local buttonObj = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Button"),
        Icon = Base.opt(data, "Icon", nil),
        Callback = Base.opt(data, "Callback", nil),
    }

    local row = Base.row(container, 26)

    local button = New("TextButton", {
        Name = "Button",
        Size = UDim2.fromScale(1, 1),
        ClipsDescendants = true, -- long labels never spill past the button edge
        Theme = { BackgroundColor3 = "Element" },
        Corner = 6,
        Parent = row,
    })

    local flash = New("Frame", {
        Name = "Flash",
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = Color3.new(1, 1, 1),
        BackgroundTransparency = 1,
        Corner = 6,
        Parent = button,
    })
    Theme.gradient(flash)

    local inner = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        List = { Padding = 7, Horizontal = true, VAlign = Enum.VerticalAlignment.Center },
        Parent = button,
    })

    local icon
    if buttonObj.Icon then
        icon = New("ImageLabel", {
            Size = UDim2.fromOffset(16, 16),
            Image = Util.asset(buttonObj.Icon),
            ImageTransparency = 0.25,
            LayoutOrder = 1,
            Theme = { ImageColor3 = "Text" },
            Parent = inner,
        })
    end

    local label
    if icon then
        label = New("TextLabel", {
            Size = UDim2.fromOffset(0, 16),
            AutomaticSize = Enum.AutomaticSize.X,
            [translate and "Translate" or "Text"] = translate and { Text = buttonObj.Name } or buttonObj.Name,
            TextTransparency = 0.2,
            LayoutOrder = 2,
            Theme = { TextColor3 = data.Danger and "Danger" or "Text" },
            Parent = inner,
        })
    else
        label = New("TextLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(1, -16, 1, 0),
            [translate and "Translate" or "Text"] = translate and { Text = buttonObj.Name } or buttonObj.Name,
            TextTransparency = 0.2,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Theme = { TextColor3 = data.Danger and "Danger" or "Text" },
            Parent = button,
        })
        inner.Visible = false
    end

    buttonObj.Items = { Button = { Instance = button }, Text = { Instance = label }, Icon = icon and { Instance = icon } or nil }
    if Base.opt(data, "Hold", nil) then
        attachHold(buttonObj, button, label, Base.opt(data, "Hold", 1), data.Danger)
    end

    Base.hoverBackground(button)

    function buttonObj:Press()
        Tween.set(flash, { BackgroundTransparency = 0.55 })
        Tween.play(flash, { BackgroundTransparency = 1 }, 0.35)
        Util.callback(self.Callback)
    end

    function buttonObj:SetText(text)
        self.Name = tostring(text)
        Locale.setText(label, "Text", self.Name)
    end

    local lastPress = 0
    button.Activated:Connect(function()
        if buttonObj.Hold then return end -- fires from the hold instead
        local now = os.clock()
        if now - lastPress < 0.08 then return end
        lastPress = now
        buttonObj:Press()
    end)

    return Base.finish(buttonObj, container, row, data)
end

function Section:Buttons(data1, data2)
    local container = self
    local list = (type(data1) == "table" and data2 == nil and #data1 > 0) and data1 or { data1, data2 }
    local count = #list
    local rowHeight = 26
    local row = Base.row(container, rowHeight)

    New("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Center,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        Padding = UDim.new(0, 6),
        Parent = row,
    })

    local buttons = {}
    local itemWidth = 1 / count
    local itemPadding = ((count - 1) * 6) / count

    for i, data in ipairs(list) do
        local translate = data.Translate
        if translate == nil then translate = container.Translate end
        local btnObj = {
            Window = container.Window,
            Page = container.Page,
            Section = container,
            Name = Base.opt(data, "Name", "Button"),
            Icon = Base.opt(data, "Icon", nil),
            Callback = Base.opt(data, "Callback", nil),
        }

        local button = New("TextButton", {
            Name = "Button_" .. i,
            Size = UDim2.new(itemWidth, -itemPadding, 1, 0),
            ClipsDescendants = true,
            Theme = { BackgroundColor3 = "Element" },
            Corner = 6,
            Parent = row,
        })

        local flash = New("Frame", {
            Name = "Flash",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1,
            Corner = 6,
            Parent = button,
        })
        Theme.gradient(flash)

        local label = New("TextLabel", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.new(1, -12, 1, 0),
            [translate and "Translate" or "Text"] = translate and { Text = btnObj.Name } or btnObj.Name,
            TextTransparency = 0.15,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            Theme = { TextColor3 = data.Danger and "Danger" or "Text" },
            Parent = button,
        })
        if data.TextColor3 then
            label.TextColor3 = data.TextColor3
        end

        btnObj.Items = { Button = { Instance = button }, Text = { Instance = label } }
        if Base.opt(data, "Hold", nil) then
            attachHold(btnObj, button, label, Base.opt(data, "Hold", 1), data.Danger)
        end
        Base.hoverBackground(button)

        function btnObj:Press()
            Tween.set(flash, { BackgroundTransparency = 0.55 })
            Tween.play(flash, { BackgroundTransparency = 1 }, 0.35)
            Util.callback(self.Callback)
        end

        function btnObj:SetText(text)
            self.Name = tostring(text)
            Locale.setText(label, "Text", self.Name)
        end

        local lastPress = 0
        button.Activated:Connect(function()
            if btnObj.Hold then return end
            local now = os.clock()
            if now - lastPress < 0.08 then return end
            lastPress = now
            btnObj:Press()
        end)

        table.insert(buttons, btnObj)
    end

    local names = {}
    for _, b in ipairs(buttons) do table.insert(names, tostring(b.Name)) end
    local group = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = table.concat(names, " "),
        Buttons = buttons,
        Items = { Row = { Instance = row } },
    }
    function group:_matches(query)
        for _, b in ipairs(buttons) do
            if Locale.matches(b.Name, query) then return true end
        end
        return false
    end
    Base.finish(group, container, row, nil)
    for _, b in ipairs(buttons) do
        b.Group = group
        function b:SetVisibility(visible) group:SetVisibility(visible) end
        b.SetVisible = b.SetVisibility
        function b:Destroy() group:Destroy() end
    end

    return buttons[1], buttons[2], buttons[3], buttons[4]
end

return true
]]

__sources["components/Changelog"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Base = require("components/Base")

local Section = Library.SectionClass

function Section:Changelog(data)
    data = data or {}
    local container = self
    local rawVersions = data.Versions or data.versions or (type(data) == "table" and not data.Versions and data) or {}

    local changelogObj = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Versions = {},
        Items = {},
    }

    local row = Base.row(container, 0, {
        AutomaticSize = Enum.AutomaticSize.Y,
    })

    local listFrame = New("Frame", {
        Name = "ChangelogList",
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
        List = { Padding = 12 },
        Parent = row,
    })

    local function renderVersion(vData, isLast)
        local verBlock = New("Frame", {
            Name = "VersionBlock",
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
            BackgroundTransparency = 1,
            List = { Padding = 4 },
            Parent = listFrame,
        })

        local verText = tostring(vData.Version or vData.version or vData.Title or "Update")
        New("TextLabel", {
            Name = "VersionTitle",
            Size = UDim2.new(1, 0, 0, 16),
            Text = verText,
            TextSize = 14,
            FontFace = Library.Fonts.Bold,
            Theme = { TextColor3 = "Text" },
            TextTruncate = Enum.TextTruncate.AtEnd,
            Parent = verBlock,
        })

        local dateText = vData.Date or vData.date
        if dateText and dateText ~= "" then
            New("TextLabel", {
                Name = "Date",
                Size = UDim2.new(1, 0, 0, 14),
                Text = tostring(dateText),
                TextSize = 11,
                FontFace = Library.Fonts.Regular,
                Theme = { TextColor3 = "SubText" },
                Parent = verBlock,
            })
        end

        local changes = vData.Changes or vData.changes or vData.Items or vData.items or {}
        if type(changes) == "table" and #changes > 0 then
            local changesFrame = New("Frame", {
                Name = "Changes",
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                BackgroundTransparency = 1,
                Padding = { Top = 2 },
                List = { Padding = 3 },
                Parent = verBlock,
            })

            for _, change in ipairs(changes) do
                local line = tostring(change)
                if not (string.sub(line, 1, 1) == "+" or string.sub(line, 1, 1) == "-" or string.sub(line, 1, 1) == "•") then
                    line = "+ " .. line
                end

                New("TextLabel", {
                    Name = "ChangeItem",
                    Size = UDim2.new(1, 0, 0, 0),
                    AutomaticSize = Enum.AutomaticSize.Y,
                    Text = line,
                    TextSize = 12,
                    FontFace = Library.Fonts.Regular,
                    TextWrapped = true,
                    Theme = { TextColor3 = "SubText" },
                    Parent = changesFrame,
                })
            end
        end

        if not isLast then
            New("Frame", {
                Name = "Divider",
                Size = UDim2.new(1, 0, 0, 1),
                Theme = { BackgroundColor3 = "Outline" },
                BackgroundTransparency = 0.5,
                Parent = listFrame,
            })
        end

        return verBlock
    end

    function changelogObj:SetVersions(versions)
        for _, child in ipairs(listFrame:GetChildren()) do
            if not child:IsA("UIListLayout") and not child:IsA("UIPadding") then
                child:Destroy()
            end
        end
        self.Versions = versions or {}
        local count = #self.Versions
        for i, v in ipairs(self.Versions) do
            renderVersion(v, i == count)
        end
    end

    function changelogObj:AddVersion(vData)
        table.insert(self.Versions, 1, vData)
        self:SetVersions(self.Versions)
    end

    changelogObj:SetVersions(rawVersions)
    changelogObj.Items = { Row = { Instance = row }, List = { Instance = listFrame } }
    Base.finish(changelogObj, container, row, data)
    return changelogObj
end

return Section
]]

__sources["components/Colorpicker"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Input = require("core/Input")
local Popup = require("core/Popup")
local Services = require("core/Services")
local Theme = require("core/Theme")

local Colorpicker = {}
Colorpicker.__index = Colorpicker

local PRESETS = {
    Color3.fromRGB(255, 255, 255), Color3.fromRGB(160, 160, 170), Color3.fromRGB(255, 70, 70), Color3.fromRGB(255, 150, 50),
    Color3.fromRGB(255, 220, 60), Color3.fromRGB(65, 215, 50), Color3.fromRGB(50, 220, 170), Color3.fromRGB(60, 170, 255),
    Color3.fromRGB(90, 100, 255), Color3.fromRGB(160, 80, 255), Color3.fromRGB(245, 80, 200), Color3.fromRGB(20, 20, 24),
}

local HUE_SEQUENCE = ColorSequence.new({
    ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 0, 0)),
    ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255, 255, 0)),
    ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0, 255, 0)),
    ColorSequenceKeypoint.new(0.5, Color3.fromRGB(0, 255, 255)),
    ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0, 0, 255)),
    ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255, 0, 255)),
    ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 0, 0)),
})

local function toColor(value)
    local kind = typeof(value)
    if kind == "Color3" then return value end
    if kind == "string" then
        local hex = string.gsub(value, "#", "")
        local ok, color = pcall(Color3.fromHex, hex)
        if ok then return color end
        return nil
    end
    if kind == "table" then
        if value.Color then return toColor(value.Color) end
        if value[1] then return Color3.fromRGB(value[1], value[2] or 0, value[3] or 0) end
    end
    return nil
end

function Colorpicker.new(opts)
    local self = setmetatable({
        Hue = 0, Saturation = 0, Value = 1,
        Alpha = 0,
        Color = Color3.new(1, 1, 1),
        HexValue = "FFFFFF",
        HasAlpha = opts.Alpha ~= nil and opts.Alpha ~= false,
        Callback = opts.Callback,
        IsOpen = false,
        _opts = opts,
    }, Colorpicker)

    local swatch = New("TextButton", {
        Name = "Swatch",
        Size = opts.Size or UDim2.fromOffset(28, 14),
        BackgroundColor3 = self.Color,
        LayoutOrder = opts.LayoutOrder or 0,
        Corner = 4,
        Parent = opts.Parent,
    })
    self.Swatch = swatch
    self.Items = { ColorpickerButton = { Instance = swatch }, Color = { Instance = swatch } }

    swatch.Activated:Connect(function()
        self:SetOpen(not self.IsOpen)
    end)

    self.Flag = Library:RegisterFlag(opts.Flag, function(color, alpha, rainbow)
        self:Set(color, alpha, rainbow == true)
    end)

    local default = toColor(opts.Default) or Color3.new(1, 1, 1)
    local defaultAlpha = (type(opts.Alpha) == "number") and opts.Alpha or 0
    self:Set(default, defaultAlpha)
    return self
end

function Colorpicker:_build()
    if self.Popup then return end

    local height = (self.HasAlpha and 262 or 240) + 30
    local frame = New("Frame", {
        Name = "Colorpicker",
        Size = UDim2.fromOffset(220, height),
        Theme = { BackgroundColor3 = "Popup" },
        Corner = 6,
    })

    local palette = New("TextButton", {
        Name = "Palette",
        Position = UDim2.fromOffset(10, 10),
        Size = UDim2.new(1, -20, 0, 120),
        BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1),
        Corner = 4,
        Parent = frame,
    })
    local white = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Corner = 4, Parent = palette })
    New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = white })
    local black = New("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), Corner = 4, Parent = palette })
    New("UIGradient", { Rotation = 90, Transparency = NumberSequence.new(1, 0), Parent = black })
    local paletteKnob = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Size = UDim2.fromOffset(10, 10),
        BackgroundTransparency = 1,
        ZIndex = 3,
        Corner = UDim.new(1, 0),
        Stroke = { Color = Color3.new(1, 1, 1), Thickness = 2 },
        Parent = palette,
    })

    local function bar(y)
        local b = New("TextButton", {
            Position = UDim2.fromOffset(10, y),
            Size = UDim2.new(1, -20, 0, 10),
            BackgroundColor3 = Color3.new(1, 1, 1),
            Corner = UDim.new(1, 0),
            Parent = frame,
        })
        local knob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0, 0.5),
            Size = UDim2.fromOffset(12, 12),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 3,
            Corner = UDim.new(1, 0),
            Stroke = { Color = Color3.fromRGB(20, 20, 20), Thickness = 1 },
            Parent = b,
        })
        return b, knob
    end

    local hueBar, hueKnob = bar(140)
    New("UIGradient", { Color = HUE_SEQUENCE, Parent = hueBar })

    local alphaBar, alphaKnob
    local y = 160
    if self.HasAlpha then
        alphaBar, alphaKnob = bar(160)
        New("UIGradient", { Transparency = NumberSequence.new(0, 1), Parent = alphaBar })
        y = 182
    end

    local presets = New("Frame", {
        Position = UDim2.fromOffset(10, y),
        Size = UDim2.new(1, -20, 0, 18),
        BackgroundTransparency = 1,
        List = { Padding = 3, Horizontal = true },
        Parent = frame,
    })
    for i, color in ipairs(PRESETS) do
        local p = New("TextButton", {
            Size = UDim2.fromOffset(13, 18),
            BackgroundColor3 = color,
            LayoutOrder = i,
            Corner = 3,
            Parent = presets,
        })
        p.Activated:Connect(function()
            self:Set(color, self.Alpha)
        end)
    end

    New("TextLabel", {
        Position = UDim2.fromOffset(10, y + 28),
        Size = UDim2.fromOffset(40, 24),
        Text = "Hex",
        TextSize = 13,
        Theme = { TextColor3 = "SubText" },
        Parent = frame,
    })
    local hexBox = New("TextBox", {
        Position = UDim2.fromOffset(44, y + 28),
        Size = UDim2.new(1, -54, 0, 24),
        Text = "#" .. self.HexValue,
        TextSize = 13,
        Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
        Corner = 4,
        Padding = { Left = 8 },
        Parent = frame,
    })
    local tools = New("Frame", {
        Position = UDim2.fromOffset(10, y + 60),
        Size = UDim2.new(1, -20, 0, 22),
        BackgroundTransparency = 1,
        List = { Padding = 6, Horizontal = true, HFlex = Enum.UIFlexAlignment.Fill },
        Parent = frame,
    })
    local function tool(text, order)
        return New("TextButton", {
            Size = UDim2.new(0, 0, 1, 0),
            LayoutOrder = order,
            Translate = { Text = text },
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Center,
            Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
            Corner = 4,
            Parent = tools,
        })
    end
    local copyButton = tool("Copy", 1)
    local pasteButton = tool("Paste", 2)
    local rainbowButton = tool("Rainbow", 3)
    copyButton.Activated:Connect(function()
        Library._ColorClipboard = { Color = self.Color, Alpha = self.Alpha }
        pcall(function()
            local setClip = setclipboard or toclipboard
            if setClip then setClip("#" .. string.upper(self.HexValue)) end
        end)
    end)
    pasteButton.Activated:Connect(function()
        local clip = Library._ColorClipboard
        if clip then self:Set(clip.Color, clip.Alpha) end
    end)
    rainbowButton.Activated:Connect(function()
        self:SetRainbow(not self.Rainbow)
    end)
    self._rainbowButton = rainbowButton

    hexBox.FocusLost:Connect(function()
        local color = toColor(hexBox.Text)
        if color then
            self:Set(color, self.Alpha)
        else
            hexBox.Text = "#" .. self.HexValue
        end
    end)

    self.Popup = Popup.new({ Frame = frame, Anchor = self.Swatch, Parent = self._opts.PopupParent, Align = "Right", Gap = 6 })
    self.Popup.OnClose = function() self.IsOpen = false end
    self.Popup.OnOpen = function() self.IsOpen = true end

    local function slidePalette(pos)
        pos = Input.toGui(palette, pos)
        local ap, as = palette.AbsolutePosition, palette.AbsoluteSize
        self.Saturation = math.clamp((pos.X - ap.X) / as.X, 0, 1)
        self.Value = 1 - math.clamp((pos.Y - ap.Y) / as.Y, 0, 1)
        self:_apply(true)
    end
    local function slideHue(pos)
        pos = Input.toGui(hueBar, pos)
        self.Hue = math.clamp((pos.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 0.9999)
        self:_apply(true)
    end
    local function slideAlpha(pos)
        pos = Input.toGui(alphaBar, pos)
        self.Alpha = Util.round(math.clamp((pos.X - alphaBar.AbsolutePosition.X) / alphaBar.AbsoluteSize.X, 0, 1), 0.01)
        self:_apply(true)
    end

    Input.drag(palette, { onStart = slidePalette, onMove = function(_, pos) slidePalette(pos) end })
    Input.drag(hueBar, { onStart = slideHue, onMove = function(_, pos) slideHue(pos) end })
    if alphaBar then
        Input.drag(alphaBar, { onStart = slideAlpha, onMove = function(_, pos) slideAlpha(pos) end })
    end

    self._ui = {
        frame = frame, palette = palette, paletteKnob = paletteKnob,
        hueKnob = hueKnob, alphaBar = alphaBar, alphaKnob = alphaKnob, hexBox = hexBox,
    }
    self:_apply(false)
end

function Colorpicker:_apply(fire, fromRainbow)
    self.Color = Color3.fromHSV(self.Hue, self.Saturation, self.Value)
    self.HexValue = self.Color:ToHex()

    Library.Flags[self.Flag] = {
        Color = self.Color,
        Alpha = self.Alpha,
        Rainbow = self.Rainbow or nil,
        Transparency = self.Alpha,
        HexValue = self.HexValue,
    }
    if not fromRainbow then
        Library:NotifyFlagChanged(self.Flag, Library.Flags[self.Flag])
    end

    self.Swatch.BackgroundColor3 = self.Color

    local ui = self._ui
    if ui then
        ui.palette.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
        ui.paletteKnob.Position = UDim2.fromScale(self.Saturation, 1 - self.Value)
        ui.hueKnob.Position = UDim2.fromScale(self.Hue, 0.5)
        ui.hueKnob.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
        if ui.alphaBar then
            ui.alphaBar.BackgroundColor3 = self.Color
            ui.alphaKnob.Position = UDim2.fromScale(self.Alpha, 0.5)
        end
        if self._rainbowButton then
            Theme.bind(self._rainbowButton, { TextColor3 = self.Rainbow and "Accent" or "Text" })
        end
        if not ui.hexBox:IsFocused() then
            ui.hexBox.Text = "#" .. string.upper(self.HexValue)
        end
    end

    if fire then
        Util.callback(self.Callback, self.Color, self.Alpha)
    end
end

function Colorpicker:Set(color, alpha, rainbow)
    if type(color) == "table" then
        if color.Alpha ~= nil and alpha == nil then alpha = color.Alpha end
        if color.Rainbow ~= nil and rainbow == nil then rainbow = color.Rainbow end
    end
    if rainbow ~= nil then self:SetRainbow(rainbow, true) end
    local c = toColor(color)
    if not c then return end
    local h, s, v = c:ToHSV()
    if s > 0 then self.Hue = h end
    self.Saturation, self.Value = s, v
    if type(alpha) == "number" then
        self.Alpha = math.clamp(alpha, 0, 1)
    end
    self:_apply(true)
end

local rainbowSet = {}
local rainbowConn
function Colorpicker:SetRainbow(on, quiet)
    on = on and true or false
    self.Rainbow = on
    rainbowSet[self] = on or nil
    if on and not rainbowConn then
        rainbowConn = Services.RunService.Heartbeat:Connect(function()
            local hue = (os.clock() / 6) % 1
            for picker in pairs(rainbowSet) do
                if picker.Swatch.Parent == nil or Library.Unloaded then
                    rainbowSet[picker] = nil
                else
                    picker.Hue = hue
                    if picker.Saturation < 0.05 then picker.Saturation = 1 end
                    if picker.Value < 0.05 then picker.Value = 1 end
                    picker:_apply(true, true)
                end
            end
            if next(rainbowSet) == nil then
                rainbowConn:Disconnect()
                rainbowConn = nil
            end
        end)
        Library.Maid:Give(function()
            if rainbowConn then rainbowConn:Disconnect() rainbowConn = nil end
            rainbowSet = {}
        end)
    end
    if not quiet then self:_apply(false) end
end

function Colorpicker:Get()
    return self.Color, self.Alpha
end

function Colorpicker:Destroy()
    rainbowSet[self] = nil
    if self.Popup then self.Popup:Destroy() end
    Library.SetFlags[self.Flag] = nil
    Library.Flags[self.Flag] = nil
    self.Swatch:Destroy()
end

function Colorpicker:SetOpen(open)
    if open then
        self:_build()
        self.Popup:Open()
    elseif self.Popup then
        self.Popup:Close()
    end
end

return Colorpicker
]]

__sources["components/Dropdown"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Popup = require("core/Popup")
local Base = require("components/Base")
local Colorpicker = require("components/Colorpicker")
local Locale = require("core/Locale")
local Gui = require("core/Gui")

local Section = Library.SectionClass

local ARROW_IMAGE = "rbxassetid://123317177279443"
local OPTION_HEIGHT = 24

local TextService
pcall(function() TextService = game:GetService("TextService") end)
local function measureWidth(text, size)
    if TextService then
        local ok, bounds = pcall(function()
            return TextService:GetTextSize(tostring(text), size, Enum.Font.GothamMedium, Vector2.new(100000, size))
        end)
        if ok and typeof(bounds) == "Vector2" and bounds.X > 0 then
            return bounds.X
        end
    end
    return #tostring(text) * size * 0.62
end

local function attachChoices(obj, opts)
    obj.Options = {}
    obj.OptionsWithIndexes = {}
    obj.Multi = opts.Multi and true or false
    obj.Value = obj.Multi and {} or nil
    obj.Labels = {}
    local order = 0

    local function display(name)
        local custom = obj.Labels[name]
        if custom then return opts.Translate and Locale.t(custom) or custom end
        if opts.Translate then return Locale.t(name) end
        return name
    end

    local defaultPlaceholder = obj.Multi and "None Selected" or "Select"
    local placeholder = (opts.Placeholder and opts.Placeholder ~= "") and opts.Placeholder or defaultPlaceholder
    local function valueText()
        if obj.Multi then
            local count = #obj.Value
            if count == 0 then return placeholder end
            if count == 1 then return display(obj.Value[1]) end
            return display(obj.Value[1]) .. "  +" .. (count - 1)
        end
        return obj.Value ~= nil and display(tostring(obj.Value)) or placeholder
    end
    obj._valueText = valueText

    local function syncFlag()
        if obj.Multi then
            Library.Flags[obj.Flag] = table.clone(obj.Value)
            Library:NotifyFlagChanged(obj.Flag, Library.Flags[obj.Flag])
        else
            Library.Flags[obj.Flag] = obj.Value
            Library:NotifyFlagChanged(obj.Flag, obj.Value)
        end
        if opts.OnText then opts.OnText(valueText()) end
    end

    local function renderOption(option)
        local selected = option.Selected
        if option.CheckBars then
            Base.fadeCheck(option.CheckBars, selected and 0 or 1, 0.1)
        end
        Tween.play(option.Label, { TextTransparency = selected and 0 or 0.35 }, 0.1)
        if selected then
            Theme.bind(option.Label, { TextColor3 = "Accent" })
        else
            Theme.bind(option.Label, { TextColor3 = "Text" })
        end
    end

    local function renderAll()
        for _, option in pairs(obj.Options) do
            local selected
            if obj.Multi then
                selected = table.find(obj.Value, option.Name) ~= nil
            else
                selected = obj.Value == option.Name
            end
            if option.Selected ~= selected then
                option.Selected = selected
                renderOption(option)
            end
        end
        syncFlag()
    end
    obj._renderAll = renderAll

    function obj:Get()
        if self.Multi then return table.clone(self.Value) end
        return self.Value
    end

    function obj:Set(value, silent)
        if self.Multi then
            if type(value) == "table" then
                local list = {}
                for _, v in ipairs(value) do
                    v = tostring(v)
                    if self.Options[v] and not table.find(list, v) then
                        table.insert(list, v)
                    end
                end
                self.Value = list
            elseif value ~= nil then
                value = tostring(value)
                if self.Options[value] then
                    local index = table.find(self.Value, value)
                    if index then table.remove(self.Value, index) else table.insert(self.Value, value) end
                end
            else
                self.Value = {}
            end
        else
            if value ~= nil then
                value = tostring(value)
                if not self.Options[value] then return end
            end
            self.Value = value
        end
        renderAll()
        if not silent then
            if opts.ImmediateCallback then
                local ok, err = pcall(self.Callback, self:Get())
                if not ok then warn("[B3] callback error: " .. tostring(err)) end
            else
                Util.callback(self.Callback, self:Get())
            end
        end
    end

    function obj:Add(item)
        local text, image
        if type(item) == "table" then
            text = item.Text or item.Label
            image = item.Image or item.Icon
            item = item.Name or item.name or item[1]
        end
        local name = tostring(item)
        if self.Options[name] then return self.Options[name] end
        if text ~= nil then self.Labels[name] = tostring(text) end
        local shown = self.Labels[name] or name
        order = order + 1

        local wrap = opts.Wrap and true or false
        local button = New("TextButton", {
            Name = "Option",
            Size = wrap and UDim2.new(1, 0, 0, 0) or UDim2.new(1, 0, 0, OPTION_HEIGHT),
            AutomaticSize = wrap and Enum.AutomaticSize.Y or nil,
            Padding = wrap and { Top = 4, Bottom = 4 } or nil,
            BackgroundTransparency = 1,
            LayoutOrder = order,
            Theme = { BackgroundColor3 = "Element Hover" },
            Corner = 4,
            Parent = opts.Holder,
        })
        local check, checkBars = Base.checkmark(button, "Accent", 13, {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
        })
        Base.fadeCheck(checkBars, 1, 0)

        local iconLabel
        if image ~= nil and image ~= "" then
            iconLabel = New("ImageLabel", {
                Name = "Icon",
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 6, 0, OPTION_HEIGHT / 2),
                Size = UDim2.fromOffset(18, 18),
                Image = Util.asset(image),
                Corner = 4,
                Parent = button,
            })
        end
        local textLeft = iconLabel and 30 or 8
        local label = New("TextLabel", {
            AnchorPoint = wrap and Vector2.new(0, 0) or Vector2.new(0, 0.5),
            Position = UDim2.new(0, textLeft, wrap and 0 or 0.5, 0),
            Size = UDim2.new(1, -(textLeft + 22), 0, wrap and 0 or 16),
            AutomaticSize = wrap and Enum.AutomaticSize.Y or nil,
            TextWrapped = wrap or nil,
            TextYAlignment = wrap and Enum.TextYAlignment.Top or nil,
            Translate = opts.Translate and { Text = shown } or nil,
            TextSize = 13,
            TextTransparency = 0.35,
            TextTruncate = (not wrap) and Enum.TextTruncate.AtEnd or nil,
            Theme = { TextColor3 = "Text" },
            Parent = button,
        })

        if not opts.Translate then label.Text = shown end
        local option = { Name = name, Text = shown, Button = button, Check = check, CheckBars = checkBars, Label = label, Icon = iconLabel, Selected = false }
        function option:Set() obj:Set(name) end
        function option:Toggle() end
        function option:RefreshPosition() end

        Base.hover(button, function()
            Tween.play(button, { BackgroundTransparency = 0.6 }, 0.1)
        end, function()
            Tween.play(button, { BackgroundTransparency = 1 }, 0.1)
        end)

        button.Activated:Connect(function()
            if obj.Multi then
                obj:Set(name)
            else
                obj:Set(name)
                if opts.OnSelect then opts.OnSelect() end
            end
        end)

        self.Options[name] = option
        table.insert(self.OptionsWithIndexes, option)
        if opts.OnChanged then opts.OnChanged() end
        return option
    end

    function obj:Remove(name)
        name = tostring(name)
        local option = self.Options[name]
        if not option then return end
        if option.Button then
            pcall(function() option.Button:Destroy() end)
        end
        self.Options[name] = nil
        self.Labels[name] = nil
        local index = table.find(self.OptionsWithIndexes, option)
        if index then table.remove(self.OptionsWithIndexes, index) end

        if self.Multi then
            local i = table.find(self.Value, name)
            if i then table.remove(self.Value, i) end
        elseif self.Value == name then
            self.Value = nil
        end
        renderAll()
        if opts.OnChanged then opts.OnChanged() end
    end

    function obj:Clear()
        for _, option in ipairs(table.clone(self.OptionsWithIndexes)) do
            if option.Button then
                pcall(function() option.Button:Destroy() end)
            end
        end
        self.Options = {}
        self.OptionsWithIndexes = {}
        self.Labels = {}
        if self.Multi then self.Value = {} else self.Value = nil end
        renderAll()
        if opts.OnChanged then opts.OnChanged() end
    end

    function obj:Refresh(list, default)
        local previous = self:Get()
        self:Clear()
        for _, item in ipairs(list or {}) do
            self:Add(item)
        end
        if default ~= nil then
            self:Set(default)
        else
            self:Set(previous, true)
        end
    end

    function obj:SelectAll()
        if not self.Multi then return end
        self:Set(self:GetItems())
    end

    function obj:ClearSelection()
        if self.Multi then self:Set({}) else self:Set(nil) end
    end

    function obj:IsSelected(name)
        if self.Multi then return table.find(self.Value, tostring(name)) ~= nil end
        return self.Value == tostring(name)
    end

    function obj:GetItems()
        local names = {}
        for _, option in ipairs(self.OptionsWithIndexes) do
            table.insert(names, option.Name)
        end
        return names
    end
end

local function actionBar(parent, obj, props)
    local bar = New("Frame", {
        Name = "Actions",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 24),
        List = { Padding = 4, Horizontal = true, HAlign = Enum.HorizontalAlignment.Right, VAlign = Enum.VerticalAlignment.Center },
        Parent = parent,
    })
    for k, v in pairs(props or {}) do bar[k] = v end
    local function action(text, order, fn)
        local b = New("TextButton", {
            Size = UDim2.fromOffset(0, 20),
            AutomaticSize = Enum.AutomaticSize.X,
            LayoutOrder = order,
            TextSize = 12,
            Translate = { Text = text },
            TextXAlignment = Enum.TextXAlignment.Center,
            Theme = { BackgroundColor3 = "Element Hover", TextColor3 = "Text" },
            Corner = 4,
            Padding = { Left = 7, Right = 7 },
            Parent = bar,
        })
        b.Activated:Connect(fn)
        return b
    end
    local all = action("Select all", 1, function() obj:SelectAll() end)
    local clear = action("Clear", 2, function() obj:ClearSelection() end)
    return bar, all, clear
end

function Section:MultiDropdown(data)
    data = data or {}
    data.Multi = true
    return self:Dropdown(data)
end

function Section:InlineDropdown(data)
    data = data or {}
    data.Inline = true
    data.Compact = true
    return self:Dropdown(data)
end
Section.Popover = Section.InlineDropdown

function Section:Dropdown(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local dropdown = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Dropdown"),
        Callback = Base.opt(data, "Callback", nil),
        Size = Base.opt(data, "Size", nil),
        MaxHeight = Base.opt(data, "OptionHolderSize", nil) or data.optionholder,
        IsOpen = false,
    }

    local isInline = (data.Inline == true) or (data.Compact == true) or (data.Popover == true)
    local isFullWidth = (not isInline) and (data.FullWidth or data.NoLabel or dropdown.Name == "" or dropdown.Name == nil)
    local boxWidth = tonumber(dropdown.Size) or (isInline and (tonumber(data.Width) or 110) or nil)
    local isStacked = (not isFullWidth) and (not isInline) and (boxWidth == nil)
    local rowHeight = isFullWidth and 26 or (isStacked and 46 or (isInline and 20 or 26))
    local hasCheckbox = isInline and data.Checkbox == true
    local labelInset = hasCheckbox and 24 or 0
    local row = Base.row(container, rowHeight)
    local label
    if not isFullWidth then
        label = Base.text(row, dropdown.Name, {
            AnchorPoint = isStacked and Vector2.new(0, 0) or Vector2.new(0, 0.5),
            Position = isStacked and UDim2.new(0, 0, 0, 0) or UDim2.new(0, 0, 0.5, 0),
            Size = isStacked and UDim2.new(1, 0, 0, 16) or (boxWidth and UDim2.new(1, -(boxWidth + 8 + labelInset), 0, 16) or UDim2.new(0.45, -6, 0, 16)),
            TextSize = 14,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, translate)
    end

    local right
    if isInline then
        right = New("Frame", {
            Name = "Right",
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, 0, 0.5, 0),
            Size = UDim2.fromOffset(0, 20),
            AutomaticSize = Enum.AutomaticSize.X,
            BackgroundTransparency = 1,
            List = { Padding = 6, Horizontal = true, HAlign = Enum.HorizontalAlignment.Right, VAlign = Enum.VerticalAlignment.Center },
            Parent = row,
        })
        right:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
            local s = math.max(Library.PopupScale or 1, 0.01)
            if label then
                label.Size = UDim2.new(1, -(right.AbsoluteSize.X / s + 8 + labelInset), 0, 16)
            end
        end)
    end

    dropdown.Checked = false
    if hasCheckbox and label then
        label.Position = UDim2.new(0, labelInset, 0.5, 0)
        local boxFrame = New("Frame", {
            Name = "Check",
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            Theme = { BackgroundColor3 = "Element" },
            Corner = 4,
            Parent = row,
        })
        local fill = New("Frame", {
            Name = "Fill",
            Size = UDim2.fromScale(1, 1),
            BackgroundColor3 = Color3.new(1, 1, 1),
            BackgroundTransparency = 1,
            Corner = 4,
            Parent = boxFrame,
        })
        Theme.gradient(fill)
        local _, checkBars = Base.checkmark(fill, "Dark", 11)
        Base.fadeCheck(checkBars, 1, 0)
        local hit = New("TextButton", {
            Name = "CheckHitbox",
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -((boxWidth or 0) + 36), 1, 0),
            ZIndex = 1,
            Parent = row,
        })
        if right then right.ZIndex = 2 end
        local function renderCheck()
            local on = dropdown.Checked
            Tween.play(fill, { BackgroundTransparency = on and 0 or 1 }, 0.12)
            Base.fadeCheck(checkBars, on and 0 or 1, 0.12)
            Tween.play(label, { TextTransparency = on and 0 or 0.25 }, 0.12)
        end
        function dropdown:GetChecked() return self.Checked end
        function dropdown:SetChecked(value, silent)
            value = value and true or false
            self.Checked = value
            if self.CheckFlag then
                Library.Flags[self.CheckFlag] = value
                Library:NotifyFlagChanged(self.CheckFlag, value)
            end
            renderCheck()
            if not silent then Util.callback(data.CheckCallback, value) end
        end
        dropdown.CheckFlag = Library:RegisterFlag(data.CheckFlag, function(value)
            dropdown:SetChecked(value)
        end)
        hit.Activated:Connect(function() dropdown:SetChecked(not dropdown.Checked) end)
        if data.CheckDefault ~= nil then dropdown:SetChecked(data.CheckDefault) end
    end

    local box = New("TextButton", {
        Name = "Box",
        AnchorPoint = (isFullWidth or isStacked) and Vector2.new(0, 0) or (isInline and Vector2.new(0, 0.5) or Vector2.new(1, 0.5)),
        Position = isFullWidth and UDim2.fromScale(0, 0) or (isStacked and UDim2.new(0, 0, 0, 20) or (isInline and UDim2.new(0, 0, 0.5, 0) or UDim2.new(1, 0, 0.5, 0))),
        Size = isFullWidth and UDim2.fromScale(1, 1) or (isStacked and UDim2.new(1, 0, 0, 26) or (boxWidth and UDim2.new(0, boxWidth, 0, isInline and 20 or 24) or UDim2.new(0.55, 0, 0, 24))),
        LayoutOrder = 1,
        Theme = { BackgroundColor3 = "Element" },
        Corner = 5,
        Parent = right or row,
    })
    if boxWidth and label and not isStacked and not right then
        label.Size = UDim2.new(1, -(boxWidth + 8), 0, 16)
    end
    local isMulti = Base.opt(data, "Multi", false) and true or false
    local defaultPlaceholder = isMulti and "None Selected" or "Select"
    local placeholder = (data.Placeholder and data.Placeholder ~= "") and data.Placeholder or defaultPlaceholder
    local valueLabel = New("TextLabel", {
        AnchorPoint = Vector2.new(0, 0.5),
        Position = UDim2.new(0, 8, 0.5, 0),
        Size = UDim2.new(1, -24, 0, 16),
        Text = placeholder,
        TextSize = isInline and 13 or 14,
        TextTransparency = 0.45,
        TextTruncate = Enum.TextTruncate.AtEnd,
        Theme = { TextColor3 = "Text" },
        Parent = box,
    })
    local arrow = New("ImageLabel", {
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -7, 0.5, 0),
        Size = UDim2.fromOffset(10, 5),
        Image = ARROW_IMAGE,
        ImageTransparency = 0.3,
        Theme = { ImageColor3 = "Text" },
        Parent = box,
    })
    Base.hoverBackground(box)

    local list = New("Frame", {
        Name = "DropdownList",
        Size = UDim2.fromOffset(160, 40),
        Theme = { BackgroundColor3 = "Popup" },
        Corner = 6,
        ClipsDescendants = true,
    })
    local barHeight = isMulti and 33 or 0
    local initialItems = Base.opt(data, "Items", {})
    local searchable = data.Search == true or (data.Search ~= false and #initialItems >= 10)
    local searchY = barHeight
    if searchable then barHeight = barHeight + 30 end
    local scroll = New("ScrollingFrame", {
        Position = UDim2.fromOffset(0, barHeight),
        Size = UDim2.new(1, 0, 1, -barHeight),
        ScrollBarThickness = 2,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Theme = { ScrollBarImageColor3 = "Accent" },
        Padding = 4,
        List = { Padding = 1 },
        Parent = list,
    })

    local maxHeight = (tonumber(dropdown.MaxHeight) or 180) + barHeight
    local wrapText = Base.opt(data, "TextWrap", false) and true or false
    local autoWidth = isInline or (Base.opt(data, "AutoWidth", false) and true or false)
    local popupAlign = data.Align or (isInline and "Right" or "Left")
    local popup = Popup.new({
        Frame = list,
        Anchor = box,
        Parent = container.PopupOwner,
        Align = popupAlign,
        MatchWidth = not autoWidth,
        AnimateHeight = true,
    })
    Base.maid(dropdown):Give(popup)

    local layout = scroll:FindFirstChildOfClass("UIListLayout")

    local widthPad = isMulti and 46 or 34
    local optTranslate = translate and not data.NoTranslate
    local function fitWidth()
        local scale = math.max(Library.PopupScale or 1, 0.01)
        local boxW = box.AbsoluteSize.X / scale
        local longest = math.max(boxW, isInline and 100 or boxW)
        for _, option in ipairs(dropdown.OptionsWithIndexes) do
            local source = option.Text or option.Name
            local text = optTranslate and Locale.t(source) or source
            local w = measureWidth(text, 13)
            if w then longest = math.max(longest, w + widthPad + (option.Icon and 22 or 0)) end
        end
        local cap = math.min(Gui.viewport().X / scale - 24, tonumber(data.MaxWidth) or 560)
        return math.clamp(math.floor(longest + 0.5), math.floor(boxW), math.max(math.floor(boxW), cap))
    end

    local function updateEmptyState()
        local isEmpty = #dropdown.OptionsWithIndexes == 0
        if isEmpty and dropdown.IsOpen then
            popup:Close()
        end
        arrow.ImageTransparency = isEmpty and 0.7 or 0.3
    end

    local function resize()
        updateEmptyState()
        local h
        if wrapText and layout then
            local content = layout.AbsoluteContentSize.Y / math.max(Library.PopupScale or 1, 0.01)
            h = content + 8 + barHeight
        else
            local count = 0
            for _, option in ipairs(dropdown.OptionsWithIndexes) do
                if option.Button.Visible then count = count + 1 end
            end
            h = math.max(count, 1) * (OPTION_HEIGHT + 1) + 8 + barHeight
        end
        h = math.min(h, math.max(maxHeight, OPTION_HEIGHT + 8 + barHeight))
        local width = autoWidth and fitWidth() or list.Size.X.Offset
        local targetHeight = math.max(h, 32 + barHeight)
        popup.TargetWidth = width
        popup.TargetHeight = targetHeight
        if not popup.IsOpen and not popup._closingAt then
            list.Size = UDim2.new(0, width, 0, targetHeight)
        end
    end

    if wrapText and layout then
        Base.maid(dropdown):Give(layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(resize))
    end

    attachChoices(dropdown, {
        Holder = scroll,
        Multi = isMulti,
        Wrap = wrapText,
        Placeholder = placeholder,
        OnText = function(text)
            valueLabel.Text = text
            valueLabel.TextTransparency = (text == placeholder) and 0.45 or 0.15
        end,
        OnSelect = function() popup:Close() end,
        OnChanged = resize,
        ImmediateCallback = data.ImmediateCallback,
        Translate = translate and not data.NoTranslate,
    })
    Base.maid(dropdown):Give(Locale.onChanged(function()
        valueLabel.Text = dropdown._valueText()
    end))

    local searchBox
    local function applySearch()
        local query = searchBox and string.lower(searchBox.Text) or ""
        for _, option in ipairs(dropdown.OptionsWithIndexes) do
            option.Button.Visible = query == "" or Locale.matches(option.Name, query) or Locale.matches(option.Text, query)
        end
        resize()
    end
    if searchable then
        searchBox = New("TextBox", {
            Name = "Search",
            Position = UDim2.fromOffset(6, searchY + 4),
            Size = UDim2.new(1, -12, 0, 24),
            Text = "",
            Translate = { PlaceholderText = "Search" },
            TextSize = 13,
            Theme = { BackgroundColor3 = "Element", TextColor3 = "Text", PlaceholderColor3 = "SubText" },
            Corner = 4,
            Padding = { Left = 8, Right = 8 },
            Parent = list,
        })
        searchBox:GetPropertyChangedSignal("Text"):Connect(applySearch)
    end
    dropdown._applySearchFilter = applySearch

    popup.OnOpen = function()
        dropdown.IsOpen = true
        resize()
        Tween.play(arrow, { Rotation = 180, ImageTransparency = 0 }, 0.2, Enum.EasingStyle.Quart)
    end
    popup.OnClose = function()
        dropdown.IsOpen = false
        if searchBox and searchBox.Text ~= "" then searchBox.Text = "" end
        local isEmpty = #dropdown.OptionsWithIndexes == 0
        Tween.play(arrow, { Rotation = 0, ImageTransparency = isEmpty and 0.7 or 0.3 }, 0.18, Enum.EasingStyle.Quad)
    end

    box.Activated:Connect(function()
        if #dropdown.OptionsWithIndexes == 0 then return end
        popup:Toggle()
    end)

    function dropdown:SetOpen(open)
        if open and #dropdown.OptionsWithIndexes == 0 then return end
        if open then popup:Open() else popup:Close() end
    end
    function dropdown:SetText(text) self.Name = tostring(text) if label then Locale.setText(label, "Text", self.Name) end end
    function dropdown:RefreshPosition() end

    function dropdown:SubColorpicker(subData)
        subData = subData or {}
        local targetParent = right or row
        return Base.maid(dropdown):Give(Colorpicker.new({
            Parent = targetParent,
            LayoutOrder = 100,
            Size = UDim2.fromOffset(14, 14),
            Flag = subData.Flag or subData.flag,
            Default = subData.Default or subData.default,
            Alpha = subData.Alpha or subData.alpha,
            Callback = subData.Callback or subData.callback,
            PopupParent = container.PopupOwner,
        }))
    end

    dropdown.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        dropdown:Set(value)
    end)

    dropdown.Items = {
        Dropdown = { Instance = row },
        Text = { Instance = label },
        RealDropdown = { Instance = box },
        Value = { Instance = valueLabel },
        OptionHolder = { Instance = list },
    }
    if searchBox then dropdown.Items.Search = { Instance = searchBox } end
    if isMulti then
        local _, all, clear = actionBar(list, dropdown, { Padding = nil })
        list.Actions.Position = UDim2.fromOffset(0, 4)
        list.Actions.Size = UDim2.new(1, -6, 0, 24)
        dropdown.Items.SelectAll = { Instance = all }
        dropdown.Items.ClearSelection = { Instance = clear }

        local divider = New("Frame", {
            Name = "Divider",
            Position = UDim2.fromOffset(0, 31),
            Size = UDim2.new(1, 0, 0, 1),
            Theme = { BackgroundColor3 = "Outline" },
            BackgroundTransparency = 0.3,
            Parent = list,
        })
        dropdown.Items.Divider = { Instance = divider }
    end

    for _, name in ipairs(Base.opt(data, "Items", {})) do
        dropdown:Add(name)
    end
    updateEmptyState()

    Base.finish(dropdown, container, row, data)
    local default = Base.opt(data, "Default", nil)
    if default ~= nil then
        dropdown:Set(default)
    else
        dropdown._renderAll()
    end
    return dropdown
end

function Section:Listbox(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local listbox = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", nil),
        Callback = Base.opt(data, "Callback", nil),
        IsOpen = true,
    }

    local height = tonumber(Base.opt(data, "Size", 150)) or 150
    local hasName = listbox.Name ~= nil and listbox.Name ~= ""
    local top = hasName and 22 or 0
    local row = Base.row(container, height + top)

    if hasName then
        Base.text(row, listbox.Name, { Size = UDim2.new(1, 0, 0, 16) }, translate)
    end

    local frame = New("Frame", {
        Name = "Listbox",
        Position = UDim2.fromOffset(0, top),
        Size = UDim2.new(1, 0, 1, -top),
        Theme = { BackgroundColor3 = "Element" },
        Corner = 5,
        Parent = row,
    })

    local isMulti = Base.opt(data, "Multi", false) and true or false
    local showActions = isMulti and not Base.opt(data, "NoActions", false)
    local search = New("TextBox", {
        Name = "Search",
        Position = UDim2.fromOffset(0, 0),
        Size = UDim2.new(1, showActions and -120 or 0, 0, 28),
        BackgroundTransparency = 1,
        Text = "",
        Translate = { PlaceholderText = "Search" },
        TextSize = 13,
        Theme = { TextColor3 = "Text", PlaceholderColor3 = "SubText" },
        Padding = { Left = 10, Right = 10 },
        Parent = frame,
    })
    New("Frame", {
        Position = UDim2.fromOffset(8, 28),
        Size = UDim2.new(1, -16, 0, 1),
        BackgroundTransparency = 0.3,
        Theme = { BackgroundColor3 = "Outline" },
        Parent = frame,
    })
    local scroll = New("ScrollingFrame", {
        Position = UDim2.fromOffset(0, 30),
        Size = UDim2.new(1, 0, 1, -30),
        ScrollBarThickness = 2,
        VerticalScrollBarInset = Enum.ScrollBarInset.ScrollBar,
        Theme = { ScrollBarImageColor3 = "Accent" },
        Padding = { Top = 4, Bottom = 4, Left = 4, Right = 4 },
        List = { Padding = 1 },
        Parent = frame,
    })

    local function applyFilter()
        local query = ""
        pcall(function() query = string.lower(search.Text or "") end)
        for _, option in ipairs(listbox.OptionsWithIndexes or {}) do
            if option.Button then
                option.Button.Visible = query == "" or Locale.matches(option.Name, query) or Locale.matches(option.Text, query)
            end
        end
    end

    attachChoices(listbox, {
        Holder = scroll,
        Multi = isMulti,
        Wrap = Base.opt(data, "TextWrap", false) and true or false,
        OnChanged = applyFilter,
        Translate = translate and not data.NoTranslate,
    })

    search:GetPropertyChangedSignal("Text"):Connect(applyFilter)

    function listbox:SetOpen() end
    function listbox:RefreshPosition() end

    listbox.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        listbox:Set(value)
    end)

    listbox.Items = { Listbox = { Instance = row }, Search = { Instance = search }, Holder = { Instance = scroll } }
    if showActions then
        local bar, all, clear = actionBar(frame, listbox)
        bar.AnchorPoint = Vector2.new(1, 0)
        bar.Position = UDim2.new(1, -4, 0, 2)
        bar.Size = UDim2.fromOffset(120, 24)
        listbox.Items.SelectAll = { Instance = all }
        listbox.Items.ClearSelection = { Instance = clear }
    end

    for _, name in ipairs(Base.opt(data, "Items", {})) do
        listbox:Add(name)
    end

    Base.finish(listbox, container, row, data)
    local default = Base.opt(data, "Default", nil)
    if default ~= nil then
        listbox:Set(default)
    else
        listbox._renderAll()
    end
    return listbox
end

return true
]]

__sources["components/HomePage"] = [[
local Services = require("core/Services")
local Library = require("core/Library")
local Util = require("core/Util")
local Theme = require("core/Theme")
local Locale = require("core/Locale")
local KeyTimer = require("core/KeyTimer")
local FrameRate = require("core/FrameRate")

require("components/StatGrid")
require("components/Changelog")
require("components/KeyValue")

local function formatDuration(seconds)
    seconds = math.max(0, math.floor(seconds))
    local h = math.floor(seconds / 3600)
    local m = math.floor((seconds % 3600) / 60)
    local s = seconds % 60
    if h > 0 then
        return string.format("%dh %02dm", h, m)
    elseif m > 0 then
        return string.format("%dm %02ds", m, s)
    else
        return string.format("%ds", s)
    end
end

local function countActiveFeatures()
    local n = 0
    for _, v in pairs(Library.Flags) do
        if v == true then n = n + 1 end
    end
    return tostring(n)
end

local function getPing()
    local ping = 0
    pcall(function()
        local stats = game:GetService("Stats")
        local item = stats.Network.ServerStatsItem["Data Ping"]
        ping = math.floor(item:GetValue())
    end)
    if ping <= 0 then
        pcall(function()
            local lp = Services.Players.LocalPlayer
            if lp and typeof(lp.GetNetworkPing) == "function" then
                ping = math.floor(lp:GetNetworkPing() * 1000)
            end
        end)
    end
    return ping > 0 and (tostring(ping) .. " ms") or "0 ms"
end

local function getPlayersCount()
    local count = 0
    local max = 0
    pcall(function()
        count = #Services.Players:GetPlayers()
        max = Services.Players.MaxPlayers or 0
    end)
    if max > 0 then
        return tostring(count) .. " / " .. tostring(max)
    end
    return tostring(count)
end

function Library:CreateHomePage(window, options)
    window = window or Library.MainWindow
    options = options or {}

    local page = window:Page({
        Name = options.Name or "Home",
        Icon = options.Icon or "76201794045889",
        Columns = 2,
        Translate = true,
        Description = options.Description,
    })

    local announcementsSec = page:Section({
        Name = options.AnnouncementsTitle or "Announcements",
        Side = 1,
        Collapsible = true,
        Icon = options.AnnouncementsIcon or "123130994927055",
    })

    local defaultChangelog = options.Changelog or {
        {
            Version = "v1.0.1",
            Date = "2026-09-16",
            Changes = {
                "Inventory Value ESP",
                "Feeds: best pet, $/s, age, rarity",
                "Auto Place Eggs own filter",
                "Place Best delay",
                "Farm tab pages",
                "Fixed status card lines",
                "Fixed place best spam",
                "Fixed ride best pet pick",
                "Fixed game AFK teleport",
                "Fixed server hop turning off",
                "Fixed farm lag + load freeze",
            }
        },
        {
            Version = "v1.0.0",
            Date = "2026-09-15",
            Changes = {
                "Auto Farm Eggs + filters",
                "Rebirth egg targeting",
                "Auto Place / Hatch",
                "Best pets placed first",
                "Auto Sell pets",
                "Auto Buy Radars / Food",
                "Auto Hatch Luck / Rebirth",
            }
        }
    }

    local changelog = announcementsSec:Changelog(defaultChangelog)

    local statusSec = page:Section({
        Name = options.StatusTitle or "Status",
        Side = 2,
        Collapsible = true,
        Icon = options.StatusIcon or "74192896732547",
    })

    local statusGrid = statusSec:StatGrid({
        Columns = 3,
        Cards = {
            { Id = "Session", Title = "session", Value = "0s" },
            { Id = "Features", Title = "features on", Value = "0" },
            { Id = "FPS", Title = "fps", Value = "60" },
            { Id = "Ping", Title = "ping", Value = "0 ms" },
            { Id = "Players", Title = "players", Value = getPlayersCount() },
            { Id = "KeyTime", Title = "key time", Value = options.KeyTime or "24h" },
        }
    })

    local statsSec = page:Section({
        Name = options.StatsTitle or "Stats",
        Side = 2,
        Collapsible = true,
        Icon = options.StatsIcon or "83919178800535",
    })

    local defaultStats = options.Stats or {
        { Id = "Cash", Title = "Cash", Value = "$0" },
        { Id = "PerSec", Title = "$ / s", Value = "0" },
        { Id = "Eggs", Title = "Eggs", Value = "0" },
        { Id = "EggsHatched", Title = "Eggs Hatched", Value = "0" },
        { Id = "PetsSold", Title = "Pets Sold", Value = "0" },
    }

    local statsGrid = statsSec:StatGrid({
        Columns = 3,
        Cards = defaultStats,
    })

    local accountSec = page:Section({
        Name = options.AccountTitle or "Account",
        Side = 2,
        Collapsible = true,
        Icon = options.AccountIcon or "78619442115317",
    })

    local keyStatusRow
    if options.KeyStatus then
        keyStatusRow = accountSec:KeyValue({
            Key = "Key status",
            Value = options.KeyStatus,
            Badge = true,
        })
    end

    local startTime = os.time()

    local liveTask = task.spawn(function()
        while not Library.Unloaded do
            if window and window._shown and window.IsOpen then
                pcall(function()
                    local elapsed = os.time() - startTime
                    statusGrid:Set("Session", formatDuration(elapsed))
                    statusGrid:Set("Features", countActiveFeatures())
                    statusGrid:Set("FPS", tostring(FrameRate.get()))
                    statusGrid:Set("Ping", getPing())
                    statusGrid:Set("Players", getPlayersCount())
                    local left, hasTimer = KeyTimer.left()
                    if hasTimer then
                        statusGrid:Set("KeyTime", KeyTimer.format(left))
                    end
                end)
            end
            task.wait(1)
        end
    end)

    return {
        Page = page,
        Announcements = announcementsSec,
        Changelog = changelog,
        Status = statusSec,
        StatusGrid = statusGrid,
        Stats = statsSec,
        StatsGrid = statsGrid,
        Account = accountSec,
        KeyStatus = keyStatusRow,
    }
end

return Library
]]

__sources["components/ItemGrid"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Base = require("components/Base")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local GAP = 6
local CAPTION = 16

local function initials(name)
    local out = ""
    for word in string.gmatch(name, "%w+") do
        out = out .. string.upper(string.sub(word, 1, 1))
        if #out >= 2 then break end
    end
    return out ~= "" and out or "?"
end

function Section:ItemGrid(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local grid = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", nil),
        Callback = Base.opt(data, "Callback", nil),
        Multi = Base.opt(data, "Multi", false) == true,
        Options = {},
        OptionsWithIndexes = {},
    }
    grid.Value = grid.Multi and {} or nil
    local cell = math.clamp(tonumber(Base.opt(data, "CellSize", 64)) or 64, 40, 140)
    local maxRows = math.max(tonumber(Base.opt(data, "MaxRows", 3)) or 3, 1)

    local row = Base.row(container, 0, { AutomaticSize = Enum.AutomaticSize.Y })
    New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 5), Parent = row })

    local header = New("Frame", {
        Name = "Header",
        Size = UDim2.new(1, 0, 0, 18),
        BackgroundTransparency = 1,
        LayoutOrder = 0,
        Parent = row,
    })
    local hasName = grid.Name ~= nil and grid.Name ~= ""
    local label = Base.text(header, hasName and grid.Name or "", {
        Size = UDim2.new(1, -120, 1, 0),
        TextSize = 14,
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)
    local actions = New("Frame", {
        Name = "Actions",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.fromScale(1, 0),
        Size = UDim2.new(0, 120, 1, 0),
        BackgroundTransparency = 1,
        List = { Padding = 4, Horizontal = true, HAlign = Enum.HorizontalAlignment.Right, VAlign = Enum.VerticalAlignment.Center },
        Parent = header,
    })
    local countLabel = New("TextLabel", {
        Name = "Count",
        Size = UDim2.fromOffset(0, 18),
        AutomaticSize = Enum.AutomaticSize.X,
        TextSize = 12,
        TextTransparency = 0.3,
        LayoutOrder = 0,
        Theme = { TextColor3 = "SubText" },
        Parent = actions,
    })
    local function action(text, order)
        local b = New("TextButton", {
            Name = text,
            Size = UDim2.fromOffset(0, 18),
            AutomaticSize = Enum.AutomaticSize.X,
            Translate = { Text = text },
            TextSize = 12,
            TextTransparency = 0.25,
            LayoutOrder = order,
            Padding = { Left = 6, Right = 6 },
            Corner = 4,
            Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
            Parent = actions,
        })
        Base.hoverBackground(b)
        return b
    end
    local allButton, clearButton
    if grid.Multi then
        allButton = action("All", 1)
        clearButton = action("Clear", 2)
    end
    header.Visible = hasName or grid.Multi

    local scroll = New("ScrollingFrame", {
        Name = "Grid",
        Size = UDim2.new(1, 0, 0, cell + CAPTION),
        LayoutOrder = 1,
        ScrollBarThickness = 2,
        Theme = { ScrollBarImageColor3 = "Accent" },
        Parent = row,
    })
    local layout = New("UIGridLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        CellPadding = UDim2.fromOffset(GAP, GAP),
        CellSize = UDim2.fromOffset(cell, cell + CAPTION),
        Parent = scroll,
    })

    local function relayout()
        local scale = math.max(Library.PopupScale or 1, 0.01)
        local width = scroll.AbsoluteSize.X / scale - 4
        local columns = width > 0 and math.max(1, math.floor((width + GAP) / (cell + GAP))) or 4
        layout.CellSize = UDim2.new(1 / columns, -math.ceil(GAP * (columns - 1) / columns) - 1, 0, cell + CAPTION)
        local rows = math.max(1, math.ceil(#grid.OptionsWithIndexes / columns))
        local shown = math.min(rows, maxRows)
        scroll.Size = UDim2.new(1, 0, 0, shown * (cell + CAPTION) + (shown - 1) * GAP)
    end
    Base.maid(grid):Give(scroll:GetPropertyChangedSignal("AbsoluteSize"):Connect(relayout))

    local function updateCount()
        if grid.Multi then
            countLabel.Text = tostring(#grid.Value) .. "/" .. tostring(#grid.OptionsWithIndexes)
        else
            countLabel.Text = ""
        end
    end

    local function render(option, instant)
        local on = grid:IsSelected(option.Name)
        local t = instant and 0 or 0.12
        option.Stroke.Enabled = true
        Tween.play(option.Stroke, { Transparency = on and 0 or 1 }, t)
        Base.fadeCheck(option.CheckBars, on and 0 or 1, t)
        Tween.play(option.Button, { BackgroundTransparency = on and 0 or 0.35 }, t)
        Tween.play(option.Caption, { TextTransparency = on and 0 or 0.35 }, t)
    end
    local function renderAll(instant)
        for _, option in ipairs(grid.OptionsWithIndexes) do render(option, instant) end
        updateCount()
    end

    local function syncFlag()
        local value = grid.Multi and table.clone(grid.Value) or grid.Value
        Library.Flags[grid.Flag] = value
        Library:NotifyFlagChanged(grid.Flag, value)
    end

    function grid:Get()
        if self.Multi then return table.clone(self.Value) end
        return self.Value
    end

    function grid:IsSelected(name)
        name = tostring(name)
        if self.Multi then return table.find(self.Value, name) ~= nil end
        return self.Value == name
    end

    function grid:Set(value, silent)
        if self.Multi then
            if type(value) == "table" then
                local list = {}
                for _, v in ipairs(value) do
                    v = tostring(v)
                    if self.Options[v] and not table.find(list, v) then table.insert(list, v) end
                end
                self.Value = list
            elseif value ~= nil then
                value = tostring(value)
                if not self.Options[value] then return end
                local i = table.find(self.Value, value)
                if i then table.remove(self.Value, i) else table.insert(self.Value, value) end
            else
                self.Value = {}
            end
        else
            if value ~= nil then
                value = tostring(value)
                if not self.Options[value] then return end
            end
            self.Value = value
        end
        renderAll()
        syncFlag()
        if not silent then Util.callback(self.Callback, self:Get()) end
    end

    function grid:Add(item)
        local text, image, color
        if type(item) == "table" then
            text, image, color = item.Text or item.Label, item.Image or item.Icon, item.Color
            item = item.Name or item.name or item[1]
        end
        local name = tostring(item)
        if name == "" or self.Options[name] then return self.Options[name] end
        local caption = text and tostring(text) or name

        local button = New("TextButton", {
            Name = "Item",
            LayoutOrder = #self.OptionsWithIndexes + 1,
            BackgroundTransparency = 0.35,
            ClipsDescendants = true,
            Corner = 6,
            Theme = { BackgroundColor3 = "Element" },
            Parent = scroll,
        })
        local stroke = Instance.new("UIStroke")
        stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
        stroke.Thickness = 1.5
        stroke.Transparency = 1
        Theme.bind(stroke, { Color = "Accent" })
        stroke.Parent = button

        local pictureSize = UDim2.new(1, -14, 1, -(CAPTION + 10))
        if image ~= nil and image ~= "" then
            New("ImageLabel", {
                Name = "Picture",
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 6),
                Size = pictureSize,
                Image = Util.asset(image),
                ScaleType = Enum.ScaleType.Fit,
                Parent = button,
            })
        else
            New("TextLabel", {
                Name = "Initials",
                AnchorPoint = Vector2.new(0.5, 0),
                Position = UDim2.new(0.5, 0, 0, 6),
                Size = pictureSize,
                Text = initials(name),
                TextSize = math.floor(cell * 0.32),
                TextXAlignment = Enum.TextXAlignment.Center,
                TextTransparency = 0.45,
                Theme = { TextColor3 = "Text" },
                Parent = button,
            })
        end
        local captionLabel = New("TextLabel", {
            Name = "Caption",
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, -3),
            Size = UDim2.new(1, -6, 0, 14),
            TextSize = 11,
            TextXAlignment = Enum.TextXAlignment.Center,
            TextTruncate = Enum.TextTruncate.AtEnd,
            TextTransparency = 0.35,
            [translate and "Translate" or "Text"] = translate and { Text = caption } or caption,
            Theme = { TextColor3 = "Text" },
            Parent = button,
        })
        if typeof(color) == "Color3" then
            New("Frame", {
                Name = "Rarity",
                AnchorPoint = Vector2.new(0.5, 1),
                Position = UDim2.fromScale(0.5, 1),
                Size = UDim2.new(1, 0, 0, 2),
                BackgroundColor3 = color,
                Parent = button,
            })
        end
        local check, checkBars = Base.checkmark(button, "Accent", 12, {
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -4, 0, 4),
        })
        Base.fadeCheck(checkBars, 1, 0)
        Base.hover(button, function()
            Tween.play(button, { BackgroundTransparency = 0 }, 0.1)
        end, function()
            if not grid:IsSelected(name) then Tween.play(button, { BackgroundTransparency = 0.35 }, 0.1) end
        end)

        local option = { Name = name, Text = caption, Button = button, Stroke = stroke, Caption = captionLabel, Check = check, CheckBars = checkBars }
        button.Activated:Connect(function()
            if grid.Multi then
                grid:Set(name)
            else
                grid:Set(grid.Value == name and nil or name)
            end
        end)
        self.Options[name] = option
        table.insert(self.OptionsWithIndexes, option)
        render(option, true)
        relayout()
        updateCount()
        return option
    end

    function grid:Remove(name)
        name = tostring(name)
        local option = self.Options[name]
        if not option then return end
        option.Button:Destroy()
        self.Options[name] = nil
        local index = table.find(self.OptionsWithIndexes, option)
        if index then table.remove(self.OptionsWithIndexes, index) end
        if self.Multi then
            local i = table.find(self.Value, name)
            if i then table.remove(self.Value, i) end
        elseif self.Value == name then
            self.Value = nil
        end
        relayout()
        renderAll()
        syncFlag()
    end

    function grid:Refresh(items, default)
        local previous = self:Get()
        for _, option in ipairs(table.clone(self.OptionsWithIndexes)) do option.Button:Destroy() end
        self.Options, self.OptionsWithIndexes = {}, {}
        self.Value = self.Multi and {} or nil
        for _, item in ipairs(items or {}) do self:Add(item) end
        if default ~= nil then self:Set(default) else self:Set(previous, true) end
        relayout()
    end

    function grid:GetItems()
        local names = {}
        for _, option in ipairs(self.OptionsWithIndexes) do table.insert(names, option.Name) end
        return names
    end
    function grid:SelectAll()
        if self.Multi then self:Set(self:GetItems()) end
    end
    function grid:ClearSelection()
        if self.Multi then self:Set({}) else self:Set(nil) end
    end
    function grid:SetText(text)
        self.Name = tostring(text)
        Locale.setText(label, "Text", self.Name)
    end
    function grid:RefreshPosition() end

    if allButton then allButton.Activated:Connect(function() grid:SelectAll() end) end
    if clearButton then clearButton.Activated:Connect(function() grid:ClearSelection() end) end

    grid.Flag = Library:RegisterFlag(Base.opt(data, "Flag", nil), function(value)
        grid:Set(value)
    end)

    for _, item in ipairs(Base.opt(data, "Items", {})) do grid:Add(item) end

    grid.Items = { ItemGrid = { Instance = row }, Text = { Instance = label }, Grid = { Instance = scroll },
        SelectAll = allButton and { Instance = allButton } or nil, ClearSelection = clearButton and { Instance = clearButton } or nil }
    function grid:_matches(query)
        if Locale.matches(self.Name, query) then return true end
        for _, option in ipairs(self.OptionsWithIndexes) do
            if Locale.matches(option.Name, query) or Locale.matches(option.Text, query) then return true end
        end
        return false
    end
    Base.finish(grid, container, row, data)

    local default = Base.opt(data, "Default", nil)
    if default ~= nil then
        grid:Set(default)
    else
        renderAll(true)
        syncFlag()
    end
    task.defer(relayout)
    return grid
end

return true
]]

__sources["components/Keybind"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Popup = require("core/Popup")
local Base = require("components/Base")
local KeybindCore = require("components/KeybindCore")
local Locale = require("core/Locale")

local Section = Library.SectionClass

local function keyButton(parent)
    local button = New("TextButton", {
        Name = "Key",
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 0, 0, 0),
        Size = UDim2.fromOffset(0, 20),
        AutomaticSize = Enum.AutomaticSize.X,
        Text = "None",
        TextSize = 12,
        TextTransparency = 0.15,
        TextXAlignment = Enum.TextXAlignment.Center,
        Theme = { BackgroundColor3 = "Element", TextColor3 = "Text" },
        Corner = 4,
        Padding = { Left = 9, Right = 9 },
        Parent = parent,
    })
    Base.hoverBackground(button)
    return button
end

local function wrapApi(obj, core)
    obj.Core = core
    obj.Flag = core.Flag
    function obj:Get() return core.Key, core.Value, core.Mode end
    function obj:Set(key) core:Set(key) end
    function obj:SetMode(mode) core:SetMode(mode) end
    function obj:Press(state) core:SetToggled(state == nil and not core.Toggled or state) end
    function obj:IsActive() return core.Toggled end
    function obj:RefreshPosition() end
    return obj
end

function Section:Keybind(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end
    local showModes = data.ShowModes ~= false

    local keybind = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Keybind"),
        Callback = Base.opt(data, "Callback", nil),
    }

    local row = Base.row(container, showModes and 48 or 20)
    Base.text(row, keybind.Name, {
        Position = UDim2.fromOffset(0, 2),
        Size = UDim2.new(1, -80, 0, 16),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)
    local button = keyButton(row)

    local segments = {}
    local highlight
    if showModes then
        local bar = New("Frame", {
            Name = "Modes",
            AnchorPoint = Vector2.new(0, 1),
            Position = UDim2.fromScale(0, 1),
            Size = UDim2.new(1, 0, 0, 22),
            Theme = { BackgroundColor3 = "Element" },
            Corner = 5,
            Parent = row,
        })
        highlight = New("Frame", {
            Size = UDim2.new(1 / 3, 0, 1, 0),
            BackgroundColor3 = Color3.new(1, 1, 1),
            Corner = 5,
            Parent = bar,
        })
        Theme.gradient(highlight)
        for i, mode in ipairs({ "Toggle", "Hold", "Always" }) do
            segments[mode] = New("TextButton", {
                Position = UDim2.fromScale((i - 1) / 3, 0),
                Size = UDim2.fromScale(1 / 3, 1),
                BackgroundTransparency = 1,
                Translate = { Text = mode },
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Center,
                Theme = { TextColor3 = "Text" },
                Parent = bar,
            })
        end
    end

    local lastMode
    local core = KeybindCore.new({
        Flag = Base.opt(data, "Flag", nil),
        Default = Base.opt(data, "Default", nil),
        Mode = Base.opt(data, "Mode", "Toggle"),
        Name = keybind.Name,
        NoKeybindList = data.NoKeybindList,
        OnChanged = function(c)
            Locale.bind(button, "Text", c.Picking and "Press a key" or c.Value)
            if highlight and lastMode ~= c.Mode then
                lastMode = c.Mode
                local index = (c.Mode == "Hold" and 1) or (c.Mode == "Always" and 2) or 0
                Tween.play(highlight, { Position = UDim2.fromScale(index / 3, 0) }, 0.15)
                for mode, seg in pairs(segments) do
                    Theme.bind(seg, { TextColor3 = mode == c.Mode and "Dark" or "Text" })
                    seg.TextTransparency = mode == c.Mode and 0 or 0.35
                end
            end
        end,
        OnState = function(state)
            Util.callback(keybind.Callback, state)
        end,
    })

    button.Activated:Connect(function()
        core:StartPicking()
    end)
    for mode, seg in pairs(segments) do
        seg.Activated:Connect(function()
            local reports = mode == "Always" or (mode == "Hold" and core.Toggled)
            core:SetMode(mode)
            if not reports then
                Util.callback(keybind.Callback, core.Toggled)
            end
        end)
    end

    wrapApi(keybind, core)
    Base.maid(keybind):Give(core)
    keybind.Items = { Label = { Instance = row }, KeyButton = { Instance = button } }
    return Base.finish(keybind, container, row, data)
end

function Section:Sub2keybind(data)
    data = data or {}
    local container = self
    local translate = data.Translate
    if translate == nil then translate = container.Translate end

    local keybind = {
        Window = container.Window,
        Page = container.Page,
        Section = container,
        Name = Base.opt(data, "Name", "Keybind"),
        Callback = Base.opt(data, "Callback", nil),
    }

    local row = Base.row(container, 20)
    Base.text(row, keybind.Name, {
        Position = UDim2.fromOffset(0, 2),
        Size = UDim2.new(1, -80, 0, 16),
        TextTruncate = Enum.TextTruncate.AtEnd,
    }, translate)
    local button = keyButton(row)

    local menu = New("Frame", {
        Name = "ModeMenu",
        Size = UDim2.fromOffset(90, 58),
        Theme = { BackgroundColor3 = "Popup" },
        Corner = 5,
        Padding = 4,
        List = { Padding = 2 },
    })
    local menuPopup = Popup.new({ Frame = menu, Anchor = button, Parent = container.PopupOwner, Align = "Right" })

    local core
    local options = {}
    for i, mode in ipairs({ "Toggle", "Hold" }) do
        local option = New("TextButton", {
            Size = UDim2.new(1, 0, 0, 24),
            BackgroundTransparency = 1,
            LayoutOrder = i,
            Translate = { Text = mode },
            TextSize = 13,
            Theme = { TextColor3 = "Text" },
            Padding = { Left = 8 },
            Parent = menu,
        })
        options[mode] = option
        option.Activated:Connect(function()
            core:SetMode(mode)
            menuPopup:Close()
        end)
    end
    menuPopup.OnOpen = function()
        for mode, option in pairs(options) do
            local selected = core.Mode == mode
            Theme.bind(option, { TextColor3 = selected and "Accent" or "Text" })
            option.TextTransparency = selected and 0 or 0.4
        end
    end

    local mode = Base.opt(data, "Mode", "Toggle")
    core = KeybindCore.new({
        Flag = Base.opt(data, "Flag", nil),
        Default = Base.opt(data, "Default", nil),
        Mode = (mode == "Hold") and "Hold" or "Toggle",
        Name = keybind.Name,
        OnChanged = function(c)
            Locale.bind(button, "Text", c.Picking and "Press a key" or c.Value)
        end,
        OnState = function(state)
            Util.callback(keybind.Callback, state)
        end,
    })

    button.Activated:Connect(function() core:StartPicking() end)
    button.MouseButton2Click:Connect(function() menuPopup:Toggle() end)
    button.TouchLongPress:Connect(function() menuPopup:Open() end)

    wrapApi(keybind, core)
    Base.maid(keybind):Give(core)
    Base.maid(keybind):Give(menuPopup)
    keybind.Items = { Label = { Instance = row }, KeyButton = { Instance = button } }
