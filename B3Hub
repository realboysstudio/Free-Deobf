function Util.parseKey(key)
    if key == nil then return nil, "None" end
    local str
    if typeof(key) == "EnumItem" then
        str = tostring(key)
    elseif type(key) == "string" then
        if key == "" or key == "None" then return nil, "None" end
        if string.sub(key, 1, 5) == "Enum." then
            str = key
        elseif Enum.KeyCode[key] ~= nil then
            str = "Enum.KeyCode." .. key
        else
            local ok = pcall(function() return Enum.UserInputType[key] end)
            if ok then str = "Enum.UserInputType." .. key else return nil, "None" end
        end
    else
        return nil, "None"
    end
    local name = string.match(str, "([^%.]+)$") or "None"
    if name == "Backspace" or name == "Escape" or name == "Unknown" then
        return nil, "None"
    end
    return str, ShortNames[name] or name
end

local FSFunctions = {
    isfile = isfile, isfolder = isfolder, readfile = readfile, writefile = writefile,
    delfile = delfile, listfiles = listfiles, makefolder = makefolder,
}

local function has(fnName)
    return type(FSFunctions[fnName]) == "function"
end

local function call(fnName, ...)
    local fn = FSFunctions[fnName]
    if type(fn) ~= "function" then return false, nil end
    return pcall(fn, ...)
end

Util.FS = {}

function Util.FS.available()
    return has("writefile") and has("readfile") and has("isfile")
end

function Util.FS.isfile(path)
    local ok, r = call("isfile", path)
    return ok and r == true
end

function Util.FS.isfolder(path)
    local ok, r = call("isfolder", path)
    return ok and r == true
end

function Util.FS.read(path)
    if not Util.FS.isfile(path) then return nil end
    local ok, r = call("readfile", path)
    if ok then return r end
    return nil
end

function Util.FS.write(path, content)
    local ok = call("writefile", path, content)
    return ok
end

function Util.FS.delete(path)
    if not Util.FS.isfile(path) then return false end
    local ok = call("delfile", path)
    return ok
end

function Util.FS.list(path)
    local ok, r = call("listfiles", path)
    if ok and type(r) == "table" then return r end
    return {}
end

function Util.FS.ensureFolder(path)
    if not path or path == "" then return end
    local current = ""
    for part in string.gmatch(path, "[^/\\]+") do
        current = (current == "") and part or (current .. "/" .. part)
        if not Util.FS.isfolder(current) then
            call("makefolder", current)
        end
    end
end

function Util.hwid()
    local candidates = {
        function() return gethwid() end,
        function() return game:GetService("RbxAnalyticsService"):GetClientId() end,
    }
    for _, fn in ipairs(candidates) do
        local ok, id = pcall(fn)
        if ok and type(id) == "string" and id ~= "" then return id end
    end
    return nil
end

function Util.detectDevice()
    local UIS = Services.UserInputService
    local ok, ten = pcall(function() return Services.GuiService:IsTenFootInterface() end)
    if ok and ten then return "Console" end
    if UIS.TouchEnabled and not UIS.KeyboardEnabled then return "Mobile" end
    if UIS.TouchEnabled then
        local cam = Services.Workspace.CurrentCamera
        if cam and (cam.ViewportSize.X < 1024 or cam.ViewportSize.Y < 640) then
            return "Mobile"
        end
    end
    if UIS.KeyboardEnabled or UIS.MouseEnabled then return "PC" end
    if UIS.GamepadEnabled then return "Console" end
    return "PC"
end

return Util
