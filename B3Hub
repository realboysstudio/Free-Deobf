    local confirm = { IsOpen = false }
    function confirm:Open()
        if self.IsOpen then return end
        self.IsOpen = true
        Popup.closeAll()
        overlay.Visible = true
        Tween.slide(dialog, UDim2.new(0.5, 0, 0.5, 10), UDim2.fromScale(0.5, 0.5), 0.18)
