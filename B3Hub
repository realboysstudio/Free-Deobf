local Library = require("core/Library")
local New = require("core/Create")
local Theme = require("core/Theme")
local Tween = require("core/Tween")
local Input = require("core/Input")
local Gui = require("core/Gui")
local Locale = require("core/Locale")

local entries = {}
local list -- the single KeybindList UI, created on demand
local entryOrder = 0

local WIDTH = 170

local function createRow(entry)
    if not list or entry.Row then return end
    local row = New("Frame", {
        Name = "Bind",
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 18),
        LayoutOrder = entry.Order,
