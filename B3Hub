    Bold = Font.new("rbxasset://fonts/families/Roboto.json", Enum.FontWeight.Bold, Enum.FontStyle.Normal),
}
Library.Font = Library.Fonts.Medium
Library.FontName = "Medium"
Library.NoSaveFlags["FontStyle"] = true

Util.prefetchMapName()

pcall(function()
    local cp = game:GetService("ContentProvider")
    local dummy = {}
    for _, font in pairs(Library.Fonts) do
        local l = Instance.new("TextLabel")
        l.FontFace = font
        table.insert(dummy, l)
    end
    cp:PreloadAsync(dummy)
    for _, l in ipairs(dummy) do
        l:Destroy()
    end
end)

function Library:Round(number, float)
    return Util.round(number, float)
end

function Library:GetMapName()
    return Util.getMapName()
end
Library.GetMapName = function(...)
    return Util.getMapName()
end

function Library:SafeCall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then
        warn("[B3] " .. tostring(err))
    end
    return ok
end

function Library:Connect(signal, callback)
    local connection = signal:Connect(function(...)
        Library._ensureIdentity()
        return callback(...)
    end)
    self.Maid:Give(connection)
    return connection
end

function Library:Thread(fn)
    local thread = task.spawn(function()
        Library._ensureIdentity()
        return fn()
    end)
    return thread
end

function Library:ToRich(text, color)
    return string.format('<font color="rgb(%d, %d, %d)">%s</font>',
        math.floor(color.R * 255), math.floor(color.G * 255), math.floor(color.B * 255), tostring(text))
end

local flagCounter = 0
function Library:NextFlag()
    flagCounter = flagCounter + 1
    return "__flag_" .. flagCounter
end

function Library:RegisterFlag(flag, setter, noSave)
    if flag == nil then
        flag = self:NextFlag()
        noSave = true
    end
    self.SetFlags[flag] = setter
    if noSave then
        self.NoSaveFlags[flag] = true
    end
    return flag
end

function Library:NotifyFlagChanged(flag, value)
    if self.OnFlagChanged then
        pcall(self.OnFlagChanged, flag, value)
    end
end

local function resolveGlobal(name)
    local ok, fn = pcall(function() return _G[name] end)
    if ok and type(fn) == "function" then return fn end
    local okv, gv = pcall(function() return getgenv and getgenv() end)
    if okv and type(gv) == "table" and type(gv[name]) == "function" then return gv[name] end
    return nil
end

local getThreadId = (typeof(getthreadidentity) == "function" and getthreadidentity)
    or (typeof(getidentity) == "function" and getidentity)
    or resolveGlobal("getthreadidentity")
    or resolveGlobal("getidentity")
    or (type(syn) == "table" and syn.get_thread_identity)
local setThreadId = (typeof(setthreadidentity) == "function" and setthreadidentity)
    or (typeof(setidentity) == "function" and setidentity)
    or resolveGlobal("setthreadidentity")
    or resolveGlobal("setidentity")
    or (type(syn) == "table" and syn.set_thread_identity)

function Library._ensureIdentity(force)
    if not setThreadId then return false end
    if force then
        pcall(setThreadId, 8)
        return true
    end
    if getThreadId then
        local ok, id = pcall(getThreadId)
        if ok and id and id < 8 then
            pcall(setThreadId, 8)
            return true
        end
        return false
    end
    pcall(setThreadId, 8)
    return true
end

local function setParentRaw(inst, parent)
    inst.Parent = parent
end

function Library._setParent(inst, parent)
    local ok, err = pcall(setParentRaw, inst, parent)
    if ok then return true end
    Library._ensureIdentity(true)
    local ok2, err2 = pcall(setParentRaw, inst, parent)
    if not ok2 then
        error(err2 or err, 2)
    end
    return true
end

return Library
]]

