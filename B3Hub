local removeEntry -- forward

local function assignChams()
    local wanted = {}
    for entry in pairs(entries) do
        if ESP.Enabled and entry.opts.Chams and entry.inRange then
            table.insert(wanted, entry)
        else
            releaseHighlight(entry)
        end
    end
    table.sort(wanted, function(a, b) return (a.distance or math.huge) < (b.distance or math.huge) end)
    local cap = math.max(0, ESP.MaxHighlights)
    for i = cap + 1, #wanted do releaseHighlight(wanted[i]) end
    for i = 1, math.min(cap, #wanted) do
        local entry = wanted[i]
        local fresh = entry.highlight == nil
        ensureHighlight(entry)
        if fresh then styleHighlight(entry, entryColor(entry)) end
    end
end

local function step()
    local now = os.clock()
    local rate = ESP.UpdateRate
    if rate and rate > 0 and now - lastUpdate < 1 / rate then return end
    lastUpdate = now
    local cam = Services.Workspace.CurrentCamera
    if not cam then return end
    local camCF = cam.CFrame
    ctx.viewport = cam.ViewportSize
    ctx.camPos = camCF.Position
    ctx.camLook = camCF.LookVector
    ctx.mouse = Draw.MousePosition()
    for entry in pairs(entries) do
        if entry.target.Parent == nil then
            removeEntry(entry)
        elseif entry.player and entry.player.Character ~= entry.target then
            removeEntry(entry)
        else
            local ok, err = pcall(updateEntry, entry, cam, now)
            if not ok then
                hide(entry)
                if not entry.warned then
                    entry.warned = true
                    warn("[B3] ESP error on " .. tostring(entry.target) .. ": " .. tostring(err))
                end
            end
        end
    end
    if now - lastChams >= CHAMS_INTERVAL then
        lastChams = now
        assignChams()
    end
end

local function syncLoop()
    local want = ESP.Enabled and entryCount > 0
    if want and not conn then
        lastUpdate = 0
        lastChams = 0
        conn = Services.RunService.RenderStepped:Connect(step)
    elseif not want and conn then
        conn:Disconnect()
        conn = nil
    end
end

local Entry = {}
Entry.__index = Entry

function Entry:Set(opts)
    for key, value in pairs(opts) do self.opts[key] = value end
    self.sColor = nil
    self.nameValue = nil
    self.nextResolve = 0
    return self
end

function Entry:Remove()
    removeEntry(self)
end
Entry.Destroy = Entry.Remove

local function addEntry(target, opts, player, group)
    local entry = setmetatable({
        target = target,
        opts = opts,
        player = player,
        group = group,
        isPart = target:IsA("BasePart"),
        shown = false,
        inRange = false,
    }, Entry)
    entries[entry] = true
    entryCount += 1
    syncLoop()
    return entry
end

function removeEntry(entry)
    if not entries[entry] then return end
    entries[entry] = nil
    entryCount -= 1
    releaseAll(entry)
    if byTarget[entry.target] == entry then byTarget[entry.target] = nil end
    local group = entry.group
    if group and group.entries[entry.target] == entry then group.entries[entry.target] = nil end
    syncLoop()
end

function ESP:Add(target, opts)
    assert(typeof(target) == "Instance", "[B3] ESP:Add expects a Model or BasePart")
    local old = byTarget[target]
    if old then removeEntry(old) end
    local entry = addEntry(target, makeOptions(opts), opts and opts.Player or nil, nil)
    byTarget[target] = entry
    return entry
end

local Group = {}
Group.__index = Group

local function newGroup(opts)
    local group = setmetatable({ opts = makeOptions(opts), entries = {}, conns = {}, playerConns = {} }, Group)
    groups[group] = true
    return group
end

function Group:_add(target, player)
    if self.Removed or target == nil then return end
    local old = self.entries[target]
    if old then removeEntry(old) end
    self.entries[target] = addEntry(target, self.opts, player, self)
end

function Group:_drop(target)
    local entry = target and self.entries[target]
    if entry then removeEntry(entry) end
end

function Group:_conn(connection)
    table.insert(self.conns, connection)
    return connection
end

function Group:Set(opts)
    for key, value in pairs(opts or {}) do self.opts[key] = value end
    for _, entry in pairs(self.entries) do
        entry.sColor = nil
        entry.nameValue = nil
        entry.nextResolve = 0
    end
    return self
end

function Group:Count()
    local n = 0
    for _ in pairs(self.entries) do n += 1 end
    return n
end

function Group:Remove()
    if self.Removed then return end
    self.Removed = true
    groups[self] = nil
    if playersGroup == self then playersGroup = nil end
    for _, c in ipairs(self.conns) do pcall(function() c:Disconnect() end) end
    for _, list in pairs(self.playerConns) do
        for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
    end
    table.clear(self.conns)
    table.clear(self.playerConns)
    local list = {}
    for _, entry in pairs(self.entries) do table.insert(list, entry) end
    for _, entry in ipairs(list) do removeEntry(entry) end
end
Group.Destroy = Group.Remove

function ESP:Players(opts)
    if playersGroup and not playersGroup.Removed then
        return playersGroup:Set(opts)
    end
    local group = newGroup(opts)
    playersGroup = group
    local Players = Services.Players

    local function watchPlayer(player)
        if player == LocalPlayer or group.playerConns[player] then return end
        group.playerConns[player] = {
            player.CharacterAdded:Connect(function(character) group:_add(character, player) end),
            player.CharacterRemoving:Connect(function(character) group:_drop(character) end),
        }
        if player.Character then group:_add(player.Character, player) end
    end

    for _, player in ipairs(Players:GetPlayers()) do watchPlayer(player) end
    group:_conn(Players.PlayerAdded:Connect(watchPlayer))
    group:_conn(Players.PlayerRemoving:Connect(function(player)
        local list = group.playerConns[player]
        if list then
            for _, c in ipairs(list) do pcall(function() c:Disconnect() end) end
            group.playerConns[player] = nil
        end
        for target, entry in pairs(group.entries) do
            if entry.player == player then group:_drop(target) end
        end
    end))
    return group
end

function ESP:Watch(container, filter, opts)
    assert(typeof(container) == "Instance", "[B3] ESP:Watch expects a container Instance")
    if type(filter) == "table" and opts == nil then
        opts, filter = filter, nil
    end
    filter = filter or function(child) return child:IsA("Model") or child:IsA("BasePart") end
    local group = newGroup(opts)
    local deep = opts and opts.Descendants

    local function consider(child)
        local ok, pass = pcall(filter, child)
        if ok and pass then group:_add(child) end
    end
    for _, child in ipairs(deep and container:GetDescendants() or container:GetChildren()) do consider(child) end
    if deep then
        group:_conn(container.DescendantAdded:Connect(consider))
        group:_conn(container.DescendantRemoving:Connect(function(child) group:_drop(child) end))
    else
        group:_conn(container.ChildAdded:Connect(consider))
        group:_conn(container.ChildRemoved:Connect(function(child) group:_drop(child) end))
    end
    return group
end

function ESP:SetEnabled(enabled)
    ESP.Enabled = enabled == true
    if not ESP.Enabled then
        for entry in pairs(entries) do
            hide(entry)
            releaseHighlight(entry)
        end
    end
    syncLoop()
end

function ESP:Count()
    return entryCount
end

function ESP:Clear()
    local list = {}
    for group in pairs(groups) do table.insert(list, group) end
    for _, group in ipairs(list) do group:Remove() end
    local rest = {}
    for entry in pairs(entries) do table.insert(rest, entry) end
    for _, entry in ipairs(rest) do removeEntry(entry) end
    for _, h in ipairs(freeHighlights) do pcall(function() h:Destroy() end) end
    table.clear(freeHighlights)
    highlightCount = 0
    if conn then
        conn:Disconnect()
        conn = nil
    end
end

function ESP:HighlightCount()
    return highlightCount
end

function ESP:BuildMenu(section, opts)
    opts = opts or {}
    local prefix = opts.Flag or "B3ESP"
    local RED = Color3.fromRGB(255, 60, 60)
    local options = {
