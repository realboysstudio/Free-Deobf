__sources["core/FrameRate"] = [[
local Services = require("core/Services")
local Library = require("core/Library")

local FrameRate = {}
local currentFps = 60
local isCounting = false

local function startCounting()
    if isCounting then return end
    isCounting = true
    local frameCount = 0
    local windowStart = os.clock()
    Library.Maid:Give(Services.RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = os.clock()
        if now - windowStart >= 1 then
            currentFps = math.floor(frameCount / math.max(now - windowStart, 0.001) + 0.5)
            frameCount = 0
            windowStart = now
        end
    end))
end

function FrameRate.get()
    startCounting()
    return currentFps
end

return FrameRate
]]

