local function ensurePad(gui, right)
    local pad = gui:FindFirstChild("TopbarPad")
    if right then
        if not pad then
            pad = Instance.new("UIPadding")
            pad.Name = "TopbarPad"
            pad.Parent = gui
        end
        pad.PaddingRight = UDim.new(0, right)
    elseif pad then
        pad:Destroy()
    end
end

function Window:_styleTab(tab, label, sidebarHeight, rightPad, compact, name, animate)
    local textX = label.Position.X.Offset
    if self.Layout == "Topbar" then
        ensurePad(tab, nil)
        tab.AutomaticSize = Enum.AutomaticSize.None
        tab.ClipsDescendants = true
        label.AutomaticSize = Enum.AutomaticSize.X
        label.Size = UDim2.new(0, 0, 0, 16)
        label.Visible = true
        local full = math.ceil(textX + label.TextBounds.X + (rightPad or 12))
        local width = compact and 40 or full
        local target = UDim2.new(0, width, 0, 30)
        Tooltip.attach(tab, compact and name or nil)
        if animate and self._shown and tab.Size.X.Scale == 0 then
            Tween.resize(tab, target, 0.22, function()
                if compact then label.Visible = false end
            end)
        else
            tab.Size = target
            label.Visible = not compact
        end
    else
        tab.ClipsDescendants = false
        label.Visible = true
        Tooltip.attach(tab, nil)
        tab.AutomaticSize = Enum.AutomaticSize.None
        tab.Size = UDim2.new(1, 0, 0, sidebarHeight or 36)
        label.AutomaticSize = Enum.AutomaticSize.None
        label.Size = UDim2.new(1, -(textX + (rightPad and rightPad + 6 or 6)), 0, 16)
        ensurePad(tab, nil)
    end
end

function Window:SetLayout(mode)
    mode = (string.lower(tostring(mode)) == "topbar") and "Topbar" or "Sidebar"
    if mode == self.Layout and self._layoutApplied then return end
    self.Layout = mode
    self._layoutApplied = true
    local topbar = mode == "Topbar"
    Popup.closeAll()

    local root = self.Root
    local wasTopbar = self._sizedForTopbar or false
    if topbar ~= wasTopbar and not self.Maximized then
        local w, h = root.Size.X.Offset, root.Size.Y.Offset
        local dw = topbar and -SIDEBAR_WIDTH or SIDEBAR_WIDTH
        local dh = topbar and TOPTABS_HEIGHT or -TOPTABS_HEIGHT
        local s = self.Scale.Scale
        root.Size = UDim2.fromOffset(w + dw, h + dh)
        root.Position = root.Position + UDim2.fromOffset(math.floor(-dw * s / 2), math.floor(-dh * s / 2))
    end
    self._sizedForTopbar = topbar
    self.MinSize = topbar and Vector2.new(380, 320 + TOPTABS_HEIGHT) or Vector2.new(SIDEBAR_WIDTH + 380, 320)

    local tabs, header, content, main, brand = self.Tabs, self.Header, self.Content, self._mainArea, self._brand
    local list = tabs:FindFirstChildOfClass("UIListLayout")
    local pad = tabs:FindFirstChildOfClass("UIPadding")

    self.Sidebar.Visible = not topbar
    main.Position = topbar and UDim2.fromOffset(0, 0) or UDim2.fromOffset(SIDEBAR_WIDTH, 0)
    main.Size = topbar and UDim2.fromScale(1, 1) or UDim2.new(1, -SIDEBAR_WIDTH, 1, 0)

    brand.Parent = topbar and header or self.Sidebar
    brand.Size = topbar and UDim2.new(0, 180, 1, 0) or UDim2.new(1, 0, 0, BRAND_HEIGHT)
    brand.Position = topbar and UDim2.fromOffset(2, -4) or UDim2.fromOffset(0, 0)
    self.PageInfo.Visible = not topbar -- the highlighted tab already names the page

    tabs.Parent = topbar and main or self.Sidebar
    if topbar then
        tabs.Position = UDim2.fromOffset(0, HEADER_HEIGHT)
        tabs.Size = UDim2.new(1, 0, 0, TOPTABS_HEIGHT)
        tabs.ScrollingDirection = Enum.ScrollingDirection.X
        tabs.AutomaticCanvasSize = Enum.AutomaticSize.X
        list.FillDirection = Enum.FillDirection.Horizontal
        list.VerticalAlignment = Enum.VerticalAlignment.Center
        if pad then
            pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 0), UDim.new(0, 4)
            pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 12), UDim.new(0, 12)
        end
    else
        local footer = self.UserProfileFrame and self.UserProfileFrame.Size.Y.Offset or 0
        tabs.Position = UDim2.fromOffset(0, BRAND_HEIGHT)
        tabs.Size = UDim2.new(1, 0, 1, -(BRAND_HEIGHT + footer))
        tabs.ScrollingDirection = Enum.ScrollingDirection.Y
        tabs.AutomaticCanvasSize = Enum.AutomaticSize.Y
        list.FillDirection = Enum.FillDirection.Vertical
        list.VerticalAlignment = Enum.VerticalAlignment.Top
        if pad then
            pad.PaddingTop, pad.PaddingBottom = UDim.new(0, 4), UDim.new(0, 12)
            pad.PaddingLeft, pad.PaddingRight = UDim.new(0, 10), UDim.new(0, 10)
        end
    end
    tabs.CanvasPosition = Vector2.new(0, 0)

    local top = topbar and (HEADER_HEIGHT + TOPTABS_HEIGHT) or HEADER_HEIGHT
    content.Position = UDim2.fromOffset(0, top)
    content.Size = UDim2.new(1, 0, 1, -top)

    for _, label in ipairs(self._categoryLabels) do
        label.Visible = not topbar
    end
    for _, page in ipairs(self.Pages) do
        if not page.Group then page:_styleTab() end
    end
    for _, group in ipairs(self.TabGroups or {}) do
        if group._applyLayout then group:_applyLayout() end
    end

    if self._shown and Library.Animations then
        local strip = tabs.Position
        Tween.slide(tabs, strip + (topbar and UDim2.fromOffset(0, -8) or UDim2.fromOffset(-12, 0)), strip, 0.24)
        Tween.slide(content, UDim2.fromOffset(0, top + 12), UDim2.fromOffset(0, top), 0.26)
    end

    self._shade.Color = self._paintShade()
    if self._layoutDropdown and self._layoutDropdown.Value ~= mode then
        self._layoutDropdown:Set(mode, true)
    end
    if self.OnLayoutChanged then Util.callback(self.OnLayoutChanged, mode) end
end

function Window:Search(query)
    query = string.lower(tostring(query or ""))
    query = string.gsub(query, "^%s+", "")
    query = string.gsub(query, "%s+$", "")
    self.SearchQuery = query
    local searching = query ~= ""
    local firstWithResults
    local activeHasResults = false

    for _, page in ipairs(self.Pages) do
        local pageCount = 0
        for _, section in ipairs(page.SectionList) do
            local sectionMatch = searching and (Locale.matches(section.Name, query) or Locale.matches(section.Description, query))
            local sectionCount = 0
            for _, element in ipairs(section.Elements) do
                local match = not searching or sectionMatch
                    or (element._matches and element:_matches(query))
                    or (not element._matches and Locale.matches(element.Name, query))
                if element._applySearch then
                    element:_applySearch(match)
                end
                if match and not element._hidden then
                    sectionCount = sectionCount + 1
                end
            end
            local showSection = not searching or sectionMatch or sectionCount > 0
            if section.Frame then
                section.Frame.Visible = showSection and not section._hidden
            end
            if section.IsCollapsed and section.Items.Body then
                local reveal = searching and sectionCount > 0
                section.Items.Body.Instance.Visible = reveal
            end
            if showSection then
                pageCount = pageCount + math.max(sectionCount, 1)
            end
        end
        page:_setSearchState(searching, pageCount)
        if pageCount > 0 then
            firstWithResults = firstWithResults or page
            if page.Active then activeHasResults = true end
        end
    end

    if searching and not activeHasResults and firstWithResults then
        self:SelectPage(firstWithResults)
        activeHasResults = true
    end
    self.NoResults.Visible = searching and not activeHasResults
end

function Window:Init()
    if self._initialized then return end
    self._initialized = true

    if not self.ActivePage and self.Pages[1] then
        self.Pages[1]:Turn(true)
    end
    local lastPage = Config.getLastPage()
    if lastPage then
        for _, page in ipairs(self.Pages) do
            if page.Name == lastPage then
                self:SelectPage(page)
                break
            end
        end
    end

    if not self._shown then
        self:_firstShow()
    end

    Library.DefaultConfig = Library:GetConfig()

    task.spawn(function()
        local name = Config.getActive()
        if Util.FS.isfile(Config.path(name) or "") and Config.load(name) then
            Library:Notification({ Title = Locale.t("Config"), Description = Locale.t("Auto loaded config") .. ": " .. name, Duration = 2 })
        end
    end)
end

function Window:_createMiniIcon()
    if self.MiniIcon then return end
    local size = Library.IsMobile and 50 or 44
    local icon = New("ImageButton", {
        Name = "MiniIcon",
        Size = UDim2.fromOffset(size, size),
        BackgroundTransparency = self.Root.BackgroundTransparency,
        Theme = { BackgroundColor3 = "Background" },
        Visible = false,
        ZIndex = 50,
        Corner = 12,
        Parent = Gui.Top,
    })

    local image = New("ImageLabel", {
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.new(1, -16, 1, -16),
        ScaleType = Enum.ScaleType.Fit,
        Image = self.Logo and Util.asset(self.Logo) or "",
        Parent = icon,
    })
    if self.LogoGradient then Theme.gradient(image) end

    if not self.Logo then
        New("TextLabel", {
            Size = UDim2.fromScale(1, 1),
            Text = string.upper(string.sub(self.Name, 1, 1)),
            TextSize = 20,
            TextXAlignment = Enum.TextXAlignment.Center,
            FontFace = Library.Fonts.Bold,
            Theme = { TextColor3 = "Accent" },
            Parent = icon,
        })
    end

    local iconScale = New("UIScale", { Parent = icon })

    local function defaultPosition()
        local inset = Services.GuiService:GetGuiInset()
        local top = inset.Y > 0 and inset.Y or 58 -- the inset reads 0 for a moment at startup
        local view = Gui.viewport()
        return UDim2.fromOffset(math.floor(view.X / 2 - size / 2), top + 10)
    end
    local saved = Config.getMiniIconPosition()
    self._miniIconCustom = saved ~= nil
    self._miniIconDefault = defaultPosition
    self._miniIconWanted = saved or Vector2.new(defaultPosition().X.Offset, defaultPosition().Y.Offset)
    icon.Position = UDim2.fromOffset(self._miniIconWanted.X, self._miniIconWanted.Y)

    local dragStart
    Library.Maid:Give(Input.drag(icon, {
        threshold = 6,
        onStart = function()
            dragStart = Vector2.new(icon.Position.X.Offset, icon.Position.Y.Offset)
        end,
        onMove = function(delta)
            local v = Gui.viewport()
            local p = dragStart + delta
            icon.Position = UDim2.fromOffset(
                math.clamp(p.X, 0, v.X - icon.AbsoluteSize.X),
                math.clamp(p.Y, 0, v.Y - icon.AbsoluteSize.Y)
            )
        end,
        onEnd = function(moved)
            if not moved then
                self:SetOpen(true)
            else
                self._miniIconCustom = true
                self._miniIconWanted = Vector2.new(icon.Position.X.Offset, icon.Position.Y.Offset)
                Config.setMiniIconPosition(self._miniIconWanted.X, self._miniIconWanted.Y)
            end
        end,
    }))

    if not Library.IsMobile then
        icon.MouseEnter:Connect(function()
            Tween.play(iconScale, { Scale = 1.06 }, 0.12)
        end)
        icon.MouseLeave:Connect(function()
            Tween.play(iconScale, { Scale = 1 }, 0.12)
        end)
    end

    self.MiniIcon = icon
    self.MiniIconScale = iconScale
    self.Items.MiniIcon = { Instance = icon }
end

