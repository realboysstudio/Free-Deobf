                local s = scale.Scale
                local view = Gui.viewport()
                local w, hgt = startSize.X, startSize.Y
                local x, y = startPos.X, startPos.Y
                if sx ~= 0 then
                    w = math.clamp(startSize.X + sx * delta.X / s, window.MinSize.X, math.max(window.MinSize.X, view.X / s))
                    if sx < 0 then x = startPos.X + (startSize.X - w) * s end
                end
                if sy ~= 0 then
