}
Theme.ThemeNames = { "Dark", "Light", "Midnight" }
Theme.AccentNames = { "B3", "Blue", "Purple", "Pink", "Red", "Orange", "Green", "Teal" }
Theme.Current = "Dark"

Library.Theme = {}
for k, v in pairs(Theme.Presets.Default) do
    Library.Theme[k] = v
end

local registry = {}
local count = 0

local function resolve(value)
    if type(value) == "function" then
        return value()
    end
    return Library.Theme[value]
end

function Theme.get(key)
    return Library.Theme[key]
end

local pruneAt = 512
local detached = {}

local function prune()
    local stillDetached = {}
    for instance in pairs(registry) do
        if instance.Parent == nil then
            if detached[instance] then
                registry[instance] = nil
                count = count - 1
            else
                stillDetached[instance] = true
            end
        end
    end
    detached = stillDetached
    pruneAt = math.max(512, count * 2)
end

function Theme.bind(instance, map)
    local entry = registry[instance]
    if not entry then
        entry = {}
        registry[instance] = entry
        count = count + 1
        if count >= pruneAt then prune() end
    end
    for property, value in pairs(map) do
        entry[property] = value
        local resolved = resolve(value)
        if resolved ~= nil then
            instance[property] = resolved
        end
    end
    return instance
end

function Theme.unbind(instance, property)
    local entry = registry[instance]
    if not entry then return end
    if property then
        entry[property] = nil
    else
        registry[instance] = nil
        count = count - 1
    end
end

function Theme.accentSequence()
    return ColorSequence.new(Library.Theme.Accent, Library.Theme.AccentGradient)
end

function Theme.gradient(parent, rotation)
    local gradient = Instance.new("UIGradient")
    gradient.Rotation = rotation or -115
    Theme.bind(gradient, { Color = Theme.accentSequence })
    gradient.Parent = parent
    return gradient
end

function Theme.set(key, color)
    Library.Theme[key] = color
    for instance, entry in pairs(registry) do
        if instance.Parent == nil then
            registry[instance] = nil
            count = count - 1
        else
            for property, value in pairs(entry) do
                if value == key or type(value) == "function" then
                    local resolved = resolve(value)
                    if resolved ~= nil then
                        instance[property] = resolved
                    end
                end
            end
        end
    end
end

function Theme.apply(map)
    for key, color in pairs(map) do
        Library.Theme[key] = color
    end
    for instance, entry in pairs(registry) do
        if instance.Parent == nil then
            registry[instance] = nil
            count = count - 1
        else
            for property, value in pairs(entry) do
                if type(value) == "function" or map[value] ~= nil then
                    local resolved = resolve(value)
                    if resolved ~= nil then
                        instance[property] = resolved
                    end
                end
            end
        end
    end
    if Library.OnThemeChanged then
        pcall(Library.OnThemeChanged, map)
    end
end

function Theme.clear()
    registry = {}
    count = 0
    pruneAt = 512
    detached = {}
    count = 0
end

local B3_ACCENT = Color3.fromRGB(128, 170, 255)
local LEGACY_ACCENTS = { ["73737d"] = true, ["9b9ba8"] = true }
function Theme.isLegacyAccent(color)
    return typeof(color) == "Color3" and LEGACY_ACCENTS[string.lower(color:ToHex())] == true
end

function Library:ChangeTheme(key, color)
    if (key == "Accent" or key == "AccentGradient") and Theme.isLegacyAccent(color) then
        color = B3_ACCENT
    end
    Theme.set(key, color)
end

function Library:SetTheme(nameOrMap, keepAccent)
    local preset = type(nameOrMap) == "table" and nameOrMap or Theme.Presets[nameOrMap]
    if not preset then return false end
    local map = {}
    for k, v in pairs(preset) do
        if not (keepAccent and (k == "Accent" or k == "AccentGradient")) then
            map[k] = v
        end
    end
    if type(nameOrMap) == "string" then Theme.Current = nameOrMap end
    Theme.apply(map)
    return true
end

function Library:SetAccent(nameOrColor, gradient)
    local a, b
    if typeof(nameOrColor) == "Color3" then
        a, b = nameOrColor, gradient or nameOrColor
    else
        local pair = Theme.Accents[nameOrColor]
        if not pair then return false end
        a, b = pair[1], pair[2]
    end
    Theme.apply({ Accent = a, AccentGradient = b })
    return true
end

function Library:AddTheme(name, map)
    local full = {}
    for k, v in pairs(Theme.Presets.Default) do full[k] = v end
    for k, v in pairs(map or {}) do full[k] = v end
    Theme.Presets[name] = full
