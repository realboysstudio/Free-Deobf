        Translate = { Text = "Unload the script?" },
        Theme = { TextColor3 = "Text" },
        ZIndex = 52,
        Parent = dialog,
    })
    local function button(text, x, colorKey)
        return New("TextButton", {
            Position = UDim2.new(x, x == 0 and 14 or 5, 1, -48),
            Size = UDim2.new(0.5, -19, 0, 32),
            Translate = { Text = text },
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Center,
            Theme = { BackgroundColor3 = colorKey, TextColor3 = "Text" },
            ZIndex = 52,
            Corner = 6,
            Parent = dialog,
        })
    end
    local cancel = button("Cancel", 0, "Element")
    local unload = button("Unload", 0.5, "Danger")
