local Services = require("core/Services")
local Library = require("core/Library")

local Gui = {}
Gui.ownLayers = setmetatable({}, { __mode = "k" })

local function getParent()
    local genv = (typeof(getgenv) == "function") and getgenv() or _G
    if genv.B3_USE_PLAYER_GUI then
        return Services.Players.LocalPlayer:WaitForChild("PlayerGui")
    end
    if typeof(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and typeof(hui) == "Instance" then
            local targetParent = hui
            pcall(function()
                if hui:IsA("ScreenGui") and hui.Parent then
                    targetParent = hui.Parent
                end
            end)
            local canAccess = false
            pcall(function()
                local probe = Instance.new("Frame")
                probe.Parent = targetParent
                local p = probe.Parent
                probe:Destroy()
                canAccess = (p == targetParent)
            end)
            if canAccess then
                return targetParent
            end
        end
    end
    local canUseCoreGui = false
    pcall(function()
        local testFrame = Instance.new("Frame")
        testFrame.Visible = false
        testFrame.Parent = Services.CoreGui
        testFrame.Visible = true
        local p = testFrame.Parent
        testFrame:Destroy()
        canUseCoreGui = (p == Services.CoreGui)
    end)
    if canUseCoreGui then
        return Services.CoreGui
    end
    return Services.Players.LocalPlayer:WaitForChild("PlayerGui")
end

local NAME_CHARS = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
local rng = Random.new()
local function randomName()
    local length = rng:NextInteger(8, 16)
    local out = table.create(length)
    for i = 1, length do
        local n = rng:NextInteger(1, #NAME_CHARS)
        out[i] = string.sub(NAME_CHARS, n, n)
    end
    return table.concat(out)
end
Gui.randomName = randomName

local function makeScreenGui(name, order)
    local gui = Instance.new("ScreenGui")
    gui.Name = name
    gui.AutoLocalize = false
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = order

    if typeof(syn) == "table" and type(syn.protect_gui) == "function" then
        pcall(syn.protect_gui, gui)
    elseif typeof(protectgui) == "function" then
        pcall(protectgui, gui)
    end

    local parent = getParent()
    local ok = pcall(function() gui.Parent = parent end)
    if not ok then
        pcall(function() gui.Parent = Services.Players.LocalPlayer:WaitForChild("PlayerGui") end)
    end
    Library.Maid:Give(gui)
    return gui
end

function Gui.init()
    Library._ensureIdentity(true)
    local genv = (typeof(getgenv) == "function") and getgenv() or _G
    local isAlive = false
    if Gui.Main then
        local ok, parent = pcall(function() return Gui.Main.Parent end)
        if ok and parent then
            isAlive = true
        else
            pcall(function() Gui.Main:Destroy() end)
            Gui.Main = nil
            Gui.Overlay = nil
            Gui.Top = nil
        end
    end

    if genv.B3_USE_PLAYER_GUI and isAlive then
        local okParent, mainParent = pcall(function() return Gui.Main.Parent end)
        local targetPg = nil
        pcall(function() targetPg = Services.Players.LocalPlayer:WaitForChild("PlayerGui", 2) end)
        if not okParent or (mainParent and targetPg and mainParent ~= targetPg) then
            pcall(function() Gui.Main:Destroy() end)
            pcall(function() if Gui.Overlay then Gui.Overlay:Destroy() end end)
            pcall(function() if Gui.Top then Gui.Top:Destroy() end end)
            Gui.Main = nil
            Gui.Overlay = nil
            Gui.Top = nil
            isAlive = false
        end
    end

    if isAlive then return end

    for _, key in ipairs({ "_B3_ACTIVE_GUIS", "_B3_ALL_GUIS" }) do
        if type(genv[key]) == "table" then
            local kept = {}
            for _, g in ipairs(genv[key]) do
                if Gui.ownLayers[g] then
                    table.insert(kept, g)
                else
                    pcall(function()
                        g:Destroy()
                    end)
                end
            end
            table.clear(genv[key])
            for _, g in ipairs(kept) do table.insert(genv[key], g) end
        end
    end

    pcall(function()
        local containers = {}
        if typeof(gethui) == "function" then
            pcall(function()
                local hui = gethui()
                if hui then table.insert(containers, hui) end
            end)
        end
        if not genv.B3_USE_PLAYER_GUI then
            pcall(function()
                local _ = Services.CoreGui:GetChildren()
                table.insert(containers, Services.CoreGui)
            end)
        end
        local lp = Services.Players.LocalPlayer
        if lp then
            pcall(function()
                local pg = lp:FindFirstChild("PlayerGui")
                if pg then table.insert(containers, pg) end
            end)
        end
        for _, c in ipairs(containers) do
            pcall(function()
                for _, child in ipairs(c:GetChildren()) do
                    pcall(function()
                        if child:IsA("ScreenGui") and (string.find(child.Name, "^ROUI_") or string.find(child.Name, "^B3_")) then
                            child:Destroy()
                        end
                    end)
                end
            end)
        end
    end)

    Gui.Main = makeScreenGui(randomName(), 999990)
    Gui.Overlay = makeScreenGui(randomName(), 999995)
    Gui.Top = makeScreenGui(randomName(), 999999)

    genv._B3_ACTIVE_GUIS = { Gui.Main, Gui.Overlay, Gui.Top }
    genv._B3_ALL_GUIS = genv._B3_ALL_GUIS or {}
    for _, g in ipairs(genv._B3_ACTIVE_GUIS) do table.insert(genv._B3_ALL_GUIS, g) end

    Library.Holder = { Instance = Gui.Main }
    Library.ScreenGui = Gui.Main
end

function Gui.newLayer(order)
    local gui = makeScreenGui(randomName(), order or 999900)
    Gui.ownLayers[gui] = true
    local genv = (typeof(getgenv) == "function") and getgenv() or _G
    genv._B3_ALL_GUIS = genv._B3_ALL_GUIS or {}
    table.insert(genv._B3_ALL_GUIS, gui)
    return gui
end

local scaled = {}
Gui.Scale = 1

function Gui.scaleWith(instance)
    local s = Instance.new("UIScale")
    s.Scale = Gui.Scale
    s.Parent = instance
    table.insert(scaled, s)
    return s
end

function Gui.applyScale(value)
    Gui.Scale = value
    for i = #scaled, 1, -1 do
        local s = scaled[i]
        if s.Parent == nil then
            table.remove(scaled, i)
        else
            s.Scale = value
        end
    end
end

Library.Maid:Give(function()
    scaled = {}
    Gui.Scale = 1
end)

function Gui.originOf(gui)
    if not gui then return Vector2.new(0, 0) end
    local ok, pos = pcall(function() return gui.AbsolutePosition end)
    if ok and typeof(pos) == "Vector2" then return pos end
    return Vector2.new(0, 0)
end

function Gui.viewport()
    if Gui.Main then
        local size = Gui.Main.AbsoluteSize
        if size.X > 0 and size.Y > 0 then
            return size
        end
    end
    local camera = Services.Workspace.CurrentCamera
    return camera and camera.ViewportSize or Vector2.new(1280, 720)
end

function Gui.eachText(callback)
    for _, root in ipairs({ Gui.Main, Gui.Overlay, Gui.Top }) do
        if root then
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("TextLabel") or d:IsA("TextButton") or d:IsA("TextBox") then
                    callback(d)
                end
            end
        end
    end
end

function Library:UpdateText()
    Gui.eachText(function(d)
        if not d:GetAttribute("ExplicitFont") then
            d.FontFace = Library.Font
        end
    end)
end

return Gui
]]

__sources["core/Hub"] = [[
local Services = require("core/Services")
local Library = require("core/Library")
local Util = require("core/Util")
local KeyTimer = require("core/KeyTimer")

local Players = Services.Players

local function genv()
    return (typeof(getgenv) == "function") and getgenv() or _G
end

local function mask(text, keep)
    text = tostring(text or "")
    keep = keep or 4
    if #text <= keep then return text end
    return string.sub(text, 1, keep) .. string.rep("*", math.min(#text - keep, 8))
end

local function shortNumber(value)
    local n = tonumber(value)
    if not n then return tostring(value) end
    local abs = math.abs(n)
    local units = { { 1e3, "K" }, { 1e6, "M" }, { 1e9, "B" }, { 1e12, "T" } }
    for i = #units, 1, -1 do
        local unit = units[i]
        if abs >= unit[1] then
            local scaled = tonumber(string.format("%.2f", n / unit[1]))
            if math.abs(scaled) >= 1000 and units[i + 1] then
                unit = units[i + 1]
                scaled = tonumber(string.format("%.2f", n / unit[1]))
            end
            local s = string.format("%.2f", scaled):gsub("%.?0+$", "")
            return s .. unit[2]
        end
    end
    return tostring(math.floor(n * 100 + 0.5) / 100)
end

Library.HubShortNumber = shortNumber

function Library:CreateHub(opts)
    opts = opts or {}
    local session = opts.Session or genv().B3_SESSION or {}

    local function toSlug(text)
        local s = tostring(text or ""):gsub("[^%w]", ""):sub(1, 24)
        return s
    end
    local rawName = tostring(session.GameName or session.PlaceId or "Game")
    local mapName = rawName:gsub("%s*%b()", ""):gsub("%s*%b[]", "")
    local slug = toSlug(mapName)
    if slug == "" then slug = toSlug(rawName) end
    if slug == "" then slug = "Game" end
    local root = (session.HubName or "B3Hub"):gsub("[^%w]", "")
    if root == "" then root = "B3Hub" end
    Library.Folders = {
        Configs = root .. "/Configs/" .. slug,
        Assets = root .. "/Assets",
    }

    local legacySlug = toSlug(rawName)
    if legacySlug ~= "" and legacySlug ~= slug then
        pcall(function()
            local FS = Util.FS
            local old = root .. "/Configs/" .. legacySlug
            local new = Library.Folders.Configs
            if FS.isfolder(old) and not FS.isfolder(new) then
                FS.ensureFolder(new)
                for _, file in ipairs(FS.list(old)) do
                    local name = string.match(file, "[^/\\]+$")
                    local content = name and FS.read(file)
                    if content then FS.write(new .. "/" .. name, content) end
                end
            end
        end)
    end

    local hub = {
        Session = session,
        _cleanups = {},
        _statGrids = {},
    }

    function hub:CleanUp(fn)
        table.insert(self._cleanups, fn)
    end

    local windowOpts = {
        Name = session.HubName or "B3 HUB",
        SubName = "auto",
        Logo = opts.Logo or "94190578752417",
        UserProfile = { Mask = true }, -- time left comes from the key timer, set by the loader
    }
    if type(opts.Window) == "table" then
        for k, v in pairs(opts.Window) do windowOpts[k] = v end
    end
    local _, hasTimer = KeyTimer.left()
    local ownTimer
    if not hasTimer and type(session.ExpiresIn) == "number" then
        Library:SetKeyExpiry(session.ExpiresIn)
        ownTimer = genv().ROUI_KeyExpiry
    end
    local Window = Library:Window(windowOpts)
    hub.Window = Window
    hub.KeyList = Library:KeybindList("Keybinds")

    if opts.Home ~= false then
        local announcements = session.Announcements
        if type(announcements) ~= "table" or #announcements == 0 then
            announcements = { { Version = "Welcome", Date = "", Changes = { "No announcements yet." } } }
        end

        local homeOpts = {
            Changelog = announcements,
            KeyStatus = false,
        }
        if opts.Leaderstats ~= false then homeOpts.Stats = {} end
        if type(opts.Home) == "table" then
            for k, v in pairs(opts.Home) do homeOpts[k] = v end
        end
        local Home = Library:CreateHomePage(Window, homeOpts)
        hub.Home = Home
        hub.StatsGrid = Home.StatsGrid
        table.insert(hub._statGrids, Home.StatsGrid)

        Home.Account:KeyValue({ Key = "Game", Value = tostring(session.GameName or "-") })
        if type(session.ExpiresAt) == "number" and session.ExpiresAt > 0 then
            Home.Account:KeyValue({ Key = "Expires on", Value = os.date("%Y-%m-%d %H:%M", session.ExpiresAt) })
        elseif type(session.ExpiresAt) == "string" and session.ExpiresAt ~= "" and session.ExpiresAt ~= "Lifetime" then
            Home.Account:KeyValue({ Key = "Expires on", Value = session.ExpiresAt })
        end
        local timeLeftRow = Home.Account:KeyValue({ Key = "Time left", Value = "Lifetime" })
        KeyTimer.listen(function(left, hasTimer)
            if hasTimer then
                timeLeftRow:SetValue(Library:FormatTime(left))
            end
        end)

        if opts.Leaderstats ~= false then
            local watched = {}
            local function watchStat(value)
                if not value:IsA("ValueBase") or watched[value] then return end
                watched[value] = true
                local id = value.Name
                local function update()
                    Home.StatsGrid:Set(id, shortNumber(value.Value), value.Name)
                end
                update()
                Library.Maid:Give(value:GetPropertyChangedSignal("Value"):Connect(update))
            end
            task.spawn(function()
                local lp = Players.LocalPlayer
                local leaderstats = lp:WaitForChild("leaderstats", 15)
                if Library.Unloaded then return end
                if not leaderstats then
                    Home.StatsGrid:Set("None", "-", "No leaderstats")
                    return
                end
                for _, child in ipairs(leaderstats:GetChildren()) do watchStat(child) end
                Library.Maid:Give(leaderstats.ChildAdded:Connect(watchStat))
            end)
        end
    end

    if opts.UtilityCategory then
        Window:Category(opts.UtilityCategory)
        hub._lastCategory = opts.UtilityCategory
    end
    if opts.Settings ~= false then
        Library:CreateSettingsPage(Window, hub.KeyList)
    end

    Library:OnUnload(function()
        for _, fn in ipairs(hub._cleanups) do
            local ok, err = pcall(fn)
            if not ok then warn("[Hub] cleanup error: " .. tostring(err)) end
        end
        if ownTimer and genv().ROUI_KeyExpiry == ownTimer then
            genv().ROUI_KeyExpiry = nil
        end
        if genv().B3_SESSION == session then
            genv().B3_SESSION = nil
        end
    end)

    function hub:Set(id, value, title)
        if self.StatsGrid then self.StatsGrid:Set(id, value, title) end
    end

    function hub:Page(name, data)
        data = data or {}
        if name and name ~= self._lastCategory then
            Window:Category(name, data.Translate)
            self._lastCategory = name
        end
        return Window:Page(data)
    end

    function hub:Group(name, data)
        data = data or {}
        data.Name = data.Name or name
        return Window:TabGroup(data)
    end

    function hub:Init()
        Window:Init()
        return Window
    end

    return hub
end

return true
]]

