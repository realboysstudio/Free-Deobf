local WIDTH = 340

local ClipboardSet = (type(setclipboard) == "function" and setclipboard)
    or (type(toclipboard) == "function" and toclipboard)
    or nil
local ClipboardGet = (type(getclipboard) == "function" and getclipboard)
    or (type(readclipboard) == "function" and readclipboard)
    or nil

local function trim(text)
    text = tostring(text or "")
    text = string.gsub(text, "^%s+", "")
    text = string.gsub(text, "%s+$", "")
    return text
end

local function mockVerifier(keys, delay)
    return function(key)
        task.wait(delay)
        for _, valid in ipairs(keys) do
            if key == tostring(valid) then return true end
        end
        return false, "Invalid key"
    end
end

function Library:KeySystem(data)
    data = data or {}

    local genv = (typeof(getgenv) == "function") and getgenv() or _G

    if genv._B3_ACTIVE_KEYPROMPT then
        pcall(function()
            if type(genv._B3_ACTIVE_KEYPROMPT.Destroy) == "function" then
                genv._B3_ACTIVE_KEYPROMPT:Destroy()
            elseif type(genv._B3_ACTIVE_KEYPROMPT.Close) == "function" then
                genv._B3_ACTIVE_KEYPROMPT:Close()
            end
        end)
        genv._B3_ACTIVE_KEYPROMPT = nil
    end

    if genv._B3_KEYPROMPT_ROOT then
        pcall(function()
            if typeof(genv._B3_KEYPROMPT_ROOT) == "Instance" then
                genv._B3_KEYPROMPT_ROOT:Destroy()
            end
        end)
        genv._B3_KEYPROMPT_ROOT = nil
    end

    if Library.KeyPrompt then
        pcall(function()
            if type(Library.KeyPrompt.Destroy) == "function" then
                Library.KeyPrompt:Destroy()
            end
        end)
        Library.KeyPrompt = nil
    end

    Gui.init()

    if Gui.Top then
        pcall(function()
            for _, child in ipairs(Gui.Top:GetChildren()) do
                if child.Name == "KeyPrompt" then
                    child:Destroy()
                end
            end
        end)
    end

    local prompt = {
        Name = data.Name or data.name or "Key system",
        Verified = false,
        Key = "",
        Items = {},
    }

    local saveKey = data.SaveKey ~= false
    local savePath = data.SaveFile or (Library.Folders.Configs .. "/key.txt")
