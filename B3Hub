        CheckCallback = function(on) set("Tracer", on and true or false) end,
        Callback = function(v)
            options.TracerFrom = v
            if group then group:Set({ TracerFrom = v }) end
        end,
    })
    tracerDrop:SubColorpicker({
        Flag = prefix .. "_TracerColor", Default = options.TracerColor,
        Callback = function(c) set("TracerColor", c) end,
    })

    local function colored(label, key, colorKey, fallback)
        local toggle = section:Toggle({
            Name = label, Flag = prefix .. "_" .. key, Default = options[key],
            Translate = true,
            Callback = function(on) set(key, on and true or false) end,
        })
        toggle:SubColorpicker({
            Flag = prefix .. "_" .. colorKey, Default = options[colorKey] or fallback,
            Callback = function(c) set(colorKey, c) end,
        })
    end
    colored("Name", "Name", "NameColor")
    colored("Distance", "Distance", "DistanceColor")

    local healthDrop = section:Dropdown({
        Name = "Health", Items = { "Both", "Bar", "Text" }, Default = options.HealthStyle or "Both",
        Flag = prefix .. "_HealthStyle", Compact = true, Size = 80,
        Translate = true,
        Checkbox = true, CheckFlag = prefix .. "_Health", CheckDefault = options.Health,
        CheckCallback = function(on) set("Health", on and true or false) end,
        Callback = function(v)
            options.HealthStyle = v
            if group then group:Set({ HealthStyle = v }) end
        end,
    })
    healthDrop:SubColorpicker({
        Flag = prefix .. "_HealthColor", Default = options.HealthColor or Color3.fromRGB(80, 230, 120),
        Callback = function(c) set("HealthColor", c) end,
    })

    local skelDrop = section:Dropdown({
        Name = "Skeleton", Items = { "Auto", "Anatomical", "Bones" }, Default = options.SkeletonMode or "Auto",
        Flag = prefix .. "_SkeletonMode", Compact = true, Size = 90,
        Translate = true,
        Checkbox = true, CheckFlag = prefix .. "_Skeleton", CheckDefault = options.Skeleton,
        CheckCallback = function(on) set("Skeleton", on and true or false) end,
        Callback = function(v)
            options.SkeletonMode = v
            if group then group:Set({ SkeletonMode = v }) end
        end,
    })
    skelDrop:SubColorpicker({
        Flag = prefix .. "_SkeletonColor", Default = options.SkeletonColor or Color3.fromRGB(255, 255, 255),
        Callback = function(c) set("SkeletonColor", c) end,
    })
    colored("Chams", "Chams", "ChamsColor")
    section:Slider({
        Name = "Max distance", Flag = prefix .. "_MaxDist",
        Min = 100, Max = 5000, Default = options.MaxDistance or 2000, Suffix = " studs",
        Translate = true,
        Callback = function(v) set("MaxDistance", v) end,
    })
    return { Group = function() return group end }
end

