__sources["components/KeybindCore"] = [[
local Library = require("core/Library")
local Util = require("core/Util")
local Input = require("core/Input")

local KeybindCore = {}
KeybindCore.__index = KeybindCore

local VALID_MODES = { Toggle = true, Hold = true, Always = true }

local function matches(io, key)
    if not key then return false end
    if io.UserInputType == Enum.UserInputType.Keyboard then
        return tostring(io.KeyCode) == key
    end
    if io.KeyCode ~= Enum.KeyCode.Unknown and tostring(io.KeyCode) == key then
        return true -- gamepad buttons
    end
    return tostring(io.UserInputType) == key
end

function KeybindCore.new(opts)
    local self = setmetatable({
        Key = nil,
        Value = "None",
        Mode = VALID_MODES[opts.Mode] and opts.Mode or "Toggle",
        Toggled = false,
        Picking = false,
        Name = opts.Name or "",
        OnChanged = opts.OnChanged,
        OnState = opts.OnState,
        _unsubscribe = {},
    }, KeybindCore)

    self.Flag = Library:RegisterFlag(opts.Flag, function(value)
        self:Set(value)
    end, opts.NoSave)

    table.insert(self._unsubscribe, Input.on("Began", function(io)
        if self.Picking then
            self:_handlePick(io)
            return
        end
        if Library.PickingKey or Input.isTyping() then return end
        if matches(io, self.Key) then
            if self.Mode == "Toggle" then
                self:SetToggled(not self.Toggled)
            else
                self:SetToggled(true)
            end
        end
    end))

    table.insert(self._unsubscribe, Input.on("Ended", function(io)
        if self.Picking or not self.Key then return end
        if self.Mode == "Hold" and matches(io, self.Key) then
            self:SetToggled(false)
        end
    end))

    if not opts.NoKeybindList and Library._AddKeybindEntry then
        self.ListEntry = Library:_AddKeybindEntry(self)
    end

    self:Set({ Key = opts.Default, Mode = self.Mode }, true)
    return self
end

function KeybindCore:_sync()
    Library.Flags[self.Flag] = { Key = self.Key, Mode = self.Mode, Toggled = self.Toggled }
    Library:NotifyFlagChanged(self.Flag, Library.Flags[self.Flag])
    if self.ListEntry then self.ListEntry:Update() end
    if self.OnChanged then self.OnChanged(self) end
end

function KeybindCore:SetToggled(value, silent)
    value = value and true or false
    if self.Mode == "Always" then value = true end
    local changed = value ~= self.Toggled
    self.Toggled = value
    self:_sync()
    if not silent and self.OnState then
        self.OnState(value, self, changed)
    end
end

function KeybindCore:SetMode(mode)
    if not VALID_MODES[mode] then return end
    self.Mode = mode
    if mode == "Always" then
        self:SetToggled(true)
    elseif mode == "Hold" and self.Toggled then
        self:SetToggled(false)
    else
        self:_sync()
    end
end

function KeybindCore:Set(value, initial)
    if type(value) == "string" and VALID_MODES[value] then
        self:SetMode(value)
        return
    end
    local mode
    if type(value) == "table" then
        mode = value.Mode or value.ModeSelected
        value = value.Key
    end
    local key, display = Util.parseKey(value)
    self.Key = key
    self.Value = display
    self.Picking = false
    if mode and VALID_MODES[mode] then
        self.Mode = mode
        if mode == "Always" then self.Toggled = true end
    end
    self:_sync()
    if not initial and self.Mode == "Always" and self.OnState then
        self.OnState(true, self, false)
    end
end

function KeybindCore:Get()
    return self.Key, self.Value, self.Mode
end

function KeybindCore:StartPicking()
    if self.Picking then
        self:StopPicking()
        return
    end
    local other = Library._PickingCore
    if other and other ~= self and other.Picking then
        other:StopPicking()
    end
    Library._PickingCore = self
    self.Picking = true
    Library.PickingKey = true
    if self.OnChanged then self.OnChanged(self) end
end

function KeybindCore:StopPicking()
    self.Picking = false
    if Library._PickingCore == self then Library._PickingCore = nil end
    task.defer(function() Library.PickingKey = false end)
    if self.OnChanged then self.OnChanged(self) end
end

function KeybindCore:_handlePick(io)
    local t = io.UserInputType
    if t == Enum.UserInputType.MouseMovement or t == Enum.UserInputType.MouseWheel or t == Enum.UserInputType.Focus then
        return
    end
    if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch then
        self:StopPicking()
        return
    end
    if t == Enum.UserInputType.Keyboard then
        if io.KeyCode == Enum.KeyCode.Backspace or io.KeyCode == Enum.KeyCode.Escape then
            self:Set(nil)
        else
            self:Set(io.KeyCode)
        end
    elseif string.find(tostring(t), "Gamepad") then
        self:Set(io.KeyCode)
    else
        self:Set(t)
    end
    self:StopPicking()
end

function KeybindCore:Destroy()
    if self.Picking then self:StopPicking() end
    for _, off in ipairs(self._unsubscribe) do off() end
    self._unsubscribe = {}
    if self.ListEntry then self.ListEntry:Remove() end
    Library.SetFlags[self.Flag] = nil
    Library.Flags[self.Flag] = nil
end

return KeybindCore
]]

