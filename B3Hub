    overlay.Activated:Connect(function() confirm:Close() end)
    cancel.Activated:Connect(function() confirm:Close() end)
    unload.Activated:Connect(function()
        confirm:Close()
        Library:Unload()
    end)

    self.UnloadConfirm = confirm
    self.Items.UnloadConfirm = { Instance = overlay, Dialog = dialog, Unload = unload, Cancel = cancel }
