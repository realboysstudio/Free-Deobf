local Maid = {}
Maid.__index = Maid

function Maid.new()
    return setmetatable({ _tasks = {} }, Maid)
end

function Maid:Give(task_)
    if task_ ~= nil then
        table.insert(self._tasks, task_)
    end
    return task_
end

local function cleanup(t)
    local kind = typeof(t)
    if kind == "RBXScriptConnection" then
        t:Disconnect()
    elseif kind == "Instance" then
        t:Destroy()
    elseif kind == "thread" then
        pcall(task.cancel, t)
    elseif kind == "function" then
        t()
    elseif type(t) == "table" then
        if type(t.Destroy) == "function" then
            t:Destroy()
        elseif type(t.Disconnect) == "function" then
            t:Disconnect()
        end
    end
end

function Maid:Clean()
    local tasks = self._tasks
    self._tasks = {}
    for i = #tasks, 1, -1 do
        local ok, err = pcall(cleanup, tasks[i])
        if not ok then
            warn("[B3] cleanup error: " .. tostring(err))
        end
    end
end

Maid.Destroy = Maid.Clean

return Maid
]]

__sources["core/Popup"] = [[
local Services = require("core/Services")
local Library = require("core/Library")
local Input = require("core/Input")
local Gui = require("core/Gui")
local Tween = require("core/Tween")

local Popup = {}
Popup.__index = Popup

local openList = {}
local renderConnection
local zCounter = 10

Library.PopupScale = 1

local function isShown(gui)
    local current = gui
    while current and not current:IsA("LayerCollector") do
        if current:IsA("GuiObject") and not current.Visible then
            return false
        end
        current = current.Parent
    end
    if not current then return false end
    if current:IsA("LayerCollector") then
        return current.Enabled
    end
    return true
end

local function updateRender()
    if #openList > 0 and not renderConnection then
        renderConnection = Services.RunService.RenderStepped:Connect(function()
            Library._ensureIdentity(true)
            for i = #openList, 1, -1 do
                local p = openList[i]
                if p then
                    if not isShown(p.Anchor) then
                        p:Close(true)
                    else
                        p:Place()
                    end
                end
            end
        end)
    elseif #openList == 0 and renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
end

function Popup.new(opts)
    Library._ensureIdentity(true)
    local self = setmetatable({}, Popup)
    self.Frame = opts.Frame
    self.Anchor = opts.Anchor
    self.ParentPopup = opts.Parent
    self.Align = opts.Align or "Left"
    self.Side = opts.Side or "Bottom"
    self.Gap = opts.Gap or 4
    self.MatchWidth = opts.MatchWidth
    self.AnimateHeight = opts.AnimateHeight and true or false
    self.TargetWidth = nil
    self.TargetHeight = nil
    self.OnOpen = opts.OnOpen
    self.OnClose = opts.OnClose
    self.IsOpen = false

    self.Scale = Instance.new("UIScale")
    Library._setParent(self.Scale, self.Frame)

    self.Frame.Visible = false
    self.Frame.AnchorPoint = Vector2.new(0, 0)
    Library._setParent(self.Frame, Gui.Overlay)
    return self
end

function Popup:IsAncestorOf(other)
    local current = other and other.ParentPopup
    while current do
        if current == self then return true end
        current = current.ParentPopup
    end
    return false
end

function Popup:ContainsAny(points)
    for _, point in ipairs(points) do
        if self:Contains(point) then return true end
    end
    return false
end

function Popup:Contains(point)
    if Input.isInside(self.Frame, point) or Input.isInside(self.Anchor, point) then
        return true
    end
    if (self.IsOpen or self._closingAt) and self.TargetHeight and self.Frame and self.Frame.Parent then
        local pos = self.Frame.AbsolutePosition
        local width = self.TargetWidth or self.Frame.AbsoluteSize.X
        local height = (self.TargetHeight or self.Frame.AbsoluteSize.Y) * (Library.PopupScale or 1)
        local topY = pos.Y
        local bottomY = pos.Y + height
        if self.Frame.AnchorPoint.Y == 1 then
            bottomY = pos.Y + self.Frame.AbsoluteSize.Y
            topY = bottomY - height
        end
        if point.X >= pos.X and point.X <= pos.X + width and point.Y >= topY and point.Y <= bottomY then
            return true
        end
    end
    for _, other in ipairs(openList) do
        if other ~= self and self:IsAncestorOf(other) and other:Contains(point) then
            return true
        end
    end
    return false
end

local OPEN_TIME = 0.20
local CLOSE_TIME = 0.16

function Popup:Place()
    local anchor = self.Anchor
    local frame = self.Frame
    local target = Library.PopupScale or 1
    local aPos, aSize = anchor.AbsolutePosition, anchor.AbsoluteSize

    if not self._openedAt and not self._closingAt then
        local view = Gui.viewport()
        local fAbs = frame.AbsoluteSize
        if self._lastAPos == aPos and self._lastASize == aSize
            and self._lastTarget == target and self._lastView == view
            and self._lastFAbs == fAbs then
            return
        end
        self._lastAPos, self._lastASize = aPos, aSize
        self._lastTarget, self._lastView, self._lastFAbs = target, view, fAbs
    else
        self._lastAPos = nil
    end

    local targetWidth
    if self.MatchWidth then
        targetWidth = math.floor(aSize.X / target + 0.5)
        self.TargetWidth = targetWidth
    else
        targetWidth = self.TargetWidth or frame.Size.X.Offset
    end

    local targetHeight = self.TargetHeight or frame.Size.Y.Offset
    local fSize = Vector2.new(targetWidth, targetHeight) * target
    if fSize.X <= 0 or fSize.Y <= 0 then
        fSize = frame.AbsoluteSize
    end
    local view = Gui.viewport()
    local x, y
    local opensUp = false

    if self.Side == "Right" then
        x = aPos.X + aSize.X + self.Gap
        y = aPos.Y
        if x + fSize.X > view.X - 4 then
            x = aPos.X - fSize.X - self.Gap
        end
    else
        x = (self.Align == "Right") and (aPos.X + aSize.X - fSize.X) or aPos.X
        local belowY = aPos.Y + aSize.Y + self.Gap
        local aboveY = aPos.Y - fSize.Y - self.Gap
        local roomBelow = (view.Y - 4) - belowY
        local roomAbove = (aPos.Y - self.Gap) - 4
        if fSize.Y <= roomBelow then
            y = belowY
        elseif fSize.Y <= roomAbove or roomAbove > roomBelow then
            y = aboveY
            opensUp = true
        else
            y = belowY
        end
    end

    x = math.clamp(x, 4, math.max(4, view.X - fSize.X - 4))
    y = math.clamp(y, 4, math.max(4, view.Y - fSize.Y - 4))

    if self.AnimateHeight then
        local progress = 1
        if self._openedAt and Library.Animations then
            progress = math.clamp((os.clock() - self._openedAt) / OPEN_TIME, 0, 1)
            if progress >= 1 then self._openedAt = nil end
        elseif self._closingAt and Library.Animations then
            progress = 1 - math.clamp((os.clock() - self._closingAt) / CLOSE_TIME, 0, 1)
            if progress <= 0 then
                self._closingAt = nil
                self.Frame.Visible = false
                local remIdx = table.find(openList, self)
                if remIdx then table.remove(openList, remIdx) end
                frame.Size = UDim2.new(0, targetWidth, 0, targetHeight)
                updateRender()
                return
            end
        end

        local eased
        if self._closingAt then
            eased = progress ^ 3
        else
            eased = 1 - (1 - progress) ^ 4
        end

        local currentHeight = math.floor(targetHeight * eased + 0.5)
        frame.ClipsDescendants = true
        frame.Size = UDim2.new(0, targetWidth, 0, currentHeight)

        if opensUp then
            frame.AnchorPoint = Vector2.new(0, 1)
            y = aPos.Y - self.Gap
        else
            frame.AnchorPoint = Vector2.new(0, 0)
            y = aPos.Y + aSize.Y + self.Gap
        end

        if self.Scale.Scale ~= target then
            self.Scale.Scale = target
        end

        local origin = Gui.originOf(frame.Parent)
        local newPos = UDim2.fromOffset(math.floor(x - origin.X + 0.5), math.floor(y - origin.Y + 0.5))
        if frame.Position ~= newPos then
            frame.Position = newPos
        end
        return
    end

    local progress = 1
    if self._openedAt and Library.Animations then
        progress = math.clamp((os.clock() - self._openedAt) / OPEN_TIME, 0, 1)
        if progress >= 1 then self._openedAt = nil end
    end
    local eased = 1 - (1 - progress) ^ 4
    local slide = (1 - eased) * 10
    y = y + (opensUp and slide or -slide)

    if self.Scale.Scale ~= target then
        self.Scale.Scale = target
    end

    local origin = Gui.originOf(frame.Parent)
    local newPos = UDim2.fromOffset(math.floor(x - origin.X + 0.5), math.floor(y - origin.Y + 0.5))
    if frame.Position ~= newPos then
        frame.Position = newPos
    end
end

function Popup:Open()
    if self.IsOpen then return end

    for i = #openList, 1, -1 do
        local other = openList[i]
        if other and other ~= self and not other:IsAncestorOf(self) then
            other:Close()
        end
    end

    self.IsOpen = true
    self._closingAt = nil
    if not table.find(openList, self) then
        table.insert(openList, self)
    end

    zCounter = zCounter + 1
    self.Frame.ZIndex = zCounter
    self._openedAt = os.clock()
    self._openStamp = os.clock()

    if self.OnOpen then self.OnOpen(self) end

    self:Place()
    self.Frame.Visible = true

    updateRender()
end

function Popup:Close(instant)
    if not self.IsOpen and not self._closingAt then return end
    self.IsOpen = false

    for i = #openList, 1, -1 do
        local other = openList[i]
        if other and self:IsAncestorOf(other) then
            other:Close(instant)
        end
    end

    if self.OnClose then self.OnClose(self) end

    if instant or not Library.Animations or not self.AnimateHeight then
        self._closingAt = nil
        self._openedAt = nil
        local index = table.find(openList, self)
        if index then table.remove(openList, index) end
        self.Frame.Visible = false
        if self.TargetWidth and self.TargetHeight then
            self.Frame.Size = UDim2.new(0, self.TargetWidth, 0, self.TargetHeight)
        end
        updateRender()
    else
        self._closingAt = os.clock()
        self._openedAt = nil
        self:Place()
        updateRender()
    end
end

function Popup:Toggle()
    if self.IsOpen then
        if self._openStamp and os.clock() - self._openStamp < 0.05 then return end
        self:Close()
    else
        self:Open()
    end
end

function Popup:Destroy()
    self:Close(true)
    if self.Frame then self.Frame:Destroy() end
end

function Popup.closeAll()
    for i = #openList, 1, -1 do
        if openList[i] then openList[i]:Close() end
    end
end

function Popup.init()
    Input.on("Began", function(io)
        if #openList == 0 then return end
        local t = io.UserInputType
        if t ~= Enum.UserInputType.MouseButton1 and t ~= Enum.UserInputType.MouseButton2 and t ~= Enum.UserInputType.Touch then
            return
        end
        local points = Input.candidates(io)
        for i = #openList, 1, -1 do
            local p = openList[i]
            if p and p.IsOpen and not p:ContainsAny(points) then
                p:Close()
            end
        end
    end)
    Library.Maid:Give(function()
        Popup.closeAll()
        if renderConnection then
            renderConnection:Disconnect()
            renderConnection = nil
        end
    end)
end

return Popup
]]

