    end)

    Base.pace()
    local settings = PopupContainer.new({ Anchor = settingsButton, Width = 260, MaxHeight = 380, Window = window, Translate = true })
    window.SettingsMenu = settings
    settingsButton.Activated:Connect(function()
        settings:ToggleOpen()
    end)
    window:_buildSettings(settings)

    if window.MiniIconEnabled then
        window:_createMiniIcon()
    end

    Library.Maid:Give(Input.on("Began", function(io)
        if Input.isTyping() or Library.PickingKey then return end
        local bind = Library.Flags.MenuBind
        local key
        if type(bind) == "table" then key = bind.Key else key = Library.MenuKeybind end
        if not key or key == "None" or key == "" then return end
        if (io.KeyCode ~= Enum.KeyCode.Unknown and tostring(io.KeyCode) == key) or tostring(io.UserInputType) == key then
            window:SetOpen(not window.IsOpen)
        end
    end))

    do
        local swipeTouch = nil
        local swipeStart = nil
        Library.Maid:Give(Input.on("Began", function(io)
            if window.IsOpen or window.MiniIconEnabled or Library.Unloaded then return end
            if io.UserInputType ~= Enum.UserInputType.Touch then return end
            local pos = Input.toScreen(io)
            local view = Gui.viewport()
            if pos.Y <= 72 and pos.X >= view.X * 0.2 and pos.X <= view.X * 0.8 then
                swipeTouch = io
                swipeStart = pos
            end
        end))
        Library.Maid:Give(Input.on("Changed", function(io)
            if io ~= swipeTouch or not swipeStart then return end
            if window.IsOpen or window.MiniIconEnabled or Library.Unloaded then
                swipeTouch = nil
                swipeStart = nil
                return
            end
            local pos = Input.toScreen(io)
            local dy = pos.Y - swipeStart.Y
            local dx = math.abs(pos.X - swipeStart.X)
            if dy >= 40 and dy > dx then
                swipeTouch = nil
                swipeStart = nil
                window:SetOpen(true)
            end
        end))
        Library.Maid:Give(Input.on("Ended", function(io)
            if io == swipeTouch then
                swipeTouch = nil
                swipeStart = nil
            end
        end))
    end

    if data.Blur then
        local Blur = require("components/Blur")
        Blur.attach(window)
    end

    local startLayout = data.Layout or data.layout
    if startLayout and string.lower(tostring(startLayout)) == "topbar" then
        window:SetLayout("Topbar")
    end

    window:SetCenter()

    if waitForMapName then
        Util.onMapName(function(mapName)
            if not Library.Unloaded and window.SubName == " " then
                window:SetTitle(nil, mapName)
            end
        end)
    end

    task.defer(function()
        while Base.isBuilding() and not window._shown and not Library.Unloaded do
            task.wait()
        end
        if not window._shown and not Library.Unloaded then
            window:_firstShow()
        end
    end)

    return window
end

function Window:_firstShow()
    self._shown = true
    if Config.getSilentLoad() then
        self:SetOpen(false, true)
    else
        self:SetOpen(true, true)
    end
end

function Window:SetCenter()
    local view = Gui.viewport()
    local s = self.Scale.Scale
    local size = self.Root.Size
    local w, h = size.X.Offset * s, size.Y.Offset * s
    self.Root.Position = UDim2.fromOffset(math.floor((view.X - w) / 2), math.floor((view.Y - h) / 2))
end

function Window:_syncModal()
    local unlock = self.ModalUnlock
    if not unlock then return end
    local want = self.IsOpen == true and Services.UserInputService.MouseBehavior ~= Enum.MouseBehavior.Default
    if unlock.Modal ~= want then
        unlock.Modal = want
    end
end

function Window:SetOpen(open, instant)
    Library._ensureIdentity()
    open = open and true or false
    self._gen = self._gen + 1
    local gen = self._gen
    self.IsOpen = open

    self:_syncModal()
    if not open then Tooltip.hide() end

    local root, scale = self.Root, self.Scale
    local s = self.BaseScale

    Tween.set(scale, { Scale = s })
    local base = self._slideBase or root.Position
    if open then
        root.Visible = true
        if instant or not Library.Animations then
            root.Position = base
            self._slideBase = nil
        else
            self._slideBase = base
            Tween.slide(root, base + UDim2.fromOffset(0, 10), base, 0.2, function()
                if self._gen == gen then self._slideBase = nil end
            end)
        end
        self:_setMiniIconVisible(false)
    else
        Popup.closeAll()
        if self.UnloadConfirm then self.UnloadConfirm:Close() end
        if instant or not Library.Animations then
            root.Visible = false
            root.Position = base
            self._slideBase = nil
        else
            self._slideBase = base
            Tween.slide(root, root.Position, base + UDim2.fromOffset(0, 8), 0.12, function()
                if self._gen == gen then
                    root.Visible = false
                    root.Position = base
                    self._slideBase = nil
                end
            end)
        end
        self:_setMiniIconVisible(true)
    end

    if self.OnVisibilityChanged then
        Util.callback(self.OnVisibilityChanged, open)
    end
end

function Window:SetMaximized(maximized)
    maximized = maximized and true or false
    if maximized == (self.Maximized or false) then return end
    local root = self.Root
    if maximized then
        self._restoreRect = { root.Size, root.Position }
        local view = Gui.viewport()
        local s = self.Scale.Scale
        local w = math.max(self.MinSize.X, math.floor((view.X - 24) / s))
        local h = math.max(self.MinSize.Y, math.floor((view.Y - 24) / s))
        self.Maximized = true
        Tween.play(root, { Size = UDim2.fromOffset(w, h), Position = UDim2.fromOffset(12, 12) }, 0.2, Enum.EasingStyle.Quint)
    else
        self.Maximized = false
        local rect = self._restoreRect
        if rect then
            Tween.play(root, { Size = rect[1], Position = rect[2] }, 0.2, Enum.EasingStyle.Quint)
        end
    end
    if self.OnMaximize then Util.callback(self.OnMaximize, maximized) end
end

function Window:Toggle()
    self:SetOpen(not self.IsOpen)
end

function Window:Minimize()
    self:SetOpen(false)
end

function Window:Restore()
    self:SetOpen(true)
end

function Window:SetUIScale(value)
    value = math.clamp(tonumber(value) or self.UserScale or 1, 0.3, 2)
    self.UserScale = value
    Library.Flags.UIScale = value
    if self._applyScale then self._applyScale() end
end

function Window:SetTransparency(value)
    value = tonumber(value) or Library.Flags.BackgroundTransparency or DEFAULT_TRANSPARENCY
    if Library.IsMobile then
        self.Root.BackgroundTransparency = math.clamp(value, 0, 0.05)
    else
        self.Root.BackgroundTransparency = value
    end
    for _, page in ipairs(self.Pages) do
        for _, section in ipairs(page.SectionList) do
            if section.Frame then section.Frame.BackgroundTransparency = value end
        end
    end
    if self.MiniIcon then
        self.MiniIcon.BackgroundTransparency = value
    end
end

function Window:SetTitle(name, subName)
    if name then
        self.Name = name
        self.Items.Title.Instance.Text = name
    end
    if subName ~= nil then
        if subName == "auto" then
            subName = Util.getMapName()
        elseif subName == false then
            subName = ""
        else
            subName = tostring(subName)
        end
        self.SubName = subName
        self.Items.SubTitle.Instance.Text = subName
        self.Items.SubTitle.Instance.Visible = subName ~= ""
